class=3D"hljs-title">YourClass</span> : <span class=3D"hljs-typename">Prode=
geRewardedLoadListener {</span></span>
    <span class=3D"hljs-comment">// ...</span>

    <span class=3D"hljs-keyword">private</span> <span class=3D"hljs-functio=
n"><span class=3D"hljs-keyword">fun</span> <span class=3D"hljs-title">loadR=
ewardedAd</span><span class=3D"hljs-params">()</span> {</span>
