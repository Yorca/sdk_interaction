{
    "SDK": "Tapjoy",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "the application has made its own determination as to whether GDPR is applicable to the user or not"
            ],
            "effects": [
                "sets user consent status for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "indicates that the user does not consent"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "indicates that the user consents"
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "indicates whether the user is subject to GDPR rules"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "user is treated as subject to GDPR regulations"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "user is treated as not subject to GDPR regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "setBelowConsentAge",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "informs Tapjoy of COPPA compliance and/or other applicable age compliance laws"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "indicates that the user is below the consent age"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "indicates that the user is above the consent age"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "sets the US privacy string derived from the IAB\u2019s US Privacy String Format"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YNN"
                    ],
                    "conditions": [],
                    "effects": [
                        "sets US privacy preference to specific compliance status"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutAdvertisingID",
            "class_name": "Tapjoy",
            "conditions": [],
            "effects": [
                "opt-out of using advertising ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "prevents accessing the advertising ID for compliance with Google Families Program"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "allows accessing the advertising ID"
                    ]
                }
            ]
        }
    ]
}