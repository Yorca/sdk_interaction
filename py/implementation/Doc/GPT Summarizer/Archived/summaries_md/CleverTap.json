{
    "SDK": "CleverTap",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "class_name": "CleverTapAPI",
            "conditions": [
                "GDPR compliance"
            ],
            "effects": [
                "stops events from being sent to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "user's data will no longer be shared with CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "user's data sharing with CleverTap is reinstated"
                    ]
                }
            ]
        },
        {
            "API_name": "enableDeviceNetworkInfoReporting",
            "class_name": "CleverTapAPI",
            "conditions": [
                "GDPR compliance"
            ],
            "effects": [
                "enables the collection of device networking information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User provides consent for network information capturing"
                    ],
                    "effects": [
                        "CleverTap starts capturing WiFi, Bluetooth, Network Information, and user IP information"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "CleverTap stops capturing network information"
                    ]
                }
            ]
        },
        {
            "API_name": "setOffline",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "no events/profile information will be sent to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is marked as offline"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User is marked as online and events can be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "setLocation",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "sets user's geographical location for better targeting"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "android.location.Location"
                    ],
                    "conditions": [
                        "User grants permission for location access"
                    ],
                    "effects": [
                        "CleverTap uses the supplied location for segmentation and targeting"
                    ]
                }
            ]
        },
        {
            "API_name": "setEncryptionLevel",
            "class_name": "CleverTapInstanceConfig",
            "conditions": [],
            "effects": [
                "defines the encryption level for sensitive personal data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is stored in plaintext"
                    ]
                },
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is encrypted completely"
                    ]
                }
            ]
        }
    ]
}