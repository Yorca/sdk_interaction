{
    "SDK": "Kochava",
    "privacy_APIs": [
        {
            "API_name": "setIntelligentConsentGranted",
            "class_name": "Tracker",
            "conditions": [
                "User response to consent prompt dialog"
            ],
            "effects": [
                "Enables or disables data collection based on user consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User grants consent"
                    ],
                    "effects": [
                        "Starts data collection"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User declines consent"
                    ],
                    "effects": [
                        "Stops data collection"
                    ]
                }
            ]
        },
        {
            "API_name": "registerPrivacyProfile",
            "class_name": "Tracker",
            "conditions": [
                "Privacy profile must be enabled to restrict datapoints"
            ],
            "effects": [
                "Creates a privacy profile to manage data transmission restrictions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "child",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        "User is determined to be a child"
                    ],
                    "effects": [
                        "Restricts transmission of specified datapoints for child users"
                    ]
                },
                {
                    "parameter_values": [
                        "restrict ids",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        null
                    ],
                    "effects": [
                        "Restricts transmission of specified datapoints for all users"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyProfileEnabled",
            "class_name": "Tracker",
            "conditions": [
                "Privacy profile must be created before enabling"
            ],
            "effects": [
                "Enables or disables a privacy profile for current user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        true
                    ],
                    "conditions": [
                        "To prevent device identifiers from egressing"
                    ],
                    "effects": [
                        "Prevents the ADID or Android ID from being transmitted"
                    ]
                },
                {
                    "parameter_values": [
                        "child",
                        true
                    ],
                    "conditions": [
                        "For child users"
                    ],
                    "effects": [
                        "Restricts transmission of specified datapoints only for child users"
                    ]
                }
            ]
        },
        {
            "API_name": "setAppLimitAdTracking",
            "class_name": "Tracker",
            "conditions": [],
            "effects": [
                "Limits the use of the advertising identifier for tracking purposes"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User opts out of being tracked"
                    ],
                    "effects": [
                        "Sets application-level limit for ad tracking"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User allows tracking"
                    ],
                    "effects": [
                        "Removes limit on ad tracking"
                    ]
                }
            ]
        }
    ]
}