{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setEnabled",
            "class_name": "AppCenter",
            "conditions": [
                "must be called after AppCenter has been started"
            ],
            "effects": [
                "controls whether the SDK will forward any information to App Center"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "disables all services, stopping data collection and reporting"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "enables all services, allowing data to be collected and reported"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserId",
            "class_name": "AppCenter",
            "conditions": [
                "must be called before each application launch as this value isn't stored by the SDK between launches"
            ],
            "effects": [
                "sets a user ID to augment crash reports, which can be searched later"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "your-user-id"
                    ],
                    "conditions": [],
                    "effects": [
                        "associates specified user ID with crash reports"
                    ]
                }
            ]
        },
        {
            "API_name": "setNetworkRequestsAllowed",
            "class_name": "AppCenter",
            "conditions": [
                "must be called before AppCenter is started"
            ],
            "effects": [
                "controls whether the SDK can send data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "disallows automatic sending of collected data until explicitly allowed again"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "allows automatic sending of collected data"
                    ]
                }
            ]
        },
        {
            "API_name": "trackError",
            "class_name": "Crashes",
            "conditions": [
                "the Crashes service must be started"
            ],
            "effects": [
                "tracks handled exceptions for reporting to App Center"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception",
                        null,
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "logs the exception without additional context or attachments"
                    ]
                },
                {
                    "parameter_values": [
                        "exception",
                        "properties",
                        "attachments"
                    ],
                    "conditions": [],
                    "effects": [
                        "logs the exception with added contextual properties and attachments"
                    ]
                }
            ]
        },
        {
            "API_name": "notifyUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "tells the SDK how to proceed based on user confirmation for sending crash logs"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "DONT_SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "informs the SDK to not send the crash report"
                    ]
                },
                {
                    "parameter_values": [
                        "SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "informs the SDK to send the crash report"
                    ]
                },
                {
                    "parameter_values": [
                        "ALWAYS_SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "informs the SDK to always send crash reports when available"
                    ]
                }
            ]
        }
    ]
}