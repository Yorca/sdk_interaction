{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setUserId",
            "class_name": "AppCenter",
            "conditions": [
                "Configure the App Center SDK by calling AppCenter.start(...)"
            ],
            "effects": [
                "Augments crash reports with user ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "your-user-id"
                    ],
                    "conditions": [
                        "User ID limited to 256 characters"
                    ],
                    "effects": [
                        "The last user ID set will be used in crash reports"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabled",
            "class_name": "AppCenter",
            "conditions": [
                "Must be called after AppCenter has been started"
            ],
            "effects": [
                "Enables or disables all App Center services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK won't forward any information to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Re-enables all App Center services"
                    ]
                }
            ]
        },
        {
            "API_name": "setNetworkRequestsAllowed",
            "class_name": "AppCenter",
            "conditions": [
                "Must be called after AppCenter has been started"
            ],
            "effects": [
                "Allows or disallows automatic sending of collected data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Collects data but sends it only when network requests are allowed"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows immediate sending of collected data"
                    ]
                }
            ]
        },
        {
            "API_name": "pause",
            "class_name": "Analytics",
            "conditions": [],
            "effects": [
                "Pauses the event transmission"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "resume",
            "class_name": "Analytics",
            "conditions": [],
            "effects": [
                "Resumes the event transmission"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "trackError",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Tracks handled exceptions and can attach additional context"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception",
                        "properties",
                        "attachments"
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows attaching properties and attachments to the error report"
                    ]
                }
            ]
        },
        {
            "API_name": "shouldAwaitUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Determines if the SDK should wait for user confirmation before sending crash reports"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "notifyUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Notifies the SDK of the user's decision regarding crash report submission"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Crashes.DONT_SEND"
                    ],
                    "conditions": [],
                    "effects": []
                },
                {
                    "parameter_values": [
                        "Crashes.SEND"
                    ],
                    "conditions": [],
                    "effects": []
                },
                {
                    "parameter_values": [
                        "Crashes.ALWAYS_SEND"
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        }
    ]
}