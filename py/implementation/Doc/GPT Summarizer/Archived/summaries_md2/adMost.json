{
    "SDK": "adMost",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "class_name": "AdMostConfiguration",
            "conditions": [
                "User must provide consent for GDPR or CCPA compliance"
            ],
            "effects": [
                "Passes user's consent to the AdMost SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the user has given consent"
                    ],
                    "effects": [
                        "User consent for data collection is acknowledged by AdMost"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the user has not given consent"
                    ],
                    "effects": [
                        "User consent for data collection is not acknowledged by AdMost"
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "AdMostConfiguration",
            "conditions": [
                "User is located within the European Economic Area or under the age of 16"
            ],
            "effects": [
                "Defines whether the user should be treated under GDPR regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the user is subject to GDPR"
                    ],
                    "effects": [
                        "The SDK applies GDPR rules for data handling"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the user is not subject to GDPR"
                    ],
                    "effects": [
                        "The SDK does not apply GDPR rules for data handling"
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToCCPA",
            "class_name": "AdMostConfiguration",
            "conditions": [
                "User is a resident of California"
            ],
            "effects": [
                "Defines whether the user should be treated under CCPA regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the user is subject to CCPA"
                    ],
                    "effects": [
                        "The SDK applies CCPA rules for data handling"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the user is not subject to CCPA"
                    ],
                    "effects": [
                        "The SDK does not apply CCPA rules for data handling"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserChild",
            "class_name": "AdMostConfiguration",
            "conditions": [
                "User is considered to be a child under the age of 18"
            ],
            "effects": [
                "Defines whether the user should be treated as a child for ad purposes"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the developer knows the user is a child"
                    ],
                    "effects": [
                        "Ads shown will comply with safeguards for children"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the developer knows the user is not a child"
                    ],
                    "effects": [
                        "Normal ad rules apply without child restrictions"
                    ]
                }
            ]
        },
        {
