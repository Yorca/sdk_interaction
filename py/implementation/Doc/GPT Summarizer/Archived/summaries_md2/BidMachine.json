{
    "SDK": "BidMachine",
    "privacy_APIs": [
        {
            "API_name": "setCoppa",
            "class_name": "BidMachine",
            "conditions": [
                "To help ensure compliance with COPPA you must indicate whether a user falls within an age-restricted category."
            ],
            "effects": [
                "Indicates whether the user is subject to COPPA regulations."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user is under the age of 13 and is subject to COPPA regulations."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user is not under the age of 13 and is not subject to COPPA regulations."
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "BidMachine",
            "conditions": [
                "Publisher needs to send a boolean flag indicating if GDPR applies to the current user."
            ],
            "effects": [
                "Indicates whether the app must comply with GDPR."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The app must collect user consent prior to requesting any ads from the Exchange server."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The app is not required to follow GDPR regulations."
                    ]
                }
            ]
        },
        {
            "API_name": "setConsentConfig",
            "class_name": "BidMachine",
            "conditions": [
                "User consent must be collected prior to requesting ads if GDPR regulations apply."
            ],
            "effects": [
                "Allows the app to configure the user's consent settings."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "<GDPR CONSENT STRING>"
                    ],
                    "conditions": [
                        "User has provided consent"
                    ],
                    "effects": [
                        "Consent string is sent to the server indicating user consent."
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        null
                    ],
                    "conditions": [
                        "User has not provided consent"
                    ],
                    "effects": [
                        "No consent string is sent to the server."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "class_name": "BidMachine",
            "conditions": [
                "To pass CCPA U.S. Privacy String to BidMachine, use this method."
            ],
            "effects": [
                "Confirms the user's privacy preferences under CCPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<CCPA U.S. Privacy STRING>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sends the specified CCPA privacy string to the server."
                    ]
                }
            ]
        },
        {
            "API_name": "setGPP",
            "class_name": "BidMachine",
            "conditions": [],
            "effects": [],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<GPP STRING>",
                        "<GPP ID LIST>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Passes the specified GPP information to the server."
                    ]
                }
            ]
        }
    ]
}