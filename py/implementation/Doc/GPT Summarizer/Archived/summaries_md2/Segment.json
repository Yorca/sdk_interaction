            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "All data collection stops, including from Segment itself"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Data collection resumes after being disabled"
                    ]
                }
            ]
        },
        {
            "API_name": "anonymizeIP",
            "class_name": "Analytics",
            "conditions": [
                "User data protection laws require IP address anonymization"
            ],
            "effects": [
                "IP address is not recorded, replacing it with '0.0.0.0' in events"
            ],
            "parameter_configurations": []
        }
    ]
}