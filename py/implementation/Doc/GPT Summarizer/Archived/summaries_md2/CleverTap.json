{
    "SDK": "CleverTap",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "class_name": "CleverTapAPI",
            "conditions": [
                "User must choose to opt out of sharing their data"
            ],
            "effects": [
                "Stops sending events to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Events will not be sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User has opted in again to share their data"
                    ]
                }
            ]
        },
        {
            "API_name": "enableDeviceNetworkInfoReporting",
            "class_name": "CleverTapAPI",
            "conditions": [
                "User must allow the app to capture device network information"
            ],
            "effects": [
                "Enables capturing of personal information like WiFi, Bluetooth, Network Information and user IP information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Device network information will be sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Device network information will not be sent to CleverTap"
                    ]
                }
            ]
        },
        {
            "API_name": "setOffline",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "Prevents any events/profile information from being sent to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is set as offline; no data is sent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User is back online; data can be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "setLocation",
            "class_name": "CleverTapAPI",
            "conditions": [
                "User must grant permission to use location services"
            ],
            "effects": [
                "Updates user location in CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "location"
                    ],
                    "conditions": [],
                    "effects": [
                        "The location is sent to CleverTap"
                    ]
                }
            ]
        },
        {
            "API_name": "setEncryptionLevel",
            "class_name": "CleverTapInstanceConfig",
            "conditions": [
                "Must be set in AndroidManifest.xml for the default instance"
            ],
            "effects": [
                "Determines how personally identifiable information (PII) is stored"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "None"
                    ],
                    "conditions": [],
                    "effects": [
                        "All stored data is in plaintext"
                    ]
                },
                {
                    "parameter_values": [
                        "Medium"
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is encrypted completely"
                    ]
                }
            ]
        }
    ]
}