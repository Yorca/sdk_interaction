{
    "SDK": "AppLovin",
    "privacy_APIs": [
        {
            "API_name": "setHasUserConsent",
            "class_name": "AppLovinPrivacySettings",
            "conditions": [
                "User must provide explicit consent for interest-based advertising"
            ],
            "effects": [
                "Indicates whether user consent is granted or not for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "User data can be processed for interest-based advertising"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "User data cannot be processed for interest-based advertising"
                    ]
                }
            ]
        },
        {
            "API_name": "setIsAgeRestrictedUser",
            "class_name": "AppLovinPrivacySettings",
            "conditions": [
                "Required to comply with COPPA, GDPR, and other age-related restrictions"
            ],
            "effects": [
                "Indicates whether the user is in an age-restricted category"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "User is under the age of 16 or as defined by applicable laws"
                    ],
                    "effects": [
                        "Prohibition on collecting personal data and serving ads to this user"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "User is not under the age of 16"
                    ],
                    "effects": [
                        "No restrictions on collecting personal data or serving ads to this user"
                    ]
                }
            ]
        },
        {
            "API_name": "setDoNotSell",
            "class_name": "AppLovinPrivacySettings",
            "conditions": [
                "Required for compliance with state laws regarding the sale of personal information"
            ],
            "effects": [
                "Indicates whether the user's data can be sold or not"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "User opts out of sale of their personal information"
                    ],
                    "effects": [
                        "User's data will not be sold"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "User does not opt out"
                    ],
                    "effects": [
                        "User's data can be sold"
                    ]
                }
            ]
        }
    ]
}