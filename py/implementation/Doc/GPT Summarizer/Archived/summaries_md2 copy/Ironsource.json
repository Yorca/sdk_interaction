{
    "SDK": "Ironsource",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "class_name": "IronSource",
            "conditions": [
                "User must provide GDPR consent"
            ],
            "effects": [
                "Specifies whether the user has consented to data collection under GDPR"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User has provided consent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User has not provided consent"
                    ]
                }
            ]
        },
        {
            "API_name": "setMetaData",
            "class_name": "IronSource",
            "conditions": [
                "Must be called before initializing the SDK"
            ],
            "effects": [
                "Sets user privacy-related metadata"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "do_not_sell",
                        "true"
                    ],
                    "conditions": [
                        "User has opted out of sale or sharing of personal information"
                    ],
                    "effects": [
                        "Indicates that personal information should not be sold or shared"
                    ]
                },
                {
                    "parameter_values": [
                        "do_not_sell",
                        "false"
                    ],
                    "conditions": [
                        "User allows sale or sharing of personal information"
                    ],
                    "effects": [
                        "Indicates that personal information can be sold or shared"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "true"
                    ],
                    "conditions": [
                        "User is identified as a child under applicable regulations"
                    ],
                    "effects": [
                        "Flags the app as child-directed"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "false"
                    ],
                    "conditions": [
                        "User is not identified as a child"
                    ],
                    "effects": [
                        "Flags the app as not child-directed"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "true"
                    ],
                    "conditions": [
                        "Applicable for children or users of unknown age"
                    ],
                    "effects": [
                        "Prevents access to the Android Advertising ID"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "false"
                    ],
                    "conditions": [
                        "App allows access to the Android Advertising ID"
                    ],
                    "effects": [
                        "Allows access to the Android Advertising ID"
                    ]
                }
            ]
        }
    ]
}