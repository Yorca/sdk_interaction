{
    "SDK": "Tapjoy",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "Application has made its own determination as to whether GDPR is applicable to the user or not"
            ],
            "effects": [
                "Indicates whether the user has consented to data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [
                        "User consents to data processing"
                    ],
                    "effects": [
                        "User data can be processed according to GDPR regulations"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [
                        "User does not consent to data processing"
                    ],
                    "effects": [
                        "User data should not be processed according to GDPR regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "Application has made its own determination regarding GDPR applicability"
            ],
            "effects": [
                "Sets whether the user is subject to GDPR regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [
                        "User is determined to be subject to GDPR rules"
                    ],
                    "effects": [
                        "GDPR rules apply to the user's data processing"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [
                        "User is determined to not be subject to GDPR rules"
                    ],
                    "effects": [
                        "GDPR rules do not apply to the user's data processing"
                    ]
                }
            ]
        },
        {
            "API_name": "setBelowConsentAge",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Indicates whether the user is below the consent age for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates compliance with COPPA and other applicable laws regarding users below consent age"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates user is of consent age"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Sets the US privacy flag based on IAB\u2019s US Privacy String format"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YYY"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates user consent status according to the US Privacy regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutAdvertisingID",
            "class_name": "Tapjoy",
            "conditions": [
                "Targeting children under the Google Families Program rules"
            ],
            "effects": [
                "Prevents access to the advertising ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null,
                        true
                    ],
                    "conditions": [
                        "Flag can be set any time before or after connect, and can be changed any time during the session"
                    ],
                    "effects": [
                        "User's advertising ID opt-out status updated"
                    ]
                }
            ]
        }
    ]
}