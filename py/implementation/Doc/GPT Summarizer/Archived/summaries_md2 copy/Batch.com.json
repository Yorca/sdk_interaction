{
    "SDK": "Batch.com",
    "privacy_APIs": [
        {
            "API_name": "updateAutomaticDataCollection",
            "class_name": "Batch",
            "conditions": [
                "User consent is required to enable data collection"
            ],
            "effects": [
                "Enables or disables automatic collection of specified data types"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        true,
                        true
                    ],
                    "conditions": [
                        "User has provided consent to collect the data"
                    ],
                    "effects": [
                        "GeoIP resolution, device brand, and device model information are collected automatically"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        false,
                        false
                    ],
                    "conditions": [
                        "User has not provided consent to collect the data"
                    ],
                    "effects": [
                        "GeoIP resolution, device brand, and device model information are not collected"
                    ]
                }
            ]
        },
        {
            "API_name": "optOut",
            "class_name": "Batch",
            "conditions": [
                "The SDK must have been started."
            ],
            "effects": [
                "Disables all SDK operations, preventing data collection and in-app campaigns."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context"
                    ],
                    "conditions": [],
                    "effects": [
                        "Stops any network capability from the SDK and all In-App campaigns."
                    ]
                }
            ]
        },
        {
            "API_name": "optOutAndWipeData",
            "class_name": "Batch",
            "conditions": [
                "The SDK must have been started."
            ],
            "effects": [
                "Wipes local data and requests remote data removal, but does not delete user-level data associated with Custom User ID."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context"
                    ],
                    "conditions": [],
                    "effects": [
                        "Logs the user out and deletes installation data."
                    ]
                }
            ]
        },
        {
            "API_name": "optIn",
            "class_name": "Batch",
            "conditions": [
                "User has previously opted-out"
            ],
            "effects": [
                "Re-enables SDK operations, allowing data collection and In-App campaigns."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context"
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK starts operating again."
                    ]
                }
            ]
        },
        {
            "API_name": "disableSDKByDefault",
            "class_name": "Batch",
            "conditions": [
                "Meta-data entry in AndroidManifest is set"
            ],
            "effects": [
                "SDK starts in a disabled state by default until opted-in by the user."
            ],
            "parameter_configurations": []
        }
    ]
}