{
    "SDK": "Facebook Audience Network",
    "privacy_APIs": [
        {
            "API_name": "setMixedAudience",
            "class_name": "AdSettings",
            "conditions": [
                "The app is Mixed Audience without an Age Gate"
            ],
            "effects": [
                "Facebook will only serve ads to non-United States users of that app through the Audience Network services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "The app is Mixed Audience without an Age Gate"
                    ],
                    "effects": [
                        "Only serve ads to non-United States users"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setAdvertiserTrackingEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "Permission is provided for Advertiser Tracking"
            ],
            "effects": [
                "Enables or disables the advertiser tracking for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Permission granted by the user"
                    ],
                    "effects": [
                        "Enables advertiser tracking"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Permission denied by the user"
                    ],
                    "effects": [
                        "Disables advertiser tracking"
                    ]
                }
            ]
        },
        {
            "API_name": "setAutoLogAppEventsEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "User provides consent after installation"
            ],
            "effects": [
                "Automatic logging of app events is enabled or disabled"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has provided consent"
                    ],
                    "effects": [
                        "Starts logging app events"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not provided consent"
                    ],
                    "effects": [
                        "Stops logging app events"
                    ]
                }
            ]
        },
        {
            "API_name": "setDataProcessingOptions",
            "class_name": "FBSDKSettings",
            "conditions": [
                "User is located in California, Colorado, or Connecticut"
            ],
            "effects": [
                "Enables Limited Data Use (LDU) for events"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        0,
                        0
                    ],
                    "conditions": [
                        "Enable LDU with geolocation"
                    ],
                    "effects": [
                        "Processes data according to service provider role"
                    ]
                },
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        1,
                        1000
                    ],
                    "conditions": [
                        "Enable LDU with specified location"
                    ],
                    "effects": [
                        "Processes data according to service provider role"
                    ]
                },
                {
                    "parameter_values": [
                        []
                    ],
                    "conditions": [],
                    "effects": [
                        "Does not enable LDU"
                    ]
                }
            ]
        }
    ]
}