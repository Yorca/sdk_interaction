{
    "SDK": "Chartboost",
    "privacy_APIs": [
        {
            "API_name": "addDataUseConsent",
            "class_name": "Chartboost",
            "conditions": [
                "publishers must obtain consent from their users to process personal data",
                "must set the COPPA privacy flag to true for apps under Google Play Designed for Families policy"
            ],
            "effects": [
                "sets consent values according to GDPR, CCPA, or COPPA standards"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "GDPR(GDPR.GDPR_CONSENT.BEHAVIORAL)"
                    ],
                    "conditions": [
                        "User consents to behavioral targeting (Behavioral and Contextual Ads)"
                    ],
                    "effects": [
                        "enables behavioral and contextual ads based on user consent under GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "GDPR(GDPR.GDPR_CONSENT.NON_BEHAVIORAL)"
                    ],
                    "conditions": [
                        "User does not consent to targeting (only Contextual ads)"
                    ],
                    "effects": [
                        "restricts ads to contextual only under GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "CCPA(CCPA.CCPA_CONSENT.OPT_IN_SALE)"
                    ],
                    "conditions": [
                        "User opts in to sale for behavioral targeting"
                    ],
                    "effects": [
                        "enables behavioral and contextual ads based on user consent under CCPA"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "CCPA(CCPA.CCPA_CONSENT.OPT_OUT_SALE)"
                    ],
                    "conditions": [
                        "User opts out of sale (only Contextual ads)"
                    ],
                    "effects": [
                        "restricts ads to contextual only under CCPA"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "COPPA(true)"
                    ],
                    "conditions": [
                        "App is child-directed"
                    ],
                    "effects": [
                        "restricts transmitting the Android advertising identifier and limits ads to contextual only under COPPA"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "Custom('name', 'value')"
                    ],
                    "conditions": [
                        "Publishers provide custom consent information"
                    ],
                    "effects": [
                        "enables setting custom consent values based on valid IAB\u2019s U.S. Privacy String"
                    ]
                }
            ]
        },
        {
            "API_name": "clearDataUseConsent",
            "class_name": "Chartboost",
            "conditions": [],
            "effects": [
                "clears any previously set privacy data use consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "dataUseConsent.privacyStandard"
                    ],
                    "conditions": [],
                    "effects": [
                        "resets the consent data for the specified privacy standard (GDPR, CCPA, COPPA, Custom)"
                    ]
                }
            ]
        }
    ]
}