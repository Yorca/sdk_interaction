{
    "SDK": "Vungle(liftoff)",
    "privacy_APIs": [
        {
            "API_name": "setGDPRStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Publisher controls the GDPR consent process at the user level",
                "Consent status must be set before initializing the SDK"
            ],
            "effects": [
                "Sets the user's consent status for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts in for data processing"
                    ],
                    "effects": [
                        "User consent is recorded as OPTED_IN"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts out of data processing"
                    ],
                    "effects": [
                        "User consent is recorded as OPTED_OUT"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must be set before initializing the SDK"
            ],
            "effects": [
                "Indicates whether the user is under the age of 13 for COPPA compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is known to be under age 13"
                    ],
                    "effects": [
                        "Treat the user as falling under COPPA regulations"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is known to be over age 13"
                    ],
                    "effects": [
                        "User does not fall under COPPA regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "setCCPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must be called to opt out of data processing"
            ],
            "effects": [
                "Sets the user's consent status for CCPA compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User opts in for data processing under CCPA"
                    ],
                    "effects": [
                        "User consent is recorded as OPTED_IN for CCPA"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of data processing under CCPA"
                    ],
                    "effects": [
                        "User consent is recorded as OPTED_OUT for CCPA"
                    ]
                }
            ]
        },
        {
            "API_name": "setPublishAndroidId",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must be set before initializing the SDK"
            ],
            "effects": [
                "Opt in or out of Android ID collection by the SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Opting in for Android ID collection"
                    ],
                    "effects": [
                        "SDK will collect Android ID"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Opting out of Android ID collection"
                    ],
                    "effects": [
                        "SDK will not collect Android ID"
                    ]
                }
            ]
        }
    ]
}