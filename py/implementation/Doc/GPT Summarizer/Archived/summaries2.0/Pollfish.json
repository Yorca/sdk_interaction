{
    "SDK": "Pollfish",
    "privacy_APIs": [
        {
            "API_name": "Prodege.initialize",
            "conditions": [
                "Requires a valid API key from Publisher Dashboard"
            ],
            "effects": [
                "Initializes Prodege SDK",
                "If advertising opt-out is requested, uses a unique session identifier instead of the Advertising ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "API_KEY",
                        "null",
                        "null"
                    ],
                    "conditions": [
                        "Called in the application's onCreate method"
                    ],
                    "effects": [
                        "The SDK is initialized with default configurations"
                    ]
                },
                {
                    "parameter_values": [
                        "API_KEY",
                        "listener",
                        "initOptions"
                    ],
                    "conditions": [
                        "Called with a listener to listen for initialization success or failure"
                    ],
                    "effects": [
                        "Receives notifications regarding SDK initialization"
                    ]
                }
            ]
        },
        {
            "API_name": "Prodege.loadRewardedAd",
            "conditions": [
                "Must provide a valid placement ID"
            ],
            "effects": [
                "Loads a Rewarded Ad Unit for display"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "PLACEMENT_ID"
                    ],
                    "conditions": [
                        "The placement ID is obtained from the Publisher Dashboard"
                    ],
                    "effects": [
                        "The specified rewarded ad will be loaded"
                    ]
                }
            ]
        },
        {
            "API_name": "Prodege.loadOfferwall",
            "conditions": [
                "Must provide a valid placement ID"
            ],
            "effects": [
                "Loads an Offerwall Ad Unit for display"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "PLACEMENT_ID"
                    ],
                    "conditions": [
                        "The placement ID is obtained from the Publisher Dashboard"
                    ],
                    "effects": [
                        "The specified offerwall will be loaded"
                    ]
                }
            ]
        },
        {
            "API_name": "Prodege.showPlacement",
            "conditions": [
                "Placement must be successfully loaded"
            ],
            "effects": [
                "Displays the specified placement"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "PLACEMENT_ID"
                    ],
                    "conditions": [
                        "The specified ad unit has been loaded successfully"
                    ],
                    "effects": [
                        "The placement is shown to the user"
                    ]
                }
            ]
        },
        {
            "API_name": "Prodege.setEventListener",
            "conditions": [],
            "effects": [
                "Enables the receipt of callback notifications for various events during ad lifecycle"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this"
                    ],
                    "conditions": [
                        "Implementing ProdegeEventListener interface"
                    ],
                    "effects": [
                        "Receives notifications of ad events"
                    ]
                }
            ]
        },
        {
            "API_name": "Prodege.setRewardListener",
            "conditions": [],
            "effects": [
                "Enables the receipt of notifications when a user receives a reward"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this"
                    ],
                    "conditions": [
                        "Implementing ProdegeRewardListener interface"
                    ],
                    "effects": [
                        "Receives notifications of rewards"
                    ]
                }
            ]
        }
    ]
}