{
    "SDK": "Adbrix(DFINERY)",
    "privacy_APIs": [
        {
            "API_name": "gdprForgetMe",
            "conditions": [],
            "effects": [
                "Stops SDK operation and analysis of all events; cannot be restored until user deletes and reinstalls the app."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "Called in response to a GDPR request from a user."
                    ],
                    "effects": [
                        "All personal data associated with the user will no longer be collected."
                    ]
                }
            ]
        },
        {
            "API_name": "setEnableAdIdTracking",
            "conditions": [
                "Must be called before AdBrixRm.init()"
            ],
            "effects": [
                "Enables or disables tracking of Google's Advertising Identifier."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If tracking of ads is desired."
                    ],
                    "effects": [
                        "Tracks Google's Advertising Identifier."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If tracking of ads is not desired."
                    ],
                    "effects": [
                        "Does not track Google's Advertising Identifier."
                    ]
                }
            ]
        }
    ]
}