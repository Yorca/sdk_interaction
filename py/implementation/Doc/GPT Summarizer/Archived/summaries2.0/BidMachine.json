{
    "SDK": "BidMachine",
    "privacy_APIs": [
        {
            "API_name": "setGDPR",
            "conditions": [
                "Publisher needs to send a boolean flag indicating if GDPR applies to the current user.",
                "If GDPR applies, Publisher must collect user consent prior to requesting ads."
            ],
            "effects": [
                "Indicates compliance with GDPR regulations.",
                "Retrieves GDPR from SharedPreference if using multiple methods."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "GDPR regulations apply"
                    ],
                    "effects": [
                        "User consent must be collected"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "GDPR regulations do not apply"
                    ],
                    "effects": [
                        "No need to collect user consent"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPA",
            "conditions": [
                "Indicate whether the user falls within an age-restricted category."
            ],
            "effects": [
                "Indicates compliance with COPPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prohibit data collection from children under 13."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Permits data collection based on user age."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "conditions": [
                "CCPA string must be compliant with IAB standards."
            ],
            "effects": [
                "Indicates compliance with CCPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "string_value"
                    ],
                    "conditions": [
                        "CCPA applies"
                    ],
                    "effects": [
                        "Informs about user's privacy choices."
                    ]
                }
            ]
        },
        {
            "API_name": "setGPP",
            "conditions": [
                "GPP string must be compliant with IAB standards."
            ],
            "effects": [
                "Indicates compliance with GPP."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "string_value",
                        []
                    ],
                    "conditions": [
                        "GPP applies"
                    ],
                    "effects": [
                        "Informs about additional privacy preferences."
                    ]
                }
            ]
        }
    ]
}