{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setCountryCode",
            "conditions": [
                "Must retrieve user's location if the device is WiFi-only"
            ],
            "effects": [
                "Reports a user's country code for Analytics sessions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "en"
                    ],
                    "conditions": [
                        "User's country code must be set prior to calling AppCenter.start"
                    ],
                    "effects": [
                        "Country code is sent with event logs"
                    ]
                }
            ]
        },
        {
            "API_name": "trackEvent",
            "conditions": [
                "App Center SDK must be started"
            ],
            "effects": [
                "Custom events can be tracked with user-defined properties"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Video clicked",
                        "{'Category': 'Music', 'FileName': 'favorite.avi'}"
                    ],
                    "conditions": [
                        "Can track events with up to 20 properties and 200 distinct event names"
                    ],
                    "effects": [
                        "Event tracked with specified properties"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabled",
            "conditions": [
                "Called after Analytics has been started"
            ],
            "effects": [
                "Enables or disables the App Center Analytics"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "To disable analytics reporting"
                    ],
                    "effects": [
                        "Stops collecting analytics information for the app"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "To enable analytics reporting"
                    ],
                    "effects": [
                        "Resumes collecting analytics information for the app"
                    ]
                }
            ]
        },
        {
            "API_name": "notifyUserConfirmation",
            "conditions": [
                "Await user confirmation for crash report sending"
            ],
            "effects": [
                "Allows for user consent before sending crash logs"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Crashes.DONT_SEND"
                    ],
                    "conditions": [
                        "User selects not to send the crash report"
                    ],
                    "effects": [
                        "The crash report is not sent"
                    ]
                },
                {
                    "parameter_values": [
                        "Crashes.SEND"
                    ],
                    "conditions": [
                        "User selects to send the crash report"
                    ],
                    "effects": [
                        "The crash report is sent to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        "Crashes.ALWAYS_SEND"
                    ],
                    "conditions": [
                        "User selects to always send crash reports"
                    ],
                    "effects": [
                        "The crash report is sent to App Center by default"
                    ]
                }
            ]
        },
        {
            "API_name": "trackError",
            "conditions": [
                "Called when an exception occurs"
            ],
            "effects": [
                "Tracks handled exceptions with additional context"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception",
                        "{'Category': 'Music', 'Wifi': 'On'}",
                        null
                    ],
                    "conditions": [
                        "Additional properties can be attached to the error report"
                    ],
                    "effects": [
                        "Error tracking enhances with context about the conditions under which error occurred"
                    ]
                }
            ]
        }
    ]
}