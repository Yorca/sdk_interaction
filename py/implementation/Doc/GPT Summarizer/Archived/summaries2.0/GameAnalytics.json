{
    "SDK": "GameAnalytics",
    "privacy_APIs": [
        {
            "API_name": "setEnabledEventSubmission",
            "conditions": [
                "User needs to disable event submission for GDPR purposes"
            ],
            "effects": [
                "Event submission is turned off"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Default setting has event submission enabled"
                    ],
                    "effects": [
                        "No events will be sent until re-enabled"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Event submission is turned on, events will be sent as per default settings"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabledManualSessionHandling",
            "conditions": [
                "User wants to manually control session handling instead of the default automatic handling"
            ],
            "effects": [
                "User is required to start and end sessions manually"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "When a game defines multiple activities or requires control over session timing"
                    ],
                    "effects": [
                        "The SDK will not automatically manage session start/end"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Default automatic session management will operate"
                    ]
                }
            ]
        },
        {
            "API_name": "SetCustomDimension01/02/03",
            "conditions": [
                "Must be set up in GA dashboard and the passed value must be defined in dashboard"
            ],
            "effects": [
                "Sets the respective custom dimension for the event that persists across sessions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "customDimension"
                    ],
                    "conditions": [
                        "Value must be one of the available defined dimension values"
                    ],
                    "effects": [
                        "If value is null, it will remove the custom dimension setting"
                    ]
                }
            ]
        },
        {
            "API_name": "SetGlobalCustomEventFields",
            "conditions": [],
            "effects": [],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "test": 1000,
                            "test_2": "global_hello_world"
                        }
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets global custom fields for events, these can be altered before sending individual events"
                    ]
                }
            ]
        }
    ]
}