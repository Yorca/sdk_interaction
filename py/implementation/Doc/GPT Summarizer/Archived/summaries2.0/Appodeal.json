{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "conditions": [],
            "effects": [
                "Indicates whether the content should be treated as child-directed for purposes of COPPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "The app is designed for kids."
                    ],
                    "effects": [
                        "Disables sending user data to ad networks."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "The app is not designed for kids."
                    ],
                    "effects": [
                        "Allows sending user data to ad networks."
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "Uses the COPPA parameter from the application's settings on appodeal.com."
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "conditions": [
