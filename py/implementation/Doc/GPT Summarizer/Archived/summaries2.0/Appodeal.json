            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity.this",
                        "dismissedListener"
                    ],
                    "conditions": [],
                    "effects": [
                        "Displays the consent form to the user if it is required."
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "conditions": [],
            "effects": [
                "Resets the consent status to unknown."
