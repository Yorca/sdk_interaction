            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [
                        "Update consent call is made during application launch."
                    ],
                    "effects": [
                        "User's consent status is updated."
                    ]
                }
            ]
        },
        {
            "API_name": "loadAndShowConsentFormIfRequired",
