{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "conditions": [
                "Must be called before the SDK initialization"
            ],
            "effects": [
                "Indicates whether the content is treated as child-directed for purposes of COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "To indicate that the content is child-directed"
                    ],
                    "effects": [
                        "User data will not be sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "To indicate that the content is not child-directed"
                    ],
                    "effects": [
                        "User data may be sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "To use the COPPA parameter from the application's settings"
                    ],
                    "effects": [
                        "COPPA parameter will be determined by the app settings"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "conditions": [
                "Call at any moment in the application lifecycle"
            ],
            "effects": [
                "Updates the user's consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [
                        "Requires passing the Appodeal app key and user's consent information"
                    ],
                    "effects": [
                        "Current consent status will be successfully updated"
                    ]
                }
            ]
        },
        {
            "API_name": "loadAndShowConsentFormIfRequired",
            "conditions": [
                "Consent form must be loaded first"
            ],
            "effects": [
                "Shows the consent form if required"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity.this"
                    ],
                    "conditions": [
                        "Context needs to be provided"
                    ],
                    "effects": [
                        "Loads and shows the consent form based on user's consent status"
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "conditions": [
                "Must provide context of the Activity where consent is revoked"
            ],
            "effects": [
                "Resets the consent status to unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity.this"
                    ],
                    "conditions": [
                        "Context must be specified"
                    ],
                    "effects": [
                        "User's consent status is revoked, setting it back to unknown"
                    ]
                }
            ]
        }
    ]
}