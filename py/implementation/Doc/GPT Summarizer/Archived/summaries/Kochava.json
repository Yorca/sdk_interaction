{
    "SDK": "Kochava",
    "privacy_APIs": [
        {
            "API_name": "setIntelligentConsentGranted",
            "conditions": [
                "User has granted consent to data collection"
            ],
            "effects": [
                "Allows data collection to proceed after consent is given"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setAppLimitAdTracking",
            "conditions": [
                "User opted out of using advertising identifier for tracking"
            ],
            "effects": [
                "Limits the use of the advertising identifier for tracking purposes"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User does not wish to be tracked"
                    ],
                    "effects": [
                        "Ad tracking is disabled for this application"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User consents to tracking"
                    ],
                    "effects": [
                        "Ad tracking is enabled for this application"
                    ]
                }
            ]
        },
        {
            "API_name": "registerPrivacyProfile",
            "conditions": [
                "Creating a privacy profile to restrict data collection"
            ],
            "effects": [
                "Allows conditional restriction of data transmission based on user profile"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "child",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        "User is a child"
                    ],
                    "effects": [
                        "Prevents transmission of identifiers for child users"
                    ]
                },
                {
                    "parameter_values": [
                        "restrict ids",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents transmission of device identifiers for all users"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyProfileEnabled",
            "conditions": [
                "To enable the privacy profile after its creation"
            ],
            "effects": [
                "Activates restrictions defined in the privacy profile"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "child",
                        true
                    ],
                    "conditions": [
                        "Child profile must be enabled"
                    ],
                    "effects": [
                        "With this profile enabled, data transmission is restricted"
                    ]
                },
                {
                    "parameter_values": [
                        "restrict ids",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "With this profile enabled, all users' device identifiers will not be transmitted"
                    ]
                }
            ]
        }
    ]
}