{
    "SDK": "Firebase",
    "privacy_APIs": [
        {
            "API_name": "setAnalyticsCollectionEnabled",
            "conditions": [
                "End-user consent must be acquired before collecting Analytics data",
                "Set to false in AndroidManifest.xml to disable collection temporarily",
                "Call the method setAnalyticsCollectionEnabled() to enable collection after consent is obtained"
            ],
            "effects": [
                "Allows enabling or disabling the collection of Analytics data depending on user consent",
                "Suspends collection until re-enabled"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not provided consent"
                    ],
                    "effects": [
                        "Analytics data collection is temporarily disabled"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User provides consent"
                    ],
                    "effects": [
                        "Analytics data collection is enabled"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserProperty",
            "conditions": [
                "Must be called to manage ad personalization based on user consent"
            ],
            "effects": [
                "Enables or disables ad personalization behavior"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "true"
                    ],
                    "conditions": [
                        "User consented to ad personalization"
                    ],
                    "effects": [
                        "Ad personalization is enabled for the user"
                    ]
                },
                {
                    "parameter_values": [
                        "false"
                    ],
                    "conditions": [
                        "User did not consent to ad personalization"
                    ],
                    "effects": [
                        "Ad personalization is disabled for the user"
                    ]
                }
            ]
        },
        {
            "API_name": "google_analytics_adid_collection_enabled",
            "conditions": [
                "Must be set to false in AndroidManifest.xml to disable Advertising ID collection"
            ],
            "effects": [
                "Disables collection of Advertising ID in the app"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Developer does not want to collect Advertising ID"
                    ],
                    "effects": [
                        "Advertising ID collection is disabled"
                    ]
                }
            ]
        }
    ]
}