{
    "SDK": "Vungle (liftoff)",
    "privacy_APIs": [
        {
            "API_name": "setGDPRStatus",
            "conditions": [
                "Opt-in requires user consent for data collection in the EU."
            ],
            "effects": [
                "Specifies whether the user has opted in or out of data collection."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts-in to data processing."
                    ],
                    "effects": [
                        "Data collection can proceed as per GDPR compliance."
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts-out of data processing."
                    ],
                    "effects": [
                        "Data collection is halted."
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAStatus",
            "conditions": [
                "Indicates whether the user is under age 13 in accordance with COPPA."
            ],
            "effects": [
                "Sets the user's COPPA compliance status to determine data handling."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is known to be under the age of 13."
                    ],
                    "effects": [
                        "User data is treated with protections outlined in COPPA."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is known to be over the age of 13."
                    ],
                    "effects": [
                        "User data is not subject to COPPA regulations."
                    ]
                }
            ]
        },
        {
            "API_name": "setCCPAStatus",
            "conditions": [
                "User may opt in or out of data collection under CCPA."
            ],
            "effects": [
                "Defines whether personal data can be collected."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User opts in to data collection."
                    ],
                    "effects": [
                        "Permits data collection in accordance with CCPA."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of data collection."
                    ],
                    "effects": [
                        "Prevents any personal data from being collected."
                    ]
                }
            ]
        },
        {
            "API_name": "setPublishAndroidId",
            "conditions": [
                "Determines if the SDK can collect Android ID."
            ],
            "effects": [
                "Controls whether the SDK transmits the Android ID."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Default behavior, allowing Android ID transmission."
                    ],
                    "effects": [
                        "Android ID can be used for advertising and tracking."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of Android ID collection."
                    ],
                    "effects": [
                        "SDK will not collect Android ID for that session."
                    ]
                }
            ]
        }
    ]
}