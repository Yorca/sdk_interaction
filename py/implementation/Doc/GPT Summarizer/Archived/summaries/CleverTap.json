{
    "SDK": "CleverTap",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "conditions": [
                "User wants to stop sending events to CleverTap"
            ],
            "effects": [
                "Stops sending events to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User chooses to opt out"
                    ],
                    "effects": [
                        "Events are no longer sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User wishes to re-enable data sharing"
                    ],
                    "effects": [
                        "Events start being sent to CleverTap again"
                    ]
                }
            ]
        },
        {
            "API_name": "enableDeviceNetworkInfoReporting",
            "conditions": [],
            "effects": [
                "Enables the capturing of device network information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User wishes to allow network information capture"
                    ],
                    "effects": [
                        "Device network information will be sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User wishes to stop network information capture"
                    ],
                    "effects": [
                        "Network information is disabled and not sent to CleverTap"
                    ]
                }
            ]
        },
        {
            "API_name": "setOffline",
            "conditions": [
                "User needs to stop sending data temporarily"
            ],
            "effects": [
                "No events or profile information will be sent to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User data is not sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User data will be sent to CleverTap again"
                    ]
                }
            ]
        },
        {
            "API_name": "setEncryptionLevel",
            "conditions": [],
            "effects": [
                "Sets the level of encryption for PII data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [],
                    "effects": [
                        "All stored data is in plaintext"
                    ]
                },
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is encrypted completely"
                    ]
                }
            ]
        }
    ]
}