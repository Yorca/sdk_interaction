{
    "SDK": "Firebase",
    "privacy_APIs": [
        {
            "API_name": "setAnalyticsCollectionEnabled",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "End-user consent needs to be obtained"
            ],
            "effects": [
                "Enables or disables the collection of analytics data for the app."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User provides consent."
                    ],
                    "effects": [
                        "Analytics data collection is enabled."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User does not provide consent."
                    ],
                    "effects": [
                        "Analytics data collection is disabled."
                    ]
                }
            ]
        },
        {
            "API_name": "setConsent",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "Consent state needs to be defined for analytics storage and advertisement storage."
            ],
            "effects": [
                "Sets the applicable end user consent state for device identifiers."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "AD_STORAGE": "GRANTED",
                            "ANALYTICS_STORAGE": "GRANTED",
                            "AD_USER_DATA": "GRANTED",
                            "AD_PERSONALIZATION": "GRANTED"
                        }
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables analytics and ad storage."
                    ]
                },
                {
                    "parameter_values": [
                        {
                            "AD_STORAGE": "DENIED",
                            "ANALYTICS_STORAGE": "DENIED",
                            "AD_USER_DATA": "DENIED",
                            "AD_PERSONALIZATION": "DENIED"
                        }
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables analytics and ad storage."
                    ]
                }
            ]
        },
        {
            "API_name": "resetAnalyticsData",
            "class_name": "FirebaseAnalytics",
            "conditions": [],
            "effects": [
                "Clears all analytics data for the app and resets the app instance id."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setUserId",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "User ID must be non-empty and no longer than 256 characters."
            ],
            "effects": [
                "Sets a user ID property for the app user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "user_id_value"
                    ],
                    "conditions": [
                        "The value must be non-empty and max 256 characters long."
                    ],
                    "effects": [
                        "The user ID is set."
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "Removes the user ID."
                    ]
                }
            ]
        }
    ]
