{
    "SDK": "Ironsource",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "class_name": "IronSource",
            "conditions": [
                "The user provided consent",
                "The user did not provide consent"
            ],
            "effects": [
                "Updates the user's consent status for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the user provided consent"
                    ],
                    "effects": [
                        "User consent is registered as true"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the user did not consent"
                    ],
                    "effects": [
                        "User consent is registered as false"
                    ]
                }
            ]
        },
        {
            "API_name": "setMetaData",
            "class_name": "IronSource",
            "conditions": [
                "Should be set before initializing the SDK",
                "User opts out of 'sale' or 'sharing' of personal information"
            ],
            "effects": [
                "Handles the 'do not sell or share' setting for U.S. state privacy laws"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "do_not_sell",
                        "true"
                    ],
                    "conditions": [
                        "If the user has opted out of 'sale' or 'sharing' of personal information"
                    ],
                    "effects": [
                        "Denotes that personal information should not be sold or shared"
                    ]
                },
                {
                    "parameter_values": [
                        "do_not_sell",
                        "false"
                    ],
                    "conditions": [
                        "If 'sale' of personal information is permitted"
                    ],
                    "effects": [
                        "Permits the sale of personal information"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "true"
                    ],
                    "conditions": [
                        "If the end-user is a child"
                    ],
                    "effects": [
                        "Flags the end-user as child-directed for compliance with laws like COPPA"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "false"
                    ],
                    "conditions": [
                        "If the end-user is not a child"
                    ],
                    "effects": [
                        "Flags the end-user as not child-directed"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "true"
                    ],
                    "conditions": [
                        "Applicable for users flagged as children"
                    ],
                    "effects": [
                        "Prevents access to the Android Advertising ID"
                    ]
                }
            ]
        }
    ]
}