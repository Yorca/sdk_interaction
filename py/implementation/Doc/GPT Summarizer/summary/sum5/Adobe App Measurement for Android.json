{
    "SDK": "Adobe App Measurement for Android",
    "privacy_APIs": [
        {
            "API_name": "setPrivacyStatus",
            "class_name": "MobileCore",
            "conditions": [],
            "effects": [
                "sets the privacy status for data collection"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.OPT_IN"
                    ],
                    "conditions": [],
                    "effects": [
                        "hits are sent for data collection"
                    ]
                },
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.OPT_OUT"
                    ],
                    "conditions": [],
                    "effects": [
                        "hits are not sent for data collection"
                    ]
                },
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.UNKNOWN"
                    ],
                    "conditions": [],
                    "effects": [
                        "hits are queued until status is known"
                    ]
                }
            ]
        },
        {
            "API_name": "getPrivacyStatus",
            "class_name": "MobileCore",
            "conditions": [],
            "effects": [
                "retrieves the current privacy status"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "getSdkIdentities",
            "class_name": "MobileCore",
            "conditions": [
                "must be called before the user opts out"
            ],
            "effects": [
                "retrieves all identifier data stored locally in SDK as a JSON string"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "AdobeCallback<String>"
                    ],
                    "conditions": [],
                    "effects": [
                        "callback is invoked with the SDK identities as a JSON string"
                    ]
                }
            ]
        },
        {
            "API_name": "setPushIdentifier",
            "class_name": "MobileCore",
            "conditions": [
                "if current SDK privacy status is optedout, the push identifier is not set"
            ],
            "effects": [
                "sets the device token for push notifications"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "pullDeviceToken"
                    ],
                    "conditions": [],
                    "effects": [
                        "updates SDK with the new push identifier"
                    ]
                }
            ]
        }
    ]
}