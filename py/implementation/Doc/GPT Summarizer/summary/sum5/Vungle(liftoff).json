{
    "SDK": "Vungle",
    "privacy_APIs": [
        {
            "API_name": "setGDPRStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "User must provide consent for data processing under GDPR regulations"
            ],
            "effects": [
                "Sets the user's consent status for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User has opted in for data processing"
                    ],
                    "effects": [
                        "User consent status registered as opted in"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User has opted out of data processing"
                    ],
                    "effects": [
                        "User consent status registered as opted out"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "App must comply with COPPA regulations"
            ],
            "effects": [
                "Updates the user's COPPA compliance status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is under the age of 13"
                    ],
                    "effects": [
                        "User is treated as falling under COPPA regulations"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is 13 years of age or older"
                    ],
                    "effects": [
                        "User is not treated as falling under COPPA regulations"
                    ]
                }
            ]
        },
        {
