{
    "SDK": "Braze",
    "privacy_APIs": [
        {
            "API_name": "setLastKnownLocation",
            "class_name": "BrazeUser",
            "conditions": [
                "User must grant location permissions according to device requirements"
            ],
            "effects": [
                "Logs the last known location for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "LATITUDE_DOUBLE_VALUE",
                        "LONGITUDE_DOUBLE_VALUE",
                        "ALTITUDE_DOUBLE_VALUE",
                        "ACCURACY_DOUBLE_VALUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Records a specific location point for the user"
                    ]
                }
            ]
        },
        {
            "API_name": "disableSDK",
            "class_name": "Braze",
            "conditions": [],
            "effects": [
                "Stops all data collection and communication with Braze servers"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "enableSDK",
            "class_name": "Braze",
            "conditions": [],
            "effects": [
                "Resumes data collection after being disabled"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "wipeData",
            "class_name": "Braze",
            "conditions": [],
            "effects": [
                "Clears all client-side data stored on the device"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "logPurchase",
            "class_name": "Braze",
            "conditions": [],
            "effects": [
                "Records an in-app purchase to Braze for analytics and revenue tracking"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "productId",
                        "currencyCode",
                        "price",
                        "quantity"
                    ],
                    "conditions": [
                        "Product Identifier must not be empty"
                    ],
                    "effects": [
                        "Logs the purchase to the user's profile"
                    ]
                }
            ]
        }
    ]
}