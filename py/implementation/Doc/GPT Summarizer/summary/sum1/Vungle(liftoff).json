{
    "SDK": "Vungle(liftoff)",
    "privacy_APIs": [
        {
            "API_name": "setGDPRStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "The publisher controls the GDPR consent process"
            ],
            "effects": [
                "Indicates whether the user has opted in or out of data processing under GDPR"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts in for data processing"
                    ],
                    "effects": [
                        "User's consent status is set to opted in"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "1.0.0"
                    ],
                    "conditions": [
                        "User opts out of data processing"
                    ],
                    "effects": [
                        "User's consent status is set to opted out"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must indicate if app is directed toward children under age 13"
            ],
            "effects": [
                "Indicates whether the user is under COPPA protection"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is confirmed to be under age 13"
                    ],
                    "effects": [
                        "Treat user as under COPPA regulations"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is known to be over age 13"
                    ],
                    "effects": [
                        "Does not treat user as under COPPA regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "setCCPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must update to SDK 6.7.0 or higher to comply with CCPA"
            ],
            "effects": [
                "Indicates whether the user has opted in or out under CCPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User opts in to data processing"
                    ],
                    "effects": [
                        "User's CCPA status is set to opted in"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of data processing"
                    ],
                    "effects": [
                        "User's CCPA status is set to opted out"
                    ]
                }
            ]
        },
        {
            "API_name": "setPublishAndroidId",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Android SDK version is 6.4.11 or higher"
            ],
            "effects": [
                "Controls whether Android ID is collected or not"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Default opt-in for Android ID collection"
                    ],
                    "effects": [
                        "Android ID can be collected by SDK"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of Android ID collection"
                    ],
                    "effects": [
                        "Android ID will not be collected by SDK"
                    ]
                }
            ]
        }
    ]
}