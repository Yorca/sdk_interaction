{
    "SDK": "AdMob",
    "privacy_APIs": [
        {
            "API_name": "putPublisherFirstPartyIdEnabled",
            "class_name": "MobileAds",
            "conditions": [
                "required to comply with Google's updated privacy policies"
            ],
            "effects": [
                "Enables or disables the Publisher first-party ID feature, formerly known as the same app key"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Publisher first-party ID feature is to be disabled"
                    ],
                    "effects": [
                        "Disables the use of the Publisher first-party ID"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Default setting or required for personalized ads"
                    ],
                    "effects": [
                        "Enables the Publisher first-party ID feature for more relevant ads"
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForChildDirectedTreatment",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Certify accurate app content classification for COPPA compliance"
            ],
            "effects": [
                "Controls whether content is treated as child-directed"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_TRUE"
                    ],
                    "conditions": [
                        "Content is intended for children"
                    ],
                    "effects": [
                        "Prevents the transmission of Android advertising identifier (AAID) and disables IBA and remarketing ads"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_FALSE"
                    ],
                    "conditions": [
                        "Content is not specifically intended for children"
                    ],
                    "effects": [
                        "Allows personalized advertising and retains advertising identifier"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_UNSPECIFIED"
                    ],
                    "conditions": [
                        "No specification on child-directed content treatment"
                    ],
                    "effects": [
                        "Default treatment applies based on other settings"
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForUnderAgeOfConsent",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Compliance with GDPR for users under the age of consent"
            ],
            "effects": [
                "Modifies how ads are processed based on user consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_TRUE"
                    ],
                    "conditions": [
                        "Ad request is for users in the EEA under the age of consent"
                    ],
                    "effects": [
                        "Disables personalized advertising and prevents AAID transmission"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_FALSE"
                    ],
                    "conditions": [
                        "Ad request is not for under-age users"
                    ],
                    "effects": [
                        "Allows standard personalized advertising processing"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_UNSPECIFIED"
                    ],
                    "conditions": [
                        "No specific request treatment for under-age users specified"
                    ],
                    "effects": [
                        "Applies default treatment"
                    ]
                }
            ]
        },
        {
            "API_name": "setMaxAdContentRating",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "To comply with content rating regulations"
            ],
            "effects": [
                "Limits ad content to specified maximum rating level"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_G"
                    ],
                    "conditions": [
                        "Want ads rated G or lower"
                    ],
                    "effects": [
                        "Limits all ads shown to G-rated content"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_PG"
                    ],
                    "conditions": [
                        "Want ads rated PG or lower"
                    ],
                    "effects": [
                        "Limits all ads shown to PG-rated content"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_T"
                    ],
                    "conditions": [
                        "Want ads rated T or lower"
                    ],
                    "effects": [
                        "Limits all ads shown to T-rated content"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_MA"
                    ],
                    "conditions": [
                        "Want ads rated MA or below"
                    ],
                    "effects": [
                        "Limits all ads shown to MA-rated content"
                    ]
                }
            ]
        },
        {
            "API_name": "setPublisherPrivacyPersonalizationState",
            "class_name": "RequestConfiguration",
            "conditions": [
                "Optional feature to enable or disable ads personalization"
            ],
            "effects": [
                "Indicates whether ads should be personalized or not"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "PublisherPrivacyPersonalizationState.DISABLED"
                    ],
                    "conditions": [
                        "Publisher opts to disable ad personalization"
                    ],
                    "effects": [
                        "All ads served will be non-personalized"
                    ]
                },
                {
                    "parameter_values": [
                        "PublisherPrivacyPersonalizationState.ENABLED"
                    ],
                    "conditions": [
                        "Default or user prefers personalized ads"
                    ],
                    "effects": [
                        "Ads will be served based on user profile and interests"
                    ]
                }
            ]
        }
    ]
}