{
    "SDK": "Kochava",
    "privacy_APIs": [
        {
            "API_name": "setIntelligentConsentGranted",
            "class_name": "Tracker",
            "conditions": [
                "User granted consent"
            ],
            "effects": [
                "Enables data collection and tracking"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows data collection as user granted consent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables data collection as user declined consent"
                    ]
                }
            ]
        },
        {
            "API_name": "registerPrivacyProfile",
            "class_name": "Tracker",
            "conditions": [
                "Need to restrict data for certain user types"
            ],
            "effects": [
                "Creates a privacy profile that restricts egress of specified data points"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Restricts egress of device identifiers from the SDK for all users"
                    ]
                },
                {
                    "parameter_values": [
                        "child",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        "User is identified as a child"
                    ],
                    "effects": [
                        "Restricts egress of device identifiers for child users"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyProfileEnabled",
            "class_name": "Tracker",
            "conditions": [
                "Created privacy profile must be enabled for certain users"
            ],
            "effects": [
                "Enables or disables the specified privacy profile to restrict data egress"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents the specified data points from being transmitted from the device"
                    ]
                },
                {
                    "parameter_values": [
                        "child",
                        true
                    ],
                    "conditions": [
                        "User is determined to be a child"
                    ],
                    "effects": [
                        "Restricts device identifiers from being transmitted for child users"
                    ]
                }
            ]
        }
    ]
}