{
    "SDK": "Tenjin",
    "privacy_APIs": [
        {
            "API_name": "optIn",
            "class_name": "TenjinSDK",
            "conditions": [
                "User must provide consent for tracking."
            ],
            "effects": [
                "Enables tracking for the device/user."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOut",
            "class_name": "TenjinSDK",
            "conditions": [
                "User opts out of tracking."
            ],
            "effects": [
                "Will not send any API requests to Tenjin for events processing."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User must have opted in for parameters to be sent."
            ],
            "effects": [
                "Only specified device-related parameters will be sent."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "ip_address",
                            "advertising_id",
                            "limit_ad_tracking",
                            "referrer"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables sending specific device-related parameters."
                    ]
                }
            ]
        },
        {
            "API_name": "optOutParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User must have opted out of certain parameters."
            ],
            "effects": [
                "Will send all device-related parameters except those specified."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "locale",
                            "timezone",
                            "build_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Excludes specified parameters from being sent."
                    ]
                }
            ]
        },
        {
            "API_name": "setGoogleDMAParameters",
            "class_name": "TenjinSDK",
            "conditions": [
                "Must manage Google DMA parameters either manually or through a CMP."
            ],
            "effects": [
                "Allows explicit management of Google DMA parameters."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the parameters to opt in for ad personalization and ad user data."
                    ]
                }
            ]
        },
        {
            "API_name": "optInOutUsingCMP",
            "class_name": "TenjinSDK",
            "conditions": [
                "User's CMP will determine if they are opted in or out."
            ],
            "effects": [
                "Automatically opts in or out based on CMP consent."
            ],
            "parameter_configurations": []
        }
    ]
}