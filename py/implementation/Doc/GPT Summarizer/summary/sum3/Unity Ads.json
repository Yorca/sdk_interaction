{
    "SDK": "Unity Ads",
    "privacy_APIs": [
        {
            "API_name": "SetMetaData",
            "class_name": "MetaData",
            "conditions": [],
            "effects": [
                "Allows the developer to set user-specific metadata related to privacy preferences such as consent for targeted advertising."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "user.nonbehavioral",
                        "true"
                    ],
                    "conditions": [
                        "User opts out of personalized ads."
                    ],
                    "effects": [
                        "User cannot receive personalized ads."
                    ]
                },
                {
                    "parameter_values": [
                        "user.nonbehavioral",
                        "false"
                    ],
                    "conditions": [
                        "User opts into personalized ads."
                    ],
                    "effects": [
                        "User can receive personalized ads."
                    ]
                },
                {
                    "parameter_values": [
                        "gdpr.consent",
                        "true"
                    ],
                    "conditions": [
                        "User opts into targeted advertising under GDPR."
                    ],
                    "effects": [
                        "User consent is recorded for targeted advertising."
                    ]
                },
                {
                    "parameter_values": [
                        "gdpr.consent",
                        "false"
                    ],
                    "conditions": [
                        "User opts out of targeted advertising under GDPR."
                    ],
                    "effects": [
                        "User consent is recorded against targeted advertising."
                    ]
                },
                {
                    "parameter_values": [
                        "pipl.consent",
                        "true"
                    ],
                    "conditions": [
                        "User opts into sending their personal identifiable information outside of China."
                    ],
                    "effects": [
                        "User consent is recorded for sending personal data."
                    ]
                },
                {
                    "parameter_values": [
                        "pipl.consent",
                        "false"
                    ],
                    "conditions": [
                        "User opts out of sending their personal identifiable information outside of China."
                    ],
                    "effects": [
                        "User consent is recorded against sending personal data."
                    ]
                }
            ]
        },
        {
            "API_name": "Implementing Custom Age Gates",
            "class_name": "MetaData",
            "conditions": [],
            "effects": [
                "Allows the developer to pass age gate flags to the Unity Ads SDK."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "privacy.useroveragelimit",
                        "true"
                    ],
                    "conditions": [
                        "User is over the specified age limit."
                    ],
                    "effects": [
                        "Unity Ads will not show the built-in age gate."
                    ]
                },
                {
                    "parameter_values": [
                        "privacy.useroveragelimit",
                        "false"
                    ],
                    "conditions": [
                        "User is under the specified age limit."
                    ],
                    "effects": [
                        "Unity Ads will show the built-in age gate."
                    ]
                }
            ]
        },
        {
            "API_name": "Custom Consent Implementation",
            "class_name": "MetaData",
            "conditions": [
                "Developer includes necessary consent management in app."
            ],
            "effects": [
                "Users can opt-out or request data deletion irrespective of consent flags."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "privacy.consent",
                        "true"
                    ],
                    "conditions": [
                        "User opts in to targeted advertising."
                    ],
                    "effects": [
                        "User is considered consenting to targeted ads."
                    ]
                },
                {
                    "parameter_values": [
                        "privacy.consent",
                        "false"
                    ],
                    "conditions": [
                        "User opts out of targeted advertising."
                    ],
                    "effects": [
                        "User is considered non-consenting to targeted ads."
                    ]
                }
            ]
        }
    ]
}