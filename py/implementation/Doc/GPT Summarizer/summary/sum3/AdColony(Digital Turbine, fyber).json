            ],
            "effects": [
                "User consent is passed to the SDK for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given their consent"
                    ],
                    "effects": [
                        "GDPR-compliant ads will be displayed to the user"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given their consent"
                    ],
                    "effects": [
                        "Only contextual ads will be displayed to the user"
                    ]
                }
            ]
        },
