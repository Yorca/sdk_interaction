{
    "SDK": "TradPlus",
    "privacy_APIs": [
        {
            "API_name": "checkCurrentArea",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing the SDK"
            ],
            "effects": [
                "determines the current region and sets the corresponding privacy API"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setCCPADoNotSell",
            "class_name": "TradPlusSdk",
            "conditions": [
                "only for California users",
                "should be set before initializing the SDK"
            ],
            "effects": [
                "indicates whether California users do not want their data sold"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "user accepts the sale of data"
                    ],
                    "effects": [
                        "user data can be reported"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "user does not accept the sale of data"
                    ],
                    "effects": [
                        "user data will not be reported"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAIsAgeRestrictedUser",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing TradPlus SDK"
            ],
            "effects": [
                "defines if the user is a child"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "the application is for children"
                    ],
                    "effects": [
                        "provides children's privacy protections"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "the application is for adults"
                    ],
                    "effects": [
                        "indicates that the user is not a child"
                    ]
                }
            ]
        },
        {
            "API_name": "setGDPRDataCollection",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing TradPlus SDK",
                "called when in the EU region"
            ],
            "effects": [
                "determines the level of GDPR data collection consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0,
                        "context"
                    ],
                    "conditions": [
                        "user agrees to personalized data reporting"
                    ],
                    "effects": [
                        "personalized device data is allowed to be reported"
                    ]
                },
                {
                    "parameter_values": [
                        1,
                        "context"
                    ],
                    "conditions": [
                        "user disagrees to personalized data reporting"
                    ],
                    "effects": [
                        "nonpersonalized device data is not allowed to be reported"
                    ]
                }
            ]
        },
        {
            "API_name": "setLGPDConsent",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing TradPlus SDK",
                "only need to call in Brazil"
            ],
            "effects": [
                "determines the consent level under LGPD"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0,
                        "context"
                    ],
                    "conditions": [
                        "data reporting is allowed"
                    ],
                    "effects": [
                        "device data is allowed to be reported"
                    ]
                },
                {
                    "parameter_values": [
                        1,
                        "context"
                    ],
                    "conditions": [
                        "data reporting is not allowed"
                    ],
                    "effects": [
                        "device data is not allowed to be reported"
                    ]
                }
            ]
        }
    ]
}