            "class_name": "CleverTapAPI",
            "conditions": [
                "Required to comply with GDPR"
            ],
            "effects": [
                "Stops sending events to CleverTap when set to true"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User data will not be shared with CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User data will be shared with CleverTap again"
                    ]
                }
            ]
        },
        {
