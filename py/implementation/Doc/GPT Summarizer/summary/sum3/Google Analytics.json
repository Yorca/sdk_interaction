{
    "SDK": "Google Analytics",
    "privacy_APIs": [
        {
            "API_name": "setAppOptOut",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Sets or resets the application-level opt out flag. If set, no hits will be sent to Google Analytics."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents any data from being sent to Google Analytics."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows data to be sent to Google Analytics."
                    ]
                }
            ]
        },
        {
            "API_name": "enableAutoActivityReports",
            "class_name": "GoogleAnalytics",
            "conditions": [
                "The device is running API level 14 or above."
            ],
            "effects": [
                "Automatically tracks the start and stop of activities, removing the need for explicit calls to reportActivityStart and reportActivityStop."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "application"
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables automatic reporting for the provided application."
                    ]
                }
            ]
        },
        {
            "API_name": "newTracker",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Creates and returns a new Tracker instance with the specified tracking ID."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "UA-000-1"
                    ],
                    "conditions": [
                        "This tracking ID must be valid and not null or empty."
                    ],
                    "effects": [
                        "The Tracker is ready to send hits."
                    ]
                }
            ]
        },
        {
            "API_name": "reportActivityStart",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Reports the start of an Activity, enabling tracking."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "activity"
                    ],
                    "conditions": [],
                    "effects": [
                        "Records the beginning of activity tracking."
                    ]
                }
            ]
        },
        {
            "API_name": "reportActivityStop",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Reports the end of an Activity, stopping tracking."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "activity"
                    ],
                    "conditions": [],
                    "effects": [
                        "Records the end of activity tracking."
                    ]
                }
            ]
        },
        {
            "API_name": "setLocalDispatchPeriod",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Sets the dispatch period for local hits."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        1800
                    ],
                    "conditions": [],
                    "effects": [
                        "The dispatcher will check for hits to dispatch every 1800 seconds."
                    ]
                },
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables automatic dispatching of local hits."
                    ]
                }
            ]
        },
        {
            "API_name": "isDryRunEnabled",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Indicates whether dry run mode is enabled."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setDryRun",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
                "Enables or disables dry run mode."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Normal code paths are executed but hits are not sent to servers."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Normal operation will continue with data sent to the servers."
                    ]
                }
            ]
        }
    ]
