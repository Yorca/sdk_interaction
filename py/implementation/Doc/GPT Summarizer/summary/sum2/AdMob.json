{
    "SDK": "AdMob",
    "privacy_APIs": [
        {
            "API_name": "putPublisherFirstPartyIdEnabled",
            "class_name": "MobileAds",
            "conditions": [
                "Google Mobile Ads SDK 21.4.0 or higher"
            ],
            "effects": [
                "Enables or disables the use of Publisher first-party ID for personalized ads."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Default setting is enabled; must explicitly call this method to disable it."
                    ],
                    "effects": [
                        "Disables the Publisher first-party ID, stopping personalized ad serving."
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForChildDirectedTreatment",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Required for compliance with COPPA."
            ],
            "effects": [
                "Defines whether the ad request should be treated as child-directed."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [
                        "Call setTagForChildDirectedTreatment with TAG_FOR_CHILD_DIRECTED_TREATMENT_TRUE."
                    ],
                    "effects": [
                        "Prevents transmission of the Android advertising identifier."
                    ]
                },
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [
                        "Call setTagForChildDirectedTreatment with TAG_FOR_CHILD_DIRECTED_TREATMENT_FALSE."
                    ],
                    "effects": [
                        "Allows normal ad serving without child-directed limitations."
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForUnderAgeOfConsent",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Intended for compliance with GDPR regarding users under the age of consent."
            ],
            "effects": [
                "Defines treatment for users under the age of consent in the EEA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [
                        "Call setTagForUnderAgeOfConsent with TAG_FOR_UNDER_AGE_OF_CONSENT_TRUE."
                    ],
                    "effects": [
                        "Disables personalized advertising for underage users."
                    ]
                },
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [
                        "Call setTagForUnderAgeOfConsent with TAG_FOR_UNDER_AGE_OF_CONSENT_FALSE."
                    ],
                    "effects": [
                        "Allows normal ad serving without underage restrictions."
                    ]
                }
            ]
        },
        {
            "API_name": "setPublisherPrivacyPersonalizationState",
            "class_name": "RequestConfiguration",
            "conditions": [
                "Optional configuration for managing ads personalization based on publisher privacy preferences."
            ],
            "effects": [
                "Turns off personalization for all ad requests."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "DISABLED"
                    ],
                    "conditions": [],
                    "effects": [
                        "All ad requests will not serve personalized ads."
                    ]
                }
            ]
        }
    ]
}