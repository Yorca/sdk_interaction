                        "Indicates that the app is restricted for users under age 13."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "The user is 13 or older."
                    ],
                    "effects": [
                        "No restrictions based on COPPA for this user."
                    ]
                }
            ]
        },
