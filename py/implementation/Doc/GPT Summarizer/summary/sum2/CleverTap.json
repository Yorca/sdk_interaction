{
    "SDK": "CleverTap",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "class_name": "CleverTapAPI",
            "conditions": [
                "Required to comply with GDPR"
            ],
            "effects": [
                "Stops sending events to CleverTap if set to true"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The application will no longer send any events to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The application will resume sending events to CleverTap"
                    ]
                }
            ]
        },
        {
            "API_name": "enableDeviceNetworkInfoReporting",
            "class_name": "CleverTapAPI",
            "conditions": [
                "Requires user permission to enable reporting"
            ],
            "effects": [
                "Enables capturing of device network information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Device network information like WiFi, Bluetooth, and user IP will be captured"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Device network information will not be captured"
                    ]
                }
            ]
        },
        {
            "API_name": "setOffline",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "Sets the user as offline, preventing any events/profile information from being sent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "No events or profile information will be sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Events and profile information will be sent to CleverTap again"
                    ]
                }
            ]
        },
        {
            "API_name": "setLocation",
            "class_name": "CleverTapAPI",
            "conditions": [
                "The application must request and obtain user's permission for location access"
            ],
            "effects": [
                "Updates the user's location in CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "location"
                    ],
                    "conditions": [
                        "User has granted permission to access their location"
                    ],
                    "effects": [
                        "User's location is set in CleverTap, enabling location-based features"
                    ]
                }
            ]
        },
        {
            "API_name": "setEncryptionLevel",
            "class_name": "CleverTapInstanceConfig",
            "conditions": [
                "The encryption level setting must be included in AndroidManifest.xml"
            ],
            "effects": [
                "Controls the encryption level of PII data stored by the SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [],
                    "effects": [
                        "All stored data is in plaintext"
                    ]
                },
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is encrypted completely"
                    ]
                }
            ]
        }
    ]
}