{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "class_name": "Appodeal",
            "conditions": [
                "should be called before the SDK initialization",
                "if your app is designed for kids"
            ],
            "effects": [
                "indicates whether the content is treated as child-directed for purposes of COPPA",
                "disables sending user data to ad networks if set to true"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "indicates content is child-directed according to COPPA"
                    ],
                    "effects": [
                        "user data is not sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "indicates content is not child-directed according to COPPA"
                    ],
                    "effects": [
                        "user data may be sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "uses the COPPA parameter from the application's settings"
                    ],
                    "effects": [
                        "follows the COPPA parameter defined in app settings"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentManager",
            "conditions": [
                "can be requested at any moment of the application lifecycle",
                "recommended to be called at application launch"
            ],
            "effects": [
                "updates the user's consent status based on current settings"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [],
                    "effects": [
                        "initiates a consent update request"
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "class_name": "ConsentManager",
            "conditions": [
                "requires context for which consent is being revoked"
            ],
            "effects": [
                "sets the consent status back to unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity"
                    ],
                    "conditions": [],
                    "effects": [
                        "revokes the user's consent status"
                    ]
                }
            ]
        }
    ]
}