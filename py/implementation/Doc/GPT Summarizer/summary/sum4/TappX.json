{
    "SDK": "TappX",
    "privacy_APIs": [
        {
            "API_name": "setUSPrivacy",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "Must provide a valid consent string from your CMP or tool to get the final user consent"
            ],
            "effects": [
                "Sets the US privacy status and allows the SDK to manage user data usage in compliance with US privacy laws"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "grantPersonalInfoConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "Must be called if the user consents to the use of their data"
            ],
            "effects": [
                "Grants permission to use the user's personal information for advertising"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [
                        "gdprConsentString must also be passed with the consent provided by the user"
                    ],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "denyPersonalInfoConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "Must be called if the user does NOT consent to use their data"
            ],
            "effects": [
                "Denies permission to use the user's personal information for advertising"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setGDPRConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "Must be called to set the GDPR consent string after the user has consented"
            ],
            "effects": [
                "Links the user's consent to the GDPR requirements"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "String"
                    ],
                    "conditions": [
                        "Called only after user consent is obtained"
                    ],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setCoppaCompliance",
            "class_name": "Tappx",
            "conditions": [
                "Set the child-specific content tag before starting the SDK integration"
            ],
            "effects": [
                "Activates or deactivates advertising restrictions based on content intended for children under 13"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Activates advertising restrictions for children-targeted content"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Deactivates advertising restrictions for children-targeted content"
                    ]
                }
            ]
        },
        {
            "API_name": "setGlobalPrivacyPlatform",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "Must provide a valid consent string from a CMP or tool to get the final user consent"
            ],
            "effects": [
                "Links the user's consent to the Global Privacy Platform (GPP) requirements"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        }
    ]
}