{
    "SDK": "Ironsource",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "class_name": "IronSource",
            "conditions": [
                "User has provided consent or not"
            ],
            "effects": [
                "Updates the user's consent status for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User provided consent"
                    ],
                    "effects": [
                        "Sets the consent flag to true"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User did not consent"
                    ],
                    "effects": [
                        "Sets the consent flag to false"
                    ]
                }
            ]
        },
        {
            "API_name": "setMetaData",
            "class_name": "IronSource",
            "conditions": [
                "API should be set before initializing the SDK"
            ],
            "effects": [
                "Updates the specified metadata for the user regarding personal information sale"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "do_not_sell",
                        "true"
                    ],
                    "conditions": [
                        "User has opted out of the sale or sharing of personal information"
                    ],
                    "effects": [
                        "Marks the user to not sell or share their personal information"
                    ]
                },
                {
                    "parameter_values": [
                        "do_not_sell",
                        "false"
                    ],
                    "conditions": [
                        "User permits the sale of personal information"
                    ],
                    "effects": [
                        "Allows the sale or sharing of personal information"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "true"
                    ],
                    "conditions": [
                        "End-user is classified as a child according to applicable regulations"
                    ],
                    "effects": [
                        "Flags the user as child-directed"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "false"
                    ],
                    "conditions": [
                        "End-user is not classified as a child"
                    ],
                    "effects": [
                        "Flags the user as not child-directed"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "true"
                    ],
                    "conditions": [
                        "User is flagged as child and must prevent access to AAID"
                    ],
                    "effects": [
                        "Prevents access to the Android Advertising ID"
                    ]
                },
                {
                    "parameter_values": [
                        "Google_Family_Self_Certified_SDKS",
                        "true"
                    ],
                    "conditions": [
                        "User is part of mixed audience directed apps"
                    ],
                    "effects": [
                        "Allows initialization only of Families Self-Certified Ads SDKs"
                    ]
                }
            ]
        }
    ]
}