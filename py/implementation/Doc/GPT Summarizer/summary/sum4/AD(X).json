{
    "SDK": "AD(X)",
    "privacy_APIs": [
        {
            "API_name": "initialize",
            "class_name": "ADXSdk",
            "conditions": [
                "GDPR compliance must be addressed",
                "used for initializing the ADX SDK",
                "must be called only once at app launch",
                "ad requests must be made after initialization is complete"
            ],
            "effects": [
                "initializes the SDK and prepares to handle advertising-related functionalities"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "ADXConfiguration.GdprType.POPUP_LOCATION"
                    ],
                    "conditions": [
                        "GDPR type must be set to 'POPUP_LOCATION' for users in the EU",
                        "must provide appropriate Activity context"
                    ],
                    "effects": [
                        "displays consent popup to users in the EU for GDPR compliance"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "ADXConfiguration.GdprType.POPUP_DEBUG"
                    ],
                    "conditions": [
                        "test environment for GDPR consent UI verification"
                    ],
                    "effects": [
                        "displays consent UI regardless of user location for testing"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "ADXConfiguration.GdprType.DIRECT_NOT_REQUIRED"
                    ],
                    "conditions": [
                        "for regions where consent is not required"
                    ],
                    "effects": [
                        "allows personalized ads without requiring user consent"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "ADXConfiguration.GdprType.DIRECT_CONFIRM"
                    ],
                    "conditions": [
                        "for regions where explicit consent was provided by the user"
                    ],
                    "effects": [
                        "enables personalized ads after user consent"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "ADXConfiguration.GdprType.DIRECT_DENIED"
                    ],
                    "conditions": [
                        "for regions where user has denied consent"
                    ],
                    "effects": [
                        "disables personalized ads"
                    ]
                }
            ]
        },
        {
            "API_name": "getResultGDPR",
            "class_name": "ADXGdprManager",
            "conditions": [],
            "effects": [
                "returns the current GDPR consent state for the user"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "saveResultGDPR",
            "class_name": "ADXGdprManager",
            "conditions": [],
            "effects": [
                "changes the current GDPR consent state for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "ADXConsentState"
                    ],
                    "conditions": [],
                    "effects": [
                        "stores the updated consent state"
                    ]
                }
            ]
        },
        {
            "API_name": "getPrivacyURL",
            "class_name": "ADXGDPR",
            "conditions": [],
            "effects": [
                "retrieves the URL of the privacy policy"
            ],
            "parameter_configurations": []
        }
    ]
}