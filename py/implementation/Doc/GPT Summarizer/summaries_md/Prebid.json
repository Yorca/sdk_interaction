{
    "SDK": "Prebid",
    "privacy_APIs": [
        {
            "API_name": "setShareGeoLocation",
            "class_name": "Prebid",
            "conditions": [
                "The app collects the user\u2019s geographical location data."
            ],
            "effects": [
                "If true, the SDK will send the user\u2019s lat/long geographical location data to the Prebid Server."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "The app needs to share geographical location."
                    ],
                    "effects": [
                        "User's geographical location is sent to the Prebid Server."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "The app needs to withhold geographical location."
                    ],
                    "effects": [
                        "User's geographical location is not sent to the Prebid Server."
                    ]
                }
            ]
        },
        {
