{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setUserId",
            "class_name": "AppCenter",
            "conditions": [
                "Must configure App Center SDK by calling AppCenter.start(...)"
            ],
            "effects": [
                "Augments crash reports with the specified user ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "your-user-id"
                    ],
                    "conditions": [
                        "Must be set before each application launch because this value isn't stored between launches"
                    ],
                    "effects": [
                        "Allows search for specific crash reports related to the user ID"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabled",
            "class_name": "AppCenter",
            "conditions": [
                "Must be called after AppCenter has been started"
            ],
            "effects": [
                "Enables or disables all App Center services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables the forwarding of information to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables all services to forward information to App Center"
                    ]
                }
            ]
        },
        {
            "API_name": "setNetworkRequestsAllowed",
            "class_name": "AppCenter",
            "conditions": [],
            "effects": [
                "Allows controlling whether network requests are sent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK continues to collect data, but it won't be sent until network requests are allowed"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows sending data collected by the SDK"
                    ]
                }
            ]
        },
        {
            "API_name": "trackError",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Tracks handled exceptions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception",
                        "properties",
                        "attachments"
                    ],
                    "conditions": [],
                    "effects": [
                        "Reports the exception to the App Center with optional properties and attachments"
                    ]
                }
            ]
        },
        {
            "API_name": "shouldAwaitUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Specifies whether to wait for user consent before sending a crash report"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Requires app to build its own UI for user consent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK sends crash reports without waiting for user consent"
                    ]
                }
            ]
        },
        {
            "API_name": "notifyUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Submits the user's choice regarding sending crash reports"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "DONT_SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "User chooses not to send crash reports"
                    ]
                },
                {
                    "parameter_values": [
                        "SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "User agrees to send the crash reports"
                    ]
                },
                {
                    "parameter_values": [
                        "ALWAYS_SEND"
                    ],
                    "conditions": [],
                    "effects": [
                        "User consents to always send crash reports"
                    ]
                }
            ]
        }
    ]
}