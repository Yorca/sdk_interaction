{
    "SDK": "AD(X)",
    "privacy_APIs": [
        {
            "API_name": "initialize",
            "class_name": "ADXSdk",
            "conditions": [
                "Must call before any advertising related code",
                "Must use ADX App ID"
            ],
            "effects": [
                "Initializes the SDK and retrieves GDPR consent",
                "Allows advertising requests only after initialization is completed"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "GdprType.POPUP_LOCATION"
                    ],
                    "conditions": [
                        "User is in the European Economic Area (EEA)"
                    ],
                    "effects": [
                        "Displays a consent UI to users for GDPR compliance"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "GdprType.DIRECT_CONFIRM"
                    ],
                    "conditions": [
                        "User is in an EU region and has provided direct consent"
                    ],
                    "effects": [
                        "Enables personalized advertising for users who consented"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "GdprType.DIRECT_DENIED"
                    ],
                    "conditions": [
                        "User is in an EU region and has denied consent"
                    ],
                    "effects": [
                        "Disables personalized advertising for users who denied consent"
                    ]
                },
                {
                    "parameter_values": [
                        "<ADX_APP_ID>",
                        "GdprType.DIRECT_NOT_REQUIRED"
                    ],
                    "conditions": [
                        "User is outside the EU region"
                    ],
                    "effects": [
                        "Allows personalized advertising as consent is not required"
                    ]
                }
            ]
        },
        {
            "API_name": "getResultGDPR",
            "class_name": "ADXGdprManager",
            "conditions": [],
            "effects": [
                "Retrieves the current GDPR consent state for the user"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "saveResultGDPR",
            "class_name": "ADXGdprManager",
            "conditions": [],
            "effects": [
                "Allows direct modification of the user's consent state"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "getPrivacyURL",
            "class_name": "ADXGdprManager",
            "conditions": [],
            "effects": [
                "Retrieves the URL for the Privacy Policy"
            ],
            "parameter_configurations": []
        }
    ]
}