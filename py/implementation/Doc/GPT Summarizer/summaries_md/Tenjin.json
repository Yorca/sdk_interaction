{
    "SDK": "Tenjin",
    "privacy_APIs": [
        {
            "API_name": "optIn",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted in for tracking"
            ],
            "effects": [
                "User will be tracked and events will be processed"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOut",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted out of tracking"
            ],
            "effects": [
                "No API requests will be sent to Tenjin, and events will not be processed"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted in for the specified parameters"
            ],
            "effects": [
                "Only the specified device-related parameters are sent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "ip_address",
                            "advertising_id",
                            "limit_ad_tracking",
                            "referrer"
                        ]
                    ],
                    "conditions": [
                        "To track specific device-related parameters"
                    ],
                    "effects": [
                        "Only the specified parameters will be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted out of specified parameters"
            ],
            "effects": [
                "All parameters except the specified ones will be sent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "locale",
                            "timezone",
                            "build_id"
                        ]
                    ],
                    "conditions": [
                        "To exclude specific device-related parameters from being sent"
                    ],
                    "effects": [
                        "The specified parameters will not be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "setGoogleDMAParameters",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Sets parameters consistent with Google DMA settings"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            true,
                            true
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Ad personalization and user data inclusion is enabled"
                    ]
                },
                {
                    "parameter_values": [
                        [
                            false,
                            false
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Ad personalization and user data inclusion is disabled"
                    ]
                }
            ]
        },
        {
            "API_name": "optInGoogleDMA",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "User will be opted in for Google DMA parameters"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOutGoogleDMA",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "User will be opted out of Google DMA parameters"
            ],
            "parameter_configurations": []
        }
    ]
}