{
    "SDK": "Yandex Metrica",
    "privacy_APIs": [
        {
            "API_name": "setAgeRestrictedUser",
            "class_name": "",
            "conditions": [
                "Data about the user's age must be transmitted to the SDK every time the application starts"
            ],
            "effects": [
                "Restricts the collection of information from children under the age of 13"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is a child under the age of 13"
                    ],
                    "effects": [
                        "Limits data collection in compliance with COPPA"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is not a child under the age of 13"
                    ],
                    "effects": [
                        "No restrictions on data collection"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserConsent",
            "class_name": "",
            "conditions": [
                "The user's consent for processing personal data must be sent to the SDK each time the application is launched"
            ],
            "effects": [
                "Processes user data only if the user has consented"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "User data from the GDPR region will be processed"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "User data will not be processed"
                    ]
                }
            ]
        },
        {
            "API_name": "contextualDataAccounting",
            "class_name": "",
            "conditions": [
                "The function is only available for Android and AppMetrica SDK version 3.14.3 or higher must be enabled"
            ],
            "effects": [
                "Allows the Mobile Ads SDK to account for app context for ad relevance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "enabled"
                    ],
                    "conditions": [
                        "Contextual data tracking is enabled in the AppMetrica SDK"
                    ],
                    "effects": [
                        "Monetization becomes more effective by selecting relevant ads"
                    ]
                },
                {
                    "parameter_values": [
                        "disabled"
                    ],
                    "conditions": [
                        "Explicitly specified in AndroidManifest.xml or programmatically"
                    ],
                    "effects": [
                        "No contextual data will be taken into account, ensuring user confidentiality in sensitive areas"
                    ]
                }
            ]
        }
    ]
}