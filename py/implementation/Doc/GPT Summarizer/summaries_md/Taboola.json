{
    "SDK": "Taboola",
    "privacy_APIs": [
        {
            "API_name": "Passing CCPA status",
            "class_name": "",
            "conditions": [
                "Use SDK version 2.4.0 or above"
            ],
            "effects": [
                "Allows forwarding CCPA 'Do Not Sell' status to Taboola SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "true"
                    ],
                    "conditions": [
                        "End-user didn't provide agreement to use personal data per CCPA regulations"
                    ],
                    "effects": [
                        "Indicates that CCPA applies and the 'Do Not Sell' status is true"
                    ]
                },
                {
                    "parameter_values": [
                        "false"
                    ],
                    "conditions": [
                        "End-user provided agreement to use personal data per CCPA regulations"
                    ],
                    "effects": [
                        "Indicates that CCPA applies and the 'Do Not Sell' status is false"
                    ]
                },
                {
                    "parameter_values": [
                        "none"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that CCPA does not apply, allowing Taboola to use user's data"
                    ]
                }
            ]
        },
        {
            "API_name": "Passing consent status",
            "class_name": "",
            "conditions": [
                "Use SDK version 2.x"
            ],
            "effects": [
                "Allows forwarding user consent status to Taboola SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "true"
                    ],
                    "conditions": [
                        "User provided consent"
                    ],
                    "effects": [
                        "Enables the use of user's data for personalized recommendations"
                    ]
                },
                {
                    "parameter_values": [
                        "false"
                    ],
                    "conditions": [
                        "User didn't provide consent"
                    ],
                    "effects": [
