{
    "SDK": "Localytics",
    "privacy_APIs": [
        {
            "API_name": "setOptedOut",
            "class_name": "Localytics",
            "conditions": [
                "To stop Localytics SDK from collecting any additional data."
            ],
            "effects": [
                "Closes the current session and tags an opt-out event, indicating that the device will no longer report any future data."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Any data point generating calls will be dropped."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts back in to data collection."
                    ],
                    "effects": [
                        "Resumes data collection for the device."
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyOptedOut",
            "class_name": "Localytics",
            "conditions": [],
            "effects": [
                "Deletes all of the end user's data and prevents further data collection.",
                "Triggers a user's Right To Be Forgotten request."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Deletes all historical data for the user."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Resumes data collection for the user."
                    ]
                }
            ]
        },
        {
            "API_name": "pauseDataUploading",
            "class_name": "Localytics",
            "conditions": [
                "While verifying the data collection opt-in status of an end user."
            ],
            "effects": [
                "Pauses any data uploading to Localytics, though data collection continues."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Temporary halt of data uploads until the user's consent is confirmed."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Resumes normal data uploading operations."
                    ]
                }
            ]
        },
        {
            "API_name": "setCustomerIdWithPrivacyOptedOut",
            "class_name": "Localytics",
            "conditions": [],
            "effects": [
                "Updates the current customer ID and immediately updates the privacy opt-out status."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "CID",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Updates data collection opt-out status based on the user being logged in."
                    ]
                },
                {
                    "parameter_values": [
                        "CID",
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user is opted back into data collection."
                    ]
                }
            ]
        }
    ]
}