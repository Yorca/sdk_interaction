{
    "SDK": "Leanplum",
    "privacy_APIs": [
        {
            "API_name": "setUserAttributes",
            "class_name": "Leanplum",
            "conditions": [
                "user must opt-in to data collection before tracking with Leanplum"
            ],
            "effects": [
                "allows setting attributes for a user, which can be used for personalized content and segmentation"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "gender": "Female",
                            "age": 29
                        }
                    ],
                    "conditions": [
                        "attributes must be strings or numbers, must not exceed 200 unique attributes per app"
                    ],
                    "effects": [
                        "updates the user profile with specified attributes"
                    ]
                },
                {
                    "parameter_values": [
                        {
                            "email": "user@example.com"
                        }
                    ],
                    "conditions": [
                        "email is a required field for running email campaigns"
                    ],
                    "effects": [
                        "enables targeting the user in email campaigns"
                    ]
                }
            ]
        },
        {
            "API_name": "deleteUser",
            "class_name": "Leanplum",
            "conditions": [],
            "effects": [
                "deletes all user attributes and session data associated with the user"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "block",
            "class_name": "Leanplum",
            "conditions": [],
            "effects": [
                "stops Leanplum from collecting data for the user and deletes all their old data from the system"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "exportUser",
            "class_name": "Leanplum",
            "conditions": [],
            "effects": [
                "returns all attributes of the user in a human or machine-readable format"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setDeviceAttributes",
            "class_name": "Leanplum",
            "conditions": [
                "used to update device-specific attributes"
            ],
            "effects": [
                "modifies the attributes related to the user's device"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setDeviceLocation",
            "class_name": "Leanplum",
            "conditions": [
                "must call disableLocationCollection first if manually setting location"
            ],
            "effects": [
                "manually sets the user's location for location-based messaging"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "location",
                        "type"
                    ],
                    "conditions": [
                        "location must be a Location object, type must be specified"
                    ],
                    "effects": [
                        "updates the device's location with the provided location and accuracy type"
                    ]
                }
            ]
        }
    ]
}