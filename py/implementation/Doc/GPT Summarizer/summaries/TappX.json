{
    "SDK": "TappX",
    "privacy_APIs": [
        {
            "API_name": "grantPersonalInfoConsent",
            "conditions": [
                "User consents to the use of their data"
            ],
            "effects": [
                "Grants consent for personal information processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "denyPersonalInfoConsent",
            "conditions": [
                "User does NOT consent to the use of their data"
            ],
            "effects": [
                "Denies consent for personal information processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setGDPRConsent",
            "conditions": [
                "Consent string must be provided"
            ],
            "effects": [
                "Sets GDPR consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "String"
                    ],
                    "conditions": [
                        "Consent must be obtained before showing ads"
                    ],
                    "effects": [
                        "Determines whether the SDK respects the user's privacy preferences under GDPR"
                    ]
                }
            ]
        },
        {
            "API_name": "setCoppaCompliance",
            "conditions": [
                "Content of the app is intended for children under 13 years of age"
            ],
            "effects": [
                "Activates advertising restrictions in compliance with COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "When content is targeted for children"
                    ],
                    "effects": [
                        "Disables data tracking and remarketing advertising"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "When content is not targeted for children"
                    ],
                    "effects": [
                        "Allows data tracking and remarketing advertising"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "conditions": [
                "User consent string must be valid"
            ],
            "effects": [
                "Sets the privacy compliance status under CCPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [
                        "Consent must be obtained before showing ads"
                    ],
                    "effects": [
                        "Determines whether the SDK respects the user's privacy preferences under CCPA"
                    ]
                }
            ]
        },
        {
            "API_name": "setGlobalPrivacyPlatform",
            "conditions": [
                "User consent string must be valid"
            ],
            "effects": [
                "Sets the global privacy status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [
                        "Consent must be obtained before showing ads"
                    ],
                    "effects": [
                        "Determines the SDK's handling of user privacy under global regulations"
                    ]
                }
            ]
        }
    ]
}