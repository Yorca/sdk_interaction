{
    "SDK": "Taboola",
    "privacy_APIs": [
        {
            "API_name": "cdns",
            "conditions": [
                "CCPA applies, and the end-user's agreement on the use of personal data"
            ],
            "effects": [
                "indicates whether to honor the 'Do Not Sell' request according to CCPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "true"
                    ],
                    "conditions": [
                        "The end-user didn't provide agreement to use the personal data per CCPA regulations"
                    ],
                    "effects": [
                        "Taboola does not use the user's personal data"
                    ]
                },
                {
                    "parameter_values": [
                        "false"
                    ],
                    "conditions": [
                        "The end-user provided agreement to use the personal data per CCPA regulations"
                    ],
                    "effects": [
                        "Taboola can use the user's personal data"
                    ]
                },
                {
                    "parameter_values": [
                        "none"
                    ],
                    "conditions": [
                        "CCPA does not apply"
                    ],
                    "effects": [
                        "The default status allows Taboola to use the user's data"
                    ]
                }
            ]
        },
        {
            "API_name": "cex",
            "conditions": [
                "GDPR applies, and the end-user's consent status on the use of personal data"
            ],
            "effects": [
                "indicates whether to use personal data for recommendations according to GDPR"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "true"
                    ],
                    "conditions": [
                        "User provided consent"
                    ],
                    "effects": [
                        "Taboola can use the user's personal data for personalized recommendations"
                    ]
                },
                {
                    "parameter_values": [
                        "false"
                    ],
                    "conditions": [
                        "User didn't provide consent"
                    ],
                    "effects": [
                        "Taboola serves contextual recommendations only, without using personal data"
                    ]
                }
            ]
        }
    ]
}