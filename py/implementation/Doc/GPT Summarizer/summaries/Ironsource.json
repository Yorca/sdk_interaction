{
    "SDK": "Ironsource",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "conditions": [
                "User provided consent must be set to true",
                "User did not consent must be set to false"
            ],
            "effects": [
                "Updates a user's consent status for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If the user provided consent"
                    ],
                    "effects": [
                        "User's consent status is set to consented"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If the user did not consent"
                    ],
                    "effects": [
                        "User's consent status is set to not consented"
                    ]
                }
            ]
        },
        {
            "API_name": "setMetaData",
            "conditions": [
                "Set before initializing the SDK",
                "For U.S. Privacy, requires user to opt out of personal information sale"
            ],
            "effects": [
                "Manages user privacy settings in compliance with U.S. privacy laws"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "do_not_sell",
                        "true"
                    ],
                    "conditions": [
                        "If the user has opted out of sale of personal information"
                    ],
                    "effects": [
                        "User's personal information is not sold or shared"
                    ]
                },
                {
                    "parameter_values": [
                        "do_not_sell",
                        "false"
                    ],
                    "conditions": [
                        "If sale of personal information is permitted"
                    ],
                    "effects": [
                        "User's personal information can be sold or shared"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "true"
                    ],
                    "conditions": [
                        "If the end-user is a child"
                    ],
                    "effects": [
                        "Flags the specific end-user as a child for compliance with applicable child privacy laws"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "false"
                    ],
                    "conditions": [
                        "If the end-user is not a child"
                    ],
                    "effects": [
                        "User is not flagged as a child"
                    ]
                }
            ]
        }
    ]
}