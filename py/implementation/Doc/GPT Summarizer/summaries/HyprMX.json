{
    "SDK": "HyprMX",
    "privacy_APIs": [
        {
            "API_name": "setConsentStatus",
            "conditions": [
                "Jurisdictions that require passing consent",
                "User provided consent in jurisdictions that require opt-in consent or did not opt out of collection or usage in jurisdictions that require opt-out consent"
            ],
            "effects": [
                "Indicates a user's opt-in or opt-out consent for the collection and use of personal data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "ConsentStatus.CONSENT_GIVEN"
                    ],
                    "conditions": [
                        "User provided consent"
                    ],
                    "effects": [
                        "User is marked as consent given"
                    ]
                },
                {
                    "parameter_values": [
                        "ConsentStatus.CONSENT_DECLINED"
                    ],
                    "conditions": [
                        "User did not provide consent or opted out"
                    ],
                    "effects": [
                        "User is marked as consent declined"
                    ]
                },
                {
                    "parameter_values": [
                        "ConsentStatus.CONSENT_STATUS_UNKNOWN"
                    ],
                    "conditions": [
                        "User's consent status is unknown"
                    ],
                    "effects": [
                        "User's consent status is marked as unknown"
                    ]
                }
            ]
        },
        {
            "API_name": "setAgeRestrictedUser",
            "conditions": [
                "Age-restricted treatment is required under applicable laws",
                "User is under 16 years old or requires child-directed treatment"
            ],
            "effects": [
                "Flags the user as requiring child-directed treatment"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is under 16 or requires child-directed treatment"
                    ],
                    "effects": [
                        "User is treated as age-restricted"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is not under 16 or the age is unknown"
                    ],
                    "effects": [
                        "User is not treated as age-restricted"
                    ]
