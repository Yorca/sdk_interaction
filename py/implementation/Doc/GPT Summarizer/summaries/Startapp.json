{
    "SDK": "Startapp",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "conditions": [
                "User is based in the EU",
                "Consent change during the lifetime of the user activity"
            ],
            "effects": [
                "Indicates whether a user has consented for sharing app data for ad personalization"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this",
                        "pas",
                        "System.currentTimeMillis()",
                        true
                    ],
                    "conditions": [
                        "User has consented"
                    ],
                    "effects": [
                        "Passes consent flag to Start.io indicating consent for personalized ads"
                    ]
                },
                {
                    "parameter_values": [
                        "this",
                        "pas",
                        "System.currentTimeMillis()",
                        false
                    ],
                    "conditions": [
                        "User has not consented"
                    ],
                    "effects": [
                        "Passes consent flag to Start.io indicating no consent for personalized ads"
                    ]
                }
            ]
        },
        {
            "API_name": "getExtras",
            "conditions": [
                "User is a resident of California"
            ],
            "effects": [
                "Enables restriction on the sale of personal information under CCPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this"
                    ],
                    "conditions": [
                        "Notify user to opt-out"
                    ],
                    "effects": [
                        "Sets the IAB US privacy string to indicate whether the user opted-out or not"
                    ]
                }
            ]
        }
    ]
}