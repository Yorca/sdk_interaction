{
    "SDK": "AdColony(Digital Turbine, fyber)",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "conditions": [
                "Call the method after starting the SDK but before requesting an ad if the user is subject to GDPR"
            ],
            "effects": [
                "Indicates whether the user has given consent under GDPR; impacts the type of ads shown to the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is shown personalized ads since consent was given"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Only contextual ads are shown since consent was not given"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "conditions": [
                "Call this method after obtaining user response for 'opt-out of the sale of their personal information' under CCPA"
            ],
            "effects": [
                "Determines the privacy setting for California residents; affects how personal information is treated"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YNN"
                    ],
                    "conditions": [
                        "User chooses NOT to opt-out"
                    ],
                    "effects": [
                        "User's data is treated as consenting to advertising"
                    ]
                },
                {
                    "parameter_values": [
                        "1YYN"
                    ],
                    "conditions": [
                        "User chooses to restrict advertising and opt-out"
                    ],
                    "effects": [
                        "User's data is treated as opting-out of advertising"
                    ]
                },
                {
                    "parameter_values": [
                        "1---"
                    ],
                    "conditions": [
                        "CCPA does not apply"
                    ],
                    "effects": [
                        "Indicates that the app does not need to comply with CCPA for the user"
                    ]
                }
            ]
        },
        {
            "API_name": "setLgpdConsent",
            "conditions": [
                "Must follow compliance requirements for processing personal data under LGPD"
            ],
            "effects": [
                "Specifies whether consent was given by the user under Brazilian data regulation"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent is confirmed; personal data can be processed"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "No consent given; restricts processing of personal data"
                    ]
                }
            ]
        },
        {
            "API_name": "currentAudienceAppliesToCoppa",
            "conditions": [
                "Invoke this method after initializing the DT SDK to confirm target audience"
            ],
            "effects": [
                "Signals compliance with COPPA if target audience is children"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "useSecureConnections",
            "conditions": [
                "Call this method to enforce secure network connections in the SDK"
            ],
            "effects": [
                "Specifies whether the SDK should only use secure connections"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "All outgoing network connections from the SDK will use SSL/HTTPS"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Network connections may not be secure, potentially exposing data"
                    ]
                }
            ]
        }
    ]
}