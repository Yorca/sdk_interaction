{
    "SDK": "Countly",
    "privacy_APIs": [
        {
            "API_name": "enableCrashReporting",
            "conditions": [
                "Must be called during SDK initialization"
            ],
            "effects": [
                "Enables automatic crash reporting for uncaught exceptions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "recordHandledException",
            "conditions": [
                "Must provide a valid Exception object"
            ],
            "effects": [
                "Records a handled exception to the Countly SDK for monitoring"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception"
                    ],
                    "conditions": [],
                    "effects": [
                        "Logs the handled exception"
                    ]
                }
            ]
        },
        {
            "API_name": "recordUnhandledException",
            "conditions": [
                "Must provide a valid Exception object"
            ],
            "effects": [
                "Records an unhandled exception to the Countly SDK for monitoring"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception"
                    ],
                    "conditions": [],
                    "effects": [
                        "Logs the unhandled exception"
                    ]
                }
            ]
        },
        {
            "API_name": "setLocation",
            "conditions": [
                "Must provide valid countryCode, city, and geographical coordinates"
            ],
            "effects": [
                "Records the user's location for analytics purposes"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "countryCode",
                        "city",
                        "gpsCoordinates",
                        "ipAddress"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sends location data to the Countly server"
                    ]
                }
            ]
        },
        {
            "API_name": "setRequiresConsent",
            "conditions": [
                "Must be set to true to require user consent for using Countly features"
            ],
            "effects": [
                "Enables conditional data collection based on user consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent must be obtained before SDK features can be used"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK features can be used without explicit consent"
                    ]
                }
            ]
        },
        {
            "API_name": "giveConsent",
            "conditions": [
                "Must specify features for which consent is granted"
            ],
            "effects": [
                "Allows specified features to be used based on user consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "sessions",
                            "events"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Features gain permission to operate and collect data"
                    ]
                }
            ]
        },
        {
            "API_name": "removeConsent",
            "conditions": [
                "Must specify features for which consent is to be removed"
            ],
            "effects": [
                "Disallows specified features from operating and collecting data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "sessions"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Resolves any tracking associated with the removed features"
                    ]
                }
            ]
        },
        {
            "API_name": "enablePublicKeyPinning",
            "conditions": [
                "Must provide a valid list of SSL certificates"
            ],
            "effects": [
                "Improves security during network communication by ensuring only specified public keys are used for SSL connections"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "cert1",
                            "cert2"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Security of server communication is enhanced"
                    ]
                }
            ]
        },
        {
            "API_name": "setParameterTamperingProtectionSalt",
            "conditions": [
                "Must provide a non-empty string as salt"
            ],
            "effects": [
                "Adds a checksum to the data sent to the server for verification"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "someSaltValue"
                    ],
                    "conditions": [],
                    "effects": [
                        "Enhances protection against parameter tampering"
                    ]
                }
            ]
        }
    ]
}