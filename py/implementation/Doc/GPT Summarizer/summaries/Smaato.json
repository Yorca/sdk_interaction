{
    "SDK": "Smaato",
    "privacy_APIs": [
        {
            "API_name": "setLgpdConsentEnabled",
            "conditions": [
                "Requires explicit user consent under LGPD"
            ],
            "effects": [
                "Determines if the user has given consent for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given explicit consent"
                    ],
                    "effects": [
                        "Allow targeted advertising using personal information"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given explicit consent"
                    ],
                    "effects": [
                        "Run contextual ads without personal information"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "No explicit signal set"
                    ],
                    "effects": [
                        "Proceed only if legal basis for targeted advertising is available"
                    ]
                }
            ]
        },
        {
            "API_name": "setGpdpConsentEnabled",
            "conditions": [
                "Requires explicit user consent according to GDPR compliance"
            ],
            "effects": [
                "Opt in or out of data processing under GDPR"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "Indeterminate status on GDPR applicability"
                    ],
                    "effects": [
                        "Invalid ads requests without user consent if GDPR applies"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given explicit consent"
                    ],
                    "effects": [
                        "Send personal data to the ad requests"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given explicit consent"
                    ],
                    "effects": [
                        "Ads requests will be dropped on the server-side"
                    ]
                }
            ]
        },
        {
            "API_name": "getUsPrivacyString",
            "conditions": [
                "Requires request from California-based users for CCPA compliance"
            ],
            "effects": [
                "Fetches the privacy string related to CCPA requirements"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "User has not opted out"
                    ],
                    "effects": [
                        "Sends requests with user's privacy string"
                    ]
                },
                {
                    "parameter_values": [
                        "iab string"
                    ],
                    "conditions": [
                        "User has opted out"
                    ],
                    "effects": [
                        "Used in ad requests as an optional parameter for privacy compliance"
                    ]
                }
            ]
        },
        {
            "API_name": "init",
            "conditions": [
                "Required to initialize the Smaato SDK"
            ],
            "effects": [
                "Starts the SDK and prepares it for ad serving"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "publisherId"
                    ],
                    "conditions": [
                        "Must be called in the onCreate method of Application class"
                    ],
                    "effects": [
                        "Sets up SDK with the publisher ID"
                    ]
                },
                {
                    "parameter_values": [
                        "config"
                    ],
                    "conditions": [
                        "Optional additional configurations can be passed"
                    ],
                    "effects": [
                        "Changes SDK settings like log level and HTTPS usage"
                    ]
                }
            ]
        }
    ]
}