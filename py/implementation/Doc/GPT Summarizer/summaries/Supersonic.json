{
    "SDK": "Supersonic",
    "privacy_APIs": [
        {
            "API_name": "supersonic.init",
            "conditions": [
                "appKey must be provided",
                "adListener must be provided"
            ],
            "effects": [
                "initializes the Supersonic plugin",
                "enables or disables GDPR data collection restrictions based on hasUserConsent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        false
                    ],
                    "conditions": [
                        "hasUserConsent is set to false"
                    ],
                    "effects": [
                        "enables GDPR data collection restrictions"
                    ]
                },
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        true
                    ],
                    "conditions": [
                        "hasUserConsent is set to true"
                    ],
                    "effects": [
                        "disables GDPR data collection restrictions"
                    ]
                }
            ]
        }
    ]
}