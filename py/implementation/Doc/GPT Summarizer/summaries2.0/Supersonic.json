{
    "SDK": "Supersonic",
    "privacy_APIs": [
        {
            "API_name": "supersonic.init",
            "conditions": [
                "appKey is required",
                "adListener is required"
            ],
            "effects": [
                "initializes the Supersonic plugin for ad loading and displaying",
                "enables or restricts GDPR data collection based on hasUserConsent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "appKey": "YOUR_APP_KEY",
                            "hasUserConsent": false
                        }
                    ],
                    "conditions": [
                        "User does not consent to data collection"
                    ],
                    "effects": [
                        "GDPR data collection restrictions are enabled"
                    ]
                },
                {
                    "parameter_values": [
                        {
                            "appKey": "YOUR_APP_KEY",
                            "hasUserConsent": true
                        }
                    ],
                    "conditions": [
                        "User consents to data collection"
                    ],
                    "effects": [
                        "GDPR data collection restrictions are lifted"
                    ]
                }
            ]
        }
    ]
}