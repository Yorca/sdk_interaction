{
    "SDK": "Google Analytics",
    "privacy_APIs": [
        {
            "API_name": "setAppOptOut",
            "conditions": [],
            "effects": [
                "Sets or resets the application-level opt-out flag. If set, no hits will be sent to Google Analytics."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Opt-out from sending hits to Google Analytics."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Re-enables sending hits to Google Analytics."
                    ]
                }
            ]
        },
        {
            "API_name": "newTracker(String trackingId)",
            "conditions": [
                "Requires valid tracking id string of the form UA-xxxx-y."
            ],
            "effects": [
                "Returns a Tracker instance ready to send hits."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "UA-000-1"
                    ],
                    "conditions": [
                        "Tracking id must not be null or empty."
                    ],
                    "effects": [
                        "Tracker instance will be associated with the provided tracking id."
                    ]
                },
                {
                    "parameter_values": [
                        ""
                    ],
                    "conditions": [
                        "Tracking id is empty at the time of tracker creation."
                    ],
                    "effects": [
                        "Tracker can still be obtained, but must set the tracking id before sending any hits."
                    ]
                }
            ]
        },
        {
            "API_name": "dispatchLocalHits",
            "conditions": [],
            "effects": [
                "Dispatches hits queued in the application store to Google Analytics if a network connection is available."
            ],
            "parameter_configurations": []
        }
    ]
}