{
    "SDK": "Adobe App Measurement for Android",
    "privacy_APIs": [
        {
            "API_name": "getConsents",
            "conditions": [],
            "effects": [
                "Retrieves the current consent preferences status in a dictionary representation."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [
                        "Callback invoked with the current consents of the extension."
                    ],
                    "effects": [
                        "Provides the current consent status including collect consent."
                    ]
                }
            ]
        },
        {
            "API_name": "updateConsents",
            "conditions": [],
            "effects": [
                "Updates the user's collect consent status for the application."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "collect": {
                                "val": "y"
                            }
                        },
                        {
                            "collect": {
                                "val": "n"
                            }
                        }
                    ],
                    "conditions": [
                        "Must provide a Map object representing the consents to be updated."
                    ],
                    "effects": [
                        "Changes the settings of the user's consent to either 'yes' or 'no'."
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyStatus",
            "conditions": [],
            "effects": [
                "Sets the privacy status for data collection according to user preferences."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.OPT_IN",
                        "MobilePrivacyStatus.OPT_OUT",
                        "MobilePrivacyStatus.UNKNOWN"
                    ],
                    "conditions": [
                        "The privacy status must match one of the defined enum values."
                    ],
                    "effects": [
                        "Determines whether hits are sent, not sent, or queued based on user's privacy preference."
                    ]
                }
            ]
        },
        {
            "API_name": "getPrivacyStatus",
            "conditions": [],
            "effects": [
                "Retrieves the current privacy status."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [
                        "Callback returns the current privacy status."
                    ],
                    "effects": [
                        "Indicates whether the user is opted in, opted out, or unknown regarding privacy."
                    ]
                }
            ]
        },
        {
            "API_name": "getSdkIdentities",
            "conditions": [],
            "effects": [
                "Retrieves all identifier data stored locally by the SDK."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [
                        "Applicable when using both Edge Network and Adobe Solutions extensions."
                    ],
                    "effects": [
                        "Returns identifiers in a JSON string format."
                    ]
                }
            ]
        }
    ]
}