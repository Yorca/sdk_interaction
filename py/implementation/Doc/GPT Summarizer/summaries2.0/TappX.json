{
    "SDK": "TappX",
    "privacy_APIs": [
        {
            "API_name": "grantPersonalInfoConsent",
            "conditions": [
                "User must consent to the use of their data"
            ],
            "effects": [
                "Grants consent for TappX to use personal data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "gdprConsentString"
                    ],
                    "conditions": [
                        "User consents to data usage"
                    ],
                    "effects": [
                        "Allows data processing according to GDPR regulations"
                    ]
                }
            ]
        },
        {
            "API_name": "denyPersonalInfoConsent",
            "conditions": [
                "User does NOT consent to the use of their data"
            ],
            "effects": [
                "Denies consent for TappX to use personal data"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setCoppaCompliance",
            "conditions": [
                "Application content is intended for children under 13 years of age"
            ],
            "effects": [
                "Activates advertising restrictions in compliance with COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Content is child-targeted"
                    ],
                    "effects": [
                        "Disables data tracking and remarketing advertising"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Content is not child-targeted"
                    ],
                    "effects": [
                        "Allows normal advertising practices"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "conditions": [
                "User must provide a valid consent string"
            ],
            "effects": [
                "Sets privacy preferences according to US privacy regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [
                        "Valid consent string from CMP or tool is provided"
                    ],
                    "effects": [
                        "Ensures compliance with applicable US privacy laws"
                    ]
                }
            ]
        },
        {
            "API_name": "setGlobalPrivacyPlatform",
            "conditions": [
                "User must provide a valid consent string"
            ],
            "effects": [
                "Sets global privacy preferences according to specified consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [
                        "Valid consent string from CMP or tool is provided"
                    ],
                    "effects": [
                        "Ensures compliance with global privacy regulations"
                    ]
                }
            ]
        }
    ]
}