{
    "SDK": "Firebase",
    "privacy_APIs": [
        {
            "API_name": "setAnalyticsCollectionEnabled",
            "conditions": [
                "requires end-user consent before collecting data"
            ],
            "effects": [
                "enables or disables Analytics data collection"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "user has provided consent to collect data"
                    ],
                    "effects": [
                        "Analytics data collection is enabled"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "user has not provided consent to collect data"
                    ],
                    "effects": [
                        "Analytics data collection is disabled"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserProperty",
            "conditions": [
                "must be called after analytics collection is enabled"
            ],
            "effects": [
                "sets user properties for personalized advertising features"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "ALLOW_AD_PERSONALIZATION_SIGNALS",
                        "true"
                    ],
                    "conditions": [
                        "ad personalization is enabled"
                    ],
                    "effects": [
                        "personalized advertising features are re-enabled for the user"
                    ]
                },
                {
                    "parameter_values": [
                        "ALLOW_AD_PERSONALIZATION_SIGNALS",
                        "false"
                    ],
                    "conditions": [
                        "ad personalization is disabled"
                    ],
                    "effects": [
                        "personalized advertising features are disabled for the user"
                    ]
                }
            ]
        }
    ]
}