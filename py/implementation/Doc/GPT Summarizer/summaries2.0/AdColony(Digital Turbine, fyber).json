{
    "SDK": "AdColony(Digital Turbine, fyber)",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "conditions": [
                "The user's consent has been collected",
                "User is subject to GDPR rules"
            ],
            "effects": [
                "SDK takes the user's consent into consideration for ad serving"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "User is eligible for personalized ads"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "Only contextual ads are shown"
                    ]
                }
            ]
        },
        {
            "API_name": "setGdprConsentString",
            "conditions": [
                "User's consent string must be obtained through a certified CMP"
            ],
            "effects": [
                "User's consent string is passed to the SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "consentString"
                    ],
                    "conditions": [
                        "Valid consent string obtained"
                    ],
                    "effects": [
                        "Allows SDK to comply with GDPR for the user"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "conditions": [
                "User has interacted with an opt-out option"
            ],
            "effects": [
                "Sets the US privacy settings based on user consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YN",
                        "1---"
                    ],
                    "conditions": [
                        "User opts to restrict advertising",
                        "User is not a resident of California"
                    ],
                    "effects": [
                        "Restricts personal advertising to user",
                        "No restrictions on personal advertising"
                    ]
                }
            ]
        },
        {
            "API_name": "setLgpdConsent",
            "conditions": [
                "User's consent must be determined under LGPD guidelines"
            ],
            "effects": [
                "Sets the LGPD consent value for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        false
                    ],
                    "conditions": [
                        "User has given consent",
                        "User has not given consent"
                    ],
                    "effects": [
                        "Allows or restricts data processing as per LGPD"
                    ]
                }
            ]
        },
        {
            "API_name": "currentAudienceAppliesToCoppa",
            "conditions": [
                "Must call this API after successful SDK initialization"
            ],
            "effects": [
                "Determines if the target audience applies to COPPA regulations"
            ],
            "parameter_configurations": []
        }
    ]
}