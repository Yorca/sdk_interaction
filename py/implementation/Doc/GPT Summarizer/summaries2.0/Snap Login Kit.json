                {
                    "parameter_values": [
                        "loginStateCallback"
                    ],
                    "conditions": [
                        "A login state callback must be available"
                    ],
                    "effects": [
                        "Stops receiving notifications on login state changes"
                    ]
                }
            ]
        },
        {
