{
    "SDK": "MobileFuse",
    "privacy_APIs": [
        {
            "API_name": "setAllowLocation",
            "conditions": [
                "User must opt-in to location tracking"
            ],
            "effects": [
                "Enables or disables location-based ad personalization"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has opted in to location-based ad personalization"
                    ],
                    "effects": [
                        "Location-based ads will be shown to the user"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has opted out of location-based ad personalization"
                    ],
                    "effects": [
                        "No location-based ads will be shown"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyPreferences",
            "conditions": [
                "Must provide a GPP Consent String or US Privacy String"
            ],
            "effects": [
                "Establishes privacy preferences for data collection and usage"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "GPP Consent String"
                    ],
                    "conditions": [
                        "User's consent for data processing is needed"
                    ],
                    "effects": [
                        "Enables compliance with IAB standards"
                    ]
                },
                {
                    "parameter_values": [
                        "<US Privacy String>"
                    ],
                    "conditions": [
                        "User is subject to US privacy regulations"
                    ],
                    "effects": [
                        "Specifies the user\u2019s privacy preferences under US law"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is opted out from tracking"
                    ],
                    "effects": [
                        "User's tracking information is restricted"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is not opted out from tracking"
                    ],
                    "effects": [
                        "User's tracking information is not restricted"
                    ]
                }
            ]
        }
    ]
}