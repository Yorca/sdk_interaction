{
    "SDK": "AppsFlyer",
    "privacy_APIs": [
        {
            "API_name": "start",
            "conditions": [
                "must call stop or anonymizeUser after a success message"
            ],
            "effects": [
                "shares only the install event and no additional information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "anonymizeUser",
            "conditions": [
                "to instruct AppsFlyer to remove all user-identifying information"
            ],
            "effects": [
                "sends install and in-app events with all identifying information deleted or hashed"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "personal identifiers are deleted and AppsFlyer ID and IP address are hashed"
                    ]
                }
            ]
        },
        {
            "API_name": "setSharingFilterForPartners",
            "conditions": [
                "must be called before start to prevent sharing data with partners"
            ],
            "effects": [
                "excludes specified partners from receiving data through postbacks, APIs, and other means"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setDisableAdvertisingIdentifiers",
            "conditions": [
                "should be called before start to disable collection of advertising IDs"
            ],
            "effects": [
                "disables the collection of GAID, OAID, and AAID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setCollectOaid",
            "conditions": [
                "should be called before start to disable OAID collection"
            ],
            "effects": [
                "disables the collection of the OAID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "send data only after user opts-in",
            "conditions": [
                "defer calling start until after the user gives consent"
            ],
            "effects": [
                "no data is sent to AppsFlyer until consent is given"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        }
    ]
}