{
    "SDK": "mixpanel",
    "privacy_APIs": [
        {
            "API_name": "identify",
            "conditions": [
                "user must be authenticated"
            ],
            "effects": [
                "connects events to the correct user as they move across devices and create a user profile"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "13793"
                    ],
                    "conditions": [
                        "Identify method must be called after log-in or sign-up"
                    ],
                    "effects": [
                        "tracks all of the authenticated application usage to the correct user ID"
                    ]
                }
            ]
        },
        {
            "API_name": "reset",
            "conditions": [
                "user must log out"
            ],
            "effects": [
                "generates a new random distinct_id and clears super properties"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "registerSuperProperties",
            "conditions": [
                "super properties need to be defined"
            ],
            "effects": [
                "automatically includes these properties with all events sent in the future"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "User Type": "Paid"
                        }
                    ],
                    "conditions": [
                        "Properly configured before tracking events"
                    ],
                    "effects": [
                        "the specified properties will be included with all events"
                    ]
                }
            ]
        },
        {
            "API_name": "trackCharge",
            "conditions": [
                "identify method must be called before charge updates"
            ],
            "effects": [
                "tracks revenue by adding transactions to the user profile"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        100,
                        null
                    ],
                    "conditions": [
                        "valid when identifying a user and tracking revenue"
                    ],
                    "effects": [
                        "adds $100 to the user's revenue profile"
                    ]
                }
            ]
        },
        {
            "API_name": "getPeople().set",
            "conditions": [
                "identify must be called before setting user profile properties"
            ],
            "effects": [
                "sets properties on a user's profile or creates a new profile if one doesn't exist"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Plan",
                        "Premium"
                    ],
                    "conditions": [
                        "user must be identified"
                    ],
                    "effects": [
                        "overwrites the 'Plan' property with 'Premium' for user profile"
                    ]
                }
            ]
        },
        {
            "API_name": "EU Data Residency",
            "conditions": [],
            "effects": [
                "routes user data to Mixpanel's EU servers for compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "https://api-eu.mixpanel.com/track?ip=1"
                    ],
                    "conditions": [
                        "Application must be configured to use the EU endpoints in the AndroidManifest.xml"
                    ],
                    "effects": [
                        "ensures data is handled in compliance with EU data residency laws"
                    ]
                }
            ]
        }
    ]
}