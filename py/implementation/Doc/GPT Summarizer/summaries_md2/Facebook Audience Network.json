{
    "SDK": "Facebook Audience Network",
    "privacy_APIs": [
        {
            "API_name": "setMixedAudience",
            "class_name": "AdSettings",
            "conditions": [
                "app is Mixed Audience without an Age Gate",
                "must set setMixedAudience flag for all users"
            ],
            "effects": [
                "Facebook will only serve ads to non-United States users"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "app is Mixed Audience without an Age Gate"
                    ],
                    "effects": [
                        "Enables ad serving specifically to non-United States users"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "user is outside U.S. or requirement isn't fulfilled"
                    ],
                    "effects": [
                        "Default ad serving behavior"
                    ]
                }
            ]
        },
        {
            "API_name": "setAdvertiserTrackingEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "permission is provided by the user to allow tracking"
            ],
            "effects": [
                "Allows advertiser tracking for app events"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "device provides permission for tracking"
                    ],
                    "effects": [
                        "Initiate advertiser tracking"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "device does not allow tracking"
                    ],
                    "effects": [
                        "Prohibit advertiser tracking"
                    ]
                }
            ]
        },
        {
            "API_name": "setAutoLogAppEventsEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "end user provides consent for event logging"
            ],
            "effects": [
                "Enables or disables automatic logging of app events"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "end user consented to event logging"
                    ],
                    "effects": [
                        "Automatic logging of predefined app events resumes"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "end user has not provided consent for event logging"
                    ],
                    "effects": [
                        "Prevents automatic logging of events"
                    ]
                }
            ]
        },
        {
            "API_name": "setDataProcessingOptions",
            "class_name": "FBSDKSettings",
            "conditions": [
                "must comply with Limited Data Use requirements for applicable states"
            ],
            "effects": [
                "Manages data processing preferences for individuals in certain states"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        0,
                        0
                    ],
                    "conditions": [
                        "enabling LDU and allowing Meta to perform geolocation"
                    ],
                    "effects": [
                        "Data is processed with Limited Data Use protocols"
                    ]
                },
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        1,
                        1000
                    ],
                    "conditions": [
                        "enabling LDU specifies a location, e.g., for California"
                    ],
                    "effects": [
                        "Data is processed under LDU protocols for California"
                    ]
                },
                {
                    "parameter_values": [
                        []
                    ],
                    "conditions": [
                        "explicitly choosing not to enable Limited Data Use"
                    ],
                    "effects": [
                        "No LDU processing is applied"
                    ]
                }
            ]
        }
    ]
}