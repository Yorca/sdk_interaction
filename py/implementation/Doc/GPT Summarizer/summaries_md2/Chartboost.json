{
    "SDK": "Chartboost",
    "privacy_APIs": [
        {
            "API_name": "addDataUseConsent",
            "class_name": "Chartboost",
            "conditions": [
                "publishers must obtain consent from users to process personal data",
                "If under Google Play Designed for Families policy, the COPPA privacy flag must be set to true"
            ],
            "effects": [
                "sets user consent data for privacy laws like GDPR, CCPA, and COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "GDPR(GDPR.GDPR_CONSENT.BEHAVIORAL)"
                    ],
                    "conditions": [],
                    "effects": [
                        "the user consents to behavioral and contextual ads under GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "GDPR(GDPR.GDPR_CONSENT.NON_BEHAVIORAL)"
                    ],
                    "conditions": [],
                    "effects": [
                        "the user does not consent to targeting, only contextual ads under GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "CCPA(CCPA.CCPA_CONSENT.OPT_IN_SALE)"
                    ],
                    "conditions": [],
                    "effects": [
                        "the user consents to the sale of their personal information for behavioral and contextual ads under CCPA"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "CCPA(CCPA.CCPA_CONSENT.OPT_OUT_SALE)"
                    ],
                    "conditions": [],
                    "effects": [
                        "the user does not consent to the sale of their personal information, only receives contextual ads under CCPA"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "COPPA(true)"
                    ],
                    "conditions": [
                        "if the app is child-directed"
                    ],
                    "effects": [
                        "COPPA restrictions apply, android advertising identifier is not transmitted, only contextual ads allowed"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "COPPA(false)"
                    ],
                    "conditions": [
                        "if the app is child-directed"
                    ],
                    "effects": [
                        "COPPA restrictions do not apply, behavioral and contextual ads are allowed"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "Custom('name', 'value')"
                    ],
                    "conditions": [
                        "valid IAB\u2019s U.S. Privacy String"
                    ],
                    "effects": [
                        "allows publishers to set custom consent information for the CCPA standard"
                    ]
                }
            ]
        },
        {
            "API_name": "clearDataUseConsent",
            "class_name": "Chartboost",
            "conditions": [],
            "effects": [
                "clears any of the privacy data use consent for GDPR, CCPA, COPPA, or Custom Consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "dataUseConsent.privacyStandard"
                    ],
                    "conditions": [],
                    "effects": [
                        "removes the specified privacy standard consent"
                    ]
                }
            ]
        }
    ]
}