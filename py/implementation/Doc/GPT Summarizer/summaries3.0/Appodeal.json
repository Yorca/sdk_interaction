{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "class_name": "Appodeal",
            "conditions": [
                "Must be called before the SDK initialization"
            ],
            "effects": [
                "Indicates whether the content is treated as child-directed for purposes of COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "If content is directed towards children"
                    ],
                    "effects": [
                        "Disables sending user data to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If content is not directed towards children"
                    ],
                    "effects": [
                        "Allows sending user data to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "If the COPPA parameter from the application's settings is needed"
                    ],
                    "effects": [
                        "Uses the COPPA parameter defined in settings"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentManager",
            "conditions": [
                "Can be called at any moment of the application lifecycle"
            ],
            "effects": [
                "Updates the user's consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity",
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [
                        "Call should be made at the application launch"
                    ],
                    "effects": [
                        "Consent status is updated successfully"
                    ]
                }
            ]
        },
        {
            "API_name": "load",
            "class_name": "ConsentManager",
            "conditions": [],
            "effects": [
                "Loads the ConsentForm for display"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity",
                        "successListener",
                        "failureListener"
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent form is loaded successfully or an error occurs"
                    ]
                }
            ]
        },
        {
            "API_name": "show",
            "class_name": "ConsentForm",
            "conditions": [],
            "effects": [
                "Displays the consent form to the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "InterstitialActivity",
                        "listener"
                    ],
                    "conditions": [],
                    "effects": [
                        "Shows consent form and captures dismissal status"
                    ]
                }
            ]
        },
        {
            "API_name": "loadAndShowConsentFormIfRequired",
            "class_name": "ConsentManager",
            "conditions": [],
            "effects": [
                "Loads and shows the consent form if required"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity",
                        "dismissedListener"
                    ],
                    "conditions": [],
                    "effects": [
                        "Shows consent form or handles error if it is not required"
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "class_name": "ConsentManager",
            "conditions": [],
            "effects": [
                "Resets the consent status to unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity"
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent status is revoked"
                    ]
                }
            ]
        }
    ]
}