{
    "SDK": "Smaato",
    "privacy_APIs": [
        {
            "API_name": "setLgpdConsentEnabled",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher needs to pass LGPD user consent to Smaato SDK"
            ],
            "effects": [
                "LGPD consent is set to true or false for user data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "Smaato will use personal data for targeted advertising"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "Smaato will run contextual ads without using personal identifiable information"
                    ]
                }
            ]
        },
        {
            "API_name": "setGpprConsentEnabled",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher needs to embed a Consent Management Platform (CMP)"
            ],
            "effects": [
                "Enables handling of user consent for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent under GDPR"
                    ],
                    "effects": [
                        "Smaato will process user data in compliance with GDPR regulations"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent under GDPR"
                    ],
                    "effects": [
                        "Smaato will not process user data and will drop ad requests"
                    ]
                }
            ]
        },
        {
            "API_name": "setUsPrivacyString",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher must ensure to request consent from California-based users"
            ],
            "effects": [
                "Sets the user privacy string specific for CCPA compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "iab string"
                    ],
                    "conditions": [
                        "User's consent status regarding personal data sharing"
                    ],
                    "effects": [
                        "Smaato uses this string for all ad requests involving California-based users"
                    ]
                }
            ]
        }
    ]
}