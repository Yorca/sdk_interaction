{
    "SDK": "Tenjin",
    "privacy_APIs": [
        {
            "API_name": "optIn",
            "class_name": "TenjinSDK",
            "conditions": [
                "User must provide consent to be tracked"
            ],
            "effects": [
                "Enables tracking of the user by sending API requests to Tenjin"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOut",
            "class_name": "TenjinSDK",
            "conditions": [
                "User chooses not to be tracked"
            ],
            "effects": [
                "Will not send API requests to Tenjin and will not process events"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted in to tracking"
            ],
            "effects": [
                "Only specified device-related parameters will be sent to Tenjin"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "ip_address",
                            "advertising_id",
                            "limit_ad_tracking",
                            "referrer"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Sends only the specified device-related parameters."
                    ]
                }
            ]
        },
        {
            "API_name": "optOutParams",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has opted in to tracking"
            ],
            "effects": [
                "Will send all device-related parameters except the specified ones."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "locale",
                            "timezone",
                            "build_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Sends all device-related parameters except locale, timezone, and build_id."
                    ]
                }
            ]
        },
        {
            "API_name": "setGoogleDMAParameters",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Sets parameters for managing data privacy settings related to Google DMA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            true,
                            false
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables or disables the collection of Google DMA parameters."
                    ]
                }
            ]
        }
    ]
}