{
    "SDK": "AerServ",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsentFlag",
            "class_name": "AerServSdk",
            "conditions": [
                "user consent was granted or denied under GDPR regulations"
            ],
            "effects": [
                "sets the GDPR user consent flag to indicate whether consent was given or not"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "user consent was granted"
                    ],
                    "effects": [
                        "GDPR flag is set to true"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "user consent was denied or is unknown"
                    ],
                    "effects": [
                        "GDPR flag is set to false"
                    ]
                }
            ]
        }
    ]
}