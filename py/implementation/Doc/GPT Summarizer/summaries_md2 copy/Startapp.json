            "class_name": "StartAppSDK",
            "conditions": [
                "User must have provided consent for data sharing"
            ],
            "effects": [
                "Indicates whether a user based in the EU has provided consent for sharing their app data for ads personalization"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this",
                        "pas",
                        "System.currentTimeMillis()",
                        true
                    ],
                    "conditions": [
                        "User has consented to the data sharing"
                    ],
                    "effects": [
                        "User will be shown personalized ads"
                    ]
                },
                {
                    "parameter_values": [
                        "this",
                        "pas",
                        "System.currentTimeMillis()",
                        false
                    ],
                    "conditions": [
                        "User has not consented to the data sharing"
                    ],
                    "effects": [
                        "User will not be shown personalized ads"
                    ]
                }
            ]
        },
        {
            "API_name": "getExtras",
            "class_name": "StartAppSDK",
            "conditions": [],
