{
    "SDK": "Nimbus",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "class_name": "NimbusAdManager",
            "conditions": [
                "Consent string must be created according to GDPR guidelines"
            ],
            "effects": [
                "Sets the GDPR consent string for user data protection, indicating whether GDPR applies"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "consentString"
                    ],
                    "conditions": [
                        "Prior values set in SharedPreferences are ignored; this call will take precedence"
                    ],
                    "effects": [
                        "Sets the GDPR consent string for the Nimbus SDK to use in requests"
                    ]
                }
            ]
        },
        {
            "API_name": "setUser",
            "class_name": "NimbusAdManager",
            "conditions": [
                "Must call setGdprConsent first if overwriting consent data"
            ],
            "effects": [
                "Global setting of user parameters that includes updated consent information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User(ext = User.Extension(consent = consentString))"
                    ],
                    "conditions": [
                        "Called after setting GDPR consent"
                    ],
                    "effects": [
                        "User data with consent string is applied globally for all requests"
                    ]
                }
            ]
        },
        {
