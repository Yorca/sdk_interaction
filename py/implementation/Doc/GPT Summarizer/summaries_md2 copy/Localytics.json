{
    "SDK": "Localytics",
    "privacy_APIs": [
        {
            "API_name": "setOptedOut",
            "class_name": "",
            "conditions": [
                "The user has explicitly requested to opt out of data collection."
            ],
            "effects": [
                "Stops the Localytics SDK from collecting any additional data and closes the current session."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Any subsequent calls that would generate a datapoint will be dropped."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Data collection is resumed."
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyOptedOut",
            "class_name": "",
            "conditions": [
                "The end user requests to be forgotten and all historical data deleted."
            ],
            "effects": [
                "Deletes all of the end user's data, prevents any further data from being collected and triggers a Right To Be Forgotten request."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The user's data is deleted and data collection is halted."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The user can be remembered and data collection resumes."
                    ]
                }
            ]
        },
        {
            "API_name": "pauseDataUploading",
            "class_name": "",
            "conditions": [
                "Opt-out status of the end user is being determined."
            ],
            "effects": [
                "Pauses any data uploading to Localytics while still collecting information."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents data from being uploaded until consent is granted."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Resumes data upload once consent is established."
                    ]
                }
            ]
        },
        {
            "API_name": "setCustomerIdWithPrivacyOptedOut",
            "class_name": "",
            "conditions": [
                "The user is logging in and their opt-out status from the server is determined."
            ],
            "effects": [
                "Updates the current customer ID and the data collection opt-out status."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "CustomerID",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets consent status for data collection to opted out."
                    ]
                },
                {
                    "parameter_values": [
                        "CustomerID",
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets consent status for data collection to opted in."
                    ]
                }
            ]
        }
    ]
}