            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent is not requested from the user."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent may be requested from the user."
                    ]
                }
            ]
        },
        {
