{
    "SDK": "AdMob",
    "privacy_APIs": [
        {
            "API_name": "putPublisherFirstPartyIdEnabled",
            "class_name": "MobileAds",
            "conditions": [
                "Google Mobile Ads SDK version 21.4.0 or higher"
            ],
            "effects": [
                "Enables or disables the Publisher first-party ID, affecting how personalized ads are delivered."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        null
                    ],
                    "effects": [
                        "Disables the Publisher first-party ID, which means ads may not be personalized based on the first-party ID."
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForChildDirectedTreatment",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Must be certified to act on behalf of the app owner as per COPPA regulations."
            ],
            "effects": [
                "Indicates whether Google should treat content as child-directed for purposes of COPPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_TRUE"
                    ],
                    "conditions": [
                        "The app content is child-directed."
                    ],
                    "effects": [
                        "Disables interest-based advertising for that ad request."
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_FALSE"
                    ],
                    "conditions": [
                        "The app content is not child-directed."
                    ],
                    "effects": [
                        "No specific restrictions applied regarding child-directed content."
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForUnderAgeOfConsent",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "Applicable for users in the European Economic Area (EEA) under the age of consent."
            ],
            "effects": [
                "Indicates treatment for users under the age of consent under GDPR."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_TRUE"
                    ],
                    "conditions": [
                        "The user is in the EEA and under the age of consent."
                    ],
                    "effects": [
                        "Prevents personalized advertising for that ad request."
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_FALSE"
                    ],
                    "conditions": [
                        "The user is not under the age of consent."
                    ],
                    "effects": [
                        "No additional privacy restrictions applied for personalized advertising."
                    ]
                }
            ]
        },
