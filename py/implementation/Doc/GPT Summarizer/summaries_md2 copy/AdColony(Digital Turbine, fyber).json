{
    "SDK": "AdColony",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Must gather user consent before passing it to the SDK",
                "Applicable for users in the EU or targeted to EU users"
            ],
            "effects": [
                "Determines if the user is subject to GDPR rules for ad targeting"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "User is eligible for personalized ads under GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "Only contextual ads will be shown to user"
                    ]
                }
            ]
        },
        {
            "API_name": "setGdprConsentString",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Must provide a valid consent string"
            ],
            "effects": [
                "Determines the consent string used for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "consentString"
                    ],
                    "conditions": [
                        "Consent string must be valid according to IAB's framework"
                    ],
                    "effects": [
                        "Updates the SDK with the user's consent status in string format"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Must gather user response regarding CCPA opt-out option"
            ],
            "effects": [
                "Defines whether the user has chosen to opt-out of the sale of personal information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YNN"
                    ],
                    "conditions": [
                        "User chooses NOT to opt-out"
                    ],
                    "effects": [
                        "User can continue receiving personalized ads"
                    ]
                },
                {
                    "parameter_values": [
                        "1YYN"
                    ],
                    "conditions": [
                        "User chooses to restrict advertising and opt-out"
                    ],
                    "effects": [
                        "User will be opted out of interest-based advertising"
                    ]
                },
                {
                    "parameter_values": [
                        "1---"
                    ],
                    "conditions": [
                        "User is not a resident of California or CCPA does not apply"
                    ],
                    "effects": [
                        "SDK will not enforce any CCPA restrictions"
                    ]
                }
            ]
        },
        {
            "API_name": "setLgpdConsent",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Appropriate user consent must have been gathered"
            ],
            "effects": [
                "Sets user consent status in compliance with LGPD"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "User's personal data can be processed under LGPD"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "User's personal data cannot be processed under LGPD"
                    ]
                }
            ]
        },
        {
            "API_name": "currentAudienceAppliesToCoppa",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Must be called after successful initialization of the SDK"
            ],
            "effects": [
                "Confirms if the target audience applies under COPPA regulations"
            ],
            "parameter_configurations": []
        }
    ]
}