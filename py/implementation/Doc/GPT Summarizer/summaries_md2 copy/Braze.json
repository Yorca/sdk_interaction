{
    "SDK": "Braze",
    "privacy_APIs": [
        {
            "API_name": "setLastKnownLocation",
            "class_name": "BrazeUser",
            "conditions": [
                "Location permissions must be granted by the user.",
                "If location tracking is enabled in braze.xml."
            ],
            "effects": [
                "Logs location data points manually even if automatic tracking is disabled."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "LATITUDE_DOUBLE_VALUE",
                        "LONGITUDE_DOUBLE_VALUE",
                        "ALTITUDE_DOUBLE_VALUE",
                        "ACCURACY_DOUBLE_VALUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the last known location with the provided latitude, longitude, altitude, and accuracy."
                    ]
                }
            ]
        },
        {
            "API_name": "disableSDK",
            "class_name": "Braze",
            "conditions": [
                "Method can be called to stop all data tracking activity."
            ],
            "effects": [
                "Cancels all network connections and stops data being passed to Braze servers."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "enableSDK",
            "class_name": "Braze",
            "conditions": [
                "Must be called to resume data tracking after it was disabled."
            ],
            "effects": [
                "Resumes data collection."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "wipeData",
            "class_name": "Braze",
            "conditions": [
                "Method will clear all client-side data stored on the device."
            ],
            "effects": [
                "All locally stored user data will be deleted."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "logPurchase",
            "class_name": "Braze",
            "conditions": [
                "Product Identifier must not be empty."
            ],
            "effects": [
                "Records in-app purchases and tracks revenue over time."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "productId",
                        "currencyCode",
                        "price",
                        "quantity"
                    ],
                    "conditions": [],
                    "effects": [
                        "Logs the purchase details to the user's profile."
                    ]
                },
                {
                    "parameter_values": [
                        "productId",
                        "currencyCode",
                        "price",
                        "quantity",
                        "purchaseProperties"
                    ],
                    "conditions": [],
                    "effects": [
                        "Logs the purchase with additional metadata."
                    ]
                }
            ]
        }
    ]
}