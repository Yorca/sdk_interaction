{
    "SDK": "TradPlus",
    "privacy_APIs": [
        {
            "API_name": "checkCurrentArea",
            "class_name": "TradPlusSdk",
            "conditions": [
                "called before initializing the SDK"
            ],
            "effects": [
                "determines the current region and sets relevant privacy APIs accordingly"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setCCPADoNotSell",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be set if in California region and application is intended for California users"
            ],
            "effects": [
                "accepts or denies data reporting from California users"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "California users accept data reporting"
                    ],
                    "effects": [
                        "user data can be reported"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "California users do not accept data reporting"
                    ],
                    "effects": [
                        "user data cannot be reported"
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAIsAgeRestrictedUser",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing TradPlus SDK"
            ],
            "effects": [
                "indicates if the user is a child under 13"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [],
                    "effects": [
                        "user is identified as a child, requiring consent from parents"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [],
                    "effects": [
                        "user is identified as not a child"
                    ]
                }
            ]
        },
        {
            "API_name": "setGDPRDataCollection",
            "class_name": "TradPlusSdk",
            "conditions": [
                "needs to be set before initializing SDK, especially if in the EU"
            ],
            "effects": [
                "sets the data collection level according to GDPR regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0,
                        "context"
                    ],
                    "conditions": [
                        "user agrees to data collection"
                    ],
                    "effects": [
                        "personalized device data is allowed to be reported"
                    ]
                },
                {
                    "parameter_values": [
                        1,
                        "context"
                    ],
                    "conditions": [
                        "user does not agree to data collection"
                    ],
                    "effects": [
                        "non-personalized device data is not allowed to be reported"
                    ]
                }
            ]
        },
        {
            "API_name": "setLGPDConsent",
            "class_name": "TradPlusSdk",
            "conditions": [
                "must be called before initializing TradPlus SDK if in Brazil"
            ],
            "effects": [
                "determines if device data reporting is allowed under Brazilian law"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0,
                        "context"
                    ],
                    "conditions": [
                        "user agrees to device data reporting"
                    ],
                    "effects": [
                        "device data is allowed to be reported"
                    ]
                },
                {
                    "parameter_values": [
                        1,
                        "context"
                    ],
                    "conditions": [
                        "user does not agree to device data reporting"
                    ],
                    "effects": [
                        "device data is not allowed to be reported"
                    ]
                }
            ]
        }
    ]
}