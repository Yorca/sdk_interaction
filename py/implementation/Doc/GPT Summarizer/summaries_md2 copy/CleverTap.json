{
    "SDK": "CleverTap",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "class_name": "CleverTapAPI",
            "conditions": [
                "User requests to stop sending events to CleverTap"
            ],
            "effects": [
                "Stops sending events to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is opted out and events are not sent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User is opted in and events can be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "enableDeviceNetworkInfoReporting",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "Enables capturing of device network information"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User allows capturing device network information"
                    ],
                    "effects": [
                        "Device network information is captured and sent to CleverTap"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Device network information is not captured"
                    ]
                }
            ]
        },
        {
            "API_name": "setOffline",
            "class_name": "CleverTapAPI",
            "conditions": [],
            "effects": [
                "Stops all events/profile information from being sent to CleverTap"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is set offline and no data is sent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User is set online and data can be sent"
                    ]
                }
            ]
        },
        {
            "API_name": "setEncryptionLevel",
            "class_name": "CleverTapInstanceConfig",
            "conditions": [
                "API version is v5.2.0 or later"
            ],
            "effects": [
                "Sets the encryption level for PII data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        0
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is stored in plaintext"
                    ]
                },
                {
                    "parameter_values": [
                        1
                    ],
                    "conditions": [],
                    "effects": [
                        "PII data is completely encrypted"
                    ]
                }
            ]
        },
        {
            "API_name": "setLocation",
            "class_name": "CleverTapAPI",
            "conditions": [
