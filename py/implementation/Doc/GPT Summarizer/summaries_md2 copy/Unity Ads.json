{
    "SDK": "Unity Ads",
    "privacy_APIs": [
        {
            "API_name": "SetMetaData",
            "class_name": "Advertisement",
            "conditions": [
                "You must commit the changes to the MetaData object for each value before trying to set another value."
            ],
            "effects": [
                "Allows the passing of user consent flags to the Unity Ads SDK."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "user",
                        "nonbehavioral",
                        "true"
                    ],
                    "conditions": [
                        "If the user opts out of personalized ads."
                    ],
                    "effects": [
                        "The user cannot receive personalized ads."
                    ]
                },
                {
                    "parameter_values": [
                        "user",
                        "nonbehavioral",
                        "false"
                    ],
                    "conditions": [
                        "If the user opts in to personalized ads."
                    ],
                    "effects": [
                        "The user can receive personalized ads."
                    ]
                },
                {
                    "parameter_values": [
                        "gdpr",
                        "consent",
                        "true"
                    ],
                    "conditions": [
                        "If the user opts in to targeted advertising."
                    ],
                    "effects": [
                        "The user opts in to targeted advertising."
                    ]
                },
                {
                    "parameter_values": [
                        "gdpr",
                        "consent",
                        "false"
                    ],
                    "conditions": [
                        "If the user opts out of targeted advertising."
                    ],
                    "effects": [
                        "The user opts out of targeted advertising."
                    ]
                }
            ]
        },
