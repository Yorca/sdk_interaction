{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setUserId",
            "class_name": "AppCenter",
            "conditions": [
                "must be set before each application launch"
            ],
            "effects": [
                "augments crash reports with a user ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "your-user-id"
                    ],
                    "conditions": [
                        "user ID limited to 256 characters"
                    ],
                    "effects": [
                        "the last user ID set will be used"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabled",
            "class_name": "AppCenter",
            "conditions": [
                "must be called after SDK initialization"
            ],
            "effects": [
                "enables or disables all App Center services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "to disable all services"
                    ],
                    "effects": [
                        "SDK won't forward any information to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "to enable services again"
                    ],
                    "effects": [
                        "SDK resumes sending collected data"
                    ]
                }
            ]
        },
        {
            "API_name": "setNetworkRequestsAllowed",
            "class_name": "AppCenter",
            "conditions": [],
            "effects": [
                "controls whether the SDK sends collected data"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK collects data but does not send until allowed"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK begins sending data immediately"
                    ]
                }
            ]
        },
        {
            "API_name": "shouldAwaitUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "determines if user confirmation is needed before sending crash reports"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": [
                        "custom UI must be provided to obtain user consent"
                    ]
                }
            ]
        },
        {
            "API_name": "notifyUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "submits the user's decision regarding crash report submission"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Crashes.DONT_SEND"
                    ],
                    "conditions": [
                        "user chooses not to send"
                    ],
                    "effects": [
                        "the crash report will not be sent"
                    ]
                },
                {
                    "parameter_values": [
                        "Crashes.SEND"
                    ],
                    "conditions": [
                        "user chooses to send"
                    ],
                    "effects": [
                        "the crash report will be sent to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        "Crashes.ALWAYS_SEND"
                    ],
                    "conditions": [
                        "user chooses to always send"
                    ],
                    "effects": [
                        "the crash report will be sent without prompting in future"
                    ]
                }
            ]
        },
        {
            "API_name": "trackError",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "tracks handled exceptions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception",
                        null,
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "sends the exception details"
                    ]
                },
                {
                    "parameter_values": [
                        "exception",
                        "properties",
                        "attachments"
                    ],
                    "conditions": [],
                    "effects": [
                        "sends exception details along with context through properties and attachments"
                    ]
                }
            ]
        }
    ]
}