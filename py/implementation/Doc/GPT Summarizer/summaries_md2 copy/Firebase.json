{
    "SDK": "Firebase",
    "privacy_APIs": [
        {
            "API_name": "setAnalyticsCollectionEnabled",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "Requires explicit user consent before data collection can begin."
            ],
            "effects": [
                "Enables or disables the collection of analytics data."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has provided consent for data collection."
                    ],
                    "effects": [
                        "Analytics data collection is enabled."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not provided consent for data collection."
                    ],
                    "effects": [
                        "Analytics data collection is disabled."
                    ]
                }
            ]
        },
        {
            "API_name": "setConsent",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "Consent for analytics must align with local privacy regulations."
            ],
            "effects": [
                "Sets user consent state for various data collection categories."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "AD_STORAGE": "GRANTED",
                            "ANALYTICS_STORAGE": "GRANTED",
                            "AD_USER_DATA": "GRANTED",
                            "AD_PERSONALIZATION": "GRANTED"
                        }
                    ],
                    "conditions": [
                        "User provides consent for all data collection types."
                    ],
                    "effects": [
                        "Data collection is permitted under specified categories."
                    ]
                },
                {
                    "parameter_values": [
                        {
                            "AD_STORAGE": "DENIED",
                            "ANALYTICS_STORAGE": "DENIED",
                            "AD_USER_DATA": "DENIED",
                            "AD_PERSONALIZATION": "DENIED"
                        }
                    ],
                    "conditions": [
                        "User denies consent for all data collection types."
                    ],
                    "effects": [
                        "Data collection is prohibited under specified categories."
                    ]
                }
            ]
        },
        {
            "API_name": "logEvent",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "Analytics collection must be enabled to log events."
            ],
            "effects": [
                "Logs a specific event along with parameters for analytics."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "event_name",
                        "event_params"
                    ],
                    "conditions": [
                        "User consent for event tracking has been granted."
                    ],
                    "effects": [
                        "The event is recorded and available for analysis."
                    ]
                }
            ]
        },
        {
            "API_name": "resetAnalyticsData",
            "class_name": "FirebaseAnalytics",
            "conditions": [],
            "effects": [
                "Clears all analytics data and resets the app instance ID."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setUserId",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "Must comply with the user's privacy settings and consent."
            ],
            "effects": [
                "Associates a unique user ID with future events."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "user_id_string"
                    ],
                    "conditions": [
                        "User ID must not exceed 256 characters."
                    ],
                    "effects": [
                        "User ID is associated with the user's analytics data."
                    ]
                }
            ]
        },
        {
            "API_name": "setUserProperty",
            "class_name": "FirebaseAnalytics",
            "conditions": [
                "User property settings must comply with privacy regulations."
            ],
            "effects": [
                "Sets a property value for the user for segmentation."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "property_name",
                        "property_value"
                    ],
                    "conditions": [
                        "Property name must be 1-24 characters, and value must be < 36 characters."
                    ],
                    "effects": [
                        "User property is retained across app sessions."
                    ]
                }
            ]
