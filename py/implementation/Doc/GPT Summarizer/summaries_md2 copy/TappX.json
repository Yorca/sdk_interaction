{
    "SDK": "TappX",
    "privacy_APIs": [
        {
            "API_name": "setUSPrivacy",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "User must provide a valid consent string from a CMP or tool."
            ],
            "effects": [
                "Sets the US privacy consent for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [
                        "Consent must be obtained before any data is processed."
                    ],
                    "effects": [
                        "Determines the user consent for data processing under CCPA."
                    ]
                }
            ]
        },
        {
            "API_name": "grantPersonalInfoConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "User must have consented to the use of their data."
            ],
            "effects": [
                "Allows the SDK to use personal data for ad targeting."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "denyPersonalInfoConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "User must not consent to the use of their data."
            ],
            "effects": [
                "Prohibits the SDK from using personal data."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setGDPRConsent",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "GDPR consent string must be provided."
            ],
            "effects": [
                "Sets the GDPR consent for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "gdprConsentString"
                    ],
                    "conditions": [
                        "Consent must be requested before showing ads."
                    ],
                    "effects": [
                        "Determines the user consent for data processing under GDPR."
                    ]
                }
            ]
        },
        {
            "API_name": "setCoppaCompliance",
            "class_name": "Tappx",
            "conditions": [
                "Must indicate if the content is intended for children under 13."
            ],
            "effects": [
                "Activates or deactivates advertising restrictions based on COPPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Set to true if the app targets children under 13."
                    ],
                    "effects": [
                        "Restricts personalized advertising."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Set to false if the app does not target children under 13."
                    ],
                    "effects": [
                        "No restrictions on personalized advertising."
                    ]
                }
            ]
        },
        {
            "API_name": "setGlobalPrivacyPlatform",
            "class_name": "TappxPrivacyManager",
            "conditions": [
                "A valid consent string from a CMP or tool must be provided."
            ],
            "effects": [
                "Sets the global privacy platform consent for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "User_Consent_String_Here"
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        }
    ]
}