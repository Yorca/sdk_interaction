{
    "SDK": "Facebook Audience Network",
    "privacy_APIs": [
        {
            "API_name": "setMixedAudience",
            "class_name": "AdSettings",
            "conditions": [
                "The app is a Mixed Audience without an Age Gate"
            ],
            "effects": [
                "Sets the flag to ensure only non-United States users see ads through the Audience Network"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "All users of the app"
                    ],
                    "effects": [
                        "Restricts ad requests to non-U.S. users of the app"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": []
                }
            ]
        },
        {
            "API_name": "setAdvertiserTrackingEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "User permission for advertiser tracking must be provided"
            ],
            "effects": [
                "Allows the application to enable or disable advertiser tracking based on user preferences"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Permission provided by the user to allow tracking"
                    ],
                    "effects": [
                        "Enables advertiser tracking for the app"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Permission not provided by the user to allow tracking"
                    ],
                    "effects": [
                        "Disables advertiser tracking for the app"
                    ]
                }
            ]
        },
        {
            "API_name": "setDataProcessingOptions",
            "class_name": "FBSDKSettings",
            "conditions": [
                "Compliance with Limited Data Use (LDU) requirements in specific U.S. states"
            ],
            "effects": [
                "Specifies how data is processed, especially concerning Limited Data Use"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        0,
                        0
                    ],
                    "conditions": [
                        "Enable LDU with automatic geolocation"
                    ],
                    "effects": [
                        "Data is processed as a service provider and adheres to state-specific terms"
                    ]
                },
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        1,
                        1000
                    ],
                    "conditions": [
                        "Enable LDU with specified location (e.g., California)"
                    ],
                    "effects": [
                        "Data is processed as specified for the designated state"
                    ]
                },
                {
                    "parameter_values": [
                        []
                    ],
                    "conditions": [],
                    "effects": [
                        "Explicitly indicates that Limited Data Use is not enabled"
                    ]
                }
            ]
        }
    ]
}