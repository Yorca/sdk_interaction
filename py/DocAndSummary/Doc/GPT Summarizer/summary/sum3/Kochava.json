{
    "SDK": "Kochava",
    "privacy_APIs": [
        {
            "API_name": "setIntelligentConsentGranted",
            "class_name": "Tracker",
            "conditions": [
                "User must provide consent"
            ],
            "effects": [
                "SDK will track data if consent is granted"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables tracking for the user"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables tracking for the user"
                    ]
                }
            ]
        },
        {
            "API_name": "registerPrivacyProfile",
            "class_name": "Tracker",
            "conditions": [],
            "effects": [
                "Creates a profile that groups specific datapoints for privacy restrictions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents transmission of device identifiers from the device for all users"
                    ]
                },
                {
                    "parameter_values": [
                        "child",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        "User is identified as a child"
                    ],
                    "effects": [
                        "Prevents transmission of device identifiers from the device only for children"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyProfileEnabled",
            "class_name": "Tracker",
            "conditions": [],
            "effects": [
                "Enables or disables a privacy profile for the current user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Stops egress of specified datapoints"
                    ]
                },
                {
                    "parameter_values": [
                        "child",
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Resumes egress of specified datapoints for children"
                    ]
                }
            ]
        },
        {
            "API_name": "setAppLimitAdTracking",
            "class_name": "Tracker",
            "conditions": [],
            "effects": [
                "Limits ad tracking at the application level"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Ad tracking is limited"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Ad tracking is not limited"
                    ]
                }
            ]
        }
    ]
}