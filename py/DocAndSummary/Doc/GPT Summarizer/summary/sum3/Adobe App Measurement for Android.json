{
    "SDK": "Adobe App Measurement for Android",
    "privacy_APIs": [
        {
            "API_name": "setPrivacyStatus",
            "class_name": "MobileCore",
            "conditions": [],
            "effects": [
                "sets the privacy status to either opted in, opted out, or unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.OPT_IN"
                    ],
                    "conditions": [],
                    "effects": [
                        "Hits are sent"
                    ]
                },
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.OPT_OUT"
                    ],
                    "conditions": [],
                    "effects": [
                        "Hits are not sent"
                    ]
                },
                {
                    "parameter_values": [
                        "MobilePrivacyStatus.UNKNOWN"
                    ],
                    "conditions": [],
                    "effects": [
                        "Hits are queued"
                    ]
                }
            ]
        },
        {
            "API_name": "getPrivacyStatus",
            "class_name": "MobileCore",
            "conditions": [],
            "effects": [
                "retrieves the current privacy status"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "setAppGroup",
            "class_name": "MobileCore",
            "conditions": [
                "only supported on iOS versions of Mobile Core"
            ],
            "effects": [
                "sets the app group for sharing user defaults and files"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "appGroupId"
                    ],
                    "conditions": [
                        "must be called in AppDidFinishLaunching"
                    ],
                    "effects": [
                        "First call will have effect on setting the app group"
                    ]
                }
            ]
        },
        {
            "API_name": "setPushIdentifier",
            "class_name": "MobileCore",
            "conditions": [
                "if the current SDK privacy status is opted out, the push identifier is not set"
            ],
            "effects": [
                "sets the device token for push notifications"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "deviceToken"
                    ],
                    "conditions": [],
                    "effects": [
                        "ensures the most up-to-date device token is set"
                    ]
                }
            ]
        },
        {
            "API_name": "getSdkIdentities",
            "class_name": "MobileCore",
            "conditions": [
                "must be called before the user opts out"
            ],
            "effects": [
                "retrieves SDK identities stored as JSON string"
            ],
            "parameter_configurations": []
        }
    ]
}