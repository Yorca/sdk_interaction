{
    "SDK": "Tenjin",
    "privacy_APIs": [
        {
            "API_name": "optIn",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has provided consent to track"
            ],
            "effects": [
                "Starts processing events for user who opted in"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOut",
            "class_name": "TenjinSDK",
            "conditions": [
                "User has chosen not to be tracked"
            ],
            "effects": [
                "Stops processing events for user who opted out"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInParams",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Only sends specified device-related parameters"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "ip_address",
                            "advertising_id",
                            "limit_ad_tracking",
                            "referrer"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Tracks only the specified device-related parameters"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutParams",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Sends all device-related parameters excluding specified ones"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "locale",
                            "timezone",
                            "build_id"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "Tracks all parameters except the specified exclusions"
                    ]
                }
            ]
        },
        {
            "API_name": "setGoogleDMAParameters",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Manages the collection of Google DMA parameters"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Explicitly opts in or opts out of Google DMA parameter collection"
                    ]
                }
            ]
        },
        {
            "API_name": "optInGoogleDMA",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Opt-ins to the collection of Google DMA parameters"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOutGoogleDMA",
            "class_name": "TenjinSDK",
            "conditions": [],
            "effects": [
                "Opt-outs from the collection of Google DMA parameters"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInOutUsingCMP",
            "class_name": "TenjinSDK",
            "conditions": [
                "User consent previously stored in CMP"
            ],
            "effects": [
                "Automatically opt in or opt out based on CMP consents"
            ],
            "parameter_configurations": []
        }
    ]
}