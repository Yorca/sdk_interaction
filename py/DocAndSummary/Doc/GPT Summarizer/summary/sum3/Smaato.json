{
    "SDK": "Smaato",
    "privacy_APIs": [
        {
            "API_name": "setLgpdConsentEnabled",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher as a user must have LGPD compliance."
            ],
            "effects": [
                "Sets the LGPD user consent to either true (given) or false (not given), which impacts how personal information can be processed."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given explicit consent."
                    ],
                    "effects": [
                        "Advertise with user data for targeted advertising."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent."
                    ],
                    "effects": [
                        "Only contextual ads will be served without PII."
                    ]
                }
            ]
        },
        {
            "API_name": "init",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Requires a valid publisher ID."
            ],
            "effects": [
                "Initializes the Smaato SDK for ad serving."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this",
                        "publisherId"
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK is initialized to start ad services."
                    ]
                },
                {
                    "parameter_values": [
                        "this",
                        "config",
                        "publisherId"
                    ],
                    "conditions": [
                        "Additional configuration parameters are provided."
                    ],
                    "effects": [
                        "Allows configuration of additional settings, such as HTTPS only and logging."
                    ]
                },
                {
                    "parameter_values": [
                        "this",
                        "config",
                        "publisherId",
                        "smaatoSdkInitialisationListener"
                    ],
                    "conditions": [
                        "Listener is set for SDK initialization callbacks."
                    ],
                    "effects": [
                        "Provides feedback on the success or failure of SDK initialization."
                    ]
                }
            ]
        },
        {
            "API_name": "setCoppa",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Integrate if COPPA compliance is required."
            ],
            "effects": [
                "Indicates whether the app is directed to children under the age of 13."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User's app is designed for children."
                    ],
                    "effects": [
                        "Restricts collection of personal data in accordance with COPPA regulations."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User's app is not directed towards children."
                    ],
                    "effects": [
                        "No restrictions on personal data collection apply."
                    ]
                }
            ]
        },
        {
            "API_name": "setUsPrivacyString",
            "class_name": "SmaatoSdk",
            "conditions": [
                "California-based publishers must comply with CCPA."
            ],
            "effects": [
                "Sets the US Privacy String for handling user privacy choices."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "iab privacy string"
                    ],
                    "conditions": [
                        "Publisher has obtained user consent regarding data transfer."
                    ],
                    "effects": [
                        "Allows targeted advertising based on user consent."
                    ]
                }
            ]
        }
    ]
}