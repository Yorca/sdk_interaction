{
    "SDK": "Tapjoy",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "The application has made its own determination regarding the applicability of GDPR"
            ],
            "effects": [
                "Sets the user's consent status for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [
                        "User does not consent"
                    ],
                    "effects": [
                        "User's data will not be processed for interest-based advertising"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [
                        "User consents"
                    ],
                    "effects": [
                        "User's data will be processed for interest-based advertising"
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Indicates whether the user is subject to GDPR"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Tapjoy assumes GDPR rules apply to the user"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Tapjoy assumes GDPR rules do not apply to the user"
                    ]
                }
            ]
        },
        {
            "API_name": "setBelowConsentAge",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Informs compliance regarding the user's age under COPPA or other regulations"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user is below the consent age"
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user is above the consent age"
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Sets the US privacy compliance status using IAB's US Privacy String Format"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YYY"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets US privacy status based on the provided US Privacy String"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutAdvertisingID",
            "class_name": "Tapjoy",
            "conditions": [],
            "effects": [
                "Opt-out of using the advertising ID for tracking"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "this",
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents the SDK from accessing the advertising ID"
                    ]
                },
                {
                    "parameter_values": [
                        "this",
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows the SDK to access the advertising ID again"
                    ]
                }
            ]
        }
    ]
}