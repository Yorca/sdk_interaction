{
    "SDK": "AdColony(Digital Turbine, fyber)",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "User must be subjected to GDPR rules.",
                "Consent must be collected before passing it to the SDK."
            ],
            "effects": [
                "Determines whether personalized ads are served based on user's consent."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has provided consent for GDPR."
                    ],
                    "effects": [
                        "Personalized ads are shown."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not provided consent for GDPR."
                    ],
                    "effects": [
                        "Only contextual ads are shown."
                    ]
                }
            ]
        },
        {
            "API_name": "setGdprConsentString",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "Consent string must be sourced from a certified CMP."
            ],
            "effects": [
                "Sets the GDPR consent string for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "consentString"
                    ],
                    "conditions": [
                        "A valid consent string must be passed."
                    ],
                    "effects": [
                        "Sets GDPR consent as per the provided string."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "User must respond to an opt-out option."
            ],
            "effects": [
                "Sets the US privacy setting string according to user preferences."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YNN"
                    ],
                    "conditions": [
                        "User opts in and does not wish to opt-out."
                    ],
                    "effects": [
                        "Advertising is permitted as usual."
                    ]
                },
                {
                    "parameter_values": [
                        "1YYN"
                    ],
                    "conditions": [
                        "User chooses to restrict advertising and opt-out."
                    ],
                    "effects": [
                        "Restricts advertising based on user's choice."
                    ]
                }
            ]
        },
        {
            "API_name": "setLgpdConsent",
            "class_name": "InneractiveAdManager",
            "conditions": [],
            "effects": [
                "Sets the LGPD consent value based on user's consent status."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates consent was given under LGPD."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates no consent was given under LGPD."
                    ]
                }
            ]
        },
        {
            "API_name": "currentAudienceAppliesToCoppa",
            "class_name": "InneractiveAdManager",
            "conditions": [
                "COPPA API must be called after successful initialization of the DT SDK."
            ],
            "effects": [
                "Confirms if the target audience of the app applies to COPPA."
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "useSecureConnections",
            "class_name": "InneractiveAdManager",
            "conditions": [],
            "effects": [
                "Configures the SDK to use secure connections (SSL/HTTPS)."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "All outgoing network connections will use secure connections."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Outgoing network connections may not use secure connections."
                    ]
                }
            ]
        }
    ]
}