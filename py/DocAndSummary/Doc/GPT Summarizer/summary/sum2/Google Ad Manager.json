{
    "SDK": "Google Ad Manager",
    "privacy_APIs": [
        {
            "API_name": "putPublisherFirstPartyIdEnabled",
            "class_name": "MobileAds",
            "conditions": [
                "requires Google Mobile Ads SDK 21.4.0 or higher"
            ],
            "effects": [
                "enables or disables the Publisher first-party ID feature for relevant and personalized ads"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "disables the use of Publisher first-party ID"
                    ]
                }
            ]
        },
        {
            "API_name": "AdManagerAdRequest",
            "class_name": "AdManagerAdRequest.Builder",
            "conditions": [
                "to enable restricted data processing (RDP) through extras parameter"
            ],
            "effects": [
                "restricts how certain unique identifiers and other data are used, resulting in non-personalized ads"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        {
                            "rdp": 1
                        }
                    ],
                    "conditions": [],
                    "effects": [
                        "notifies Google to enable RDP for the ad request"
                    ]
                },
                {
                    "parameter_values": [
                        {
                            "IABUSPrivacy_String": "IAB_STRING"
                        }
                    ],
                    "conditions": [],
                    "effects": [
                        "notifies Google to enable RDP using IAB signal for the ad request"
                    ]
                }
            ]
        }
    ]
}