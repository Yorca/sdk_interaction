{
    "SDK": "Ironsource",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "class_name": "IronSource",
            "conditions": [
                "User must provide consent before using the API"
            ],
            "effects": [
                "Sets the consent status for GDPR compliance"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user provided consent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user did not provide consent"
                    ]
                }
            ]
        },
        {
            "API_name": "setMetaData",
            "class_name": "IronSource",
            "conditions": [
                "API must be called before initializing the SDK"
            ],
            "effects": [
                "Sets privacy-related metadata for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "do_not_sell",
                        "true"
                    ],
                    "conditions": [
                        "User has opted out of sale or sharing of personal information"
                    ],
                    "effects": [
                        "Restricts the sale or sharing of user's personal information"
                    ]
                },
                {
                    "parameter_values": [
                        "do_not_sell",
                        "false"
                    ],
                    "conditions": [
                        "User has not opted out of sale or sharing of personal information"
                    ],
                    "effects": [
                        "Allows the sale or sharing of user's personal information"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "true"
                    ],
                    "conditions": [
                        "End-user is a child as defined by applicable regulations"
                    ],
                    "effects": [
                        "Flags the end-user as a child for compliance"
                    ]
                },
                {
                    "parameter_values": [
                        "is_child_directed",
                        "false"
                    ],
                    "conditions": [
                        "End-user is not a child"
                    ],
                    "effects": [
                        "Flags the end-user as not a child"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "true"
                    ],
                    "conditions": [
                        "Required for configurations directed at children"
                    ],
                    "effects": [
                        "Prevents access to the Android Advertising ID"
                    ]
                },
                {
                    "parameter_values": [
                        "is_deviceid_optout",
                        "false"
                    ],
                    "conditions": [
                        "Not directed at children"
                    ],
                    "effects": [
                        "Permits access to the Android Advertising ID"
                    ]
                }
            ]
        }
    ]
}