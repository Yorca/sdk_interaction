            "API_name": "setAppOptOut",
            "class_name": "GoogleAnalytics",
            "conditions": [
                "The application-level opt out flag should be set when initialization code is executed."
            ],
            "effects": [
                "No hits will be sent to Google Analytics."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Enforces application-level opt out."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Resets the application-level opt out."
                    ]
                }
            ]
        },
        {
            "API_name": "getAppOptOut",
            "class_name": "GoogleAnalytics",
            "conditions": [],
            "effects": [
