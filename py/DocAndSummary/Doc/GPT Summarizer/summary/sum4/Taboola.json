{
    "SDK": "Taboola",
    "privacy_APIs": [
        {
            "API_name": "Passing CCPA status",
            "class_name": "",
            "conditions": [
                "CCPA applies",
                "SDK version 2.4.0 or above"
            ],
            "effects": [
                "Provides a way to forward the CCPA 'Do Not Sell' status to Taboola SDK",
                "Changes the ability of Taboola to use the user's data based on consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "cdns: true"
                    ],
                    "conditions": [
                        "End-user didn't provide agreement to use personal data (Do not sell is true)"
                    ],
                    "effects": [
                        "Taboola cannot sell or use user's personal data"
                    ]
                },
                {
                    "parameter_values": [
                        "cdns: false"
                    ],
                    "conditions": [
                        "End-user provided agreement to use personal data (Do not sell is false)"
                    ],
                    "effects": [
                        "Taboola can sell or use user's personal data"
                    ]
                },
                {
                    "parameter_values": [
                        "cdns: none"
                    ],
                    "conditions": [],
                    "effects": [
                        "The default status where CCPA does not apply, allowing Taboola to use user's data"
                    ]
                }
            ]
        },
        {
            "API_name": "Passing consent status",
            "class_name": "",
            "conditions": [
                "User is a GDPR subject",
                "SDK version 2.x or above"
            ],
            "effects": [
                "Allows Taboola to serve personalized recommendations based on user consent",
                "If no valid consent signal is received, only contextual recommendations will be served"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "cex: true"
                    ],
                    "conditions": [
                        "User provided consent"
                    ],
                    "effects": [
                        "Taboola can use user's personal data for personalized recommendations"
                    ]
                },
                {
                    "parameter_values": [
                        "cex: false"
                    ],
                    "conditions": [
                        "User did not provide consent"
                    ],
                    "effects": [
                        "Taboola cannot use user's personal data"
                    ]
                }
            ]
        }
    ]
}