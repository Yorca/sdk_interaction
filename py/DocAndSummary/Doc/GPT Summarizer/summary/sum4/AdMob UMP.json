{
    "SDK": "AdMob UMP",
    "privacy_APIs": [
        {
            "API_name": "getConsentInformation",
            "class_name": "UserMessagingPlatform",
            "conditions": [
                "required to comply with GDPR and obtain user consent"
            ],
            "effects": [
                "retrieves the consent information for the user"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentInformation",
            "conditions": [
                "must be called to request user consent information update"
            ],
            "effects": [
                "triggers an update to the consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "params",
                        "OnConsentInfoUpdateSuccessListener",
                        "OnConsentInfoUpdateFailureListener"
                    ],
                    "conditions": [
                        "parameters must contain valid context and consent request parameters"
                    ],
                    "effects": [
                        "successful update of consent information or triggers failure listener on error"
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForUnderAgeOfConsent",
            "class_name": "ConsentRequestParameters.Builder",
            "conditions": [
                "must be set when indicating that a user is under the age of consent"
            ],
            "effects": [
                "prevents the user from being prompted for consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "used for mixed audience apps to not request consent from child users"
                    ],
                    "effects": [
                        "ensures no consent request is made"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "used when the user is 18 years or older to request consent"
                    ],
                    "effects": [
                        "triggers the consent request dialog"
                    ]
                }
            ]
        },
        {
            "API_name": "showPrivacyOptionsForm",
            "class_name": "UserMessagingPlatform",
            "conditions": [
                "invoked to allow users to modify their consent choices"
            ],
            "effects": [
                "displays the consent options to the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "OnConsentFormDismissedListener"
                    ],
                    "conditions": [
                        "must provide a valid dismissal listener"
                    ],
                    "effects": [
                        "shown to users to modify consent choices"
                    ]
                }
            ]
        }
    ]
}