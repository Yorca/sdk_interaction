            ],
            "effects": [
                "Updates the user's consent status successfully or fails to do so"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [],
                    "effects": [
                        "User's consent status successfully updated"
                    ]
                }
            ]
        },
        {
            "API_name": "loadAndShowConsentFormIfRequired",
            "class_name": "ConsentManager",
