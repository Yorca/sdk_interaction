{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "class_name": "Appodeal",
            "conditions": [
                "Should be called before the SDK initialization",
                "If your app is designed for kids"
            ],
            "effects": [
                "Indicates whether to treat content as child-directed for purposes of COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User data will not be sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User data may be sent to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "Uses the COPPA parameter from the application's settings on Appodeal"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentManager",
            "conditions": [
                "Required parameters: YOUR_APP_KEY must be provided",
