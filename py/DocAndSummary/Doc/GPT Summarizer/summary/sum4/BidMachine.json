{
    "SDK": "BidMachine",
    "privacy_APIs": [
        {
            "API_name": "setCoppa",
            "class_name": "BidMachine",
            "conditions": [
                "To help ensure compliance with COPPA you must indicate whether a user falls within an age-restricted category."
            ],
            "effects": [
                "Indicates whether the SDK should comply with COPPA regulations."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The SDK will treat the user as a child under COPPA regulations."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The SDK will not treat the user as a child under COPPA regulations."
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "BidMachine",
            "conditions": [
                "The Publisher needs to send a boolean flag indicating if GDPR applies to the current user."
            ],
            "effects": [
                "Indicates whether the SDK needs to comply with GDPR regulations."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The SDK will enforce GDPR compliance for the user."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The SDK will not enforce GDPR compliance for the user."
                    ]
                }
            ]
        },
        {
            "API_name": "setConsentConfig",
            "class_name": "BidMachine",
            "conditions": [],
            "effects": [
                "Configures user consent for GDPR compliance."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "<GDPR CONSENT STRING>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the consent string to indicate user consent according to GDPR."
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "<GDPR CONSENT STRING>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the consent string without user consent."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "class_name": "BidMachine",
            "conditions": [
                "To pass CCPA U.S. Privacy String to BidMachine."
            ],
            "effects": [
                "Sets the user's privacy consent status according to CCPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<CCPA U.S. PRIVACY STRING>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the CCPA U.S. Privacy String for compliance."
                    ]
                }
            ]
        },
        {
            "API_name": "setGPP",
            "class_name": "BidMachine",
            "conditions": [
                "To pass GPP information to BidMachine."
            ],
            "effects": [
                "Sets the Global Privacy Platform information for compliance."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "<GPP STRING>",
                        "<GPP IDs>"
                    ],
                    "conditions": [],
                    "effects": [
                        "Sets the GPP string and IDs for compliance."
                    ]
                }
            ]
        }
    ]
}