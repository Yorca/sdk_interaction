{
    "SDK": "Vungle",
    "privacy_APIs": [
        {
            "API_name": "setGDPRStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "User consent is collected using the publisher's mechanism or Vungle's consent dialog must be used for European users."
            ],
            "effects": [
                "Sets the user's GDPR consent status to opted in or opted out."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "1.0.0"
                    ],
                    "conditions": [],
                    "effects": [
                        "User is considered opted in for GDPR."
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "1.0.0"
                    ],
                    "conditions": [],
                    "effects": [
                        "User is considered opted out for GDPR."
                    ]
                }
            ]
        },
        {
            "API_name": "setCOPPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Used to indicate that a user is under or over age 13 in compliance with COPPA regulations."
            ],
            "effects": [
                "Provides Vungle with the user's COPPA status to ensure proper compliance with COPPA for targeted ads."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user is under age 13 and thus protected under COPPA."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user is over age 13 and not protected under COPPA."
                    ]
                }
            ]
        },
        {
            "API_name": "setCCPAStatus",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must have been updated to Android SDK 6.7.0 or higher to comply with CCPA."
            ],
            "effects": [
                "Sets the user's CCPA consent status to opted in or opted out."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User status set to opted in for CCPA."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User status set to opted out for CCPA."
                    ]
                }
            ]
        },
        {
            "API_name": "setPublishAndroidId",
            "class_name": "VunglePrivacySettings",
            "conditions": [
                "Must be called prior to initializing the SDK."
            ],
            "effects": [
                "Determines whether the SDK will collect the Android ID."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Opt in for Android ID collection."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Opt out for Android ID collection."
                    ]
                }
            ]
        }
    ]
