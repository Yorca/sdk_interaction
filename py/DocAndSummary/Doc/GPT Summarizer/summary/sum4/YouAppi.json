{
    "SDK": "YouAppi",
    "privacy_APIs": [
        {
            "API_name": "init",
            "class_name": "YouAPPi",
            "conditions": [
                "USER_CONSENT must be determined by the app developer according to the User's response to a Consent Request.",
                "DOES_GDPR_APPLY must be set according to the user's residency status"
            ],
            "effects": [
                "Initializes YouAppi SDK with user consent and compliance with GDPR."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        true,
                        false
                    ],
                    "conditions": [
                        "User is not subject to GDPR."
                    ],
                    "effects": [
                        "Allows processing of personal information."
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        false,
                        true
                    ],
                    "conditions": [
                        "User is subject to GDPR."
                    ],
                    "effects": [
                        "May not respond to ad requests as user cannot be detected."
                    ]
                }
            ]
        },
        {
            "API_name": "setUserConsent",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets the user consent value for tracking and ad serving."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user consented to data processing."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user did not consent to data processing."
                    ]
                }
            ]
        },
        {
            "API_name": "setgdpr",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets whether GDPR regulations apply."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates a non-EU user, may process personal data."
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates an EU user, must comply with GDPR."
                    ]
                }
            ]
        },
        {
            "API_name": "setAgeRestrictedUser",
            "class_name": "YouAPPi",
            "conditions": [
                "User is known to be in an age-restricted class."
            ],
            "effects": [
                "Marks the user as age-restricted for ad targeting."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is under the age of 16 or under the age of 13 based on jurisdiction."
                    ],
                    "effects": [
                        "Prevents ads targeted to children based on legal requirements."
                    ]
                }
            ]
        }
    ]
}