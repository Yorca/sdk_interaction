{
    "SDK": "Tapjoy",
    "privacy_APIs": [
        {
            "API_name": "setUserConsent",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "The application must make its own determination as to whether GDPR is applicable to the user."
            ],
            "effects": [
                "Sets the user consent status for data processing."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [
                        "User consents to data processing."
                    ],
                    "effects": [
                        "Allows for the use of personal data for processing."
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [
                        "User does not consent to data processing."
                    ],
                    "effects": [
                        "Restricts the use of personal data for processing."
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "class_name": "TJPrivacyPolicy",
            "conditions": [
                "The application must determine whether GDPR rules are applicable to the user."
            ],
            "effects": [
                "Indicates whether user data processing is subject to GDPR compliance."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [
                        "User is determined to be subject to GDPR."
                    ],
                    "effects": [
                        "Enforces GDPR compliance for the user's data."
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [
                        "User is determined not to be subject to GDPR."
                    ],
                    "effects": [
                        "No GDPR compliance enforcement required."
                    ]
                }
            ]
        },
        {
            "API_name": "setBelowConsentAge",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Informs Tapjoy about the user's age with respect to legal compliance."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TJStatus.TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Informs Tapjoy that this user is below the consent age for data processing."
                    ]
                },
                {
                    "parameter_values": [
                        "TJStatus.FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Informs Tapjoy that this user is above the consent age for data processing."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacy",
            "class_name": "TJPrivacyPolicy",
            "conditions": [],
            "effects": [
                "Sets the US Privacy flag for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YYY"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates the user's privacy preferences in accordance with IAB's US Privacy String Format."
                    ]
                }
            ]
        },
        {
            "API_name": "optOutAdvertisingID",
            "class_name": "Tapjoy",
            "conditions": [
                "User has elected to opt-out of allowing the app to access their advertising ID."
            ],
            "effects": [
                "Prevents the SDK from using the advertising ID for targeted advertising."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User chooses to opt-out."
                    ],
                    "effects": [
                        "Disables the collection of the advertising ID."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User does not opt-out."
                    ],
                    "effects": [
                        "Enables the collection of the advertising ID."
                    ]
                }
            ]
        }
    ]
}