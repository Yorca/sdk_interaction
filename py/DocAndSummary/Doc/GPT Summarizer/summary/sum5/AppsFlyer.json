{
    "SDK": "AppsFlyer",
    "privacy_APIs": [
        {
            "API_name": "anonymizeUser",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Anonymizes a user's installs, events, and sessions."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "All identifiers, including IP address, are deleted or hashed."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "No anonymization of user data."
                    ]
                }
            ]
        },
        {
            "API_name": "setConsentData",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Transfers consent data to the SDK."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "AppsFlyerConsent object"
                    ],
                    "conditions": [
                        "User has provided consent."
                    ],
                    "effects": [
                        "Consent data is sent with every event logged by the SDK."
                    ]
                }
            ]
        },
        {
            "API_name": "enableTCFDataCollection",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Enables the collection of Transparency and Consent Framework (TCF) data."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK collects TCF data from SharedPreferences."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "TCF data collection is disabled."
                    ]
                }
            ]
        },
        {
            "API_name": "setDisableAdvertisingIdentifiers",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Disables collection of various Advertising IDs."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Prevents the SDK from collecting Google Advertising ID (GAID), OAID, and Amazon Advertising ID (AAID)."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The SDK will collect advertising identifiers."
                    ]
                }
            ]
        },
        {
            "API_name": "setSharingFilterForPartners",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Prevents sharing install and in-app event information with specified partners."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "String... partners"
                    ],
                    "conditions": [
                        "This method must be called before the SDK is started."
                    ],
                    "effects": [
                        "Specified partners will not receive data through APIs or raw data reports."
                    ]
                }
            ]
        },
        {
            "API_name": "start",
            "class_name": "AppsFlyerLib",
            "conditions": [],
            "effects": [
                "Starts the AppsFlyer SDK."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "Context context",
                        "String key",
                        "AppsFlyerRequestListener listener"
                    ],
                    "conditions": [
                        "Consent may be required before calling this method."
                    ],
                    "effects": [
                        "Opt-in user consent is necessary to send data."
                    ]
                }
            ]
        }
    ]
}