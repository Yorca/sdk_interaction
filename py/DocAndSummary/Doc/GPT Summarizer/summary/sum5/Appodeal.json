{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "class_name": "Appodeal",
            "conditions": [
                "should be called before the SDK initialization"
            ],
            "effects": [
                "indicates whether content is treated as child-directed for purposes of COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "app is designed for kids"
                    ],
                    "effects": [
                        "disables sending user data to ad networks for a child-directed app"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "indicates that the app is not directed towards children, allowing data collection"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "uses the COPPA parameter from the application's settings"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentManager",
            "conditions": [
                "recommended to call at application launch"
            ],
            "effects": [
                "updates the consent status of the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity",
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [
                        "requires valid Appodeal app key"
                    ],
                    "effects": [
                        "updates consent status for the user associated with the provided key"
                    ]
                }
            ]
        },
        {
            "API_name": "loadAndShowConsentFormIfRequired",
            "class_name": "ConsentManager",
            "conditions": [
                "should be called when consent form is required"
            ],
            "effects": [
                "loads and displays the consent form to the user if necessary"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity"
                    ],
                    "conditions": [],
                    "effects": [
                        "shows the consent form if it was loaded successfully"
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "class_name": "ConsentManager",
            "conditions": [
                "requires the context in which consent is revoked"
            ],
            "effects": [
                "resets the consent status to unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity"
                    ],
                    "conditions": [],
                    "effects": [
                        "state of consent switches to unknown after revocation"
                    ]
                }
            ]
        }
    ]
}