{
    "SDK": "Visual Studio App Center",
    "privacy_APIs": [
        {
            "API_name": "setUserId",
            "class_name": "AppCenter",
            "conditions": [
                "Must be called after AppCenter has been started"
            ],
            "effects": [
                "Augments crash reports with the user ID"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "your-user-id"
                    ],
                    "conditions": [],
                    "effects": [
                        "Search for specific crash reports associated with the provided user ID"
                    ]
                }
            ]
        },
        {
            "API_name": "setEnabled",
            "class_name": "AppCenter",
            "conditions": [
                "Must be called after AppCenter has been started"
            ],
            "effects": [
                "Enables or disables all App Center services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK won't forward any information to App Center"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables all App Center services again"
                    ]
                }
            ]
        },
        {
            "API_name": "setNetworkRequestsAllowed",
            "class_name": "AppCenter",
            "conditions": [],
            "effects": [
                "Disallows automatic sending of data collected by the App Center SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Continues to collect data but sends it only when network requests are allowed"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Allows the App Center SDK to send data automatically"
                    ]
                }
            ]
        },
        {
            "API_name": "trackError",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Tracks exceptions and sends them to App Center"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "exception"
                    ],
                    "conditions": [],
                    "effects": [
                        "Reports the handled exception to App Center for diagnostics"
                    ]
                },
                {
                    "parameter_values": [
                        "exception",
                        "properties"
                    ],
                    "conditions": [],
                    "effects": [
                        "Reports the handled exception along with additional context properties"
                    ]
                },
                {
                    "parameter_values": [
                        "exception",
                        "null",
                        "attachments"
                    ],
                    "conditions": [],
                    "effects": [
                        "Reports the handled exception with attachments (binary or text)"
                    ]
                }
            ]
        },
        {
            "API_name": "shouldAwaitUserConfirmation",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Decides if user confirmation is needed before sending crash reports"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "The app must obtain user consent before sending any crash reports"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "No user confirmation is required, crash reports will be sent automatically"
                    ]
                }
            ]
        },
        {
            "API_name": "getErrorAttachments",
            "class_name": "Crashes",
            "conditions": [],
            "effects": [
                "Allows attaching files to a crash report before sending it"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "report"
                    ],
                    "conditions": [],
                    "effects": [
                        "Returns attachments for the given crash report"
                    ]
                }
            ]
        }
    ]
}