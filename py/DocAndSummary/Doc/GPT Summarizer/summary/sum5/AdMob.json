{
    "SDK": "AdMob",
    "privacy_APIs": [
        {
            "API_name": "putPublisherFirstPartyIdEnabled",
            "class_name": "MobileAds",
            "conditions": [
                "Application uses the Google Mobile Ads SDK version 21.4.0 or higher"
            ],
            "effects": [
                "Enables or disables the collection of Publisher first-party ID for personalized ads"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "If set to false, prevents the ID from being sent for ad personalization"
                    ],
                    "effects": [
                        "Disables the use of Publisher first-party ID, thereby affecting ad personalization"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables the use of Publisher first-party ID for personalized ad delivery"
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForChildDirectedTreatment",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "When making ad requests that require handling according to COPPA"
            ],
            "effects": [
                "Configures whether content is treated as child-directed"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables child-directed setting preventing IBA and remarketing ads"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables the child-directed treatment"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_CHILD_DIRECTED_TREATMENT_UNSPECIFIED"
                    ],
                    "conditions": [],
                    "effects": [
                        "Leaves the child-directed setting unspecified in ad requests"
                    ]
                }
            ]
        },
        {
            "API_name": "setTagForUnderAgeOfConsent",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [
                "For users in the European Economic Area (EEA) under the age of consent"
            ],
            "effects": [
                "Specifies treatment for users under the age of consent in EEA, disabling personalized ads"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_TRUE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables treatment for users under the age of consent, disabling personalized advertising"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_FALSE"
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the ad request does not require underage treatment"
                    ]
                },
                {
                    "parameter_values": [
                        "TAG_FOR_UNDER_AGE_OF_CONSENT_UNSPECIFIED"
                    ],
                    "conditions": [],
                    "effects": [
                        "Leaves the underage treatment unspecified in ad requests"
                    ]
                }
            ]
        },
        {
            "API_name": "setMaxAdContentRating",
            "class_name": "RequestConfiguration.Builder",
            "conditions": [],
            "effects": [
                "Sets the maximum content rating for ads shown in the application"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_G"
                    ],
                    "conditions": [],
                    "effects": [
                        "Configures requests to return only ads with a content rating of G or lower"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_PG"
                    ],
                    "conditions": [],
                    "effects": [
                        "Configures requests to return only ads with a content rating of PG or lower"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_T"
                    ],
                    "conditions": [],
                    "effects": [
                        "Configures requests to return only ads with a content rating of T or lower"
                    ]
                },
                {
                    "parameter_values": [
                        "MAX_AD_CONTENT_RATING_MA"
                    ],
                    "conditions": [],
                    "effects": [
                        "Configures requests to return only ads with a content rating of MA or lower"
                    ]
                }
            ]
        },
        {
            "API_name": "setPublisherPrivacyPersonalizationState",
            "class_name": "RequestConfiguration",
            "conditions": [],
            "effects": [
                "Enables or disables ad personalization for all requests"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "PublisherPrivacyPersonalizationState.DISABLED"
                    ],
                    "conditions": [],
                    "effects": [
                        "Turns off personalized ads for subsequent ad requests"
                    ]
                },
                {
                    "parameter_values": [
                        "PublisherPrivacyPersonalizationState.ENABLED"
                    ],
                    "conditions": [],
                    "effects": [
                        "Enables personalized ads for ad requests"
                    ]
                }
            ]
        }
    ]
}