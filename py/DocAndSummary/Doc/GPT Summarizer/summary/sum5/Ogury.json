                "Transmits the user consent to Ogury SDK",
                "Call must be made again if user consent changes"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "iabString",
                        "new Integer[0]"
                    ],
                    "conditions": [
                        "The CMP generates a TCFv2 consent string and is not leveraging the IAB GDPR Consent Framework"
                    ],
                    "effects": [
                        "Consent for vendors registered in the IAB Global Vendor List is transmitted to the Ogury SDK"
                    ]
                },
                {
                    "parameter_values": [
                        "consentBoolean",
                        "consentManagerName"
                    ],
                    "conditions": [
                        "Using a third-party CMP that is not compatible with TCFv2"
                    ],
                    "effects": [
                        "Sets the user consent to Ogury SDK"
                    ]
                }
            ]
        },
