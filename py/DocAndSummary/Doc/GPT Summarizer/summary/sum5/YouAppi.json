{
    "SDK": "YouAppi",
    "privacy_APIs": [
        {
            "API_name": "init",
            "class_name": "YouAPPi",
            "conditions": [
                "Requires USER_CONSENT based on user's response to a dialog asking for permission",
                "DOES_GDPR_APPLY should be set based on whether the user is an EU residence"
            ],
            "effects": [
                "Initializes YouAppi SDK with user consent and compliance with GDPR regulations",
                "Enables the SDK to access user private information, such as Advertising ID and IP address"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        true,
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "SDK is initialized successfully and prepared to load ads"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        false,
                        true
                    ],
                    "conditions": [
                        "User does not provide consent"
                    ],
                    "effects": [
                        "The SDK may not respond to ad requests as user actions cannot be attributed"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserConsent",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets the user consent status for data processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User consent is granted for data processing"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User consent is denied for data processing"
                    ]
                }
            ]
        },
        {
            "API_name": "setgdpr",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets whether the GDPR rules apply for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "GDPR does not apply; may not restrict ad processing"
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "GDPR applies; requires consent for processing personal data"
                    ]
                }
            ]
        },
        {
            "API_name": "setAgeRestrictedUser",
            "class_name": "YouAPPi",
            "conditions": [
                "User is known to be in an age restricted category such as under 16 or under 13"
            ],
            "effects": [
                "Indicates if the user is in an age-restricted category, which affects ad processing"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "User is treated as age-restricted, affecting ad targeting"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "User is not treated as age-restricted, allowing normal ad targeting"
                    ]
                }
            ]
        }
    ]
}