{
    "SDK": "BidMachine",
    "privacy_APIs": [
        {
            "API_name": "setConsentConfig",
            "conditions": [
                "User consent must be collected prior to requesting ads from the Exchange server for GDPR compliance."
            ],
            "effects": [
                "Configures the GDPR consent string indicating the publisher's compliance with GDPR."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "GDPR_CONSENT_STRING"
                    ],
                    "conditions": [
                        "GDPR regulations apply."
                    ],
                    "effects": [
                        "Indicates that adherence to GDPR is in effect and provides consent string."
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "null"
                    ],
                    "conditions": [
                        "GDPR regulations do not apply."
                    ],
                    "effects": [
                        "Indicates that adherence to GDPR is not applicable."
                    ]
                }
            ]
        },
        {
            "API_name": "setUSPrivacyString",
            "conditions": [
                "CCPA compliance is required when applicable."
            ],
            "effects": [
                "Sets the U.S. Privacy String for compliance with CCPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "CCPA_STRING"
                    ],
                    "conditions": [
                        "User is subject to CCPA regulations."
                    ],
                    "effects": [
                        "Transmits appropriate privacy settings according to CCPA."
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "User is not subject to CCPA."
                    ],
                    "effects": [
                        "No settings are transmitted for CCPA."
                    ]
                }
            ]
        },
        {
            "API_name": "setGPP",
            "conditions": [
                "GPP (Global Privacy Control) requirements may need to be passed."
            ],
            "effects": [
                "Sets GPP string and associated IDs based on user privacy preferences."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "GPP_STRING",
                        [
                            12345
                        ]
                    ],
                    "conditions": [
                        "User has provided GPP preferences."
                    ],
                    "effects": [
                        "Indicates compliance with user's GPP selection."
                    ]
                },
                {
                    "parameter_values": [
                        null,
                        null
                    ],
                    "conditions": [
                        "No GPP preferences set by user."
                    ],
                    "effects": [
                        "Indicates no action needed for GPP."
                    ]
                }
            ]
        },
        {
            "API_name": "setSubjectToGDPR",
            "conditions": [
                "Determines if GDPR regulations must be applied."
            ],
            "effects": [
                "Sets a boolean value indicating whether the app/advertising should comply with GDPR."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is based in a region where GDPR applies."
                    ],
                    "effects": [
                        "Enforces strict adherence to GDPR for all user data handling."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is based in a region where GDPR does not apply."
                    ],
                    "effects": [
                        "No GDPR constraints on data handling."
                    ]
                }
            ]
        },
        {
            "API_name": "setCoppa",
            "conditions": [
                "Age-restricted user parameters must be set for COPPA compliance."
            ],
            "effects": [
                "Flags if the user is a child under the age of 13."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User is under the age of 13."
                    ],
                    "effects": [
                        "Ensures compliance with COPPA regulations."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User is over the age of 13."
                    ],
                    "effects": [
                        "Data handling is not subject to COPPA."
                    ]
                }
            ]
        }
    ]
}