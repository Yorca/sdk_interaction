{
    "SDK": "Segment",
    "privacy_APIs": [
        {
            "API_name": "optOut",
            "class_name": "Analytics",
            "conditions": [
                "User opts to not participate in analytics"
            ],
            "effects": [
                "Disables data collection for analytics and persists the opt-out status across device reboots"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User decides to opt-out of data collection"
                    ],
                    "effects": [
                        "All analytics data collection stops"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User decides to opt back into data collection"
                    ],
                    "effects": [
                        "Data collection resumes"
                    ]
                }
            ]
        },
        {
            "API_name": "anonymizeIP",
            "class_name": "Analytics",
            "conditions": [
                "User wants to prevent IP address tracking"
            ],
            "effects": [
                "Sets the event's context.ip field to '0.0.0.0', preventing the recording of the user's actual IP address"
            ],
            "parameter_configurations": []
        }
    ]
}