{
    "SDK": "YouAppi",
    "privacy_APIs": [
        {
            "API_name": "init",
            "class_name": "YouAPPi",
            "conditions": [
                "USER_CONSENT must be determined by the app developer according to the User\u2019s response to a Consent Request",
                "DOES_GDPR_APPLY must be set based on whether the user is subject to GDPR rules"
            ],
            "effects": [
                "Initializes the YouAppi SDK with the provided app token and user consent",
                "Allows the SDK to process and store the user\u2019s Personal Information if DOES_GDPR_APPLY is true"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        true,
                        false
                    ],
                    "conditions": [
                        "User is not subject to GDPR regulations (e.g., not an EU resident)"
                    ],
                    "effects": [
                        "YouAppi SDK will process the user's Personal Information and respond to ad requests"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        true,
                        true
                    ],
                    "conditions": [
                        "User is subject to GDPR regulations"
                    ],
                    "effects": [
                        "YouAppi SDK will process the user's Personal Information according to GDPR"
                    ]
                },
                {
                    "parameter_values": [
                        "context",
                        "<YOUR_APP_TOKEN>",
                        false,
                        false
                    ],
                    "conditions": [
                        "If user denies consent"
                    ],
                    "effects": [
                        "YouAppi may decide not to respond to the ad request, as the user's actions cannot be attributed"
                    ]
                }
            ]
        },
        {
            "API_name": "setUserConsent",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets the USER_CONSENT value for the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user has provided consent"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user has not provided consent"
                    ]
                }
            ]
        },
        {
            "API_name": "setgdpr",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Sets whether GDPR regulations apply to the user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that GDPR applies, requiring user consent for processing personal information"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that GDPR does not apply, potentially limiting the processing of personal information"
                    ]
                }
            ]
        },
        {
            "API_name": "setAgeRestrictedUser",
            "class_name": "YouAPPi",
            "conditions": [],
            "effects": [
                "Indicates whether the user falls under age restrictions"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Confirms that the user is in an age-restricted category"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Indicates that the user is not restricted by age limits"
                    ]
                }
            ]
        }
    ]
}