{
    "SDK": "Appodeal",
    "privacy_APIs": [
        {
            "API_name": "setChildDirectedTreatment",
            "class_name": "Appodeal",
            "conditions": [
                "Should be called before the SDK initialization"
            ],
            "effects": [
                "Indicates whether the app content is directed towards children for purposes of COPPA"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "When you want your content treated as child-directed for purposes of COPPA"
                    ],
                    "effects": [
                        "Disables sending user data to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "When you don't want your content treated as child-directed for purposes of COPPA"
                    ],
                    "effects": [
                        "Allows sending user data to ad networks"
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [],
                    "effects": [
                        "Uses the COPPA parameter from the application's settings on Appodeal"
                    ]
                }
            ]
        },
        {
            "API_name": "requestConsentInfoUpdate",
            "class_name": "ConsentManager",
            "conditions": [
                "Required parameters include YOUR_APP_KEY, and parameters for consent update request"
            ],
            "effects": [
                "Updates the user's consent status"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity@this",
                        "YOUR_APP_KEY",
                        false,
                        "Appodeal",
                        "Appodeal.getVersion()"
                    ],
                    "conditions": [
                        "When calling the method to update consent"
                    ],
                    "effects": [
                        "User's consent status is updated successfully or initializes the SDK with default parameters upon failure"
                    ]
                }
            ]
        },
        {
            "API_name": "load",
            "class_name": "ConsentManager",
            "conditions": [
                "Consent form loading or showing can fail"
            ],
            "effects": [
                "Loads the ConsentForm for user consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity@this",
                        "onConsentFormLoadSuccess",
                        "onConsentFormLoadFailure"
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent form is ready to be presented to users if loaded successfully"
                    ]
                }
            ]
        },
        {
            "API_name": "revoke",
            "class_name": "ConsentManager",
            "conditions": [
                "The context in which consent is to be revoked must be specified"
            ],
            "effects": [
                "Resets the consent status to unknown"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "YourActivity@this"
                    ],
                    "conditions": [],
                    "effects": [
                        "Consent status is reset to unknown for the user"
                    ]
                }
            ]
        }
    ]
}