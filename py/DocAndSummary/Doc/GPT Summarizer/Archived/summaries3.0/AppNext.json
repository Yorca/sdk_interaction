{
    "SDK": "AppNext",
    "privacy_APIs": [
        {
            "API_name": "setConsent",
            "class_name": "Appnext",
            "conditions": [
                "Consent status must be checked on each SDK session"
            ],
            "effects": [
                "Updates the consent status for data collection by the Appnext SDK"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "Positive consent is provided by the end-user"
                    ],
                    "effects": [
                        "Appnext SDK can collect personal information"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "Negative consent is provided by the end-user"
                    ],
                    "effects": [
                        "Appnext SDK cannot collect personal information"
                    ]
                }
            ]
        }
    ]
}