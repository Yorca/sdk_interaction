{
    "SDK": "Amplitude",
    "privacy_APIs": [
        {
            "API_name": "setOptOut",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Enabled users to opt-out of tracking, disabling event and property logging for the user."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "All subsequent events for the user will not be tracked."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "Tracking is enabled for the user, and events can be logged."
                    ]
                }
            ]
        },
        {
            "API_name": "setDeviceId",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Sets a custom device ID to be used for user identification."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "UUID.randomUUID().toString()"
                    ],
                    "conditions": [
                        "Ensure the device ID is sufficiently unique."
                    ],
                    "effects": [
                        "The SDK will track events under the new device ID."
                    ]
                }
            ]
        },
        {
            "API_name": "enableCoppaControl",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Disables tracking of certain data to comply with COPPA."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [],
                    "effects": [
                        "Disables ADID, city, IP, and location tracking."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "All tracking capabilities are restored, potentially violating COPPA."
                    ]
                }
            ]
        },
        {
            "API_name": "setTrackingOptions",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Configures which user tracking properties are collected."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "disableCity().disableIpAddress()"
                    ],
                    "conditions": [],
                    "effects": [
                        "Excludes city and IP address from being tracked."
                    ]
                }
            ]
        },
        {
            "API_name": "setUserId",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Sets a custom user ID, linking user actions across devices."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "user@example.com"
                    ],
                    "conditions": [],
                    "effects": [
                        "User will now be identified by the specified user ID."
                    ]
                }
            ]
        },
        {
            "API_name": "setGroup",
            "class_name": "Amplitude",
            "conditions": [],
            "effects": [
                "Groups users based on specified criteria, linking event data to group identifiers."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "orgId",
                        "15"
                    ],
                    "conditions": [],
                    "effects": [
                        "User is now linked to the specified group."
                    ]
                },
                {
                    "parameter_values": [
                        "sport",
                        [
                            "tennis",
                            "soccer"
                        ]
                    ],
                    "conditions": [],
                    "effects": [
                        "User is now part of multiple groups."
                    ]
                }
            ]
        }
    ]
}