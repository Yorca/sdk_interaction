{
    "SDK": "Facebook Audience Network",
    "privacy_APIs": [
        {
            "API_name": "setMixedAudience",
            "class_name": "AdSettings",
            "conditions": [
                "app or service is Mixed Audience without an Age Gate"
            ],
            "effects": [
                "only serves ads to non-United States users of the app through Audience Network services"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "app or service tells Facebook that the setMixedAudience flag is set"
                    ],
                    "effects": [
                        "restricts ad serving to non-US users"
                    ]
                }
            ]
        },
        {
            "API_name": "setAdvertiserTrackingEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "permission is provided from the device"
            ],
            "effects": [
                "allows the tracking of advertiser events"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "device provides permission for tracking"
                    ],
                    "effects": [
                        "enables advertiser tracking"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "device does not allow tracking"
                    ],
                    "effects": [
                        "disables advertiser tracking"
                    ]
                }
            ]
        },
        {
            "API_name": "setAutoLogAppEventsEnabled",
            "class_name": "FBSDKSettings",
            "conditions": [
                "User has provided consent"
            ],
            "effects": [
                "controls automatic logging of app events"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has agreed to allow event logging"
                    ],
                    "effects": [
                        "re-enables automatic event logging"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not provided consent"
                    ],
                    "effects": [
                        "disables automatic event logging"
                    ]
                }
            ]
        },
        {
            "API_name": "setDataProcessingOptions",
            "class_name": "FBSDKSettings",
            "conditions": [
                "to fulfill obligations under state privacy laws"
            ],
            "effects": [
                "limits the use of the user's data if Limited Data Use is enabled"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        0,
                        0
                    ],
                    "conditions": [
                        "enable LDU and have Meta perform geolocation"
                    ],
                    "effects": [
                        "ensures data is processed as per Limited Data Use regulations"
                    ]
                },
                {
                    "parameter_values": [
                        [
                            "LDU"
                        ],
                        1,
                        1000
                    ],
                    "conditions": [
                        "enable LDU and manually specify location for California"
                    ],
                    "effects": [
                        "ensures data from California is processed under Limited Data Use"
                    ]
                }
            ]
        }
    ]
}