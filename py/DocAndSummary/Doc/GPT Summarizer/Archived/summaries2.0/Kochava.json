{
    "SDK": "Kochava",
    "privacy_APIs": [
        {
            "API_name": "setIntelligentConsentGranted",
            "conditions": [
                "User provides consent after the consent prompt",
                "Intelligent Consent Management feature is enabled on the dashboard"
            ],
            "effects": [
                "Allows data collection to proceed",
                "Stops the SDK from blocking data transmission"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User grants consent"
                    ],
                    "effects": [
                        "Data collection is permitted"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User declines or does not respond to consent prompt"
                    ],
                    "effects": [
                        "Data collection is blocked"
                    ]
                }
            ]
        },
        {
            "API_name": "registerPrivacyProfile",
            "conditions": [
                "Set a privacy profile name and list of datapoint keys to restrict"
            ],
            "effects": [
                "Creates a collection of datapoints to restrict from egress for current user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        [
                            "adid",
                            "android_id"
                        ]
                    ],
                    "conditions": [
                        "Profile name and corresponding datapoint keys are provided"
                    ],
                    "effects": [
                        "Prevents specified datapoints from being transmitted"
                    ]
                }
            ]
        },
        {
            "API_name": "setPrivacyProfileEnabled",
            "conditions": [
                "Privacy profile has been registered and needs to be enabled for restriction"
            ],
            "effects": [
                "Activates the restriction on specified datapoints for the current user"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "restrict ids",
                        true
                    ],
                    "conditions": [
                        "A privacy profile named 'restrict ids' is registered"
                    ],
                    "effects": [
                        "Device identifiers will not be transmitted"
                    ]
                }
            ]
        }
    ]
}