                    ],
                    "conditions": [
                        "When GDPR regulations apply"
                    ],
                    "effects": [
                        "Device information will be passed to the ad server"
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "When GDPR regulations do not apply"
                    ],
                    "effects": [
