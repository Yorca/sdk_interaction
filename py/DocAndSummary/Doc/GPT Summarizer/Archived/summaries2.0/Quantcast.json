{
    "SDK": "Quantcast",
    "privacy_APIs": [
        {
            "API_name": "setCollectionEnabled",
            "conditions": [
                "User wants to opt-out of Quantcast Measure"
            ],
            "effects": [
                "Stops transmitting information to or from the user's device and deletes any cached information."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User opts out of Quantcast Measure"
                    ],
                    "effects": [
                        "User's data is no longer collected or transmitted."
                    ]
                },
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User does not opt-out of Quantcast Measure"
                    ],
                    "effects": [
                        "Quantcast continues to collect and transmit user data."
                    ]
                }
            ]
        },
        {
            "API_name": "showAboutQuantcastScreen",
            "conditions": [
                "User wants to access the About Quantcast screen."
            ],
            "effects": [
                "Displays information about Quantcast Measure and its data usage."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "activity"
                    ],
                    "conditions": [
                        "User taps the button to learn more about Quantcast."
                    ],
                    "effects": [
                        "Shows the About Quantcast screen."
                    ]
                }
            ]
        },
        {
            "API_name": "showQuantcastPrivacyPolicy",
            "conditions": [
                "User wants to view Quantcast's privacy policy."
            ],
            "effects": [
                "Displays the privacy policy of Quantcast."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "activity"
                    ],
                    "conditions": [
                        "User opts to view privacy policy."
                    ],
                    "effects": [
                        "Shows Quantcast's privacy policy."
                    ]
                }
            ]
        }
    ]
}