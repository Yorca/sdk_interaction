{
    "SDK": "TopOn",
    "privacy_APIs": [
        {
            "API_name": "setGDPRUploadDataLevel",
            "conditions": [
                "GDPR compliance required for users in the EU"
            ],
            "effects": [
                "Sets the GDPR data reporting level for the SDK, which can affect advertising data collection."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "ATSDK.PERSONALIZED"
                    ],
                    "conditions": [
                        "User has consented to personalized data usage"
                    ],
                    "effects": [
                        "Allows collection of device data for advertising purposes"
                    ]
                },
                {
                    "parameter_values": [
                        "ATSDK.NONPERSONALIZED"
                    ],
                    "conditions": [
                        "User has not consented to personalized data usage"
                    ],
                    "effects": [
                        "Disallows collection of any personal device data"
                    ]
                },
                {
                    "parameter_values": [
                        "ATSDK.UNKNOWN"
                    ],
                    "conditions": [
                        "GDPR level has not been set"
                    ],
                    "effects": [
                        "The system retains default settings until the user makes a choice"
                    ]
                }
            ]
        },
        {
            "API_name": "showGdprAuth",
            "conditions": [
                "Must be called if the user is determined to be in the EU and has not previously set GDPR level."
            ],
            "effects": [
                "Displays a consent dialog to the user for GDPR data usage, allowing them to select their preferences."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "context"
                    ],
                    "conditions": [
                        "Called during app initialization for users in the EU"
                    ],
                    "effects": [
                        "Prompts user for consent and sets data reporting level based on user input"
                    ]
                }
            ]
        },
        {
            "API_name": "deniedUploadDeviceInfo",
            "conditions": [
                "Call before initializing the SDK to restrict data reporting."
            ],
            "effects": [
                "Limits the collection of specific device data."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "DeviceDataInfo.DEVICE_SCREEN_SIZE",
                        "DeviceDataInfo.ANDROID_ID",
                        "DeviceDataInfo.APP_PACKAGE_NAME",
                        "DeviceDataInfo.APP_VERSION_CODE",
                        "DeviceDataInfo.APP_VERSION_NAME",
                        "DeviceDataInfo.BRAND",
                        "DeviceDataInfo.GAID",
                        "DeviceDataInfo.LANGUAGE",
                        "DeviceDataInfo.MCC",
                        "DeviceDataInfo.MNC",
                        "DeviceDataInfo.MODEL",
                        "DeviceDataInfo.ORIENTATION",
                        "DeviceDataInfo.OS_VERSION_CODE",
                        "DeviceDataInfo.OS_VERSION_NAME",
                        "DeviceDataInfo.TIMEZONE",
                        "DeviceDataInfo.USER_AGENT",
                        "DeviceDataInfo.NETWORK_TYPE",
                        "DeviceDataInfo.INSTALLER",
                        "ChinaDeviceDataInfo.MAC",
                        "ChinaDeviceDataInfo.IMEI",
                        "ChinaDeviceDataInfo.OAID",
                        "ChinaDeviceDataInfo.SSID",
                        "ChinaDeviceDataInfo.IMSI"
                    ],
                    "conditions": [
                        "Developer wants to limit data reporting"
                    ],
                    "effects": [
                        "Prevents the SDK from reporting specified device information, which may affect functionality"
                    ]
                }
            ]
        }
    ]
}