{
    "SDK": "Tenjin",
    "privacy_APIs": [
        {
            "API_name": "optIn",
            "conditions": [
                "User has given consent"
            ],
            "effects": [
                "Allows tracking and sends API requests to Tenjin after user opts in"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOut",
            "conditions": [
                "User has not given consent"
            ],
            "effects": [
                "Stops sending API requests to Tenjin and does not process events"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "checkOptInValue",
            "conditions": [
                "Must be implemented to verify if the user opted in or out"
            ],
            "effects": [
                "Returns true if the user opted in, false otherwise"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optInParams",
            "conditions": [
                "Must specify device-related parameters to include"
            ],
            "effects": [
                "Sends only specified device-related parameters"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "ip_address",
                            "advertising_id",
                            "limit_ad_tracking",
                            "referrer"
                        ]
                    ],
                    "conditions": [
                        "The SDK has been initialized and consent is obtained"
                    ],
                    "effects": [
                        "Will send only the specified parameters to Tenjin"
                    ]
                }
            ]
        },
        {
            "API_name": "optOutParams",
            "conditions": [
                "Must specify device-related parameters to exclude"
            ],
            "effects": [
                "Sends all device-related parameters except the specified ones"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            "locale",
                            "timezone",
                            "build_id"
                        ]
                    ],
                    "conditions": [
                        "The SDK has been initialized"
                    ],
                    "effects": [
                        "Will send all parameters except those specified"
                    ]
                }
            ]
        },
        {
            "API_name": "setGoogleDMAParameters",
            "conditions": [
                "If there is a CMP integrated"
            ],
            "effects": [
                "Manages the collection of Google DMA parameters"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        [
                            true,
                            false
                        ]
                    ],
                    "conditions": [
                        "The user wants to opt in or out of Google DMA parameters"
                    ],
                    "effects": [
                        "Will choose to enable or disable Google DMA parameters collection"
                    ]
                }
            ]
        },
        {
            "API_name": "optInGoogleDMA",
            "conditions": [],
            "effects": [
                "Enables the collection of Google DMA parameters"
            ],
            "parameter_configurations": []
        },
        {
            "API_name": "optOutGoogleDMA",
            "conditions": [],
            "effects": [
                "Disables the collection of Google DMA parameters"
            ],
            "parameter_configurations": []
        }
    ]
}