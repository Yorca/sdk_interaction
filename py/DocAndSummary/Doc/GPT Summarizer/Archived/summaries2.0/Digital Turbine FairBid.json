{
    "SDK": "Digital Turbine FairBid",
    "privacy_APIs": [
        {
            "API_name": "setGdprConsent",
            "conditions": [
                "User consent must be gathered before initializing the SDK",
                "The user is located in the EU or registered as an EU resident"
            ],
            "effects": [
                "Determines whether personalized ads can be shown to the user based on their consent"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "Personalized ads may be shown to the user"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "Only contextual ads will be shown to that user"
                    ]
                }
            ]
        },
        {
            "API_name": "setIabUsPrivacyString",
            "conditions": [
                "User opt out must be gathered before initializing the SDK",
                "CCPA applies if a California resident uses the app"
            ],
            "effects": [
                "Sets the privacy string to either allow or restrict advertising based on user opt-out preferences"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "1YNN",
                        "context"
                    ],
                    "conditions": [
                        "User does not opt out of advertising"
                    ],
                    "effects": [
                        "User is allowed to receive personalized ads"
                    ]
                },
                {
                    "parameter_values": [
                        "1YYN",
                        "context"
                    ],
                    "conditions": [
                        "User opts out of advertising"
                    ],
                    "effects": [
                        "User will not receive personalized ads and advertising will be restricted"
                    ]
                },
                {
                    "parameter_values": [
                        "1---",
                        "context"
                    ],
                    "conditions": [
                        "CCPA does not apply (user is not a resident of California)"
                    ],
                    "effects": [
                        "No privacy string set or default behavior"
                    ]
                }
            ]
        },
        {
            "API_name": "setLgpdConsent",
            "conditions": [
                "User consent must be gathered before initializing the SDK",
                "The user is located in Brazil or registered as a Brazilian resident"
            ],
            "effects": [
                "Determines whether personalized ads can be shown to the user based on their consent under LGPD"
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true,
                        "context"
                    ],
                    "conditions": [
                        "User has given consent"
                    ],
                    "effects": [
                        "Personalized ads may be shown to the user"
                    ]
                },
                {
                    "parameter_values": [
                        false,
                        "context"
                    ],
                    "conditions": [
                        "User has not given consent"
                    ],
                    "effects": [
                        "Only contextual ads will be shown to that user"
                    ]
                }
            ]
        }
    ]
}