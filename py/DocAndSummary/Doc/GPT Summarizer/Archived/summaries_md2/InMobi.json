                    "conditions": [],
                    "effects": [
                        "The request is treated as child-directed."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [],
                    "effects": [
                        "The request is not treated as child-directed."
                    ]
                }
            ]
        },
        {
