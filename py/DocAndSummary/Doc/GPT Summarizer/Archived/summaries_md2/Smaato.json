{
    "SDK": "Smaato",
    "privacy_APIs": [
        {
            "API_name": "setLgpdConsentEnabled",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher must request LGPD user consent."
            ],
            "effects": [
                "Sets LGPD consent to enable or disable targeted advertising based on user consent."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has given consent."
                    ],
                    "effects": [
                        "Allows the use of personal data for targeted advertising."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has not given consent."
                    ],
                    "effects": [
                        "Runs contextual ads with dropped personally identifiable information (PII)."
                    ]
                },
                {
                    "parameter_values": [
                        null
                    ],
                    "conditions": [
                        "User consent is not explicitly set."
                    ],
                    "effects": [
                        "Publisher only calls Smaato if they have enough legal basis for targeted advertising under LGPD."
                    ]
                }
            ]
        },
        {
            "API_name": "setCmprConsentEnabled",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher must integrate a Consent Management Platform (CMP)."
            ],
            "effects": [
                "Stores and retrieves user consent information in SharedPreferences."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        true
                    ],
                    "conditions": [
                        "User has provided consent."
                    ],
                    "effects": [
                        "Allows the SDK to serve ads based on the user's consent preferences."
                    ]
                },
                {
                    "parameter_values": [
                        false
                    ],
                    "conditions": [
                        "User has opted out."
                    ],
                    "effects": [
                        "Only contextual ads will be served without using personal data."
                    ]
                }
            ]
        },
        {
            "API_name": "setUsPrivacyString",
            "class_name": "SmaatoSdk",
            "conditions": [
                "Publisher must ensure compliance with CCPA for California-based users."
            ],
            "effects": [
                "Stores the US Privacy String which directs the ad requests for compliance."
            ],
            "parameter_configurations": [
                {
                    "parameter_values": [
                        "iab string"
                    ],
                    "conditions": [
                        "Privacy string is provided by the publisher."
                    ],
                    "effects": [
                        "SDK uses the provided US Privacy String during ad requests."
                    ]
                }
            ]
        }
    ]
}