 error)</span> {
                <span class=3D"hljs-comment">// There's something wrong dur=
ing ad loading</span>
            }

            <span class=3D"hljs-meta">@Override</span>
            <span class=3D"hljs-keyword">public</span> <span class=3D"hljs-=
keyword">void</span> <span class=3D"hljs-title function_">onAdLoaded</span>=
<span class=3D"hljs-params">(<span class=3D"hljs-meta">@NonNull</span> Nati=
veAd ad)</span> {
                mNativeAd =3D ad;
            }
