DK/android/gettingstarted.html#location"><button type=3D"button" class=3D"b=
tn btn-xl btn-success col-md-12" style=3D"background:#4CAF50">Automatic loc=
ation on Android</button></a>
              </div>
            </div>
            <div class=3D"col-md-6">
              <div class=3D"col-md-11">
                <a href=3D"https://documentation.smartadserver.com/displayS=
DK/ios/gettingstarted.html#location"><button type=3D"button" class=3D"btn b=
tn-xl btn-success col-md-12" style=3D"background:#29B6F6">Automatic locatio=
