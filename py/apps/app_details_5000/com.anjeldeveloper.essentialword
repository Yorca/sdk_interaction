{
    "title": "\u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc 504 \u0648\u0627\u0698\u0647",
    "description": "\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \"504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 1100 \u0648\u0627\u0698\u0647 \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f\" \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u0647 \u062c\u0627\u0645\u0639 \u0648 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0631\u0627\u06cc \u0645\u0647\u0627\u062c\u0631\u062a \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0644\u063a\u0627\u062a \u0645\u0647\u0645 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0647 \u0633\u0627\u062f\u06af\u06cc \u0648 \u0628\u0627 \u0633\u0631\u0639\u062a \u0628\u0627\u0644\u0627 \u06cc\u0627\u062f \u0628\u06af\u06cc\u0631\u06cc\u062f. \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \"504 Essential Words\" \u0648 \"1100 Words You Need to Know\" \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647 \u0648 \u0628\u0627 \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u0639\u0644\u0645\u06cc \u0645\u0627\u0646\u0646\u062f \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 \u0648 \u0641\u0644\u0634 \u06a9\u0627\u0631\u062a\u060c \u0641\u0631\u0622\u06cc\u0646\u062f \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0645\u0647\u0627\u062c\u0631\u062a \u0645\u0648\u062b\u0631\u062a\u0631 \u0648 \u062c\u0630\u0627\u0628\u200c\u062a\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f.\r\n\u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0645\u0627\u0645\u06cc \u06a9\u0644\u0645\u0627\u062a \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0634\u062f\u0647 \u0648 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u062a\u0631\u062c\u0645\u0647 \u0641\u0627\u0631\u0633\u06cc\u060c \u062a\u0644\u0641\u0638 \u0635\u0648\u062a\u06cc \u0628\u0631\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0645\u06a9\u0627\u0644\u0645\u0647 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 \u0645\u062b\u0627\u0644\u200c\u0647\u0627\u06cc \u062a\u0635\u0648\u06cc\u0631\u06cc \u062c\u0647\u062a \u0622\u0645\u0648\u0632\u0634 \u06af\u0631\u0627\u0645\u0631 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0634\u0645\u0627 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u062f\u0647\u062f. \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0631\u0627\u06cc \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc \u0645\u0627\u0646\u0646\u062f IELTS \u0648 TOEFL  \u0622\u0645\u0627\u062f\u0647 \u0634\u0648\u06cc\u062f \u0648 \u062f\u0627\u06cc\u0631\u0647 \u0644\u063a\u0627\u062a \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0633\u0631\u0639\u062a \u06af\u0633\u062a\u0631\u0634 \u062f\u0647\u06cc\u062f.\r\n\u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0627\u0635\u0644\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc:\r\n\u2022\t\u062a\u0644\u0641\u0638 \u0635\u0648\u062a\u06cc \u062f\u0642\u06cc\u0642 \u06a9\u0644\u0645\u0627\u062a:  \u062a\u0645\u0627\u0645\u06cc \u06a9\u0644\u0645\u0627\u062a \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u062a\u0648\u0633\u0637 \u0686\u0646\u062f\u06cc\u0646 \u06af\u0648\u06cc\u0646\u062f\u0647 \u062a\u0644\u0641\u0638 \u0634\u062f\u0647 \u0627\u0646\u062f \u062a\u0627 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0627\u0645\u0644 \u0627\u0646\u062c\u0627\u0645 \u0634\u0648\u062f\r\n\u2022\t\u0622\u0645\u0648\u0632\u0634 \u062a\u0635\u0648\u06cc\u0631\u06cc \u0644\u063a\u0627\u062a \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0645\u062b\u0627\u0644\u200c\u0647\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc: \u0628\u0631\u0627\u06cc \u062a\u0642\u0648\u06cc\u062a \u062d\u0627\u0641\u0638\u0647 \u0628\u0635\u0631\u06cc \u0648 \u0628\u0647 \u062e\u0627\u0637\u0631 \u0633\u067e\u0627\u0631\u06cc \u0644\u063a\u0627\u062a\r\n\u2022\t\u0631\u0648\u0634 \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 \u0648 \u0641\u0644\u0634 \u06a9\u0627\u0631\u062a:  \u0628\u0631\u0627\u06cc \u062a\u06a9\u0631\u0627\u0631 \u0645\u0648\u062b\u0631 \u06a9\u0644\u0645\u0627\u062a \u0622\u06cc\u062a\u0644\u0633 \u0648 \u062a\u0627\u0641\u0644 \u0648 \u062a\u062b\u0628\u06cc\u062a \u0622\u0646\u200c\u0647\u0627 \u062f\u0631 \u062d\u0627\u0641\u0638\u0647 \u0628\u0644\u0646\u062f\u0645\u062f\u062a\r\n\u2022\t\u062a\u0644\u0641\u0638 \u0635\u0648\u062a\u06cc \u0645\u062b\u0627\u0644 \u0647\u0627\u06cc \u06a9\u0644\u0645\u0627\u062a: \u0628\u06cc\u0634 \u0627\u0632 2000 \u0645\u062b\u0627\u0644 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0647 \u0635\u0648\u0631\u062a\u06cc \u0635\u0648\u062a\u06cc\r\n\u2022\t\u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u06a9\u0627\u0645\u0644 \u06a9\u0644\u0645\u0627\u062a \u0648 \u0627\u0635\u0637\u0644\u0627\u062d\u0627\u062a: \u0634\u0627\u0645\u0644 504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0648 1100 \u0648\u0627\u0698\u0647 \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\u060c \u0628\u0647 \u062a\u0641\u06a9\u06cc\u06a9 \u062f\u0631\u0633\u200c\u0647\u0627\r\n\u2022\t\u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627 \u0648 \u062a\u0633\u062a\u200c\u0647\u0627\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0648 \u062c\u0627\u0645\u0639:  \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u062a\u0642\u0648\u06cc\u062a \u0622\u0645\u0627\u062f\u06af\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0622\u06cc\u0644\u062a\u0633 \u0648 \u062a\u0627\u0641\u0644\r\n\u2022\t\u0645\u062d\u06cc\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0633\u0627\u062f\u0647\u060c \u0632\u06cc\u0628\u0627 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc: \u0628\u0647 \u06af\u0648\u0646\u0647\u200c\u0627\u06cc \u06a9\u0647 \u062a\u062c\u0631\u0628\u0647 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0631\u0627 \u0644\u0630\u062a\u200c\u0628\u062e\u0634 \u0648 \u0645\u0648\u062b\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f\r\n\u2022\t\u0646\u0645\u0627\u06cc\u0634 \u0645\u0633\u06cc\u0631 \u067e\u06cc\u0634\u0631\u0641\u062a: \u062c\u0647\u062a \u0627\u06cc\u062c\u0627\u062f \u0627\u0646\u06af\u06cc\u0632\u0647 \u0648 \u062f\u0646\u0628\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0631\u0648\u0646\u062f \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc\r\n\u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0634\u0627\u0645\u0644 42  \u062f\u0631\u0633 \u0627\u0632 \u06a9\u062a\u0627\u0628 504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 46  \u062f\u0631\u0633 \u0627\u0632 \u06a9\u062a\u0627\u0628 1100 \u0648\u0627\u0698\u0647 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647\u200c\u0637\u0648\u0631 \u06a9\u0627\u0645\u0644 \u062a\u0645\u0627\u0645\u06cc \u0644\u063a\u0627\u062a \u0631\u0627 \u0628\u0627 \u062a\u0631\u062c\u0645\u0647 \u0641\u0627\u0631\u0633\u06cc\u060c \u0645\u062b\u0627\u0644 \u0648 \u062a\u0644\u0641\u0638 \u0628\u0631\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0632 \u0635\u0641\u0631 \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0628\u0627 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u060c \u062f\u06cc\u06af\u0631 \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062f\u06cc\u06a9\u0634\u0646\u0631\u06cc\u200c\u0647\u0627\u06cc \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0648 \u06a9\u0644\u0627\u0633 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u0646\u062f\u0627\u0631\u06cc\u062f\u061b \u0686\u0631\u0627 \u06a9\u0647 \u062a\u0645\u0627\u0645\u06cc \u0627\u0635\u0637\u0644\u0627\u062d\u0627\u062a \u0648 \u0644\u063a\u0627\u062a \u0645\u0647\u0645 \u0648 \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0634\u0645\u0627\u0633\u062a \u0648 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u062f\u0631 30 \u0631\u0648\u0632 \u0631\u0627 \u062a\u062c\u0631\u0628\u0647 \u06a9\u0646\u06cc\u062f.\r\n\u0627\u06af\u0631 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u0633\u0631\u06cc\u0639\u200c\u062a\u0631\u06cc\u0646 \u0631\u0648\u0634 \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0631\u0627\u06cc \u0634\u0631\u06a9\u062a \u062f\u0631 \u0622\u0632\u0645\u0648\u0646 \u0647\u0627\u06cc \u062a\u0627\u0641\u0644 \u0648 \u0645\u0627\u06a9 \u0622\u06cc\u0644\u062a\u0633 \u0647\u0633\u062a\u06cc\u062f\u060c \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0631\u0627 \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f \u0648 \u062f\u0631 \u0647\u0631 \u0644\u062d\u0638\u0647 \u0648 \u0645\u06a9\u0627\u0646\u060c \u0628\u0647 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0628\u067e\u0631\u062f\u0627\u0632\u06cc\u062f \u0648 \u062f\u0627\u06cc\u0631\u0647 \u0644\u063a\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u06af\u0633\u062a\u0631\u0634 \u062f\u0647\u06cc\u062f.",
    "descriptionHTML": "\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 &quot;504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 1100 \u0648\u0627\u0698\u0647 \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f&quot; \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u0647 \u062c\u0627\u0645\u0639 \u0648 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0631\u0627\u06cc \u0645\u0647\u0627\u062c\u0631\u062a \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0644\u063a\u0627\u062a \u0645\u0647\u0645 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0647 \u0633\u0627\u062f\u06af\u06cc \u0648 \u0628\u0627 \u0633\u0631\u0639\u062a \u0628\u0627\u0644\u0627 \u06cc\u0627\u062f \u0628\u06af\u06cc\u0631\u06cc\u062f. \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc &quot;504 Essential Words&quot; \u0648 &quot;1100 Words You Need to Know&quot; \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647 \u0648 \u0628\u0627 \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u0639\u0644\u0645\u06cc \u0645\u0627\u0646\u0646\u062f \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 \u0648 \u0641\u0644\u0634 \u06a9\u0627\u0631\u062a\u060c \u0641\u0631\u0622\u06cc\u0646\u062f \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0645\u0647\u0627\u062c\u0631\u062a \u0645\u0648\u062b\u0631\u062a\u0631 \u0648 \u062c\u0630\u0627\u0628\u200c\u062a\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f.<br>\u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0645\u0627\u0645\u06cc \u06a9\u0644\u