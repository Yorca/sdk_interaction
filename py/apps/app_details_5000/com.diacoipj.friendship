{
    "title": "\u0641\u0631\u0646\u062f\u0644\u0646\u062f : \u062c\u0627\u06cc\u06cc \u0628\u0631\u0627\u06cc \u0622\u0634\u0646\u0627\u06cc\u06cc",
    "description": "\u0641\u0631\u0646\u062f\u0644\u0646\u062f \u06cc\u06a9 \u0634\u0628\u06a9\u0647 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0622\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u06af\u067e \u0628\u0632\u0646\u06cc\u062f \u0648 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f. \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0641\u0631\u0646\u062f\u0644\u0646\u062f \u0628\u0633\u06cc\u0627\u0631 \u0645\u062a\u0646\u0648\u0639 \u0648 \u06a9\u0627\u0645\u0644 \u0627\u0633\u062a\u061b \u0627\u0632 \u062f\u0648\u0633\u062a\u200c\u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u06af\u0631\u0641\u062a\u0647 \u062a\u0627 \u06af\u0641\u062a\u06af\u0648\u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0633\u0631\u06af\u0631\u0645\u200c\u06a9\u0646\u0646\u062f\u0647\u060c \u0647\u0645\u0647 \u0628\u0631\u0627\u06cc \u062a\u062c\u0631\u0628\u0647\u200c\u0627\u06cc \u0634\u0627\u062f \u0648 \u0644\u0630\u062a\u200c\u0628\u062e\u0634 \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647\u200c\u0627\u0646\u062f.\r\n\r\n\u062f\u0631 \u0686\u062a \u0631\u0648\u0645\u200c\u0647\u0627\u06cc \u0641\u0631\u0646\u062f\u0644\u0646\u062f\u060c \u0645\u062d\u06cc\u0637\u06cc \u06a9\u0627\u0645\u0644\u0627\u064b \u062f\u0648\u0633\u062a\u0627\u0646\u0647 \u0648 \u0635\u0645\u06cc\u0645\u06cc \u0628\u0631\u0627\u06cc \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u062f\u0627\u0631\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0641\u0631\u0646\u062f\u0644\u0646\u062f \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627 \u0627\u06cc\u0645\u06cc\u0644 \u0646\u06cc\u0633\u062a! \u062a\u0646\u0647\u0627 \u0628\u0627 \u06cc\u06a9 \u062b\u0628\u062a\u200c\u0646\u0627\u0645 \u0633\u0631\u06cc\u0639 \u0648 \u0633\u0627\u062f\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0647 \u0635\u0648\u0631\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0627 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0686\u062a \u0648 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u06a9\u0646\u06cc\u062f.\r\n\r\n\u0641\u0631\u0646\u062f\u0644\u0646\u062f \u062c\u0627\u06cc\u06af\u0627\u0647\u06cc \u0639\u0627\u0644\u06cc \u0628\u0631\u0627\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f\u060c \u0635\u062d\u0628\u062a\u200c\u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0633\u0631\u06af\u0631\u0645 \u0634\u062f\u0646 \u0627\u0633\u062a!",
    "descriptionHTML": "\u0641\u0631\u0646\u062f\u0644\u0646\u062f \u06cc\u06a9 \u0634\u0628\u06a9\u0647 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0622\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u06af\u067e \u0628\u0632\u0646\u06cc\u062f \u0648 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f. \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0641\u0631\u0646\u062f\u0644\u0646\u062f \u0628\u0633\u06cc\u0627\u0631 \u0645\u062a\u0646\u0648\u0639 \u0648 \u06a9\u0627\u0645\u0644 \u0627\u0633\u062a\u061b \u0627\u0632 \u062f\u0648\u0633\u062a\u200c\u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u06af\u0631\u0641\u062a\u0647 \u062a\u0627 \u06af\u0641\u062a\u06af\u0648\u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0633\u0631\u06af\u0631\u0645\u200c\u06a9\u0646\u0646\u062f\u0647\u060c \u0647\u0645\u0647 \u0628\u0631\u0627\u06cc \u062a\u062c\u0631\u0628\u0647\u200c\u0627\u06cc \u0634\u0627\u062f \u0648 \u0644\u0630\u062a\u200c\u0628\u062e\u0634 \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647\u200c\u0627\u0646\u062f.<br><br>\u062f\u0631 \u0686\u062a \u0631\u0648\u0645\u200c\u0647\u0627\u06cc \u0641\u0631\u0646\u062f\u0644\u0646\u062f\u060c \u0645\u062d\u06cc\u0637\u06cc \u06a9\u0627\u0645\u0644\u0627\u064b \u062f\u0648\u0633\u062a\u0627\u0646\u0647 \u0648 \u0635\u0645\u06cc\u0645\u06cc \u0628\u0631\u0627\u06cc \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u062f\u0627\u0631\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0641\u0631\u0646\u062f\u0644\u0646\u062f \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627 \u0627\u06cc\u0645\u06cc\u0644 \u0646\u06cc\u0633\u062a! \u062a\u0646\u0647\u0627 \u0628\u0627 \u06cc\u06a9 \u062b\u0628\u062a\u200c\u0646\u0627\u0645 \u0633\u0631\u06cc\u0639 \u0648 \u0633\u0627\u062f\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0647 \u0635\u0648\u0631\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0627 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0686\u062a \u0648 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u06a9\u0646\u06cc\u062f.<br><br>\u0641\u0631\u0646\u062f\u0644\u0646\u062f \u062c\u0627\u06cc\u06af\u0627\u0647\u06cc \u0639\u0627\u0644\u06cc \u0628\u0631\u0627\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f\u060c \u0635\u062d\u0628\u062a\u200c\u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0633\u0631\u06af\u0631\u0645 \u0634\u062f\u0646 \u0627\u0633\u062a!",
