    "title": "\u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc 504 \u0648\u0627\u0698\u0647",
    "description": "504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u06cc\u06a9 \u06a9\u062a\u0627\u0628 \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0622\u0645\u0648\u0632\u0634 504 Essential Words \u0631\u0648\u0632 \u0628\u0647 \u0631\u0648\u0632 504 Words \u0648 1100 \u0644\u063a\u062a \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0627 \u0645\u0639\u0646\u06cc \u0641\u0627\u0631\u0633\u06cc \u0648 \u062a\u0644\u0641\u0638 \u0635\u0648\u062a\u06cc \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0622\u0645\u0648\u0632\u0634 \u062a\u0635\u0648\u06cc\u0631\u06cc \u0644\u063a\u0627\u062a\u060c \u062a\u0633\u062a \u0644\u063a\u0627\u062a \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0622\u0645\u0627\u062f\u06af\u06cc \u062f\u0631 \u0622\u0632\u0645\u0648\u0646 \u0622\u06cc\u0644\u062a\u0633 \u0648 \u0622\u0632\u0645\u0648\u0646 \u062a\u0627\u0641\u0644 \u0628\u0647 \u062a\u0641\u06a9\u06cc\u06a9 \u0647\u0631 \u062f\u0631\u0633 \u0647\u0645\u06af\u0627\u0645 \u0628\u0627 \u0622\u0645\u0648\u0632\u0634 504 \u0644\u063a\u062a \u0636\u0631\u0648\u0631\u06cc \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0645\u06cc\u06af\u06cc\u0631\u062f. \u0637\u0631\u0627\u062d\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628 504 \u0648\u0627\u0698\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 \u06a9\u062a\u0627\u0628 1100 \u0648\u0627\u0698\u0647 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \" \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \" \u0628\u0631 \u0627\u0633\u0627\u0633 \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 504 Essential Words \u0648 \u0641\u0644\u0634 \u06a9\u0627\u0631\u062a \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0645\u06cc\u200c\u0628\u0627\u0634\u062f. \u0628\u0647 \u06af\u0648\u0646\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0631\u0648\u0646\u062f \u0622\u0645\u0648\u0632\u0634 \u062a\u0635\u0648\u06cc\u0631\u06cc \u0644\u063a\u0627\u062a \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0648 \u0622\u0632\u0645\u0648\u0646 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0635\u0648\u0631\u062a \u0645\u0648\u0627\u0632\u06cc \u0648 \u0627\u0632 \u0645\u0628\u062a\u062f\u06cc \u062a\u0627 \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0631\u0627 \u062f\u0631 \u0628\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u062f. \u06a9\u062a\u0627\u0628 504 \u0644\u063a\u062a \u0636\u0631\u0648\u0631\u06cc \u0648 \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f \u0648 1100 \u06a9\u0644\u0645\u0647 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\u060c \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0634\u0627\u0645\u0644 \u0627\u0635\u0637\u0644\u0627\u062d\u0627\u062a \u067e\u0631\u06a9\u0627\u0631\u0628\u0631\u062f \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0627 \u062a\u0644\u0641\u0638 \u0648 \u0645\u0639\u0646\u06cc \u0641\u0627\u0631\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0647\u0631 \u0632\u0628\u0627\u0646 \u0622\u0645\u0648\u0632 \u0628\u0647 \u0622\u0646 \u0646\u06cc\u0627\u0632 \u067e\u06cc\u062f\u0627 \u0645\u06cc\u200c\u06a9\u0646\u062f. \" \u0622\u0645\u0648\u0632\u0634 504 \u0648\u0627\u0698\u0647 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \" \u0627\u0632 \u062c\u0645\u0644\u0647 \u0645\u062a\u062f\u0647\u0627\u06cc \u0628\u0631\u062a\u0631 \u0648 \u067e\u0631\u0633\u0631\u0639\u062a \u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u06