{
    "title": "Bricoram \u0633\u0648\u0642 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a",
    "description": "\u062a\u062d\u062a\u0627\u062c \u0635\u0628\u0627\u063a, \u0625\u0635\u0644\u0627\u062d \u062b\u0644\u0627\u062c\u0629, \u0625\u0635\u0644\u0627\u062d \u063a\u0633\u0627\u0644\u0629, \u0628\u0646\u0627\u0621, \u0628\u0644\u0648\u0645\u0628\u064a, \u0646\u0642\u0644 \u0633\u0644\u0639, \u062a\u0631\u062d\u064a\u0644 \u064a\u0646\u0629 \u0645\u0646\u0632\u0644\u064a\u0629, \u0645\u0631\u0628\u064a\u0629 \u0623\u0637\u0641\u0627\u0644, \u062a\u0645\u0631\u064a\u0636 \u0641\u064a \u0627\u0644\u0645\u0646\u0632\u0644 \u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062a\u0633\u0639\u064a\u0646 \u0635\u0646\u0641 \u0623\u062e\u0631 \u0627\u0644 \u062e\u062f\u0645\u0627\u062a\r\n\u0643\u0644 \u0647\u0630\u0627 \u062f\u0627\u062e\u0644 \u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u062d\u062f \u064a\u0645\u062b\u0644 \u0623\u0648\u0644 \u0633\u0648\u0642 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631\r\n\r\n:\u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\r\n\u0646\u0634\u0631 \u0637\u0644\u0628 \u0628\u0636\u063a\u0637\u0629 \u0632\u0631 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062e\u0645\u0633\u0629 \u062f\u0642\u0627\u0626\u0642 -\r\n\u062a\u0635\u0641\u062d \u0628\u0634\u0641\u0627\u0641\u064a\u0629 \u062a\u0627\u0645\u0629 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648 \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0632\u0628\u0627\u0626\u0646 \u0644\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 -\r\n\u062a\u0633\u0639\u064a\u0646 \u0635\u0646\u0641 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u062d\u062f -\r\n\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0633\u0631\u064a\u0639\u0629 \u0648 \u0645\u062d\u0627\u062f\u062b\u0629 \u0641\u0648\u0631\u064a\u0629 \u0645\u0639 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 -\r\n\u0645\u0642\u0627\u0631\u0646\u0629 \u0639\u0631\u0648\u0636 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 -\r\n\u0633\u0648\u0642 \u0630\u0648 \u0633\u064a\u0648\u0644\u0629 \u0639\u0627\u0644\u064a\u0629 \u0648 \u062a\u0641\u0627\u0639\u0644 \u0648\u0627\u0633\u0639 \u0648 \u0645\u0633\u062a\u0645\u0631 -\r\n\r\nhttps://bricoram.com/ \u0645\u062a\u0648\u0641\u0631 \u0623\u064a\u0636\u0627 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0645\u0648\u0642\u0639 \u0648\u064a\u0628\r\n:\u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u062a\u0646\u0627 \u0639\u0644\u0649 \u0645\u062e\u062a\u0644\u0641 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\r\n https://www.facebook.com/bricoram :\u0641\u064a\u0633\u0628\u0648\u0643\r\nhttps://www.instagram.com/bricoram/ :\u0627\u0646\u0633\u062a\u063a\u0631\u0627\u0645\r\nhttps://www.linkedin.com/company/bricoram/ :\u0644\u064a\u0646\u0643\u062f\u0646",
    "descriptionHTML": "\u062a\u062d\u062a\u0627\u062c \u0635\u0628\u0627\u063a, \u0625\u0635\u0644\u0627\u062d \u062b\u0644\u0627\u062c\u0629, \u0625\u0635\u0644\u0627\u062d \u063a\u0633\u0627\u0644\u0629, \u0628\u0646\u0627\u0621, \u0628\u0644\u0648\u0645\u0628\u064a, \u0646\u0642\u0644 \u0633\u0644\u0639, \u062a\u0631\u062d\u064a\u0644 \u064a\u0646\u0629 \u0645\u0646\u0632\u0644\u064a\u0629, \u0645\u0631\u0628\u064a\u0629 \u0623\u0637\u0641\u0627\u0644, \u062a\u0645\u0631\u064a\u0636 \u0641\u064a \u0627\u0644\u0645\u0646\u0632\u0644 \u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062a\u0633\u0639\u064a\u0646 \u0635\u0646\u0641 \u0623\u062e\u0631 \u0627\u0644 \u062e\u062f\u0645\u0627\u062a<br>\u0643\u0644 \u0647\u0630\u0627 \u062f\u0627\u062e\u0644 \u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u062d\u062f \u064a\u0645\u062b\u0644 \u0623\u0648\u0644 \u0633\u0648\u0642 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u064a \u0627\u0644\u062c\u0632\u0627\u0626\u0631<br><br>:\u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642<br>\u0646\u0634\u0631 \u0637\u0644\u0628 \u0628\u0636\u063a\u0637\u0629 \u0632\u0631 \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062e\u0645\u0633\u0629 \u062f\u0642\u0627\u0626\u0642 -<br>\u062a\u0635\u0641\u062d \u0628\u0634\u0641\u0627\u0641\u064a\u0629 \u062a\u0627\u0645\u0629 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648 \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0632\u0628\u0627\u0626\u0646 \u0644\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 -<br>\u062a\u0633\u0639\u064a\u0646 \u0635\u0646\u0641 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u062d\u062f -<br>\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0633\u0631\u064a\u0639\u0629 \u0648 \u0645\u062d\u0627\u062f\u062b\u0629 \u0641\u0648\u0631\u064a\u0629 \u0645\u0639 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 -<br>\u0645\u0642\u0627\u0631\u0646\u0629 \u0639\u0631\u0648\u0636 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 -<br>\u0633\u0648\u0642 \u0630\u0648 \u0633\u064a\u0648\u0644\u0629 \u0639\u0627\u0644\u064a\u0629 \u0648 \u062a\u0641\u0627\u0639\u0644 \u0648\u0627\u0633\u0639 \u0648 \u0645\u0633\u062a\u0645\u0631 -<br><br>https://bricoram.com/ \u0645\u062a\u0648\u0641\u0631 \u0623\u064a\u0636\u0627 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0645\u0648\u0642\u0639 \u0648\u064a\u0628<br>:\u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u062a\u0646\u0627 \u0639\u0644\u0649 \u0645\u062e\u062a\u0644\u0641 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a<br> https://www.facebook.com/bricoram :\u0641\u064a\u0633\u0628\u0648\u0643<br>https://www.instagram.com/bricoram/ :\u0627\u0646\u0633\u062a\u063a\u0631\u0627\u0645<br>https://www.linkedin.com/company/bricoram/ :\u0644\u064a\u0646\u0643\u062f\u0646",
    "summary": "\u062a\u062d\u062a\u0627\u062c \u0645\u062d\u062a\u0631\u0641\u061f \u0623\u0646\u0634\u0631 \u0627\u0644\u0637\u0644\u0628 \u0648 \u0627\u0644\u0628\u0627\u0642\u064a \u0639\u0644\u064a\u0646\u0627. \u0623\u0646\u062a \u0645\u062d\u062a\u0631\u0641\u061f \u0639\u0644\u064a\u0643 \u0627\u0644\u0645\u0647\u0627\u0631\u0629 \u0648 \u0639\u0644\u064a\u0646\u0627 \u0627\u0644\u0632\u0628\u0648\u0646",
