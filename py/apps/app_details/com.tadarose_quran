{
    "title": "\u062a\u062f\u0627\u0631\u0633 \u0627\u0644\u0642\u0631\u0622\u0646",
    "description": "\u0628\u0641\u0643\u0631\u0629 \u0625\u0628\u062f\u0627\u0639\u064a\u0629 \u063a\u064a\u0631 \u0645\u0633\u0628\u0648\u0642\u0629  \u060c \u0648\u0628\u062c\u0647\u062f \u0636\u062e\u0645 \u0628\u0644\u063a \u0639\u0634\u0631\u0627\u062a \u0627\u0644\u0622\u0644\u0627\u0641 \u0645\u0646 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u062a\u0648\u0627\u0635\u0644\u0629\u060c \u0627\u0633\u0641\u0631\u062a \u0639\u0646 \u062c\u0645\u0639 \u0627\u0643\u062b\u0631 \u0645\u0646 100 \u0627\u0644\u0641 \u0648\u0642\u0641\u0629\r\n\u064a\u0633\u0631\u0646\u0627 \u0627\u0646 \u0646\u0642\u062f\u0645 \u0644\u0643\u0645 \u062a\u0637\u0628\u064a\u0642 ( \u062a\u062f\u0627\u0631\u0633 \u0627\u0644\u0642\u0631\u0622\u0646 ) : \r\n\u0648\u0647\u0648 \u0645\u0635\u062d\u0641 \u062c\u062f\u064a\u062f \u062a\u062a\u0644\u0648\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u060c \u0648 \u062a\u062c\u062f \u0641\u064a \u0643\u0644 \u0622\u064a\u0629 \u0645\u0646\u0647 \u0648\u0642\u0641\u0627\u062a \u0645\u062a\u0646\u0648\u0639\u0647 \u0648\u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u060c \u062a\u0628\u062d\u0631 \u0628\u0647\u0627  \u0625\u0644\u0649 \u0643\u0646\u0648\u0632 \u0627\u0644\u0642\u0631\u0627\u0646  \u0648\u062a\u0646\u0647\u0644 \u0645\u0646 \u0644\u0622\u0644\u0626 \u062e\u064a\u0631\u0627\u062a\u0647  \u060c \u0648\u0630\u0644\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0623\u0642\u0633\u0627\u0645 \u0645\u062a\u0639\u062f\u062f\u0647   : \r\n\r\n\u0661- \u062a\u062f\u0628\u0631\u0627\u062a \u0648\u062a\u0623\u0645\u0644\u0627\u062a \u0642\u0631\u0622\u0646\u064a\u0629 \u0645\u0646\u0648\u0639\u0647 \u0645\u0627 \u0628\u064a\u0646 \u0646\u0635\u064a\u0629 \u0648\u062c\u0631\u0627\u0641\u064a\u0643 \u0648\u0645\u0642\u0627\u0637\u0639 \u064a\u0648\u062a\u064a\u0648\u0628 \u0645\u0639 \u0627\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u062a\u0627\u0628\u0629 \u062a\u062f\u0628\u0631\u0627\u062a\u0647 \u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0627\u0644\u0627\u062e\u0631\u0649.\r\n\u0662- \u062a\u0641\u0633\u064a\u0631 \u0644\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0645\u0642\u0627\u0637\u0639 \u0645\u0631\u0626\u064a\u0629 \u0648\u0645\u0633\u0645\u0648\u0639\u0629  \u0644\u0643\u0628\u0627\u0631 \u0627\u0644\u0645\u0634\u0627\u064a\u062e \u0627\u0644\u0645\u0639\u0627\u0635\u0631\u064a\u0646 \u0645\u062b\u0644 \u0627\u0628\u0646 \u0628\u0627\u0632 \u0648\u0627\u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648\u0627\u0644\u0634\u0646\u0642\u064a\u0637\u064a \u0648\u0627\u0644\u0634\u0639\u0631\u0627\u0648\u064a \u060c \u0648\u063a\u064a\u0631\u0647\u0645 \u0627\u0644\u0643\u062b\u064a\u0631 \u0627\u0644\u0643\u062b\u064a\u0631  .\r\n\u0663- \u0627\u0644\u0623\u0633\u0631\u0627\u0631 \u0627\u0644\u0628\u0644\u0627\u063a\u064a\u0629 \u0641\u064a \u0627\u0644\u0622\u064a\u0629 : \u0627\u0644\u0622\u0644\u0627\u0641 \u0645\u0646 \u0627\u0644\u0627\u0633\u0631\u0627\u0631 \u0627\u0644\u0628\u0644\u0627\u063a\u064a\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0646\u0628\u0637\u0647\u0627 \u0627\u0644\u0639\u0644\u0645\u0627\u0621  \u0648\u0642\u062f\u0645\u0646\u0627\u0647\u0627 \u0628\u0639\u062f\u0629 \u0627\u0634\u0643\u0627\u0644 \u0645\u0631\u0626\u064a\u0629 \u0648\u0645\u0633\u0645\u0648\u0639\u0629 \u0648\u0645\u0643\u062a\u0648\u0628\u0629  .\r\n\u0664- \u062a\u0630\u0643\u0631 \u0648\u0625\u0639\u062a\u0628\u0627\u0631 : \u0627\u0644\u0625\u0639\u062c\u0627\u0632 \u0627\u0644\u0639\u0644\u0645\u064a \u0641\u064a \u0627\u0644\u0642\u0631\u0627\u0646 \u060c \u0648\u0642\u0635\u0635 \u0627\u0644\u0646\u0627\u0633 \u0645\u0639 \u0627\u0644\u0622\u064a\u0629\u060c \u0648\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0639\u0646\u0647\u0627 \u060c \u0648\u063a\u064a\u0631\u0647 \u0645\u0646 \u0639\u0644\u0648\u0645 \u0627\u0644\u0622\u064a\u0629 \u0648\u0643\u0646\u0648\u0632\u0647\u0627 .\r\n\u0665- \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0648\u0627\u0644\u0623\u062f\u0627\u0628 \u0627\u0644\u062a\u064a \u062a\u062d\u062f\u062b\u062a \u0639\u0646\u0647\u0627 \u0627\u0644\u0622\u064a\u0629 : \u0634\u0631\u062d \u0648\u0627\u0641\u064a \u0644\u0644\u0627\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0641\u064a \u0627\u0644\u0627\u064a\u0627\u062a \u064a\u0642\u062f\u0645\u0647\u0627 \u0639\u0644\u0645\u0627\u0621 \u0627\u062c\u0644\u0627\u0621  \u0645\u062b\u0644 \u0627\u0644\u0634\u0628\u062e \u0645\u062d\u0645\u062f \u0627\u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648 \u0627\u0644\u0634\u064a\u062e \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0644\u0637\u0631\u064a\u0641\u064a \u0648\u0627\u0644\u0634\u064a\u062e \u0633\u0639\u062f \u0627\u0644\u0634\u062b\u0631\u064a \u0648\u063a\u064a\u0631\u0647\u0645  .\r\n\u0666- \u0625\u0642\u062a\u0631\u0627\u062d\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u0622\u064a\u0629 : \u0648\u0644\u064a\u062c\u0645\u0639 \u0627\u0644\u0642\u0627\u0631\u0626 \u0628\u064a\u0646 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u0622\u064a\u0629 \u062c\u0645\u0639\u0646\u0627 \u0628\u0639\u0636  \u0627\u0644\u0627\u0639\u0645\u0627\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u064a\u0629 \u0644\u0644\u0627\u064a\u0627\u062a .\r\n\u0667- \u0627\u0644\u062f\u0639\u0627\u0621 \u0648\u0627\u0644\u0645\u0646\u0627\u062c\u0627\u0629 : \u062c\u0645\u0639\u0646\u0627 \u0623\u062f\u0639\u064a\u0629 \u0645\u0646 \u0645\u0641\u0647\u0648\u0645  \u0627\u0644\u0622\u064a\u0629 \u062a\u062f\u0639\u0648 \u0628\u0647\u0627 \u0639\u0646\u062f \u062a\u0644\u0627\u0648\u062a\u0643 \u0644\u0647\u0627 .\r\n\u0668-  \u0627\u0644\u062a\u0633\u0627\u0624\u0644\u0627\u062a :\u0627\u062c\u0627\u0628\u0627\u062a \u0639\u0646 \u0628\u0639\u0636 \u0627\u0644\u0627\u0633\u0626\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u0628\u0627\u062f\u0631 \u0625\u0644\u0649 \u0627\u0644\u0630\u0647\u0646 \u0639\u0646\u062f \u062a\u0644\u0627\u0648\u0629 \u0627\u0644\u0622\u064a\u0627\u062a   \u0623\u062c\u0627\u0628 \u0639\u0646\u0647\u0627 \u0647\u064a\u0626\u0629 \u0643\u0628\u0627\u0631 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0648\u0627\u0644\u0634\u064a\u062e \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0628\u0646 \u0628\u0627\u0632 \u0648\u0627\u0644\u0634\u064a\u062e \u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648\u0645\u0646 \u0645\u062c\u0644\u0629 \u0627\u0644\u0628\u062d\u0648\u062b \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u063a\u064a\u0631\u0647\u0645  .\r\n\u0669- \u0642\u0633\u0645 \u0627\u0644\u0645\u062a\u0634\u0627\u0628\u0647 : \u0628\u0639\u0636 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0648\u0627\u0644\u0637\u0631\u0642 \u0644\u0636\u0628\u0637 \u0627\u0644\u062d\u0641\u0638 \u0648\u0625\u062a\u0642\u0627\u0646\u0647 . \r\n\r\n\u0648 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u0647 \u0645\u0635\u062d\u0641 \u062a\u0641\u0627\u0639\u0644\u064a \u064a\u0633\u062a\u0637\u064a\u0639 \u0645\u0633\u062a\u062e\u062f\u0645\u0647 \u0625\u062f\u0631\u0627\u062c \u062a\u062f\u0628\u0631\u0627\u062a\u0647 \u0648\u062a\u0633\u0627\u0624\u0644\u0627\u062a\u0647 \u0648 \u0648\u0642\u0641\u0627\u062a\u0647 \u0627\u0644\u0645\u062a\u0646\u0648\u0639\u0647 \u060c \u0648\u064a\u0639\u0644\u0642 \u0639\u0644\u0649 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0648\u064a\u0636\u0639 \u0644\u0647\u0627 \u0625\u0639\u062c\u0627\u0628 \u0648\u0639\u062f\u0645 \u0625\u0639\u062c\u0627\u0628 \u060c \u0641\u064a \u062c\u0648 \u062a\u0641\u0627\u0639\u0644\u064a \u0646\u0634\u0637 .\r\n\r\n\u0648\u0643\u0630\u0644\u0643 \u0645\u0646 \u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u0627\u0644\u0631\u0627\u0626\u0639\u0629 :\r\n* \u0628\u0637\u0631\u064a\u0642\u0629 \u0628\u0631\u0645\u062c\u064a\u0629 \u0625\u0628\u062f\u0627\u0639\u064a\u0629 : \u064a\u0645\u0643\u0646\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u0625\u0631\u0633\u0627\u0644 \u0623\u064a \u062a\u062f\u0628\u0631  :  \u0639\u0644\u0649 \u0634\u0643\u0644 \u0644\u0648\u062d\u0629 \u062c\u0631\u0627\u0641\u064a\u0643 \u0631\u0627\u0626\u0639\u0629 \u060c \u062a\u062e\u062a\u0627\u0631 \u062e\u0644\u0641\u064a\u062a\u0647\u0627 \u0645\u0646 \u0635\u0648\u0631 \u062c\u0645\u064a\u0644\u0647 \u0627\u062f\u0631\u062c\u0646\u0627\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u060c \u0648\u0627\u0644\u0623\u062c\u0645\u0644 \u0623\u0646\u0643  \u062a\u0633\u062a\u0637\u064a\u0639 \u0627\u0646 \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u062e\u0644\u0641\u064a\u0629  \u0645\u0646 \u0623\u0644\u0628\u0648\u0645 \u0627\u0644\u0635\u0648\u0631 \u0641\u064a \u062c\u0648\u0627\u0644\u0643 \u0623\u0648 \u062a\u0644\u062a\u0642\u0637\u0647\u0627 \u0628\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062c\u0648\u0627\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 .\r\n* \u0648\u0643\u0630\u0644\u0643 \u062c\u0645\u0639\u0646\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 2500 \u0644\u0648\u062d\u0629 \u062c\u0631\u0627\u0641\u064a\u0643 \u062a\u062f\u0628\u0631\u064a\u0647 \u062c\u0645\u064a\u0644\u0647 \u062a\u062c\u062f\u0647\u0627 \u0645\u062f\u0631\u062c\u0647 \u0641\u064a \u0643\u0644 \u0622\u064a\u0629 \u062a\u062e\u0635\u0647\u0627 .\r\n* \u062d\u0631\u0635\u0627 \u0645\u0646\u0627 \u0639\u0644\u0649 \u0646\u0634\u0631 \u0627\u0644\u0639\u0644\u0645 : \u062a\u0633\u062a\u0637\u064a\u0639 \u062a\u0635\u062f\u064a\u0631 \u0648\u0642\u0641\u0627\u062a \u0622\u064a\u0629 \u0623\u0648 \u0633\u0648\u0631\u0629 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0645\u0644\u0641 pdf  \u0623\u0648 \u0645\u0644\u0641 word \u0627\u0648 \u062a\u0633\u062a\u0639\u0631\u0636\u0647\u0627 \u0628\u0634\u0643\u0644 \u0645\u0631\u062a\u0628 \u0641\u064a \u0627\u0644\u0645\u062a\u0635\u0641\u062d . ( \u062d\u062f \u0623\u0642\u0635\u0649 \u0661\u0660 \u0622\u064a\u0627\u062a \u0644\u0645\u0644\u0641\u0627\u062a pdf \u060c \u0648\u0639\u062f\u062f \u0644\u0627 \u0645\u062d\u062f\u0648\u062f \u0644\u0644\u0628\u0642\u064a\u0629 )\r\n* \u0628\u0625\u0645\u0643\u0627\u0646\u0643 -\u062a\u0635\u0641\u062d \u0648\u0642\u0641\u0627\u062a \u0623\u064a \u0639\u0627\u0644\u0645 \u0627\u0648 \u0634\u064a\u062e \u0627\u0648 \u0645\u062a\u062f\u0628\u0631 \u060c \u0648\u0630\u0644\u0643 \u0628\u0627\u0644\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627 \u0639\u0644\u0649 \u0625\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0648\u0642\u0641\u0629  \u060c \u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u062c\u062f\u064a\u062f\u0647 \u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0642\u0648\u0645 \u0628\u062a\u0641\u0636\u064a\u0644\u0647 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 .\r\n* \u0645\u064a\u0632\u0629 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0648\u0642\u0641\u0627\u062a .\r\n* \u0645\u064a\u0632\u0629 \u062a\u0641\u0636\u064a\u0644 \u0648\u0642\u0641\u0629 \u0645\u0639\u064a\u0646\u0629  \u0644\u0643\u064a \u062a\u0631\u062c\u0639 \u0644\u0647\u0627 \u0644\u0627\u062d\u0642\u0627.\r\n*  \u0662\u0667 \u0643\u062a\u0627\u0628 \u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u0631\u0648\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u062f\u0631\u0631 \u0627\u0644\u0633\u0646\u064a\u0629 \u0627\u0644\u0631\u0627\u0626\u0639 .\r\n* \u0645\u0645\u064a\u0632\u0627\u062a \u0623\u062e\u0631\u0649  : \u0645\u062b\u0644 \u0627\u0644\u0648\u0631\u062f \u0627\u0644\u064a\u0648\u0645\u064a - \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0644\u064a\u0644\u064a - \u062a\u063a\u064a\u064a\u0631 \u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062e\u0637 \u0648\u0627\u0644\u062e\u0644\u0641\u064a\u0629 - \u0625\u0636\u0627\u0641\u0629 \u0645\u0644\u0627\u062d\u0638\u0629 \u0644\u0644\u0622\u064a\u0629 - \u0648\u0636\u0639 \u0639\u0644\u0627\u0645\u0629 \u0644\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u0635\u0641\u062d\u0629 - \u062a\u0643\u0628\u064a\u0631 \u062e\u0637 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0648\u062a\u0635\u063a\u064a\u0631\u0647 \u060c \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0627\u0626\u0639\u0629 .\r\n\r\n\u0648\u0644\u062f\u0639\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u0634\u0623\u0646\u0627 \u0642\u0646\u0627\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628 \u0642\u0645\u0646\u0627 \u0641\u064a\u0647\u0627 \u0628\u0645\u0648\u0646\u062a\u0627\u062c \u0623\u0643\u062b\u0631 \u0645\u0646 \u0661\u0666\u0660\u0660 \u0645\u0642\u0637\u0639 \u0641\u064a \u0627\u0644\u062a\u0641\u0633\u064a\u0631 \u0648\u0627\u0644\u062a\u062f\u0628\u0631 .\r\n\r\n\u0633\u0623\u0644\u064a\u0646 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u062c\u0639\u0644 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639\u064a\u0646 \u0644\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u062a\u062f\u0627\u0631\u0633 \u0627\u0644\u0642\u0631\u0627\u0646 \u0648\u062a\u062f\u0628\u0631\u0647  \u0648\u0623\u0646 \u064a\u0634\u0645\u0644\u0646\u0627 \u062c\u0645\u064a\u0639\u0627 \u0642\u0648\u0644  \u0627\u0644\u0631\u0633\u0648\u0644 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 ( \u0645\u064e\u0627 \u0627\u062c\u0652\u062a\u064e\u0645\u064e\u0639\u064e \u0642\u064e\u0648\u0652\u0645\u064c \u0641\u0650\u064a \u0628\u064e\u064a\u0652\u062a\u064d \u0645\u0650\u0646\u0652 \u0628\u064f\u064a\u064f\u0648\u062a\u0650 \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u062a\u0652\u0644\u064f\u0648\u0646\u064e \u0643\u0650\u062a\u064e\u0627\u0628\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u064a\u064e\u062a\u064e\u062f\u064e\u0627\u0631\u064e\u0633\u064f\u0648\u0646\u064e\u0647\u064f \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0646\u064e\u0632\u064e\u0644\u064e\u062a\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u064f \u0627\u0644\u0633\u0651\u064e\u0643\u0650\u064a\u0646\u064e\u0629\u064f \u0648\u064e\u063a\u064e\u0634\u0650\u064a\u064e\u062a\u0652\u0647\u064f\u0645\u064f \u0627\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0629\u064f \u0648\u064e\u062d\u064e\u0641\u0651\u064e\u062a\u0652\u0647\u064f\u0645\u064f \u0627\u0644\u0652\u0645\u064e\u0644\u064e\u0627\u0626\u0650\u0643\u064e\u0629\u064f \u0648\u064e\u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u0645\u064f \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0641\u0650\u064a\u0645\u064e\u0646\u0652 \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f ) .",
    "descriptionHTML": "\u0628\u0641\u0643\u0631\u0629 \u0625\u0628\u062f\u0627\u0639\u064a\u0629 \u063a\u064a\u0631 \u0645\u0633\u0628\u0648\u0642\u0629  \u060c \u0648\u0628\u062c\u0647\u062f \u0636\u062e\u0645 \u0628\u0644\u063a \u0639\u0634\u0631\u0627\u062a \u0627\u0644\u0622\u0644\u0627\u0641 \u0645\u0646 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u062a\u0648\u0627\u0635\u0644\u0629\u060c \u0627\u0633\u0641\u0631\u062a \u0639\u0646 \u062c\u0645\u0639 \u0627\u0643\u062b\u0631 \u0645\u0646 100 \u0627\u0644\u0641 \u0648\u0642\u0641\u0629<br>\u064a\u0633\u0631\u0646\u0627 \u0627\u0646 \u0646\u0642\u062f\u0645 \u0644\u0643\u0645 \u062a\u0637\u0628\u064a\u0642 ( \u062a\u062f\u0627\u0631\u0633 \u0627\u0644\u0642\u0631\u0622\u0646 ) : <br>\u0648\u0647\u0648 \u0645\u0635\u062d\u0641 \u062c\u062f\u064a\u062f \u062a\u062a\u0644\u0648\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u060c \u0648 \u062a\u062c\u062f \u0641\u064a \u0643\u0644 \u0622\u064a\u0629 \u0645\u0646\u0647 \u0648\u0642\u0641\u0627\u062a \u0645\u062a\u0646\u0648\u0639\u0647 \u0648\u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u060c \u062a\u0628\u062d\u0631 \u0628\u0647\u0627  \u0625\u0644\u0649 \u0643\u0646\u0648\u0632 \u0627\u0644\u0642\u0631\u0627\u0646  \u0648\u062a\u0646\u0647\u0644 \u0645\u0646 \u0644\u0622\u0644\u0626 \u062e\u064a\u0631\u0627\u062a\u0647  \u060c \u0648\u0630\u0644\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0623\u0642\u0633\u0627\u0645 \u0645\u062a\u0639\u062f\u062f\u0647   : <br><br>\u0661- \u062a\u062f\u0628\u0631\u0627\u062a \u0648\u062a\u0623\u0645\u0644\u0627\u062a \u0642\u0631\u0622\u0646\u064a\u0629 \u0645\u0646\u0648\u0639\u0647 \u0645\u0627 \u0628\u064a\u0646 \u0646\u0635\u064a\u0629 \u0648\u062c\u0631\u0627\u0641\u064a\u0643 \u0648\u0645\u0642\u0627\u0637\u0639 \u064a\u0648\u062a\u064a\u0648\u0628 \u0645\u0639 \u0627\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u062a\u0627\u0628\u0629 \u062a\u062f\u0628\u0631\u0627\u062a\u0647 \u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0627\u0644\u0627\u062e\u0631\u0649.<br>\u0662- \u062a\u0641\u0633\u064a\u0631 \u0644\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0645\u0642\u0627\u0637\u0639 \u0645\u0631\u0626\u064a\u0629 \u0648\u0645\u0633\u0645\u0648\u0639\u0629  \u0644\u0643\u0628\u0627\u0631 \u0627\u0644\u0645\u0634\u0627\u064a\u062e \u0627\u0644\u0645\u0639\u0627\u0635\u0631\u064a\u0646 \u0645\u062b\u0644 \u0627\u0628\u0646 \u0628\u0627\u0632 \u0648\u0627\u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648\u0627\u0644\u0634\u0646\u0642\u064a\u0637\u064a \u0648\u0627\u0644\u0634\u0639\u0631\u0627\u0648\u064a \u060c \u0648\u063a\u064a\u0631\u0647\u0645 \u0627\u0644\u0643\u062b\u064a\u0631 \u0627\u0644\u0643\u062b\u064a\u0631  .<br>\u0663- \u0627\u0644\u0623\u0633\u0631\u0627\u0631 \u0627\u0644\u0628\u0644\u0627\u063a\u064a\u0629 \u0641\u064a \u0627\u0644\u0622\u064a\u0629 : \u0627\u0644\u0622\u0644\u0627\u0641 \u0645\u0646 \u0627\u0644\u0627\u0633\u0631\u0627\u0631 \u0627\u0644\u0628\u0644\u0627\u063a\u064a\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0646\u0628\u0637\u0647\u0627 \u0627\u0644\u0639\u0644\u0645\u0627\u0621  \u0648\u0642\u062f\u0645\u0646\u0627\u0647\u0627 \u0628\u0639\u062f\u0629 \u0627\u0634\u0643\u0627\u0644 \u0645\u0631\u0626\u064a\u0629 \u0648\u0645\u0633\u0645\u0648\u0639\u0629 \u0648\u0645\u0643\u062a\u0648\u0628\u0629  .<br>\u0664- \u062a\u0630\u0643\u0631 \u0648\u0625\u0639\u062a\u0628\u0627\u0631 : \u0627\u0644\u0625\u0639\u062c\u0627\u0632 \u0627\u0644\u0639\u0644\u0645\u064a \u0641\u064a \u0627\u0644\u0642\u0631\u0627\u0646 \u060c \u0648\u0642\u0635\u0635 \u0627\u0644\u0646\u0627\u0633 \u0645\u0639 \u0627\u0644\u0622\u064a\u0629\u060c \u0648\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0639\u0646\u0647\u0627 \u060c \u0648\u063a\u064a\u0631\u0647 \u0645\u0646 \u0639\u0644\u0648\u0645 \u0627\u0644\u0622\u064a\u0629 \u0648\u0643\u0646\u0648\u0632\u0647\u0627 .<br>\u0665- \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0648\u0627\u0644\u0623\u062f\u0627\u0628 \u0627\u0644\u062a\u064a \u062a\u062d\u062f\u062b\u062a \u0639\u0646\u0647\u0627 \u0627\u0644\u0622\u064a\u0629 : \u0634\u0631\u062d \u0648\u0627\u0641\u064a \u0644\u0644\u0627\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0641\u064a \u0627\u0644\u0627\u064a\u0627\u062a \u064a\u0642\u062f\u0645\u0647\u0627 \u0639\u0644\u0645\u0627\u0621 \u0627\u062c\u0644\u0627\u0621  \u0645\u062b\u0644 \u0627\u0644\u0634\u0628\u062e \u0645\u062d\u0645\u062f \u0627\u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648 \u0627\u0644\u0634\u064a\u062e \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0644\u0637\u0631\u064a\u0641\u064a \u0648\u0627\u0644\u0634\u064a\u062e \u0633\u0639\u062f \u0627\u0644\u0634\u062b\u0631\u064a \u0648\u063a\u064a\u0631\u0647\u0645  .<br>\u0666- \u0625\u0642\u062a\u0631\u0627\u062d\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u0622\u064a\u0629 : \u0648\u0644\u064a\u062c\u0645\u0639 \u0627\u0644\u0642\u0627\u0631\u0626 \u0628\u064a\u0646 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u0622\u064a\u0629 \u062c\u0645\u0639\u0646\u0627 \u0628\u0639\u0636  \u0627\u0644\u0627\u0639\u0645\u0627\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u064a\u0629 \u0644\u0644\u0627\u064a\u0627\u062a .<br>\u0667- \u0627\u0644\u062f\u0639\u0627\u0621 \u0648\u0627\u0644\u0645\u0646\u0627\u062c\u0627\u0629 : \u062c\u0645\u0639\u0646\u0627 \u0623\u062f\u0639\u064a\u0629 \u0645\u0646 \u0645\u0641\u0647\u0648\u0645  \u0627\u0644\u0622\u064a\u0629 \u062a\u062f\u0639\u0648 \u0628\u0647\u0627 \u0639\u0646\u062f \u062a\u0644\u0627\u0648\u062a\u0643 \u0644\u0647\u0627 .<br>\u0668-  \u0627\u0644\u062a\u0633\u0627\u0624\u0644\u0627\u062a :\u0627\u062c\u0627\u0628\u0627\u062a \u0639\u0646 \u0628\u0639\u0636 \u0627\u0644\u0627\u0633\u0626\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u0628\u0627\u062f\u0631 \u0625\u0644\u0649 \u0627\u0644\u0630\u0647\u0646 \u0639\u0646\u062f \u062a\u0644\u0627\u0648\u0629 \u0627\u0644\u0622\u064a\u0627\u062a   \u0623\u062c\u0627\u0628 \u0639\u0646\u0647\u0627 \u0647\u064a\u0626\u0629 \u0643\u0628\u0627\u0631 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0648\u0627\u0644\u0634\u064a\u062e \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0628\u0646 \u0628\u0627\u0632 \u0648\u0627\u0644\u0634\u064a\u062e \u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u062b\u064a\u0645\u064a\u0646 \u0648\u0645\u0646 \u0645\u062c\u0644\u0629 \u0627\u0644\u0628\u062d\u0648\u062b \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u063a\u064a\u0631\u0647\u0645  .<br>\u0669- \u0642\u0633\u0645 \u0627\u0644\u0645\u062a\u0634\u0627\u0628\u0647 : \u0628\u0639\u0636 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0648\u0627\u0644\u0637\u0631\u0642 \u0644\u0636\u0628\u0637 \u0627\u0644\u062d\u0641\u0638 \u0648\u0625\u062a\u0642\u0627\u0646\u0647 . <br><br>\u0648 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u0647 \u0645\u0635\u062d\u0641 \u062a\u0641\u0627\u0639\u0644\u064a \u064a\u0633\u062a\u0637\u064a\u0639 \u0645\u0633\u062a\u062e\u062f\u0645\u0647 \u0625\u062f\u0631\u0627\u062c \u062a\u062f\u0628\u0631\u0627\u062a\u0647 \u0648\u062a\u0633\u0627\u0624\u0644\u0627\u062a\u0647 \u0648 \u0648\u0642\u0641\u0627\u062a\u0647 \u0627\u0644\u0645\u062a\u0646\u0648\u0639\u0647 \u060c \u0648\u064a\u0639\u0644\u0642 \u0639\u0644\u0649 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0648\u064a\u0636\u0639 \u0644\u0647\u0627 \u0625\u0639\u062c\u0627\u0628 \u0648\u0639\u062f\u0645 \u0625\u0639\u062c\u0627\u0628 \u060c \u0641\u064a \u062c\u0648 \u062a\u0641\u0627\u0639\u0644\u064a \u0646\u0634\u0637 .<br><br>\u0648\u0643\u0630\u0644\u0643 \u0645\u0646 \u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u0627\u0644\u0631\u0627\u0626\u0639\u0629 :<br>* \u0628\u0637\u0631\u064a\u0642\u0629 \u0628\u0631\u0645\u062c\u064a\u0629 \u0625\u0628\u062f\u0627\u0639\u064a\u0629 : \u064a\u0645\u0643\u0646\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u0625\u0631\u0633\u0627\u0644 \u0623\u064a \u062a\u062f\u0628\u0631  :  \u0639\u0644\u0649 \u0634\u0643\u0644 \u0644\u0648\u062d\u0629 \u062c\u0631\u0627\u0641\u064a\u0643 \u0631\u0627\u0626\u0639\u0629 \u060c \u062a\u062e\u062a\u0627\u0631 \u062e\u0644\u0641\u064a\u062a\u0647\u0627 \u0645\u0646 \u0635\u0648\u0631 \u062c\u0645\u064a\u0644\u0647 \u0627\u062f\u0631\u062c\u0646\u0627\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642  \u060c \u0648\u0627\u0644\u0623\u062c\u0645\u0644 \u0623\u0646\u0643  \u062a\u0633\u062a\u0637\u064a\u0639 \u0627\u0646 \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u062e\u0644\u0641\u064a\u0629  \u0645\u0646 \u0623\u0644\u0628\u0648\u0645 \u0627\u0644\u0635\u0648\u0631 \u0641\u064a \u062c\u0648\u0627\u0644\u0643 \u0623\u0648 \u062a\u0644\u062a\u0642\u0637\u0647\u0627 \u0628\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062c\u0648\u0627\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 .<br>* \u0648\u0643\u0630\u0644\u0643 \u062c\u0645\u0639\u0646\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 2500 \u0644\u0648\u062d\u0629 \u062c\u0631\u0627\u0641\u064a\u0643 \u062a\u062f\u0628\u0631\u064a\u0647 \u062c\u0645\u064a\u0644\u0647 \u062a\u062c\u062f\u0647\u0627 \u0645\u062f\u0631\u062c\u0647 \u0641\u064a \u0643\u0644 \u0622\u064a\u0629 \u062a\u062e\u0635\u0647\u0627 .<br>* \u062d\u0631\u0635\u0627 \u0645\u0646\u0627 \u0639\u0644\u0649 \u0646\u0634\u0631 \u0627\u0644\u0639\u0644\u0645 : \u062a\u0633\u062a\u0637\u064a\u0639 \u062a\u0635\u062f\u064a\u0631 \u0648\u0642\u0641\u0627\u062a \u0622\u064a\u0629 \u0623\u0648 \u0633\u0648\u0631\u0629 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0645\u0644\u0641 pdf  \u0623\u0648 \u0645\u0644\u0641 word \u0627\u0648 \u062a\u0633\u062a\u0639\u0631\u0636\u0647\u0627 \u0628\u0634\u0643\u0644 \u0645\u0631\u062a\u0628 \u0641\u064a \u0627\u0644\u0645\u062a\u0635\u0641\u062d . ( \u062d\u062f \u0623\u0642\u0635\u0649 \u0661\u0660 \u0622\u064a\u0627\u062a \u0644\u0645\u0644\u0641\u0627\u062a pdf \u060c \u0648\u0639\u062f\u062f \u0644\u0627 \u0645\u062d\u062f\u0648\u062f \u0644\u0644\u0628\u0642\u064a\u0629 )<br>* \u0628\u0625\u0645\u0643\u0627\u0646\u0643 -\u062a\u0635\u0641\u062d \u0648\u0642\u0641\u0627\u062a \u0623\u064a \u0639\u0627\u0644\u0645 \u0627\u0648 \u0634\u064a\u062e \u0627\u0648 \u0645\u062a\u062f\u0628\u0631 \u060c \u0648\u0630\u0644\u0643 \u0628\u0627\u0644\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627 \u0639\u0644\u0649 \u0625\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0648\u0642\u0641\u0629  \u060c \u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u062c\u062f\u064a\u062f\u0647 \u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0642\u0648\u0645 \u0628\u062a\u0641\u0636\u064a\u0644\u0647 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 .<br>* \u0645\u064a\u0632\u0629 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0648\u0642\u0641\u0627\u062a .<br>* \u0645\u064a\u0632\u0629 \u062a\u0641\u0636\u064a\u0644 \u0648\u0642\u0641\u0629 \u0645\u0639\u064a\u0646\u0629  \u0644\u0643\u064a \u062a\u0631\u062c\u0639 \u0644\u0647\u0627 \u0644\u0627\u062d\u0642\u0627.<br>*  \u0662\u0667 \u0643\u062a\u0627\u0628 \u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u0631\u0648\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u062f\u0631\u0631 \u0627\u0644\u0633\u0646\u064a\u0629 \u0627\u0644\u0631\u0627\u0626\u0639 .<br>* \u0645\u0645\u064a\u0632\u0627\u062a \u0623\u062e\u0631\u0649  : \u0645\u062b\u0644 \u0627\u0644\u0648\u0631\u062f \u0627\u0644\u064a\u0648\u0645\u064a - \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0644\u064a\u0644\u064a - \u062a\u063a\u064a\u064a\u0631 \u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062e\u0637 \u0648\u0627\u0644\u062e\u0644\u0641\u064a\u0629 - \u0625\u0636\u0627\u0641\u0629 \u0645\u0644\u0627\u062d\u0638\u0629 \u0644\u0644\u0622\u064a\u0629 - \u0648\u0636\u0639 \u0639\u0644\u0627\u0645\u0629 \u0644\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u0635\u0641\u062d\u0629 - \u062a\u0643\u0628\u064a\u0631 \u062e\u0637 \u0627\u0644\u0648\u0642\u0641\u0627\u062a \u0648\u062a\u0635\u063a\u064a\u0631\u0647 \u060c \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0627\u0626\u0639\u0629 .<br><br>\u0648\u0644\u062f\u0639\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u0634\u0623\u0646\u0627 \u0642\u0646\u0627\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628 \u0642\u0645\u0646\u0627 \u0641\u064a\u0647\u0627 \u0628\u0645\u0648\u0646\u062a\u0627\u062c \u0623\u0643\u062b\u0631 \u0645\u0646 \u0661\u0666\u0660\u0660 \u0645\u0642\u0637\u0639 \u0641\u064a \u0627\u0644\u062a\u0641\u0633\u064a\u0631 \u0648\u0627\u0644\u062a\u062f\u0628\u0631 .<br><br>\u0633\u0623\u0644\u064a\u0646 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u062c\u0639\u0644 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639\u064a\u0646 \u0644\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u062a\u062f\u0627\u0631\u0633 \u0627\u0644\u0642\u0631\u0627\u0646 \u0648\u062a\u062f\u0628\u0631\u0647  \u0648\u0623\u0646 \u064a\u0634\u0645\u0644\u0646\u0627 \u062c\u0645\u064a\u0639\u0627 \u0642\u0648\u0644  \u0627\u0644\u0631\u0633\u0648\u0644 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 ( \u0645\u064e\u0627 \u0627\u062c\u0652\u062a\u064e\u0645\u064e\u0639\u064e \u0642\u064e\u0648\u0652\u0645\u064c \u0641\u0650\u064a \u0628\u064e\u064a\u0652\u062a\u064d \u0645\u0650\u0646\u0652 \u0628\u064f\u064a\u064f\u0648\u062a\u0650 \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u062a\u0652\u0644\u064f\u0648\u0646\u064e \u0643\u0650\u062a\u064e\u0627\u0628\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u064a\u064e\u062a\u064e\u062f\u064e\u0627\u0631\u064e\u0633\u064f\u0648\u0646\u064e\u0647\u064f \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0646\u064e\u0632\u064e\u0644\u064e\u062a\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u064f \u0627\u0644\u0633\u0651\u064e\u0643\u0650\u064a\u0646\u064e\u0629\u064f \u0648\u064e\u063a\u064e\u0634\u0650\u064a\u064e\u062a\u0652\u0647\u064f\u0645\u064f \u0627\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0629\u064f \u0648\u064e\u062d\u064e\u0641\u0651\u064e\u062a\u0652\u0647\u064f\u0645\u064f \u0627\u0644\u0652\u0645\u064e\u0644\u064e\u0627\u0626\u0650\u0643\u064e\u0629\u064f \u0648\u064e\u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u0645\u064f \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0641\u0650\u064a\u0645\u064e\u0646\u0652 \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f ) .",
