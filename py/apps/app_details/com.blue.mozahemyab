{
    "title": "\u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u0648 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u062d\u0631\u0641\u0647 \u0627\u06cc",
    "description": "\u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u0648 \u0646\u0645\u0627\u06cc\u0634 \u0646\u0627\u0645 \u0634\u0645\u0627\u0631\u0647 \u0646\u0627\u0634\u0646\u0627\u0633\r\n\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0647 \u0627\u0641\u0631\u0627\u062f \u0628\u0627 \u0648\u0631\u0648\u062f \u0646\u0627\u0645 \u0622\u0646\u0647\u0627\r\n\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0646\u0627\u0645 \u0634\u0645\u0627\u0631\u0647 \u0647\u0627\u06cc \u0646\u0627\u0634\u0646\u0627\u0633\r\n\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0642\u0648\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u062d\u0631\u0641\u0647 \u0627\u06cc \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u0628\u0627 \u0627\u0633\u0645 \u0648 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u06cc \u0628\u0627\u0634\u062f\r\n\u0628\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0627\u0633\u0645 \u0627\u0641\u0631\u0627\u062f \u0634\u0645\u0627\u0631\u0647 \u0622\u0646\u0647\u0627 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f\r\n\u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0634\u0645\u0627\u0631\u0647 \u0646\u0627 \u0634\u0646\u0627\u0633 \u0627\u0632 \u0631\u0648\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 \u0646\u06cc\u0632 \u062f\u06cc\u06af\u0631 \u0642\u0627\u0628\u0644\u06cc\u062a \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062a\r\n\u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0648 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0627\u0646\u0644\u0627\u06cc\u0646 \u0628\u0647 \u0634\u0645\u0627\u0631\u0647 \u06a9\u0645\u06a9 \u0645\u06cc\u06a9\u0646\u062f \u0628\u0647 \u0635\u0648\u0631\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627 \u0634\u0645\u0627\u0631\u0647 \u0646\u0627\u0634\u0646\u0627\u0633 \u062e\u0648\u062f \u0631\u0627 \u0628\u06cc\u0627\u0628\u06cc\u062f",
    "descriptionHTML": "\u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u0648 \u0646\u0645\u0627\u06cc\u0634 \u0646\u0627\u0645 \u0634\u0645\u0627\u0631\u0647 \u0646\u0627\u0634\u0646\u0627\u0633<br>\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0647 \u0627\u0641\u0631\u0627\u062f \u0628\u0627 \u0648\u0631\u0648\u062f \u0646\u0627\u0645 \u0622\u0646\u0647\u0627<br>\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0646\u0627\u0645 \u0634\u0645\u0627\u0631\u0647 \u0647\u0627\u06cc \u0646\u0627\u0634\u0646\u0627\u0633<br>\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0642\u0648\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u062d\u0631\u0641\u0647 \u0627\u06cc \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u0628\u0627 \u0627\u0633\u0645 \u0648 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627\u0628 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u06cc \u0628\u0627\u0634\u062f<br>\u0628\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0627\u0633\u0645 \u0627\u0641\u0631\u0627\u062f \u0634\u0645\u0627\u0631\u0647 \u0622\u0646\u0647\u0627 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f<br>\u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0634\u0645\u0627\u0631\u0647 \u0646\u0627 \u0634\u0646\u0627\u0633 \u0627\u0632 \u0631\u0648\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 \u0646\u06cc\u0632 \u062f\u06cc\u06af\u0631 \u0642\u0627\u0628\u0644\u06cc\u062a \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062a<br>\u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0648 \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627\u0628 \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0627\u0646\u0644\u0627\u06cc\u0646 \u0628\u0647 \u0634\u0645\u0627\u0631\u0647 \u06a9\u0645\u06a9 \u0645\u06cc\u06a9\u0646\u062f \u0628\u0647 \u0635\u0648\u0631\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u0632\u0627\u062d\u0645 \u06cc\u0627 \u0634\u0645\u0627\u0631\u0647 \u0646\u0627\u0634\u0646\u0627\u0633 \u062e\u0648\u062f \u0631\u0627 \u0628\u06cc\u0627\u0628\u06cc\u062f",
