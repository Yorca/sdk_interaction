{
    "title": "\u0622\u0645\u0648\u0632\u0634 \u0632\u0628\u0627\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0627 \u062f\u0627\u0633\u062a\u0627\u0646",
    "description": "\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u0647\u0627\u0631\u062a \u0647\u0627\u06cc \u0635\u062d\u0628\u062a \u06a9\u0631\u062f\u0646\u060c \u0634\u0646\u06cc\u062f\u0646\u060c \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0646\u0648\u0634\u062a\u0646 \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0631\u0648\u0634 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u06cc \u0628\u0647\u0628\u0648\u062f \u0628\u062e\u0634\u06cc\u062f.\r\n\r\n\u0628\u062e\u0634\u06cc \u0627\u0632 \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u06a9\u0633\u067e\u0631\u062a:\r\n\r\n- \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0644\u063a\u0627\u062a \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\r\n- \u062a\u0642\u0648\u06cc\u062a \u0645\u0647\u0627\u0631\u062a \u062e\u0648\u0627\u0646\u062f\u0646 \u0628\u0627 \u0622\u0632\u0645\u0648\u0646 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\r\n- \u0645\u062a\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u062a\u0631\u062c\u0645\u0647 \u0648 \u0635\u0648\u062a \u062f\u0627\u0633\u062a\u0627\u0646\r\n- \u062f\u0631\u0633 \u0647\u0627\u06cc \u0633\u0637\u062d \u0628\u0646\u062f\u0647 \u0634\u062f\u0647\r\n- \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 \u062d\u0631\u0641\u0647 \u0627\u06cc \u0628\u0627 \u0642\u0627\u0628\u0644\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0644\u063a\u0627\u062a \u0628\u0635\u0648\u0631\u062a \u0622\u0646\u0644\u0627\u06cc\u0646\r\n- \u062f\u06cc\u06a9\u0634\u0646\u0631\u06cc \u062f\u0648 \u0632\u0628\u0627\u0646\u0647\r\n- \u062a\u0645\u0631\u06cc\u0646 \u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639\r\n- \u062f\u0641\u062a\u0631\u0686\u0647 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0622\u0646\u0644\u0627\u06cc\u0646\r\n- \u0648\u0627\u062d\u062f \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646",
    "descriptionHTML": "\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u0647\u0627\u0631\u062a \u0647\u0627\u06cc \u0635\u062d\u0628\u062a \u06a9\u0631\u062f\u0646\u060c \u0634\u0646\u06cc\u062f\u0646\u060c \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0646\u0648\u0634\u062a\u0646 \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0631\u0648\u0634 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u06cc \u0628\u0647\u0628\u0648\u062f \u0628\u062e\u0634\u06cc\u062f.<br><br>\u0628\u062e\u0634\u06cc \u0627\u0632 \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u06a9\u0633\u067e\u0631\u062a:<br><br>- \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0644\u063a\u0627\u062a \u0636\u0631\u0648\u0631\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc<br>- \u062a\u0642\u0648\u06cc\u062a \u0645\u0647\u0627\u0631\u062a \u062e\u0648\u0627\u0646\u062f\u0646 \u0628\u0627 \u0622\u0632\u0645\u0648\u0646 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641<br>- \u0645\u062a\u0646 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u062a\u0631\u062c\u0645\u0647 \u0648 \u0635\u0648\u062a \u062f\u0627\u0633\u062a\u0627\u0646<br>- \u062f\u0631\u0633 \u0647\u0627\u06cc \u0633\u0637\u062d \u0628\u0646\u062f\u0647 \u0634\u062f\u0647<br>- \u062c\u0639\u0628\u0647 \u0644\u0627\u06cc\u062a\u0646\u0631 \u062d\u0631\u0641\u0647 \u0627\u06cc \u0628\u0627 \u0642\u0627\u0628\u0644\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0644\u063a\u0627\u062a \u0628\u0635\u0648\u0631\u062a \u0622\u0646\u0644\u0627\u06cc\u0646<br>- \u062f\u06cc\u06a9\u0634\u0646\u0631\u06cc \u062f\u0648 \u0632\u0628\u0627\u0646\u0647<br>- \u062a\u0645\u0631\u06cc\u0646 \u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639<br>- \u062f\u0641\u062a\u0631\u0686\u0647 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0622\u0646\u0644\u0627\u06cc\u0646<br>- \u0648\u0627\u062d\u062f \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646",
