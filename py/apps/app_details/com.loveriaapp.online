{
    "title": "\u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a blind date",
    "description": "\u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u0648\u06cc\u0646\u06cc \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0642\u0631\u0627\u0631 \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u0633\u0627\u06cc\u062a \u062c\u062f\u06cc\u062f \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a \u062f\u0648 \u0646\u0627\u0634\u0646\u0627\u0633 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0648\u0631\u0698\u0646 \u062c\u062f\u06cc\u062f \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a  blind date \r\n\u0645\u0627\u0647 \u0639\u0633\u0644\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u0622\u0646\u0644\u0627\u06cc\u0646\r\n\u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u062c\u062f\u06cc\u062f \u0628\u0627 \u06a9\u0644\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646\r\n\u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0628\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633\r\n\u0686\u062a \u0631\u0648\u0645 \u0645\u0627\u0647 \u0639\u0633\u0644\r\n\u0633\u0627\u06cc\u062a \u0648 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0646\u0632\u062f\u06cc\u06a9\u0627 \u062c\u062f\u06cc\u062f \r\n\u06af\u067e \u0648 \u06af\u0641\u062a\u06af\u0648 \u0622\u0646\u0644\u0627\u06cc\u0646 nazdika\r\n\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0686\u062a \u0631\u0648\u0645 \u062f\u0631 \u0627\u0637\u0631\u0627\u0641\u06cc\u0627\u0646 \u0634\u0645\u0627\r\n\u0628\u0627 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0646\u0632\u062f\u06cc\u06a9\u0627 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u06af\u067e \u0628\u0632\u0646\u06cc\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc \u0641\u0627\u0631\u0633\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u0627\u0647 \u0639\u0633\u0644\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc nazdika\r\n\u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0686\u062a \u0631\u0648\u0645 \u0628\u0627 \u06a9\u0644\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646\r\n\u062a\u0645\u0627\u0633 \u0635\u0648\u062a\u06cc \u0648\u062a\u0635\u0648\u06cc\u0631\u06cc \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0622\u0646\u0644\u0627\u06cc\u0646\r\n\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645 \u0634\u062e\u0635\u06cc \u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u0627\u0631\u0633\u0627\u0644 \u0648\u06cc\u0633 \u0648 \u0639\u06a9\u0633 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \r\n\u0646\u0632\u062f\u06cc\u06a9\u0627 \u0648\u0631\u0698\u0646 \u062c\u062f\u06cc\u062f \u0642\u062f\u06cc\u0645\r\n\u062c\u0633\u062a\u062c\u0648\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647\r\n\u0628\u0644\u0627\u06a9 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u0632\u0627\u062d\u0645\r\n\u0627\u0645\u06a9\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u062a\u0646\u060c \u0639\u06a9\u0633 \u060c \u0648\u06cc\u0633 \u0648...\r\n\u0631\u0627\u0628\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0622\u0633\u0627\u0646 \u0648 \u0632\u06cc\u0628\u0627\r\n\u0648 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u06cc\u06af\u0631",
    "descriptionHTML": "\u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u0648\u06cc\u0646\u06cc \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0642\u0631\u0627\u0631 \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u0633\u0627\u06cc\u062a \u062c\u062f\u06cc\u062f \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0642\u0631\u0627\u0631 \u0645\u0644\u0627\u0642\u0627\u062a \u062f\u0648 \u0646\u0627\u0634\u0646\u0627\u0633 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0648\u0631\u0698\u0646 \u062c\u062f\u06cc\u062f \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a  blind date <br>\u0645\u0627\u0647 \u0639\u0633\u0644<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc \u0646\u0632\u062f\u06cc\u06a9\u0627<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc\u0627\u0628\u06cc \u0648 \u0686\u062a \u0622\u0646\u0644\u0627\u06cc\u0646<br>\u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u062c\u062f\u06cc\u062f \u0628\u0627 \u06a9\u0644\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646<br>\u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0628\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633<br>\u0686\u062a \u0631\u0648\u0645 \u0645\u0627\u0647 \u0639\u0633\u0644<br>\u0633\u0627\u06cc\u062a \u0648 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0646\u0632\u062f\u06cc\u06a9\u0627 \u062c\u062f\u06cc\u062f <br>\u06af\u067e \u0648 \u06af\u0641\u062a\u06af\u0648 \u0622\u0646\u0644\u0627\u06cc\u0646 nazdika<br>\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0686\u062a \u0631\u0648\u0645 \u062f\u0631 \u0627\u0637\u0631\u0627\u0641\u06cc\u0627\u0646 \u0634\u0645\u0627<br>\u0628\u0627 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0646\u0632\u062f\u06cc\u06a9\u0627 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u06af\u067e \u0628\u0632\u0646\u06cc<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc \u0641\u0627\u0631\u0633\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u0645\u0627\u0647 \u0639\u0633\u0644<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0633\u062a\u06cc nazdika<br>\u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0686\u062a \u0631\u0648\u0645 \u0628\u0627 \u06a9\u0644\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646<br>\u062a\u0645\u0627\u0633 \u0635\u0648\u062a\u06cc \u0648\u062a\u0635\u0648\u06cc\u0631\u06cc \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0622\u0646\u0644\u0627\u06cc\u0646<br>\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645 \u0634\u062e\u0635\u06cc \u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u0627\u0631\u0633\u0627\u0644 \u0648\u06cc\u0633 \u0648 \u0639\u06a9\u0633 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 <br>\u0646\u0632\u062f\u06cc\u06a9\u0627 \u0648\u0631\u0698\u0646 \u062c\u062f\u06cc\u062f \u0642\u062f\u06cc\u0645<br>\u062c\u0633\u062a\u062c\u0648\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647<br>\u0628\u0644\u0627\u06a9 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u0632\u0627\u062d\u0645<br>\u0627\u0645\u06a9\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u062a\u0646\u060c \u0639\u06a9\u0633 \u060c \u0648\u06cc\u0633 \u0648...<br>\u0631\u0627\u0628\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0622\u0633\u0627\u0646 \u0648 \u0632\u06cc\u0628\u0627<br>\u0648 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u06cc\u06af\u0631",
    "summary": "\u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u0648\u06cc\u0646\u06cc \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0642\u0631\u0627\u0631 \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u06cc\u0646\u062f \u062f\u06cc\u062a \u062f\u06cc\u062a \u0646\u0627\u0634\u0646\u0627\u0633  blind date",
