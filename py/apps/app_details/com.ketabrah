{
    "title": "\u06a9\u062a\u0627\u0628\u0631\u0627\u0647: \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0648 \u0635\u0648\u062a\u06cc",
    "description": "\u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0631\u0645\u0627\u0646 \u0648 \u0645\u062c\u0644\u0647 \u062f\u0631 \u062c\u06cc\u0628 \u0634\u0645\u0627\r\n\u00bb \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0631\u0627\u06cc\u06af\u0627\u0646!\r\n\u00bb \u0647\u0645\u06cc\u0634\u0647 \u0647\u0645\u0631\u0627\u0647 \u0648 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633!\r\n\u00bb \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0634\u062e\u0635\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0633\u0627\u0632\u06cc\u062f!\r\n\u00bb \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u06a9\u0634\u0641 \u06a9\u0646\u06cc\u062f!\r\n\r\n\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0627\u0645\u06a9\u0627\u0646 \u062f\u0627\u0646\u0644\u0648\u062f \u0642\u0627\u0646\u0648\u0646\u06cc \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0648 \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0631\u0645\u0627\u0646 \u0648 \u0645\u062c\u0644\u0647 \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0628\u0644\u062a \u0648 \u0631\u0627\u06cc\u0627\u0646\u0647 \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0634\u0645\u0627 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0647\u0645\u06cc\u0634\u0647 \u0648 \u0647\u0645\u0647 \u062c\u0627 \u0628\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u062e\u0648\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f \u0648 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0633\u0627\u062f\u06af\u06cc \u0627\u0632 \u0647\u0631 \u0641\u0631\u0635\u062a\u06cc \u0628\u0631\u0627\u06cc \u0645\u0637\u0627\u0644\u0639\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0645\u0647 \u0633\u0644\u06cc\u0642\u0647\u200c\u0647\u0627 \u0627\u0632 \u062f\u0627\u0633\u062a\u0627\u0646 \u0648 \u0631\u0645\u0627\u0646 \u062a\u0627 \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u06cc \u0648 \u0639\u0644\u0645\u06cc \u0648... \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc\u06cc \u067e\u06cc\u062f\u0627 \u0645\u06cc \u0634\u0648\u062f.\r\n\r\n\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f:\r\n- \u0647\u0631 \u0631\u0648\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0631\u0627 \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f.\r\n- \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0631\u0627 \u0628\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u062e\u0648\u062f \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.\r\n- \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631\u0628\u0627\u0631\u0647 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062b\u0628\u062a \u06a9\u0646\u06cc\u062f.\r\n- \u062f\u06cc\u062f\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631\u0627\u0646 \u062f\u0631 \u0645\u0648\u0631\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.",
    "descriptionHTML": "\u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0631\u0645\u0627\u0646 \u0648 \u0645\u062c\u0644\u0647 \u062f\u0631 \u062c\u06cc\u0628 \u0634\u0645\u0627<br>\u00bb \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0631\u0627\u06cc\u06af\u0627\u0646!<br>\u00bb \u0647\u0645\u06cc\u0634\u0647 \u0647\u0645\u0631\u0627\u0647 \u0648 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633!<br>\u00bb \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0634\u062e\u0635\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0633\u0627\u0632\u06cc\u062f!<br>\u00bb \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u06a9\u0634\u0641 \u06a9\u0646\u06cc\u062f!<br><br>\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0627\u0645\u06a9\u0627\u0646 \u062f\u0627\u0646\u0644\u0648\u062f \u0642\u0627\u0646\u0648\u0646\u06cc \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0648 \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0631\u0645\u0627\u0646 \u0648 \u0645\u062c\u0644\u0647 \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0628\u0644\u062a \u0648 \u0631\u0627\u06cc\u0627\u0646\u0647 \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0634\u0645\u0627 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0647\u0645\u06cc\u0634\u0647 \u0648 \u0647\u0645\u0647 \u062c\u0627 \u0628\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u062e\u0648\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f \u0648 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0633\u0627\u062f\u06af\u06cc \u0627\u0632 \u0647\u0631 \u0641\u0631\u0635\u062a\u06cc \u0628\u0631\u0627\u06cc \u0645\u0637\u0627\u0644\u0639\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0645\u0647 \u0633\u0644\u06cc\u0642\u0647\u200c\u0647\u0627 \u0627\u0632 \u062f\u0627\u0633\u062a\u0627\u0646 \u0648 \u0631\u0645\u0627\u0646 \u062a\u0627 \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u06cc \u0648 \u0639\u0644\u0645\u06cc \u0648... \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc\u06cc \u067e\u06cc\u062f\u0627 \u0645\u06cc \u0634\u0648\u062f.<br><br>\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u06a9\u062a\u0627\u0628\u0631\u0627\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f:<br>- \u0647\u0631 \u0631\u0648\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0631\u0627 \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f.<br>- \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0631\u0627 \u0628\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u062e\u0648\u062f \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.<br>- \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631\u0628\u0627\u0631\u0647 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062b\u0628\u062a \u06a9\u0646\u06cc\u062f.<br>- \u062f\u06cc\u062f\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631\u0627\u0646 \u062f\u0631 \u0645\u0648\u0631\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.",
    "summary": "\u062f\u0627\u0646\u0644\u0648\u062f \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u060c \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0631\u0645\u0627\u0646 \u0648 \u0645\u062c\u0644\u0647",
