{
    "title": "\u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0440\u044f\u0434\u043e\u043c, \u0447\u0430\u0442. RusDate",
    "description": "\u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0445 \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0435 \u0438 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443. \r\nRusDate \u2013 \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0441\u0430\u0439\u0442 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432, \u0433\u0434\u0435 \u0432\u044b \u043d\u0430\u0439\u0434\u0435\u0442\u0435 \u043b\u044e\u0434\u0435\u0439 \u0441 \u043e\u0431\u0449\u0438\u043c\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c\u0438, \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u044f\u043c\u0438. \u041c\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u043c \u0441 2008 \u0433\u043e\u0434\u0430 \u0438 \u0443\u0436\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u043e\u0442\u043d\u0438 \u0442\u044b\u0441\u044f\u0447 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 RusDate \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430 \u043d\u043e\u0432\u044b\u0445 \u0434\u0440\u0443\u0437\u0435\u0439, \u043b\u044e\u0431\u0432\u0438 \u0438 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. \r\n\r\n\u041d\u0430\u0448\u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438:\r\n\r\n\u041f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438 \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441. \u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0430\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 2 \u043c\u0438\u043d\u0443\u0442\u044b. \u041c\u043e\u0436\u043d\u043e \u0432\u0432\u0435\u0441\u0442\u0438 e-mail \u0438\u043b\u0438 \u0432\u043e\u0439\u0442\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u043e\u0446\u0441\u0435\u0442\u0435\u0439. \r\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u043e 30 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0439 \u0432 \u0430\u043d\u043a\u0435\u0442\u0443.\r\n\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u0430\u043d\u043a\u0435\u0442\u044b: \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043f\u0440\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0440\u0435\u0436\u0438\u043c \u0434\u043d\u044f, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0446\u0435\u043b\u0438 \u043f\u043e\u0438\u0441\u043a\u0430, \u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \r\n\u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0432\u044b \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043e \u0441\u0435\u0431\u0435, \u0442\u0435\u043c \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u043d\u0443\u0436\u043d\u043e\u043c\u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443. \r\n\u0423\u0434\u043e\u0431\u043d\u044b\u0439 \u0447\u0430\u0442. \u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u044f\u043c\u043e \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438. \r\n\u042f\u0440\u043a\u0438\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u0438 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b. \u0425\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u0447\u044c \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435? \u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u0437\u0430 \u043c\u043e\u043d\u0435\u0442\u044b, \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0440\u0430\u0432\u043d\u043e\u0434\u0443\u0448\u043d\u044b\u043c! \u0417\u0430\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0439. \r\n\u0411\u043e\u043b\u0435\u0435 100 \u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043d\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0442\u0435\u043c\u044b, \u043f\u0440\u043e\u0445\u043e\u0434\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0441\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u0438\u0442\u0435 \u0442\u0435\u0445 \u043a\u0442\u043e \u0441 \u043f\u043e\u0445\u043e\u0436\u0438\u043c\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c\u0438 \u043d\u0430 \u0436\u0438\u0437\u043d\u044c. \r\n\u0411\u044b\u0441\u0442\u0440\u044b\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u041e\u0446\u0435\u043d\u0438\u0432\u0430\u0439\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0432 \u0438\u0433\u0440\u0435 \u201c\u0421\u0438\u043c\u043f\u0430\u0442\u0438\u0438\u201d. \u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0432\u0437\u0430\u0438\u043c\u043d\u0443\u044e \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u044e - \u0441\u043c\u0435\u043b\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0439\u0442\u0435 \u0431\u0435\u0441\u0435\u0434\u0443. \r\n\u0424\u0438\u043b\u044c\u0442\u0440 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0440\u044f\u0434\u043e\u043c \u0438\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441 \u0444\u043e\u0442\u043e? \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0444\u0438\u043b\u044c\u0442\u0440 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439, \u0438 \u043e\u0431\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u0441 \u0442\u0435\u043c\u0438, \u043a\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0432\u0430\u0448\u0438\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u043f\u043e\u0438\u0441\u043a\u0430!\r\n\u0420\u0435\u0436\u0438\u043c \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043a\u0430. \u0414\u043b\u044f \u0442\u0435\u0445, \u043a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0438\u043d\u043a\u043e\u0433\u043d\u0438\u0442\u043e. \u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0439\u0442\u0435 \u041d\u0435\u0432\u0438\u0434\u0438\u043c\u043a\u0443 \u0438 \u0432\u0430\u0448\u0443 \u0430\u043d\u043a\u0435\u0442\u0443 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u0438\u0434\u043d\u043e \u043d\u0430 \u0441\u0430\u0439\u0442\u0435. \r\n\u0412\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f. \u041c\u044b \u0441\u043b\u0435\u0434\u0438\u043c \u0437\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u0430\u043d\u043d\u044b\u0445, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0441\u0435 \u0430\u043d\u043a\u0435\u0442\u044b \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0432 4 \u044d\u0442\u0430\u043f\u0430: \u043f\u043e \u0444\u043e\u0442\u043e, e-mail, \u043d\u043e\u043c\u0435\u0440\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u043e\u0446\u0441\u0435\u0442\u0435\u0439. \u041f\u043e\u0441\u043b\u0435 - \u043d\u0430\u0448\u0438 \u043c\u043e\u0434\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442 \u0432\u0441\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e, \u044d\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u043e\u0442\u043e\u0432 \u0438 \u0444\u0435\u0439\u043a\u043e\u0432\u044b\u0445 \u0430\u043d\u043a\u0435\u0442. \r\n\u041d\u0430\u0431\u043e\u0440 \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0444\u0440\u0430\u0437 \u0434\u043b\u044f \u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u041d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435, \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u043c\u0441\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c? \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043e\u0434\u043d\u0443 \u0438\u0437 300 \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0444\u0440\u0430\u0437 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043a\u0443\u0441, \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0431\u0435\u0437 \u043e\u0442\u0432\u0435\u0442\u0430!\r\n\u0423\u043c\u043d\u044b\u0439 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442. \u041d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435, \u043e \u0447\u0435\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0441 \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u043e\u043c? \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043e\u043f\u0446\u0438\u044e \u201c\u0423\u043c\u043d\u044b\u0439 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u201d. \u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0435\u0442, \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e.\r\n\u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u043a\u0435\u0442\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0446\u0432\u0435\u0442\u0430. \u0425\u043e\u0442\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u0430\u0441 \u0442\u043e\u0447\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438? \u0412\u044b\u0434\u0435\u043b\u0438\u0442\u0435 \u0430\u043d\u043a\u0435\u0442\u0443 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438\u0437 \u0444\u043e\u0442\u043e, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0438\u0442\u0435 \u043a \u0441\u0435\u0431\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f! \r\n\u0421\u043b\u0443\u0436\u0431\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430 \u0441\u0432\u044f\u0437\u0438 \u0438 \u0433\u043e\u0442\u043e\u0432\u0430 \u043f\u043e\u043c\u043e\u0447\u044c \u043f\u043e \u043b\u044e\u0431\u043e\u043c\u0443 \u0432\u043e\u043f\u0440\u043e\u0441\u0443 - \u043e\u0442 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0438 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0430\u043d\u043a\u0435\u0442\u044b \u0434\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. \r\n\r\n\r\n\u041c\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0441 \u0432\u0430\u043c\u0438, \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430. \u0421\u043c\u0435\u043b\u043e \u043e\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 https://rusdate.net/contact, \u0438\u043b\u0438 \u043f\u0438\u0448\u0438\u0442\u0435 \u043d\u0430 \u043f\u043e\u0447\u0442\u0443: info@datesupport.net.",
    "descriptionHTML": "\u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0445 \u0432 \u0410\u043c\u0435\u0440\u0438\u043a\u0435 \u0438 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443. <br>RusDate \u2013 \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0441\u0430\u0439\u0442 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432, \u0433\u0434\u0435 \u0432\u044b \u043d\u0430\u0439\u0434\u0435\u0442\u0435 \u043b\u044e\u0434\u0435\u0439 \u0441 \u043e\u0431\u0449\u0438\u043c\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c\u0438, \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u044f\u043c\u0438. \u041c\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u043c \u0441 2008 \u0433\u043e\u0434\u0430 \u0438 \u0443\u0436\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u043e\u0442\u043d\u0438 \u0442\u044b\u0441\u044f\u0447 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 RusDate \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430 \u043d\u043e\u0432\u044b\u0445 \u0434\u0440\u0443\u0437\u0435\u0439, \u043b\u044e\u0431\u0432\u0438 \u0438 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. <br><br>\u041d\u0430\u0448\u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438:<br><br>\u041f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438 \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441. \u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0430\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 2 \u043c\u0438\u043d\u0443\u0442\u044b. \u041c\u043e\u0436\u043d\u043e \u0432\u0432\u0435\u0441\u0442\u0438 e-mail \u0438\u043b\u0438 \u0432\u043e\u0439\u0442\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u043e\u0446\u0441\u0435\u0442\u0435\u0439. <br>\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u043e 30 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0439 \u0432 \u0430\u043d\u043a\u0435\u0442\u0443.<br>\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0435 \u0430\u043d\u043a\u0435\u0442\u044b: \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043f\u0440\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0432\u0437\u0433\u043b\u044f\u0434\u044b \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0440\u0435\u0436\u0438\u043c \u0434\u043d\u044f, \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0446\u0435\u043b\u0438 \u043f\u043e\u0438\u0441\u043a\u0430, \u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u044c \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. <br>\u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0432\u044b \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043e \u0441\u0435\u0431\u0435, \u0442\u0435\u043c \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u043d\u0443\u0436\u043d\u043e\u043c\u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443. <br>\u0423\u0434\u043e\u0431\u043d\u044b\u0439 \u0447\u0430\u0442. \u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u044f\u043c\u043e \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438. <br>\u042f\u0440\u043a\u0438\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u0438 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b. \u0425\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u0447\u044c \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435? \u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u0437\u0430 \u043c\u043e\u043d\u0435\u0442\u044b, \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0440\u0430\u0432\u043d\u043e\u0434\u0443\u0448\u043d\u044b\u043c! \u0417\u0430\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0439. <br>\u0411\u043e\u043b\u0435\u0435 100 \u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043d\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0442\u0435\u043c\u044b, \u043f\u0440\u043e\u0445\u043e\u0434\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0441\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u0438\u0442\u0435 \u0442\u0435\u0445 \u043a\u0442\u043e \u0441 \u043f\u043e\u0445\u043e\u0436\u0438\u043c\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u0430\u043c\u0438 \u043d\u0430 \u0436\u0438\u0437\u043d\u044c. <br>\u0411\u044b\u0441\u0442\u0440\u044b\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u041e\u0446\u0435\u043d\u0438\u0432\u0430\u0439\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0432 \u0438\u0433\u0440\u0435 \u201c\u0421\u0438\u043c\u043f\u0430\u0442\u0438\u0438\u201d. \u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0432\u0437\u0430\u0438\u043c\u043d\u0443\u044e \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u044e - \u0441\u043c\u0435\u043b\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0439\u0442\u0435 \u0431\u0435\u0441\u0435\u0434\u0443. <br>\u0424\u0438\u043b\u044c\u0442\u0440 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0440\u044f\u0434\u043e\u043c \u0438\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441 \u0444\u043e\u0442\u043e? \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0444\u0438\u043b\u044c\u0442\u0440 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439, \u0438 \u043e\u0431\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u0441 \u0442\u0435\u043c\u0438, \u043a\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0432\u0430\u0448\u0438\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u043f\u043e\u0438\u0441\u043a\u0430!<br>\u0420\u0435\u0436\u0438\u043c \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043a\u0430. \u0414\u043b\u044f \u0442\u0435\u0445, \u043a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0438\u043d\u043a\u043e\u0433\u043d\u0438\u0442\u043e. \u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0439\u0442\u0435 \u041d\u0435\u0432\u0438\u0434\u0438\u043c\u043a\u0443 \u0438 \u0432\u0430\u0448\u0443 \u0430\u043d\u043a\u0435\u0442\u0443 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u0438\u0434\u043d\u043e \u043d\u0430 \u0441\u0430\u0439\u0442\u0435. <br>\u0412\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f. \u041c\u044b \u0441\u043b\u0435\u0434\u0438\u043c \u0437\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u0430\u043d\u043d\u044b\u0445, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0441\u0435 \u0430\u043d\u043a\u0435\u0442\u044b \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0432 4 \u044d\u0442\u0430\u043f\u0430: \u043f\u043e \u0444\u043e\u0442\u043e, e-mail, \u043d\u043e\u043c\u0435\u0440\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u043e\u0446\u0441\u0435\u0442\u0435\u0439. \u041f\u043e\u0441\u043b\u0435 - \u043d\u0430\u0448\u0438 \u043c\u043e\u0434\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442 \u0432\u0441\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e, \u044d\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u043e\u0442\u043e\u0432 \u0438 \u0444\u0435\u0439\u043a\u043e\u0432\u044b\u0445 \u0430\u043d\u043a\u0435\u0442. <br>\u041d\u0430\u0431\u043e\u0440 \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0444\u0440\u0430\u0437 \u0434\u043b\u044f \u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u041d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435, \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u043c\u0441\u044f \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c? \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043e\u0434\u043d\u0443 \u0438\u0437 300 \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0444\u0440\u0430\u0437 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043a\u0443\u0441, \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0431\u0435\u0437 \u043e\u0442\u0432\u0435\u0442\u0430!<br>\u0423\u043c\u043d\u044b\u0439 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442. \u041d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435, \u043e \u0447\u0435\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0441 \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u043e\u043c? \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043e\u043f\u0446\u0438\u044e \u201c\u0423\u043c\u043d\u044b\u0439 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u201d. \u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0435\u0442, \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e.<br>\u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u043a\u0435\u0442\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0446\u0432\u0435\u0442\u0430. \u0425\u043e\u0442\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u0430\u0441 \u0442\u043e\u0447\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438? \u0412\u044b\u0434\u0435\u043b\u0438\u0442\u0435 \u0430\u043d\u043a\u0435\u0442\u0443 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438\u0437 \u0444\u043e\u0442\u043e, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0438\u0442\u0435 \u043a \u0441\u0435\u0431\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f! <br>\u0421\u043b\u0443\u0436\u0431\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430 \u0441\u0432\u044f\u0437\u0438 \u0438 \u0433\u043e\u0442\u043e\u0432\u0430 \u043f\u043e\u043c\u043e\u0447\u044c \u043f\u043e \u043b\u044e\u0431\u043e\u043c\u0443 \u0432\u043e\u043f\u0440\u043e\u0441\u0443 - \u043e\u0442 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0438 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0430\u043d\u043a\u0435\u0442\u044b \u0434\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. <br><br><br>\u041c\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0441 \u0432\u0430\u043c\u0438, \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430. \u0421\u043c\u0435\u043b\u043e \u043e\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 https://rusdate.net/contact, \u0438\u043b\u0438 \u043f\u0438\u0448\u0438\u0442\u0435 \u043d\u0430 \u043f\u043e\u0447\u0442\u0443: info@datesupport.net.",
    "summary": "\u0421\u0430\u0439\u0442 \u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432 \u0434\u043b\u044f \u0440\u0443\u0441\u0441\u043a\u043e\u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0445 \u0432 \u0421\u0428\u0410. \u0417\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u043b\u0435\u0433\u043a\u043e",
