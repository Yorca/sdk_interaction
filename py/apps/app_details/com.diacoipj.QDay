{
    "title": "QDay \u062c\u0627\u06cc\u0632\u0647 \u0646\u0642\u062f\u06cc\u200e | \u06a9\u06cc\u0648\u062f\u06cc \u0628\u0627\u0632\u06cc ",
    "description": "\u06a9\u06cc\u0648\u062f\u06cc \u06cc\u06a9 \u0628\u0627\u0632\u06cc \u0647\u06cc\u062c\u0627\u0646 \u0627\u0646\u06af\u06cc\u0632 \u0633\u0648\u0627\u0644 \u0648 \u062c\u0648\u0627\u0628 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0628\u0627\u0632\u06cc \u06a9\u0631\u062f\u0646 \u0648 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0639\u0645\u0648\u0645\u06cc\u062a \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631\u0646\u062f\u0647 \u0628\u0634\u06cc...\r\n\r\n\u062f\u0631 \u0647\u06cc\u062c\u0627\u0646  \u0628\u0627\u0632\u06cc \u063a\u0631\u0642 \u0634\u0648 \u0648 \u062c\u0627\u06cc\u0632\u0647 \u0628\u0631\u0646\u062f\u0647 \u0634\u0648 \r\n\r\n\u0647\u0631 \u0686\u06cc \u0627\u0645\u062a\u06cc\u0627\u0632  \u0628\u06cc\u0634\u062a\u0631\u06cc \u062f\u0631 \u0644\u06cc\u06af \u0647\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc \u0645\u06cc\u062a\u0648\u0646\u06cc \u062a\u0648\u06cc \u062c\u062f\u0648\u0644 \u0645\u0627 \u0628\u0627\u0644\u0627\u062a\u0631 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0631\u0627\u062d\u062a \u062a\u0631 \u0628\u0631\u0646\u062f\u0647 \u0628\u0634\u06cc\r\n\r\n\r\n\u0628\u0627 \u06a9\u06cc\u0648\u062f\u06cc \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0627\u0648\u0642\u0627\u062a \u0641\u0631\u0627\u063a\u062a\u062a \u0631\u0648 \u067e\u0631 \u06a9\u0646\u06cc \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631\u0646\u062f\u0647 \u062c\u0627\u06cc\u0632\u0647 \u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0648\u06cc\u0698\u0647 \u0645\u0627 \u0628\u0627\u0634\u06cc - \u0633\u06a9\u0647 \u0647\u0627\u06cc \u0631\u0627\u06cc\u06af\u0627\u0646\u062a \u0631\u0648 \u0647\u0631 \u0631\u0648\u0632 \u0628\u06af\u06cc\u0631 \u0648 \u0628\u0627\u0632\u06cc \u06a9\u0646\r\n\r\n\r\n-  \u0644\u06cc\u06af \u0647\u0627\u06cc \u0648\u06cc\u0698\u0647 \u0628\u0627 \u062c\u0648\u0627\u06cc\u0632 \u0645\u06cc\u0644\u06cc\u0648\u0646\u06cc \u0628\u0627 \u0648\u0627\u0631\u06cc\u0632 \u0641\u0648\u0631\u06cc\r\n- \u0686\u0627\u0644\u0634 \u0631\u0648\u0632\u0627\u0646\u0647\r\n- \u06af\u0631\u062f\u0648\u0646\u0647 \u0634\u0627\u0646\u0633 \u0648 \u062c\u0639\u0628\u0647 \u0631\u0648\u0632\u0627\u0646\u0647\r\n\r\n\r\n\u06a9\u06cc\u0648\u062f\u06cc \u0634\u0627\u0645\u0644 \u0644\u06cc\u06af \u0648\u06cc\u0698\u0647 \u0648 \u0644\u06cc\u06af \u0633\u0631\u0639\u062a\u06cc \u0645\u06cc\u0628\u0627\u0634\u062f \u060c \u0627\u0632 \u0686\u0627\u0644\u0634 \u0647\u0627\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0647\u0645 \u063a\u0627\u0641\u0644 \u0646\u0634\u0648!\r\n\r\n\r\n\u0644\u06cc\u06af \u062c\u0630\u0627\u0628 \u0648\u06cc\u0698\u0647  \u06a9\u0647 \u0631\u0648\u0632\u0627\u0646\u0647 \u0628\u0631\u06af\u0632\u0627\u0631 \u0645\u06cc\u0634\u0648\u062f \u0647\u0645 \u0627\u0632 \u062c\u0630\u0627\u0628\u06cc\u062a \u0647\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0627\u0632\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0634\u0627\u0645\u0644 \u062f\u0648 \u0645\u062f\u0644 \u0628\u0627\u0632\u06cc \" \u0648\u06cc\u0698\u0647  \u0648 \u0633\u0631\u0639\u062a\u06cc \" \u0645\u06cc\u0628\u0627\u0634\u062f \u06a9\u0647 \u062c\u0648\u0627\u06cc\u0632 \u0628\u0633\u06cc\u0627\u0631 \u0641\u0648\u0642 \u0627\u0644\u0639\u0627\u062f\u0647 \u0627\u06cc \u062f\u0627\u0631\u0646\u062f",
    "descriptionHTML": "\u06a9\u06cc\u0648\u062f\u06cc \u06cc\u06a9 \u0628\u0627\u0632\u06cc \u0647\u06cc\u062c\u0627\u0646 \u0627\u0646\u06af\u06cc\u0632 \u0633\u0648\u0627\u0644 \u0648 \u062c\u0648\u0627\u0628 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0628\u0627\u0632\u06cc \u06a9\u0631\u062f\u0646 \u0648 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0639\u0645\u0648\u0645\u06cc\u062a \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631\u0646\u062f\u0647 \u0628\u0634\u06cc...<br><br>\u062f\u0631 \u0647\u06cc\u062c\u0627\u0646  \u0628\u0627\u0632\u06cc \u063a\u0631\u0642 \u0634\u0648 \u0648 \u062c\u0627\u06cc\u0632\u0647 \u0628\u0631\u0646\u062f\u0647 \u0634\u0648 <br><br>\u0647\u0631 \u0686\u06cc \u0627\u0645\u062a\u06cc\u0627\u0632  \u0628\u06cc\u0634\u062a\u0631\u06cc \u062f\u0631 \u0644\u06cc\u06af \u0647\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc \u0645\u06cc\u062a\u0648\u0646\u06cc \u062a\u0648\u06cc \u062c\u062f\u0648\u0644 \u0645\u0627 \u0628\u0627\u0644\u0627\u062a\u0631 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0631\u0627\u062d\u062a \u062a\u0631 \u0628\u0631\u0646\u062f\u0647 \u0628\u0634\u06cc<br><br><br>\u0628\u0627 \u06a9\u06cc\u0648\u062f\u06cc \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0627\u0648\u0642\u0627\u062a \u0641\u0631\u0627\u063a\u062a\u062a \u0631\u0648 \u067e\u0631 \u06a9\u0646\u06cc \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631\u0646\u062f\u0647 \u062c\u0627\u06cc\u0632\u0647 \u0647\u0627\u06cc \u062c\u0630\u0627\u0628 \u0648 \u0648\u06cc\u0698\u0647 \u0645\u0627 \u0628\u0627\u0634\u06cc - \u0633\u06a9\u0647 \u0647\u0627\u06cc \u0631\u0627\u06cc\u06af\u0627\u0646\u062a \u0631\u0648 \u0647\u0631 \u0631\u0648\u0632 \u0628\u06af\u06cc\u0631 \u0648 \u0628\u0627\u0632\u06cc \u06a9\u0646<br><br><br>-  \u0644\u06cc\u06af \u0647\u0627\u06cc \u0648\u06cc\u0698\u0647 \u0628\u0627 \u062c\u0648\u0627\u06cc\u0632 \u0645\u06cc\u0644\u06cc\u0648\u0646\u06cc \u0628\u0627 \u0648\u0627\u0631\u06cc\u0632 \u0641\u0648\u0631\u06cc<br>- \u0686\u0627\u0644\u0634 \u0631\u0648\u0632\u0627\u0646\u0647<br>- \u06af\u0631\u062f\u0648\u0646\u0647 \u0634\u0627\u0646\u0633 \u0648 \u062c\u0639\u0628\u0647 \u0631\u0648\u0632\u0627\u0646\u0647<br><br><br>\u06a9\u06cc\u0648\u062f\u06cc \u0634\u0627\u0645\u0644 \u0644\u06cc\u06af \u0648\u06cc\u0698\u0647 \u0648 \u0644\u06cc\u06af \u0633\u0631\u0639\u062a\u06cc \u0645\u06cc\u0628\u0627\u0634\u062f \u060c \u0627\u0632 \u0686\u0627\u0644\u0634 \u0647\u0627\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0647\u0645 \u063a\u0627\u0641\u0644 \u0646\u0634\u0648!<br><br><br>\u0644\u06cc\u06af \u062c\u0630\u0627\u0628 \u0648\u06cc\u0698\u0647  \u06a9\u0647 \u0631\u0648\u0632\u0627\u0646\u0647 \u0628\u0631\u06af\u0632\u0627\u0631 \u0645\u06cc\u0634\u0648\u062f \u0647\u0645 \u0627\u0632 \u062c\u0630\u0627\u0628\u06cc\u062a \u0647\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0627\u0632\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0634\u0627\u0645\u0644 \u062f\u0648 \u0645\u062f\u0644 \u0628\u0627\u0632\u06cc &quot; \u0648\u06cc\u0698\u0647  \u0648 \u0633\u0631\u0639\u062a\u06cc &quot; \u0645\u06cc\u0628\u0627\u0634\u062f \u06a9\u0647 \u062c\u0648\u0627\u06cc\u0632 \u0628\u0633\u06cc\u0627\u0631 \u0641\u0648\u0642 \u0627\u0644\u0639\u0627\u062f\u0647 \u0627\u06cc \u062f\u0627\u0631\u0646\u062f",
    "summary": "\u0644\u06cc\u06af \u0647\u0627\u06cc \u0648\u06cc\u0698\u0647 \u0628\u0627 \u062c\u0648\u0627\u06cc\u0632 \u0645\u06cc\u0644\u06cc\u0648\u0646\u06cc \u0628\u0627 \u0648\u0627\u0631\u06cc\u0632 \u0641\u0648\u0631\u06cc",
