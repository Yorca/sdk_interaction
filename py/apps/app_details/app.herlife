{
    "title": "Herlife-\u0647\u0631\u0644\u0627\u06cc\u0641",
    "description": "\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u067e\u0631\u06cc\u0648\u062f \u0648 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0647\u0631\u0644\u0627\u06cc\u0641\r\n\r\n\u0647\u0650\u0631\u0644\u0627\u06cc\u0641 \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u06c0 \u067e\u0631\u06cc\u0648\u062f \u062a\u0631\u06a9\u0631 (\u062a\u0642\u0648\u06cc\u0645 \u0642\u0627\u0639\u062f\u06af\u06cc) \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0627\u0633\u062a. \u00ab\u062a\u0642\u0648\u06cc\u0645 \u067e\u0631\u06cc\u0648\u062f\u060c \u062a\u0642\u0648\u06cc\u0645 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc\u060c \u0645\u062d\u0627\u0633\u0628\u06c0 \u0633\u06cc\u06a9\u0644 \u0642\u0627\u0639\u062f\u06af\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646\u060c \u0645\u0634\u0627\u0648\u0631\u0647 \u0648 \u0648\u06cc\u0632\u06cc\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0628\u0627 \u067e\u0632\u0634\u06a9\u060c \u0645\u0634\u0627\u0647\u062f\u06c0 \u0648\u0636\u0639\u06cc\u062a \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc\u060c \u0639\u0644\u0627\u0626\u0645 \u067e\u0631\u06cc\u0648\u062f\u060c \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS)\u060c \u067e\u0646\u062c\u0631\u06c0 \u0628\u0627\u0631\u0648\u0631\u06cc \u0648 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc\u00bb \u0627\u0632 \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0647\u0645 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0647\u0633\u062a\u0646\u062f.\u00a0\r\n\r\n\u062f\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0647\u0631\u0644\u0627\u06cc\u0641\u060c \u062d\u062a\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc \u06cc\u0627 \u00ab\u0647\u0645\u0631\u0627\u0647\u00bb \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062c\u0631\u06cc\u0627\u0646 \u00ab\u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f\u060c\u00a0 \u0648\u0636\u0639\u06cc\u062a \u0631\u0648\u062d\u06cc \u0648 \u062c\u0633\u0645\u06cc\u00bb \u062e\u0648\u062f \u0642\u0631\u0627\u0631 \u062f\u0647\u06cc\u062f \u062a\u0627 \u0628\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc\u060c \u0628\u06cc\u0634\u062a\u0631 \u0645\u0631\u0627\u0642\u0628 \u0634\u0645\u0627 \u0628\u0627\u0634\u062f.\r\n\r\n\u200f\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0647\u0631\u0644\u0627\u06cc\u0641 \u0628\u0631\u0627\u06cc \u0627\u0646\u062f\u0631\u0648\u06cc\u062f:\r\n\r\n\r\n\u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0648\u0631\u0647 \u0648 \u0648\u06cc\u0632\u06cc\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u062f\u0631 \u0628\u062e\u0634 \u00ab\u06a9\u0644\u06cc\u0646\u06cc\u06a9\u00bb \u0628\u0627 \u067e\u0632\u0634\u06a9\u200c\u0647\u0627\u06cc \u0645\u062a\u062e\u0635\u0635\r\n\r\n\u0648\u062c\u0648\u062f \u062f\u0633\u062a\u0647 \u0628\u0646\u062f\u06cc\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639 \u062f\u0631 \u06a9\u0644\u06cc\u0646\u06cc\u06a9 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0645\u0627\u0646\u0646\u062f: \u00ab\u0632\u0646\u0627\u0646 \u0648 \u0632\u0627\u06cc\u0645\u0627\u0646\u060c \u067e\u0648\u0633\u062a \u0648 \u0645\u0648\u060c \u062a\u063a\u0630\u06cc\u0647 \u0648 \u062f\u0627\u062e\u0644\u06cc\u00bb\r\n\r\n\u200f\u2022 \u062b\u0628\u062a \u062a\u0627\u0631\u06cc\u062e \u067e\u0631\u06cc\u0648\u062f\u060c \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0648 \u062a\u062d\u0644\u06cc\u0644 \u0639\u0627\u062f\u062a \u0645\u0627\u0647\u0627\u0646\u0647 (\u062a\u0642\u0648\u06cc\u0645 \u0642\u0627\u0639\u062f\u06af\u06cc)\r\n\r\n\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u0634 \u0628\u06cc\u0646\u06cc \u0632\u0645\u0627\u0646 \u062f\u0642\u06cc\u0642 \u067e\u0631\u06cc\u0648\u062f \u0628\u0639\u062f\u06cc\r\n\r\n\u067e\u06cc\u0634 \u0628\u06cc\u0646\u06cc \u0632\u0645\u0627\u0646 \u0645\u0646\u0627\u0633\u0628 \u0628\u0627\u0631\u0648\u0631\u06cc \u0648 \u062a\u062e\u0645\u06cc\u0646 \u0631\u0648\u0632 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc\r\n\r\n\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0627\u062d\u062a\u0645\u0627\u0644 \u0628\u0631\u0648\u0632 \u0639\u0644\u0627\u0626\u0645 \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS) \u0648 \u0631\u0627\u0647\u200c\u0647\u0627\u06cc \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u0622\u0646\r\n\r\n\u200f\u2022 \u062b\u0628\u062a \u062d\u0627\u0644\u0627\u062a \u0631\u0648\u062d\u06cc \u0648 \u062c\u0633\u0645\u06cc\u060c \u0648 \u0639\u0644\u0627\u0626\u0645 \u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0628\u0647 \u0635\u0648\u0631\u062a \u0631\u0648\u0632\u0627\u0646\u0647 \u0645\u0627\u0646\u0646\u062f: \u00ab\u062a\u0631\u0634\u062d\u0627\u062a \u0648\u0627\u0698\u0646\u060c \u062f\u0631\u062f \u067e\u0633\u062a\u0627\u0646 \u0648 \u0646\u0648\u0633\u0627\u0646\u0627\u062a \u062e\u0644\u0642\u06cc\u00bb\r\n\r\n\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0647\u062f\u06c0 \u0631\u0634\u062a\u0647 \u0627\u0633\u062a\u0648\u0631\u06cc\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0648\u0632\u0627\u0646\u0647\u060c \u062a\u0648\u0635\u06cc\u0647\u200c\u0647\u0627\u06cc \u0639\u0644\u0645\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0648\u0636\u0639\u06cc\u062a \u062c\u0633\u0645\u0627\u0646\u06cc \u0648 \u062d\u0627\u0644 \u0631\u0648\u062d\u06cc \u0634\u0645\u0627 \u0648 \u0639\u0644\u0627\u0626\u0645 \u0631\u0648\u0632\u0627\u0646\u0647\r\n\r\n\u200f\u2022 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06af\u0630\u0627\u0631\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc\u060c \u0634\u0631\u0648\u0639 \u0633\u0646\u062f\u0631\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS)\u060c \u067e\u0631\u06cc\u0648\u062f \u0648 \u062a\u062e\u0645\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u0628\u0627 \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc (\u0647\u0645\u0631\u0627\u0647)\r\n\r\n\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0648 \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u062d\u0627\u0644 \u0648 \u0631\u0648\u0632 \u0634\u0645\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0648\u06cc\u0698\u06af\u06cc \u00ab\u0647\u0645\u0631\u0627\u0647\u00bb \u0628\u0631\u0627\u06cc \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc\u200c\u062a\u0627\u0646\u00a0\r\n\r\n\u200f\u2022 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0645\u0642\u0627\u0644\u0627\u062a \u0639\u0644\u0645\u06cc \u0648 \u0645\u0648\u0631\u062f \u062a\u0623\u06cc\u06cc\u062f \u067e\u0632\u0634\u06a9\u060c \u062f\u0631\u0628\u0627\u0631\u06c0 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0648\u0636\u0639\u06cc\u062a \u062c\u0633\u0645\u06cc \u0648 \u0631\u0648\u062d\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0647\u0631 \u0631\u0648\u0632\r\n\r\n\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u062f\u0631\u06cc\u0627\u0641\u062a \u06af\u0632\u0627\u0631\u0634 \u062a\u062d\u0644\u06cc\u0644\u06cc \u0627\u0632 \u0648\u0636\u0639\u06cc\u062a \u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0648 \u0639\u0644\u0627\u0626\u0645 \u062c\u0633\u0645\u06cc \u0648 \u0631\u0648\u062d\u06cc \u0628\u0631\u0627\u06cc \u062f\u0631\u06a9 \u0628\u0647\u062a\u0631 \u0627\u0644\u06af\u0648\u06cc \u0628\u062f\u0646\u06cc \u0645\u0646\u062d\u0635\u0631 \u0628\u0647 \u0641\u0631\u062f \u0648 \u0627\u0631\u0627\u0626\u0647 \u0628\u0647 \u067e\u0632\u0634\u06a9 \u062e\u0648\u062f\r\n\r\n\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u067e\u0631\u0633\u0634 \u0648 \u067e\u0627\u0633\u062e \u0648 \u062a\u0628\u0627\u062f\u0644 \u062a\u062c\u0631\u0628\u0647 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0627\u0645\u0644\u0627\u064b \u0646\u0627\u0634\u0646\u0627\u0633 \u062f\u0631 \u0641\u0636\u0627\u06cc \u0627\u0645\u0646 \u00ab\u067e\u0631\u0633\u200c\u0648\u06af\u0648\u00bb\r\n\r\n\u200f\u2022 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0628\u0627 \u067e\u0634\u062a\u0648\u0627\u0646\u06c0 \u0639\u0644\u0645\u06cc \u0648 \u0628\u0627 \u0647\u0645\u0631\u0627\u0647\u06cc \u062a\u06cc\u0645 \u067e\u0632\u0634\u06a9\u06cc \u062e\u0648\u062f\u060c \u0628\u0647 \u0633\u0624\u0627\u0644\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u062a\u063a\u06cc\u06cc\u0631 \u00ab\u062e\u0644\u0642\u200c \u0648\u200c \u062e\u0648\u060c \u0633\u0637\u062d \u0627\u0646\u0631\u0698\u06cc\u060c \u067e\u0648\u0633\u062a \u0648 \u0645\u0648\u060c \u062f\u0633\u062a\u06af\u0627\u0647 \u06af\u0648\u0627\u0631\u0634\u06cc \u0648 \u062f\u06cc\u06af\u0631 \u0639\u0644\u0627\u0626\u0645 \u067e\u0631\u06cc\u0648\u062f\u06cc\u00bb \u062f\u0631 \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc \u067e\u0627\u0633\u062e \u0645\u06cc\u200c\u062f\u0647\u062f.\r\n\r\n\u00a0\u067e\u0627\u0633\u062e \u0633\u0624\u0627\u0644\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0628\u062e\u0634 \u06a9\u0644\u06cc\u0646\u06cc\u06a9\u060c \u067e\u0631\u0633\u200c\u0648\u06af\u0648 \u06cc\u0627 \u062f\u0631 \u0628\u062e\u0634 \u0645\u0642\u0627\u0644\u0627\u062a \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.\r\n\r\n\u200f\u2022 \u0628\u062e\u0634 \u00ab\u067e\u0631\u0633\u200c\u0648\u06af\u0648\u00bb \u062f\u0631 \u0647\u0631\u0644\u0627\u06cc\u0641\u060c \u0641\u0636\u0627\u06cc\u06cc \u0627\u0645\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647 \u0634\u0645\u0627 \u0627\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646 \u0631\u0627 \u0645\u06cc\u200c\u062f\u0647\u062f \u062a\u0627 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0648 \u0628\u0647 \u0635\u0648\u0631\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0627 \u067e\u0632\u0634\u06a9 \u06af\u0641\u062a\u06af\u0648 \u06a9\u0646\u06cc\u062f. \u0647\u0645\u06cc\u0646\u200c\u0637\u0648\u0631 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062a\u0639\u0627\u0645\u0644 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f\u060c \u0648 \u062a\u062c\u0631\u0628\u06cc\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u067e\u0631\u06cc\u0648\u062f \u0648 \u0633\u0644\u0627\u0645\u062a\u06cc \u0628\u0627 \u06cc\u06a9\u062f\u06cc\u06af\u0631 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.\r\n\r\n\u200f\u0627\u06af\u0631 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0631\u0647\u06af\u06cc\u0631\u06cc \u067e\u0631\u06cc\u0648\u062f (Period Tracker) \u0628\u0631\u0627\u06cc \u062b\u0628\u062a \u0648 \u0628\u0631\u0631\u0633\u06cc \u067e\u0631\u06cc\u0648\u062f\u060c \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc \u06cc\u0627 \u062a\u062e\u0645\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u0647\u0633\u062a\u06cc\u062f \u06cc\u0627 \u0635\u0631\u0641\u0627\u064b \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0628\u062f\u0646 \u062e\u0648\u062f \u0631\u0627 \u0628\u06cc\u0634\u062a\u0631 \u0628\u0634\u0646\u0627\u0633\u06cc\u062f\u060c \u0647\u0631\u0644\u0627\u06cc\u0641 \u06a9\u0646\u0627\u0631 \u0634\u0645\u0627\u0633\u062a \u062a\u0627 \u0628\u0627 \u0647\u0645 \u062f\u0644\u06cc\u060c \u0622\u06af\u0627\u0647\u06cc \u062f\u0627\u062f\u0646 \u0648 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0633\u0628\u06a9 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u062f\u06af\u06cc \u0648 \u062a\u0639\u0627\u062f\u0644 \u0631\u0627 \u0628\u0647 \u0632\u0646\u062f\u06af\u06cc \u0634\u0645\u0627 \u0647\u062f\u06cc\u0647 \u062f\u0647\u062f.",
    "descriptionHTML": "\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u067e\u0631\u06cc\u0648\u062f \u0648 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0647\u0631\u0644\u0627\u06cc\u0641<br><br>\u0647\u0650\u0631\u0644\u0627\u06cc\u0641 \u06cc\u06a9 \u0628\u0631\u0646\u0627\u0645\u06c0 \u067e\u0631\u06cc\u0648\u062f \u062a\u0631\u06a9\u0631 (\u062a\u0642\u0648\u06cc\u0645 \u0642\u0627\u0639\u062f\u06af\u06cc) \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0627\u0633\u062a. \u00ab\u062a\u0642\u0648\u06cc\u0645 \u067e\u0631\u06cc\u0648\u062f\u060c \u062a\u0642\u0648\u06cc\u0645 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc\u060c \u0645\u062d\u0627\u0633\u0628\u06c0 \u0633\u06cc\u06a9\u0644 \u0642\u0627\u0639\u062f\u06af\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646\u060c \u0645\u0634\u0627\u0648\u0631\u0647 \u0648 \u0648\u06cc\u0632\u06cc\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u0628\u0627 \u067e\u0632\u0634\u06a9\u060c \u0645\u0634\u0627\u0647\u062f\u06c0 \u0648\u0636\u0639\u06cc\u062a \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc\u060c \u0639\u0644\u0627\u0626\u0645 \u067e\u0631\u06cc\u0648\u062f\u060c \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS)\u060c \u067e\u0646\u062c\u0631\u06c0 \u0628\u0627\u0631\u0648\u0631\u06cc \u0648 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc\u00bb \u0627\u0632 \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0647\u0645 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0647\u0633\u062a\u0646\u062f.\u00a0<br><br>\u062f\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0647\u0631\u0644\u0627\u06cc\u0641\u060c \u062d\u062a\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc \u06cc\u0627 \u00ab\u0647\u0645\u0631\u0627\u0647\u00bb \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062c\u0631\u06cc\u0627\u0646 \u00ab\u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f\u060c\u00a0 \u0648\u0636\u0639\u06cc\u062a \u0631\u0648\u062d\u06cc \u0648 \u062c\u0633\u0645\u06cc\u00bb \u062e\u0648\u062f \u0642\u0631\u0627\u0631 \u062f\u0647\u06cc\u062f \u062a\u0627 \u0628\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc\u060c \u0628\u06cc\u0634\u062a\u0631 \u0645\u0631\u0627\u0642\u0628 \u0634\u0645\u0627 \u0628\u0627\u0634\u062f.<br><br>\u200f\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0647\u0631\u0644\u0627\u06cc\u0641 \u0628\u0631\u0627\u06cc \u0627\u0646\u062f\u0631\u0648\u06cc\u062f:<br><br><br>\u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0648\u0631\u0647 \u0648 \u0648\u06cc\u0632\u06cc\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u062f\u0631 \u0628\u062e\u0634 \u00ab\u06a9\u0644\u06cc\u0646\u06cc\u06a9\u00bb \u0628\u0627 \u067e\u0632\u0634\u06a9\u200c\u0647\u0627\u06cc \u0645\u062a\u062e\u0635\u0635<br><br>\u0648\u062c\u0648\u062f \u062f\u0633\u062a\u0647 \u0628\u0646\u062f\u06cc\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639 \u062f\u0631 \u06a9\u0644\u06cc\u0646\u06cc\u06a9 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0645\u0627\u0646\u0646\u062f: \u00ab\u0632\u0646\u0627\u0646 \u0648 \u0632\u0627\u06cc\u0645\u0627\u0646\u060c \u067e\u0648\u0633\u062a \u0648 \u0645\u0648\u060c \u062a\u063a\u0630\u06cc\u0647 \u0648 \u062f\u0627\u062e\u0644\u06cc\u00bb<br><br>\u200f\u2022 \u062b\u0628\u062a \u062a\u0627\u0631\u06cc\u062e \u067e\u0631\u06cc\u0648\u062f\u060c \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0648 \u062a\u062d\u0644\u06cc\u0644 \u0639\u0627\u062f\u062a \u0645\u0627\u0647\u0627\u0646\u0647 (\u062a\u0642\u0648\u06cc\u0645 \u0642\u0627\u0639\u062f\u06af\u06cc)<br><br>\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u0634 \u0628\u06cc\u0646\u06cc \u0632\u0645\u0627\u0646 \u062f\u0642\u06cc\u0642 \u067e\u0631\u06cc\u0648\u062f \u0628\u0639\u062f\u06cc<br><br>\u067e\u06cc\u0634 \u0628\u06cc\u0646\u06cc \u0632\u0645\u0627\u0646 \u0645\u0646\u0627\u0633\u0628 \u0628\u0627\u0631\u0648\u0631\u06cc \u0648 \u062a\u062e\u0645\u06cc\u0646 \u0631\u0648\u0632 \u062a\u062e\u0645\u06a9 \u06af\u0630\u0627\u0631\u06cc<br><br>\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0627\u062d\u062a\u0645\u0627\u0644 \u0628\u0631\u0648\u0632 \u0639\u0644\u0627\u0626\u0645 \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS) \u0648 \u0631\u0627\u0647\u200c\u0647\u0627\u06cc \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u0622\u0646<br><br>\u200f\u2022 \u062b\u0628\u062a \u062d\u0627\u0644\u0627\u062a \u0631\u0648\u062d\u06cc \u0648 \u062c\u0633\u0645\u06cc\u060c \u0648 \u0639\u0644\u0627\u0626\u0645 \u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0628\u0647 \u0635\u0648\u0631\u062a \u0631\u0648\u0632\u0627\u0646\u0647 \u0645\u0627\u0646\u0646\u062f: \u00ab\u062a\u0631\u0634\u062d\u0627\u062a \u0648\u0627\u0698\u0646\u060c \u062f\u0631\u062f \u067e\u0633\u062a\u0627\u0646 \u0648 \u0646\u0648\u0633\u0627\u0646\u0627\u062a \u062e\u0644\u0642\u06cc\u00bb<br><br>\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0647\u062f\u06c0 \u0631\u0634\u062a\u0647 \u0627\u0633\u062a\u0648\u0631\u06cc\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0648\u0632\u0627\u0646\u0647\u060c \u062a\u0648\u0635\u06cc\u0647\u200c\u0647\u0627\u06cc \u0639\u0644\u0645\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0648\u0636\u0639\u06cc\u062a \u062c\u0633\u0645\u0627\u0646\u06cc \u0648 \u062d\u0627\u0644 \u0631\u0648\u062d\u06cc \u0634\u0645\u0627 \u0648 \u0639\u0644\u0627\u0626\u0645 \u0631\u0648\u0632\u0627\u0646\u0647<br><br>\u200f\u2022 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06af\u0630\u0627\u0631\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc\u060c \u0634\u0631\u0648\u0639 \u0633\u0646\u062f\u0631\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc (PMS)\u060c \u067e\u0631\u06cc\u0648\u062f \u0648 \u062a\u062e\u0645\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u0628\u0627 \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc (\u0647\u0645\u0631\u0627\u0647)<br><br>\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0648 \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u062d\u0627\u0644 \u0648 \u0631\u0648\u0632 \u0634\u0645\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0648\u06cc\u0698\u06af\u06cc \u00ab\u0647\u0645\u0631\u0627\u0647\u00bb \u0628\u0631\u0627\u06cc \u0634\u0631\u06cc\u06a9 \u0639\u0627\u0637\u0641\u06cc\u200c\u062a\u0627\u0646\u00a0<br><br>\u200f\u2022 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0645\u0642\u0627\u0644\u0627\u062a \u0639\u0644\u0645\u06cc \u0648 \u0645\u0648\u0631\u062f \u062a\u0623\u06cc\u06cc\u062f \u067e\u0632\u0634\u06a9\u060c \u062f\u0631\u0628\u0627\u0631\u06c0 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646 \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0648\u0636\u0639\u06cc\u062a \u062c\u0633\u0645\u06cc \u0648 \u0631\u0648\u062d\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0647\u0631 \u0631\u0648\u0632<br><br>\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u062f\u0631\u06cc\u0627\u0641\u062a \u06af\u0632\u0627\u0631\u0634 \u062a\u062d\u0644\u06cc\u0644\u06cc \u0627\u0632 \u0648\u0636\u0639\u06cc\u062a \u0686\u0631\u062e\u06c0 \u067e\u0631\u06cc\u0648\u062f \u0648 \u0639\u0644\u0627\u0626\u0645 \u062c\u0633\u0645\u06cc \u0648 \u0631\u0648\u062d\u06cc \u0628\u0631\u0627\u06cc \u062f\u0631\u06a9 \u0628\u0647\u062a\u0631 \u0627\u0644\u06af\u0648\u06cc \u0628\u062f\u0646\u06cc \u0645\u0646\u062d\u0635\u0631 \u0628\u0647 \u0641\u0631\u062f \u0648 \u0627\u0631\u0627\u0626\u0647 \u0628\u0647 \u067e\u0632\u0634\u06a9 \u062e\u0648\u062f<br><br>\u200f\u2022 \u0627\u0645\u06a9\u0627\u0646 \u067e\u0631\u0633\u0634 \u0648 \u067e\u0627\u0633\u062e \u0648 \u062a\u0628\u0627\u062f\u0644 \u062a\u062c\u0631\u0628\u0647 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0627\u0645\u0644\u0627\u064b \u0646\u0627\u0634\u0646\u0627\u0633 \u062f\u0631 \u0641\u0636\u0627\u06cc \u0627\u0645\u0646 \u00ab\u067e\u0631\u0633\u200c\u0648\u06af\u0648\u00bb<br><br>\u200f\u2022 \u0647\u0631\u0644\u0627\u06cc\u0641 \u0628\u0627 \u067e\u0634\u062a\u0648\u0627\u0646\u06c0 \u0639\u0644\u0645\u06cc \u0648 \u0628\u0627 \u0647\u0645\u0631\u0627\u0647\u06cc \u062a\u06cc\u0645 \u067e\u0632\u0634\u06a9\u06cc \u062e\u0648\u062f\u060c \u0628\u0647 \u0633\u0624\u0627\u0644\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u062a\u063a\u06cc\u06cc\u0631 \u00ab\u062e\u0644\u0642\u200c \u0648\u200c \u062e\u0648\u060c \u0633\u0637\u062d \u0627\u0646\u0631\u0698\u06cc\u060c \u067e\u0648\u0633\u062a \u0648 \u0645\u0648\u060c \u062f\u0633\u062a\u06af\u0627\u0647 \u06af\u0648\u0627\u0631\u0634\u06cc \u0648 \u062f\u06cc\u06af\u0631 \u0639\u0644\u0627\u0626\u0645 \u067e\u0631\u06cc\u0648\u062f\u06cc\u00bb \u062f\u0631 \u0686\u0631\u062e\u06c0 \u0642\u0627\u0639\u062f\u06af\u06cc \u067e\u0627\u0633\u062e \u0645\u06cc\u200c\u062f\u0647\u062f.<br><br>\u00a0\u067e\u0627\u0633\u062e \u0633\u0624\u0627\u0644\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0628\u062e\u0634 \u06a9\u0644\u06cc\u0646\u06cc\u06a9\u060c \u067e\u0631\u0633\u200c\u0648\u06af\u0648 \u06cc\u0627 \u062f\u0631 \u0628\u062e\u0634 \u0645\u0642\u0627\u0644\u0627\u062a \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.<br><br>\u200f\u2022 \u0628\u062e\u0634 \u00ab\u067e\u0631\u0633\u200c\u0648\u06af\u0648\u00bb \u062f\u0631 \u0647\u0631\u0644\u0627\u06cc\u0641\u060c \u0641\u0636\u0627\u06cc\u06cc \u0627\u0645\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647 \u0634\u0645\u0627 \u0627\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646 \u0631\u0627 \u0645\u06cc\u200c\u062f\u0647\u062f \u062a\u0627 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0648 \u0628\u0647 \u0635\u0648\u0631\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0627 \u067e\u0632\u0634\u06a9 \u06af\u0641\u062a\u06af\u0648 \u06a9\u0646\u06cc\u062f. \u0647\u0645\u06cc\u0646\u200c\u0637\u0648\u0631 \u0628\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u06cc\u06af\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062a\u0639\u0627\u0645\u0644 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f\u060c \u0648 \u062a\u062c\u0631\u0628\u06cc\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u067e\u0631\u06cc\u0648\u062f \u0648 \u0633\u0644\u0627\u0645\u062a\u06cc \u0628\u0627 \u06cc\u06a9\u062f\u06cc\u06af\u0631 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.<br><br>\u200f\u0627\u06af\u0631 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0631\u0647\u06af\u06cc\u0631\u06cc \u067e\u0631\u06cc\u0648\u062f (Period Tracker) \u0628\u0631\u0627\u06cc \u062b\u0628\u062a \u0648 \u0628\u0631\u0631\u0633\u06cc \u067e\u0631\u06cc\u0648\u062f\u060c \u0633\u0646\u062f\u0631\u0648\u0645 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0627\u0639\u062f\u06af\u06cc \u06cc\u0627 \u062a\u062e\u0645\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u0647\u0633\u062a\u06cc\u062f \u06cc\u0627 \u0635\u0631\u0641\u0627\u064b \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0628\u062f\u0646 \u062e\u0648\u062f \u0631\u0627 \u0628\u06cc\u0634\u062a\u0631 \u0628\u0634\u0646\u0627\u0633\u06cc\u062f\u060c \u0647\u0631\u0644\u0627\u06cc\u0641 \u06a9\u0646\u0627\u0631 \u0634\u0645\u0627\u0633\u062a \u062a\u0627 \u0628\u0627 \u0647\u0645 \u062f\u0644\u06cc\u060c \u0622\u06af\u0627\u0647\u06cc \u062f\u0627\u062f\u0646 \u0648 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0633\u0628\u06a9 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u062f\u06af\u06cc \u0648 \u062a\u0639\u0627\u062f\u0644 \u0631\u0627 \u0628\u0647 \u0632\u0646\u062f\u06af\u06cc \u0634\u0645\u0627 \u0647\u062f\u06cc\u0647 \u062f\u0647\u062f.",
    "summary": "\u0647\u0631\u0644\u0627\u06cc\u0641 - \u0628\u0631\u0646\u0627\u0645\u06c0 \u062c\u0627\u0645\u0639 \u0633\u0644\u0627\u0645\u062a \u0632\u0646\u0627\u0646\u060c \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u067e\u0631\u06cc\u0648\u062f \u0648 \u0648\u06cc\u0632\u06cc\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 \u067e\u0632\u0634\u06a9",
