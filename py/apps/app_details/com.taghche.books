{
    "title": "\u0637\u0627\u0642\u0686\u0647\u061b \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u0635\u0648\u062a\u06cc",
    "description": "* \u062f\u0631 \u0627\u0648\u0644\u06cc\u0646 \u062e\u0631\u06cc\u062f\u062a\u0627\u0646 \u0627\u0632 \u0637\u0627\u0642\u0686\u0647 \u06f5\u06f0 \u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641 \u0628\u06af\u06cc\u0631\u06cc\u062f *\r\n\r\n\u0637\u0627\u0642\u0686\u0647 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646\u06cc \u0627\u0633\u062a \u0628\u0631\u0627\u06cc \u0644\u0630\u062a \u0628\u0631\u062f\u0646 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628. \u062f\u0631 \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0647 \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc (\u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc)\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0645\u062c\u0644\u0647 \u0648 \u0631\u0648\u0632\u0646\u0627\u0645\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f. \u0637\u0627\u0642\u0686\u0647 \u0628\u0627 \u0635\u062f\u0647\u0627 \u0646\u0627\u0634\u0631 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u200c\u200c\u200c\u200c\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f. \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0632\u06cc\u0627\u062f\u06cc \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0627\u0631\u062f. \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0648\u06cc \u0645\u062a\u0646\u200c\u0647\u0627 \u0639\u0644\u0627\u0645\u062a\u200c\u200c\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f (\u0647\u0627\u06cc\u0644\u0627\u06cc\u062a)\u060c \u0627\u0646\u062f\u0627\u0632\u0647 \u0648 \u0646\u0648\u0639 \u0642\u0644\u0645 (\u0641\u0648\u0646\u062a) \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f \u0648 \u062f\u0631 \u0647\u0631 \u0642\u0633\u0645\u062a\u06cc \u06a9\u0647 \u062f\u0648\u0633\u062a \u062f\u0627\u0634\u062a\u06cc\u062f\u060c \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u00ab\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a\u00bb \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u200c\u0654 \u0639\u0645\u0648\u0645\u06cc \u0637\u0627\u0642\u0686\u0647 \u0639\u0636\u0648 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0627 \u0647\u0632\u06cc\u0646\u0647\u200c\u0654 \u06cc\u06a9 \u06a9\u062a\u0627\u0628\u060c \u0628\u0647 \u062a\u0639\u062f\u0627\u062f \u0632\u06cc\u0627\u062f\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u067e\u0631\u0641\u0631\u0648\u0634 \u0637\u0627\u0642\u0686\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.\r\n\r\n\u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0646\u0633\u062e\u0647\u200c\u0654 \u062c\u062f\u06cc\u062f :\r\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u0654 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a\r\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0628\u0632\u0631\u06af \u06a9\u0631\u062f\u0646 \u062c\u0644\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0631 \u0635\u0641\u062d\u0647\u0654 \u062c\u0632\u0626\u06cc\u0627\u062a \u0647\u0631 \u06a9\u062a\u0627\u0628\r\n\r\n\r\n\u0628\u0627 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0637\u0627\u0642\u0686\u0647\u060c \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0647\u0645\u0631\u0627\u0647\u062a\u0627\u0646 \u0647\u0633\u062a\u0646\u062f \u0648 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0648 \u0647\u0645\u0647\u200c\u062c\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f \u0648 \u0628\u0634\u0646\u0648\u06cc\u062f\u060c \u062d\u062a\u06cc \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0646\u06cc\u0633\u062a\u06cc\u062f.\r\n\r\n\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a\r\n\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u062f\u0631 \u0648\u0627\u0642\u0639 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u062d\u0642 \u0639\u0636\u0648\u06cc\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0622\u0646 \u0639\u0636\u0648 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0647 \u062a\u0645\u0627\u0645 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0622\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0648 \u067e\u0631\u0641\u0631\u0648\u0634 \u0637\u0627\u0642\u0686\u0647 \u0631\u0627 \u0647\u0645 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f. \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u067e\u0648\u06cc\u0627 \u0648 \u062f\u0631 \u062d\u0627\u0644 \u0631\u0634\u062f \u0627\u0633\u062a \u06a9\u0647 \u0647\u0645\u0648\u0627\u0631\u0647 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062a\u0627\u0632\u0647\u200c\u0627\u06cc \u0628\u0647 \u0622\u0646 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0628\u0627 \u0647\u0632\u06cc\u0646\u0647\u0654 \u06cc\u06a9 \u06a9\u062a\u0627\u0628\u060c \u0627\u0645\u06a9\u0627\u0646 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u0635\u062f\u0647\u0627 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u0634\u062a.\r\n\r\n\u0686\u0631\u0627 \u0637\u0627\u0642\u0686\u0647 \u06af\u0632\u06cc\u0646\u0647\u200c\u0654 \u062e\u0648\u0628\u06cc \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u062f\u0646\u06cc\u0627\u06cc \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0627\u0633\u062a\u061f\r\n\u2022 \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0642\u06cc\u0645\u062a \u06cc\u06a9 \u06a9\u062a\u0627\u0628 \u0686\u0627\u067e\u06cc \u0686\u0646\u062f \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.\r\n\u2022 \u062a\u0639\u062f\u0627\u062f \u0632\u06cc\u0627\u062f\u06cc \u06a9\u062a\u0627\u0628\u200c\u0650 \u0631\u0627\u06cc\u06af\u0627\u0646 \u062f\u0627\u0631\u062f \u06a9\u0647 \u0645\u062f\u0627\u0645 \u0628\u0647 \u062a\u0639\u062f\u0627\u062f\u0634 \u0627\u0641\u0632\u0648\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.\r\n\u2022 \u0628\u0627 \u0637\u0627\u0642\u0686\u0647 \u062f\u0631 \u0647\u0631 \u0632\u0645\u0627\u0646 \u0648 \u0645\u06a9\u0627\u0646\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u06a9\u062a\u0627\u0628 \u062f\u0644\u062e\u0648\u0627\u0647\u062a\u0627\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f.\r\n\u2022 \u0628\u0647 \u0634\u0645\u0627 \u0627\u0645\u06a9\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u0648\u0642\u062a\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc \u0633\u062e\u062a \u0627\u0633\u062a\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc \u06af\u0648\u0634 \u062f\u0647\u06cc\u062f.\r\n\u2022 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062e\u0627\u0631\u062c \u0627\u0632 \u06a9\u0634\u0648\u0631 \u0627\u0645\u06a9\u0627\u0646 \u062e\u0631\u06cc\u062f \u062f\u0627\u0631\u062f.\r\n\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u06a9\u0648\u062a\u0627\u0647\u200c\u062e\u0648\u0627\u0646\u0650 \u0628\u0627\u06a9\u06cc\u0641\u06cc\u062a\u06cc \u062f\u0627\u0631\u062f \u06a9\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0628\u0627 \u06f1\u06f0\u06f0 \u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.\r\n\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u062a\u0646\u0648\u0639 \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f \u0648 \u062f\u0631 \u0622\u0646 \u0628\u0647 \u0627\u0646\u0648\u0627\u0639 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u062a\u062e\u0635\u0635\u06cc\u060c \u067e\u0632\u0634\u06a9\u06cc \u0648\u2026 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f.\r\n\u2022 \u0628\u0627 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0648\u0642\u062a\u200c\u0647\u0627\u06cc \u0645\u0631\u062f\u0647\u200c\u062a\u0627\u0646 \u0631\u0627 \u0632\u0646\u062f\u0647 \u06a9\u0646\u06cc\u062f!\r\n\r\n\u0627\u0645\u06a9\u0627\u0646\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc\r\n\u2022 \u0642\u0628\u0644 \u0627\u0632 \u062e\u0631\u06cc\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0686\u0646\u062f \u0635\u0641\u062d\u0647 \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.\r\n\u2022 \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628 \u0628\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0646\u06cc\u0627\u0632 \u0646\u062f\u0627\u0631\u06cc\u062f.\r\n\u2022 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646\u200c\u06a9\u0647 \u0686\u0634\u0645\u062a\u0627\u0646 \u062e\u0633\u062a\u0647 \u0646\u0634\u0648\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0646\u06af\u200c \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f \u062a\u0627 \u0628\u0627 \u0634\u0631\u0627\u06cc\u0637 \u0646\u0648\u0631 \u0647\u0645\u0627\u0647\u0646\u06af \u0634\u0648\u062f.\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0642\u0644\u0645 (\u0641\u0648\u0646\u062a) \u062f\u0644\u062e\u0648\u0627\u0647\u062a\u0627\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f: \u062a\u0631\u0627\u0641\u06cc\u06a9\u060c \u0631\u0624\u06cc\u0627\u060c \u06cc\u0627\u0642\u0648\u062a\u060c \u0645\u06cc\u062a\u0631\u0627 \u0648...\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0646\u062f\u0627\u0632\u0647\u0654 \u0642\u0644\u0645 \u0631\u0627 \u0628\u0632\u0631\u06af \u0648 \u06a9\u0648\u0686\u06a9 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u06a9\u0644\u0645\u0647\u200c\u200c\u0647\u0627 \u0631\u0627 \u062f\u0631 \u06af\u0648\u0634\u06cc \u0648\u0627\u0636\u062d\u200c\u062a\u0631 \u0628\u0628\u06cc\u0646\u06cc\u062f.\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u0645\u062a\u0646 \u06a9\u0647 \u062e\u0648\u0627\u0633\u062a\u06cc\u062f\u060c \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0648\u06cc \u0645\u062a\u0646 \u0628\u0627 \u0631\u0646\u06af\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639 \u0639\u0644\u0627\u0645\u062a \u0628\u06af\u0630\u0627\u0631\u06cc\u062f (\u0647\u0627\u06cc\u200c\u0644\u0627\u06cc\u062a).\r\n\u2022 \u062a\u0645\u0627\u0645 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0648 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a\u200c\u0647\u0627\u06cc \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062f\u0631 \u0633\u0631\u0648\u0631\u0647\u0627\u06cc \u0627\u0628\u0631\u06cc \u0637\u0627\u0642\u0686\u0647 \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.\r\n\u2022 \u062a\u0627 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u06a9\u0647 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f\u060c \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u064e\u0648\u06cc\u062f\u060c \u0645\u062a\u0646 \u0627\u0632 \u0647\u0645\u0627\u0646 \u062c\u0627\u06cc \u0642\u0628\u0644\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.\r\n\r\n\u0627\u0645\u06a9\u0627\u0646\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc\r\n\u2022 \u0642\u0628\u0644 \u0627\u0632 \u062e\u0631\u06cc\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0686\u0646\u062f \u062f\u0642\u06cc\u0642\u0647 \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u0634\u0646\u0648\u06cc\u062f.\r\n\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u062f\u0627\u0646\u0644\u0648\u062f\u0634\u062f\u0647 \u0631\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u062d\u0627\u0644\u062a \u0622\u0641\u0644\u0627\u06cc\u0646 \u0628\u0634\u0646\u0648\u06cc\u062f.\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0633\u0631\u0639\u062a \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f.\r\n\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u067e\u062e\u0634 \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc \u0686\u0647 \u0632\u0645\u0627\u0646\u06cc \u062e\u0627\u0645\u0648\u0634 \u0634\u0648\u062f.\r\n\u2022 \u062a\u0627 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u06a9\u0647 \u0628\u0634\u0646\u0648\u06cc\u062f\u060c \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u064e\u0648\u06cc\u062f\u060c \u0627\u0632 \u0627\u062f\u0627\u0645\u0647\u200c\u0627\u0634 \u067e\u062e\u0634 \u0645\u06cc\u200c\u0634\u0648\u062f.\r\n\r\n\u062a\u0646\u0648\u0639 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0631 \u0637\u0627\u0642\u0686\u0647\r\n\u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc\u06cc \u0628\u0627 \u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u0633\u062a\u0627\u0646\u060c \u0631\u0645\u0627\u0646\u060c \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u06cc\u060c \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u06a9\u0633\u0628\u200c\u0648\u06a9\u0627\u0631\u060c \u0645\u0648\u0641\u0642\u06cc\u062a\u060c \u0641\u0644\u0633\u0641\u0647\u060c \u0627\u0642\u062a\u0635\u0627\u062f \u0648... \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.\r\n\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0637\u0627\u0642\u0686\u0647 \u0628\u0627 \u0635\u062f\u0647\u0627 \u0646\u0627\u0634\u0631 \u0639\u0645\u0648\u0645\u06cc\u060c \u062a\u062e\u0635\u0635\u06cc\u060c \u062f\u0627\u0646\u0634\u06af\u0627\u0647\u06cc\u060c \u06a9\u0645\u06a9\u200c\u062f\u0631\u0633\u06cc \u0648\u2026 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f \u0648 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u0622\u0646\u200c\u0647\u0627 \u0644\u0630\u062a \u0628\u0628\u0631\u06cc\u062f.\r\n\r\n\u06a9\u062a\u0627\u0628\u200c\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u062f\u0631 \u0637\u0627\u0642\u0686\u0647\r\n\u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u0637\u0627\u0642\u0686\u0647 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0645\u062a\u0645\u0631\u06a9\u0632 \u062f\u0631 \u0627\u0646\u062a\u0634\u0627\u0631 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u0646\u06cc\u0632 \u0641\u0639\u0627\u0644 \u0627\u0633\u062a \u0648 \u0628\u0627 \u0646\u0634\u0631\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u062a\u06cc\u0645\u0648\u0631\u0632\u0627\u062f\u0647\u060c \u06a9\u0627\u0645\u0631\u0627\u0646 \u0627\u062d\u0645\u062f\u06cc\u060c \u0627\u0631\u062c\u0645\u0646\u062f\u060c \u067e\u0627\u0631\u0633\u06cc\u0627\u0646 \u0637\u0628\u060c \u0627\u0634\u0631\u0627\u0642\u06cc\u0647\u060c \u062a\u0648\u0627\u0646 \u0637\u0628\u060c \u0631\u0632\u06cc\u062f\u0646\u062a\u200c\u06cc\u0627\u0631\u060c \u0645\u062f\u06cc\u06a9\u0648 \u0648... \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062a\u0645\u0627\u0645 \u0627\u06cc\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0628\u0627 \u0631\u0639\u0627\u06cc\u062a \u062d\u0642\u200c \u06a9\u067e\u06cc\u200c\u0631\u0627\u06cc\u062a \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u0646\u062a\u0634\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f.\r\n\r\n\u06a9\u062a\u0627\u0628 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u062a\u0641\u0631\u06cc\u062d\u0650 \u0644\u0630\u062a\u200c\u0628\u062e\u0634 \u0645\u0627\u0633\u062a \u0648 \u0637\u0627\u0642\u0686\u0647 \u0627\u06cc\u0646 \u062a\u0641\u0631\u06cc\u062d \u0631\u0627 \u0622\u0633\u0627\u0646 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0628\u0627 \u0645\u0627 \u062f\u0631 \u0627\u06cc\u0646 \u062a\u062c\u0631\u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u0634\u0648\u06cc\u062f.",
    "descriptionHTML": "* \u062f\u0631 \u0627\u0648\u0644\u06cc\u0646 \u062e\u0631\u06cc\u062f\u062a\u0627\u0646 \u0627\u0632 \u0637\u0627\u0642\u0686\u0647 \u06f5\u06f0 \u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641 \u0628\u06af\u06cc\u0631\u06cc\u062f *<br><br>\u0637\u0627\u0642\u0686\u0647 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646\u06cc \u0627\u0633\u062a \u0628\u0631\u0627\u06cc \u0644\u0630\u062a \u0628\u0631\u062f\u0646 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628. \u062f\u0631 \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0647 \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc (\u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc)\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc\u060c \u0645\u062c\u0644\u0647 \u0648 \u0631\u0648\u0632\u0646\u0627\u0645\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f. \u0637\u0627\u0642\u0686\u0647 \u0628\u0627 \u0635\u062f\u0647\u0627 \u0646\u0627\u0634\u0631 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u200c\u200c\u200c\u200c\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f. \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0632\u06cc\u0627\u062f\u06cc \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0627\u0631\u062f. \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0648\u06cc \u0645\u062a\u0646\u200c\u0647\u0627 \u0639\u0644\u0627\u0645\u062a\u200c\u200c\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f (\u0647\u0627\u06cc\u0644\u0627\u06cc\u062a)\u060c \u0627\u0646\u062f\u0627\u0632\u0647 \u0648 \u0646\u0648\u0639 \u0642\u0644\u0645 (\u0641\u0648\u0646\u062a) \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f \u0648 \u062f\u0631 \u0647\u0631 \u0642\u0633\u0645\u062a\u06cc \u06a9\u0647 \u062f\u0648\u0633\u062a \u062f\u0627\u0634\u062a\u06cc\u062f\u060c \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u00ab\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a\u00bb \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u200c\u0654 \u0639\u0645\u0648\u0645\u06cc \u0637\u0627\u0642\u0686\u0647 \u0639\u0636\u0648 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0627 \u0647\u0632\u06cc\u0646\u0647\u200c\u0654 \u06cc\u06a9 \u06a9\u062a\u0627\u0628\u060c \u0628\u0647 \u062a\u0639\u062f\u0627\u062f \u0632\u06cc\u0627\u062f\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u067e\u0631\u0641\u0631\u0648\u0634 \u0637\u0627\u0642\u0686\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.<br><br>\u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0646\u0633\u062e\u0647\u200c\u0654 \u062c\u062f\u06cc\u062f :<br>\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u0654 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a<br>\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0628\u0632\u0631\u06af \u06a9\u0631\u062f\u0646 \u062c\u0644\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0631 \u0635\u0641\u062d\u0647\u0654 \u062c\u0632\u0626\u06cc\u0627\u062a \u0647\u0631 \u06a9\u062a\u0627\u0628<br><br><br>\u0628\u0627 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0637\u0627\u0642\u0686\u0647\u060c \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0647\u0645\u0631\u0627\u0647\u062a\u0627\u0646 \u0647\u0633\u062a\u0646\u062f \u0648 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0648 \u0647\u0645\u0647\u200c\u062c\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f \u0648 \u0628\u0634\u0646\u0648\u06cc\u062f\u060c \u062d\u062a\u06cc \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0646\u06cc\u0633\u062a\u06cc\u062f.<br><br>\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a<br>\u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u062f\u0631 \u0648\u0627\u0642\u0639 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u062d\u0642 \u0639\u0636\u0648\u06cc\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0622\u0646 \u0639\u0636\u0648 \u0634\u0648\u06cc\u062f \u0648 \u0628\u0647 \u062a\u0645\u0627\u0645 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0622\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0648 \u067e\u0631\u0641\u0631\u0648\u0634 \u0637\u0627\u0642\u0686\u0647 \u0631\u0627 \u0647\u0645 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f. \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u067e\u0648\u06cc\u0627 \u0648 \u062f\u0631 \u062d\u0627\u0644 \u0631\u0634\u062f \u0627\u0633\u062a \u06a9\u0647 \u0647\u0645\u0648\u0627\u0631\u0647 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062a\u0627\u0632\u0647\u200c\u0627\u06cc \u0628\u0647 \u0622\u0646 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0628\u06cc\u200c\u0646\u0647\u0627\u06cc\u062a \u0628\u0627 \u0647\u0632\u06cc\u0646\u0647\u0654 \u06cc\u06a9 \u06a9\u062a\u0627\u0628\u060c \u0627\u0645\u06a9\u0627\u0646 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u0635\u062f\u0647\u0627 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u0634\u062a.<br><br>\u0686\u0631\u0627 \u0637\u0627\u0642\u0686\u0647 \u06af\u0632\u06cc\u0646\u0647\u200c\u0654 \u062e\u0648\u0628\u06cc \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u062f\u0646\u06cc\u0627\u06cc \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0627\u0633\u062a\u061f<br>\u2022 \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0642\u06cc\u0645\u062a \u06cc\u06a9 \u06a9\u062a\u0627\u0628 \u0686\u0627\u067e\u06cc \u0686\u0646\u062f \u06a9\u062a\u0627\u0628 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.<br>\u2022 \u062a\u0639\u062f\u0627\u062f \u0632\u06cc\u0627\u062f\u06cc \u06a9\u062a\u0627\u0628\u200c\u0650 \u0631\u0627\u06cc\u06af\u0627\u0646 \u062f\u0627\u0631\u062f \u06a9\u0647 \u0645\u062f\u0627\u0645 \u0628\u0647 \u062a\u0639\u062f\u0627\u062f\u0634 \u0627\u0641\u0632\u0648\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.<br>\u2022 \u0628\u0627 \u0637\u0627\u0642\u0686\u0647 \u062f\u0631 \u0647\u0631 \u0632\u0645\u0627\u0646 \u0648 \u0645\u06a9\u0627\u0646\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u06a9\u062a\u0627\u0628 \u062f\u0644\u062e\u0648\u0627\u0647\u062a\u0627\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f.<br>\u2022 \u0628\u0647 \u0634\u0645\u0627 \u0627\u0645\u06a9\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u0648\u0642\u062a\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628 \u0645\u062a\u0646\u06cc \u0633\u062e\u062a \u0627\u0633\u062a\u060c \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc \u06af\u0648\u0634 \u062f\u0647\u06cc\u062f.<br>\u2022 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062e\u0627\u0631\u062c \u0627\u0632 \u06a9\u0634\u0648\u0631 \u0627\u0645\u06a9\u0627\u0646 \u062e\u0631\u06cc\u062f \u062f\u0627\u0631\u062f.<br>\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u06a9\u0648\u062a\u0627\u0647\u200c\u062e\u0648\u0627\u0646\u0650 \u0628\u0627\u06a9\u06cc\u0641\u06cc\u062a\u06cc \u062f\u0627\u0631\u062f \u06a9\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0628\u0627 \u06f1\u06f0\u06f0 \u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.<br>\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u062a\u0646\u0648\u0639 \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f \u0648 \u062f\u0631 \u0622\u0646 \u0628\u0647 \u0627\u0646\u0648\u0627\u0639 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u062a\u062e\u0635\u0635\u06cc\u060c \u067e\u0632\u0634\u06a9\u06cc \u0648\u2026 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0631\u06cc\u062f.<br>\u2022 \u0628\u0627 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0648\u0642\u062a\u200c\u0647\u0627\u06cc \u0645\u0631\u062f\u0647\u200c\u062a\u0627\u0646 \u0631\u0627 \u0632\u0646\u062f\u0647 \u06a9\u0646\u06cc\u062f!<br><br>\u0627\u0645\u06a9\u0627\u0646\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc<br>\u2022 \u0642\u0628\u0644 \u0627\u0632 \u062e\u0631\u06cc\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0686\u0646\u062f \u0635\u0641\u062d\u0647 \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.<br>\u2022 \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u06a9\u062a\u0627\u0628 \u0628\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0646\u06cc\u0627\u0632 \u0646\u062f\u0627\u0631\u06cc\u062f.<br>\u2022 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646\u200c\u06a9\u0647 \u0686\u0634\u0645\u062a\u0627\u0646 \u062e\u0633\u062a\u0647 \u0646\u0634\u0648\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0646\u06af\u200c \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f \u062a\u0627 \u0628\u0627 \u0634\u0631\u0627\u06cc\u0637 \u0646\u0648\u0631 \u0647\u0645\u0627\u0647\u0646\u06af \u0634\u0648\u062f.<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0642\u0644\u0645 (\u0641\u0648\u0646\u062a) \u062f\u0644\u062e\u0648\u0627\u0647\u062a\u0627\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u062f\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f: \u062a\u0631\u0627\u0641\u06cc\u06a9\u060c \u0631\u0624\u06cc\u0627\u060c \u06cc\u0627\u0642\u0648\u062a\u060c \u0645\u06cc\u062a\u0631\u0627 \u0648...<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0646\u062f\u0627\u0632\u0647\u0654 \u0642\u0644\u0645 \u0631\u0627 \u0628\u0632\u0631\u06af \u0648 \u06a9\u0648\u0686\u06a9 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u06a9\u0644\u0645\u0647\u200c\u200c\u0647\u0627 \u0631\u0627 \u062f\u0631 \u06af\u0648\u0634\u06cc \u0648\u0627\u0636\u062d\u200c\u062a\u0631 \u0628\u0628\u06cc\u0646\u06cc\u062f.<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u0645\u062a\u0646 \u06a9\u0647 \u062e\u0648\u0627\u0633\u062a\u06cc\u062f\u060c \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0648\u06cc \u0645\u062a\u0646 \u0628\u0627 \u0631\u0646\u06af\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639 \u0639\u0644\u0627\u0645\u062a \u0628\u06af\u0630\u0627\u0631\u06cc\u062f (\u0647\u0627\u06cc\u200c\u0644\u0627\u06cc\u062a).<br>\u2022 \u062a\u0645\u0627\u0645 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0648 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a\u200c\u0647\u0627\u06cc \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062f\u0631 \u0633\u0631\u0648\u0631\u0647\u0627\u06cc \u0627\u0628\u0631\u06cc \u0637\u0627\u0642\u0686\u0647 \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.<br>\u2022 \u062a\u0627 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u06a9\u0647 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f\u060c \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u064e\u0648\u06cc\u062f\u060c \u0645\u062a\u0646 \u0627\u0632 \u0647\u0645\u0627\u0646 \u062c\u0627\u06cc \u0642\u0628\u0644\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.<br><br>\u0627\u0645\u06a9\u0627\u0646\u200c\u0647\u0627\u06cc \u0637\u0627\u0642\u0686\u0647 \u0628\u0631\u0627\u06cc \u0644\u0630\u062a\u200c \u0628\u0631\u062f\u0646 \u0627\u0632 \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc<br>\u2022 \u0642\u0628\u0644 \u0627\u0632 \u062e\u0631\u06cc\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0686\u0646\u062f \u062f\u0642\u06cc\u0642\u0647 \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0628\u0634\u0646\u0648\u06cc\u062f.<br>\u2022 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0635\u0648\u062a\u06cc \u062f\u0627\u0646\u0644\u0648\u062f\u0634\u062f\u0647 \u0631\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u062d\u0627\u0644\u062a \u0622\u0641\u0644\u0627\u06cc\u0646 \u0628\u0634\u0646\u0648\u06cc\u062f.<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0633\u0631\u0639\u062a \u0634\u0646\u06cc\u062f\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f.<br>\u2022 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u067e\u062e\u0634 \u06a9\u062a\u0627\u0628 \u0635\u0648\u062a\u06cc \u0686\u0647 \u0632\u0645\u0627\u0646\u06cc \u062e\u0627\u0645\u0648\u0634 \u0634\u0648\u062f.<br>\u2022 \u062a\u0627 \u0647\u0631 \u062c\u0627\u06cc\u06cc \u0627\u0632 \u06a9\u062a\u0627\u0628 \u0631\u0627 \u06a9\u0647 \u0628\u0634\u0646\u0648\u06cc\u062f\u060c \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u064e\u0648\u06cc\u062f\u060c \u0627\u0632 \u0627\u062f\u0627\u0645\u0647\u200c\u0627\u0634 \u067e\u062e\u0634 \u0645\u06cc\u200c\u0634\u0648\u062f.<br><br>\u062a\u0646\u0648\u0639 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u062f\u0631 \u0637\u0627\u0642\u0686\u0647<br>\u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc\u06cc \u0628\u0627 \u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u0633\u062a\u0627\u0646\u060c \u0631\u0645\u0627\u0646\u060c \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u06cc\u060c \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u06a9\u0633\u0628\u200c\u0648\u06a9\u0627\u0631\u060c \u0645\u0648\u0641\u0642\u06cc\u062a\u060c \u0641\u0644\u0633\u0641\u0647\u060c \u0627\u0642\u062a\u0635\u0627\u062f \u0648... \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.<br>\u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0637\u0627\u0642\u0686\u0647 \u0628\u0627 \u0635\u062f\u0647\u0627 \u0646\u0627\u0634\u0631 \u0639\u0645\u0648\u0645\u06cc\u060c \u062a\u062e\u0635\u0635\u06cc\u060c \u062f\u0627\u0646\u0634\u06af\u0627\u0647\u06cc\u060c \u06a9\u0645\u06a9\u200c\u062f\u0631\u0633\u06cc \u0648\u2026 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0648 \u0635\u0648\u062a\u06cc \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u062f\u0627\u0646\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f \u0648 \u0627\u0632 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u0622\u0646\u200c\u0647\u0627 \u0644\u0630\u062a \u0628\u0628\u0631\u06cc\u062f.<br><br>\u06a9\u062a\u0627\u0628\u200c\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u062f\u0631 \u0637\u0627\u0642\u0686\u0647<br>\u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc\u060c \u0637\u0627\u0642\u0686\u0647 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0645\u062a\u0645\u0631\u06a9\u0632 \u062f\u0631 \u0627\u0646\u062a\u0634\u0627\u0631 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u067e\u0632\u0634\u06a9\u06cc \u0646\u06cc\u0632 \u0641\u0639\u0627\u0644 \u0627\u0633\u062a \u0648 \u0628\u0627 \u0646\u0634\u0631\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u062a\u06cc\u0645\u0648\u0631\u0632\u0627\u062f\u0647\u060c \u06a9\u0627\u0645\u0631\u0627\u0646 \u0627\u062d\u0645\u062f\u06cc\u060c \u0627\u0631\u062c\u0645\u0646\u062f\u060c \u067e\u0627\u0631\u0633\u06cc\u0627\u0646 \u0637\u0628\u060c \u0627\u0634\u0631\u0627\u0642\u06cc\u0647\u060c \u062a\u0648\u0627\u0646 \u0637\u0628\u060c \u0631\u0632\u06cc\u062f\u0646\u062a\u200c\u06cc\u0627\u0631\u060c \u0645\u062f\u06cc\u06a9\u0648 \u0648... \u0647\u0645\u06a9\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062a\u0645\u0627\u0645 \u0627\u06cc\u0646 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627 \u0628\u0627 \u0631\u0639\u0627\u06cc\u062a \u062d\u0642\u200c \u06a9\u067e\u06cc\u200c\u0631\u0627\u06cc\u062a \u062f\u0631 \u0637\u0627\u0642\u0686\u0647 \u0645\u0646\u062a\u0634\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f.<br><br>\u06a9\u062a\u0627\u0628 \u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0634\u0646\u06cc\u062f\u0646 \u062a\u0641\u0631\u06cc\u062d\u0650 \u0644\u0630\u062a\u200c\u0628\u062e\u0634 \u0645\u0627\u0633\u062a \u0648 \u0637\u0627\u0642\u0686\u0647 \u0627\u06cc\u0646 \u062a\u0641\u0631\u06cc\u062d \u0631\u0627 \u0622\u0633\u0627\u0646 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0628\u0627 \u0645\u0627 \u062f\u0631 \u0627\u06cc\u0646 \u062a\u062c\u0631\u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u0634\u0648\u06cc\u062f.",
