{
    "title": "\u0622\u06cc\u0686\u064e\u062a | \u0686\u062a\u060c \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0686\u062a \u0631\u0648\u0645",
    "description": "\u0622\u06cc\u0686\u064e\u062a \u06cc\u06a9 \u0634\u0628\u06a9\u0647 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646 \u062d\u0631\u0641\u0647 \u0627\u06cc \u0628\u0631\u0627\u06cc \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0647\u0633\u062a\u0634 \u06a9\u0647 \u0628\u0627 \u0627\u0648\u0646 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0627 \u0647\u0631 \u06a9\u0627\u0631\u0628\u0631\u06cc \u06a9\u0647 \u062a\u0648 \u0628\u0631\u0646\u0627\u0645\u0647 \u0639\u0636\u0648 \u0634\u062f\u0647 \u06cc\u0627 \u0622\u0646\u0644\u0627\u06cc\u0646\u0647 \u06af\u067e \u0628\u0632\u0646\u06cc \u0648 \u0628\u0627\u0647\u0645 \u062f\u0648\u0633\u062a \u0628\u0634\u06cc\u0646.\r\n\u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0622\u06cc\u0686\u064e\u062a \u062e\u06cc\u0644\u06cc \u06a9\u0627\u0645\u0644\u0647! \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0686\u062a\u060c \u06af\u0641\u062a\u06af\u0648 \u0648 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u06cc\u06af\u0647 \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc \u0634\u0645\u0627 \u06a9\u0627\u0631\u0628\u0631 \u0639\u0632\u06cc\u0632\u0645\u0648\u0646 \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647.\r\n\u0686\u062a \u0631\u0648\u0645 \u0622\u06cc\u0686\u064e\u062a \u06a9\u0627\u0645\u0644\u0627 \u0647\u0633\u062a\u0634!\r\n\u0628\u0631\u0627\u06cc \u06a9\u0627\u0631 \u0628\u0627 \u0622\u06cc\u0686\u064e\u062a \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062b\u0628\u062a \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627 \u0627\u06cc\u0645\u06cc\u0644 \u0646\u06cc\u0633\u062a\u060c \u062e\u06cc\u0644\u06cc \u0631\u0627\u062d\u062a \u0628\u0627 \u06cc\u06a9 \u062b\u0628\u062a \u0646\u0627\u0645 \u0633\u0627\u062f\u0647 \u0645\u06cc\u062a\u0648\u0646\u06cc\u062f \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0634\u06cc\u062f \u0648 \u0634\u0631\u0648\u0639 \u0628\u0647 \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u06a9\u0646\u06cc\u062f\u060c \u0627\u0648\u0646\u0645 \u0628\u0635\u0648\u0631\u062a \u0686\u062a \u0646\u0627\u0634\u0646\u0627\u0633!\r\n\r\n\u0622\u06cc\u0686\u064e\u062a \u0628\u0631\u0627\u06cc \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc\u060c \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0645\u06cc\u062a\u0648\u0646\u0647 \u062e\u06cc\u0644\u06cc \u06a9\u0645\u06a9\u062a \u06a9\u0646\u0647.\r\n\r\n\u0645\u0627 \u0647\u0645 \u0645\u062b\u0644 \u062e\u0648\u062f\u062a \u0627\u0647\u0644 \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0686\u062a \u06a9\u0631\u062f\u0646 \u0647\u0633\u062a\u06cc\u0645 \u0648\u0627\u0633\u0647 \u0647\u0645\u06cc\u0646 \u0628\u0631\u0627\u0645\u0648\u0646 \u0645\u0647\u0645\u0647 \u06a9\u0647 \u062a\u0648\u06cc \u0622\u06cc\u0686\u064e\u062a \u062c\u0645\u0639\u06cc \u0635\u0645\u06cc\u0645\u06cc\u060c \u0645\u0637\u0645\u0626\u0646 \u0648 \u0633\u0627\u0644\u0645 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u0645!\r\n\r\n\u0686\u062a \u0631\u0648\u0645 \u0622\u06cc\u0686\u064e\u062a \u062e\u06cc\u0644\u06cc \u0634\u0644\u0648\u063a\u0647\u060c \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u0627\u0631\u0647 \u062f\u0642\u06cc\u0642\u0627 \u0645\u062b\u0644 \u0686\u062a \u0631\u0648\u0645 \u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u067e\u0631\u0634\u06cc\u0646 \u0686\u062a\u060c \u0628\u0627\u0631\u0627\u0646 \u0686\u062a\u060c \u0645\u06cc\u0647\u0646 \u0686\u062a \u0648 ...\r\n\r\n\u062a\u0627\u0632\u0647 \u0648\u0627\u0633\u0647 \u062f\u0648\u0633\u062a\u06cc \u0648 \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0647\u0645 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u0627\u0631\u0647!\r\n\r\n\u0628\u0627 \u0622\u06cc\u0686\u064e\u062a \u0645\u06cc\u062a\u0648\u0646\u06cc \u0646\u0632\u062f\u06cc\u06a9\u0627 \u062a\u0648 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc \u0648 \u0628\u0627\u0647\u0627\u0634\u0648\u0646 \u06af\u067e \u0628\u0632\u0646\u06cc\r\n\r\n\u0622\u06cc\u0686\u064e\u062a \u067e\u0627\u062a\u0648\u0642 \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0628\u0627\u0647\u0645 \u0628\u0648\u062f\u0646\u0647\r\n\r\n\u0686\u062a \u0622\u06cc\u0686\u062a | \u067e\u0627\u062a\u0648\u0642 \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0686\u062a \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\r\n\r\n\u0686\u062a \u0622\u06cc\u0686\u062a | \u0647\u0645 \u0635\u062d\u0628\u062a \u0648 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f\r\n\r\n\u0628\u0627 \u06a9\u0645\u06a9 \u0631\u0627\u062f\u0627\u0631 \u062f\u0648\u0633\u062a\u0627\u0646 \u0627\u0637\u0631\u0627\u0641\u062a\u0648 \u067e\u06cc\u062f\u0627 \u06a9\u0646 \u0648 \u0628\u0627\u0647\u0627\u0634\u0648\u0646 \u06af\u067e \u0628\u0632\u0646\r\n\r\n\u0634\u0631\u062d \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0622\u06cc\u0686\u064e\u062a:\r\n\r\n\u062b\u0628\u062a \u0646\u0627\u0645 \u0633\u0627\u062f\u0647 \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0634\u0645\u0627\u0631\u0647 \u0648 \u0627\u06cc\u0645\u06cc\u0644\r\n\u0633\u06cc\u0633\u062a\u0645 \u0686\u062a \u0644\u0627\u06cc\u0648 \u0628\u062f\u0648\u0646 \u062a\u0627\u062e\u06cc\u0631\r\n\u0627\u0645\u06a9\u0627\u0646 \u062c\u0633\u062a\u062c\u0648\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647\r\n\u0627\u0645\u06a9\u0627\u0646 \u0686\u062a \u062e\u0635\u0648\u0635\u06cc \u0628\u0627 \u0647\u0645\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646\r\n\u0627\u0645\u06a9\u0627\u0646 \u0686\u062a \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0648 \u06af\u067e \u0628\u0627 \u0647\u0645\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646\r\n\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0627\u0641\u0631\u0627\u062f \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0647 \u062e\u0648\u062f\u062a \u06cc\u0627 \u0647\u0645\u0634\u0647\u0631\u06cc \u0647\u0627\r\n\u0686\u062a \u0631\u0648\u0645 \u06a9\u0627\u0645\u0644\u0627 \u062d\u0631\u0641\u0647 \u0627\u06cc\r\n\u0686\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0645\u062c\u0647\u0632 \u0628\u0647 \u0646\u0632\u062f\u06cc\u06a9 \u06cc\u0627\u0628\r\n\u0627\u0645\u06a9\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u062a\u0646\u060c \u0639\u06a9\u0633 \u060c \u0635\u062f\u0627 \u0648 \u0641\u06cc\u0644\u0645\r\n\u0628\u062f\u0648\u0646 \u0647\u06cc\u0686\u06af\u0648\u0646\u0647 \u067e\u06cc\u0627\u0645 \u06cc\u0627 \u0646\u0648\u062a\u06cc\u0641\u06cc\u06a9\u06cc\u0634\u0646 \u0627\u0636\u0627\u0641\u0647\r\n\u0627\u0645\u0646\u06cc\u062a \u0628\u0633\u06cc\u0627\u0631 \u0628\u0627\u0644\u0627 \u0648 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u067e\u06cc\u0627\u0645 \u0647\u0627\r\n\u0627\u0645\u06a9\u0627\u0646 \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc\u060c \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648\r\n\r\n\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u064e\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\u067e\u06cc\u0634\u0627\u067e\u06cc\u0634 \u0648\u0631\u0648\u062f\u062a\u0648 \u0628\u0647 \u062c\u0645\u0639 \u0635\u0645\u06cc\u0645\u06cc \u062e\u0648\u062f\u0645\u0648\u0646 \u062a\u0628\u0631\u06cc\u06a9 \u0645\u06cc\u06af\u06cc\u0645\ud83d\ude0d\u2665\ufe0f\r\n\u0622\u06cc\u0686\u062a (\u0622\u06cc\u200c\u0686\u062a)\u061b \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646\u060c\u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\u0686\u062a \u0622\u06cc\u0686\u062a | \u0628\u0627\u0632\u06cc\u060c \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0686\u062a \u0631\u0648\u0645\u060c \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\r\n\u0622\u06cc\u0686\u062a (\u0622\u06cc\u200c\u0686\u062a)\u061b \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646\u060c\u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627\r\n\r\n\u0622\u06cc\u0686\u064e\u062a \u060c \u0645\u062d\u06cc\u0637\u06cc \u0633\u0627\u0644\u0645 \u0628\u0631\u0627\u06cc \u0686\u062a \u061b \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc \u0628\u0627 \u062f\u0648\u0633\u062a\u0627\u0646",
    "descriptionHTML": "\u0622\u06cc\u0686\u064e\u062a \u06cc\u06a9 \u0634\u0628\u06a9\u0647 \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646 \u062d\u0631\u0641\u0647 \u0627\u06cc \u0628\u0631\u0627\u06cc \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0647\u0633\u062a\u0634 \u06a9\u0647 \u0628\u0627 \u0627\u0648\u0646 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0627 \u0647\u0631 \u06a9\u0627\u0631\u0628\u0631\u06cc \u06a9\u0647 \u062a\u0648 \u0628\u0631\u0646\u0627\u0645\u0647 \u0639\u0636\u0648 \u0634\u062f\u0647 \u06cc\u0627 \u0622\u0646\u0644\u0627\u06cc\u0646\u0647 \u06af\u067e \u0628\u0632\u0646\u06cc \u0648 \u0628\u0627\u0647\u0645 \u062f\u0648\u0633\u062a \u0628\u0634\u06cc\u0646.<br>\u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0622\u06cc\u0686\u064e\u062a \u062e\u06cc\u0644\u06cc \u06a9\u0627\u0645\u0644\u0647! \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0686\u062a\u060c \u06af\u0641\u062a\u06af\u0648 \u0648 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u06cc\u06af\u0647 \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc \u0634\u0645\u0627 \u06a9\u0627\u0631\u0628\u0631 \u0639\u0632\u06cc\u0632\u0645\u0648\u0646 \u0637\u0631\u0627\u062d\u06cc \u0634\u062f\u0647.<br>\u0686\u062a \u0631\u0648\u0645 \u0622\u06cc\u0686\u064e\u062a \u06a9\u0627\u0645\u0644\u0627 \u0647\u0633\u062a\u0634!<br>\u0628\u0631\u0627\u06cc \u06a9\u0627\u0631 \u0628\u0627 \u0622\u06cc\u0686\u064e\u062a \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062b\u0628\u062a \u0634\u0645\u0627\u0631\u0647 \u06cc\u0627 \u0627\u06cc\u0645\u06cc\u0644 \u0646\u06cc\u0633\u062a\u060c \u062e\u06cc\u0644\u06cc \u0631\u0627\u062d\u062a \u0628\u0627 \u06cc\u06a9 \u062b\u0628\u062a \u0646\u0627\u0645 \u0633\u0627\u062f\u0647 \u0645\u06cc\u062a\u0648\u0646\u06cc\u062f \u0648\u0627\u0631\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0634\u06cc\u062f \u0648 \u0634\u0631\u0648\u0639 \u0628\u0647 \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u06a9\u0646\u06cc\u062f\u060c \u0627\u0648\u0646\u0645 \u0628\u0635\u0648\u0631\u062a \u0686\u062a \u0646\u0627\u0634\u0646\u0627\u0633!<br><br>\u0622\u06cc\u0686\u064e\u062a \u0628\u0631\u0627\u06cc \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc\u060c \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0645\u06cc\u062a\u0648\u0646\u0647 \u062e\u06cc\u0644\u06cc \u06a9\u0645\u06a9\u062a \u06a9\u0646\u0647.<br><br>\u0645\u0627 \u0647\u0645 \u0645\u062b\u0644 \u062e\u0648\u062f\u062a \u0627\u0647\u0644 \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0686\u062a \u06a9\u0631\u062f\u0646 \u0647\u0633\u062a\u06cc\u0645 \u0648\u0627\u0633\u0647 \u0647\u0645\u06cc\u0646 \u0628\u0631\u0627\u0645\u0648\u0646 \u0645\u0647\u0645\u0647 \u06a9\u0647 \u062a\u0648\u06cc \u0622\u06cc\u0686\u064e\u062a \u062c\u0645\u0639\u06cc \u0635\u0645\u06cc\u0645\u06cc\u060c \u0645\u0637\u0645\u0626\u0646 \u0648 \u0633\u0627\u0644\u0645 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u0645!<br><br>\u0686\u062a \u0631\u0648\u0645 \u0622\u06cc\u0686\u064e\u062a \u062e\u06cc\u0644\u06cc \u0634\u0644\u0648\u063a\u0647\u060c \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u0627\u0631\u0647 \u062f\u0642\u06cc\u0642\u0627 \u0645\u062b\u0644 \u0686\u062a \u0631\u0648\u0645 \u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u067e\u0631\u0634\u06cc\u0646 \u0686\u062a\u060c \u0628\u0627\u0631\u0627\u0646 \u0686\u062a\u060c \u0645\u06cc\u0647\u0646 \u0686\u062a \u0648 ...<br><br>\u062a\u0627\u0632\u0647 \u0648\u0627\u0633\u0647 \u062f\u0648\u0633\u062a\u06cc \u0648 \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0647\u0645 \u06a9\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u062f\u0627\u0631\u0647!<br><br>\u0628\u0627 \u0622\u06cc\u0686\u064e\u062a \u0645\u06cc\u062a\u0648\u0646\u06cc \u0646\u0632\u062f\u06cc\u06a9\u0627 \u062a\u0648 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc \u0648 \u0628\u0627\u0647\u0627\u0634\u0648\u0646 \u06af\u067e \u0628\u0632\u0646\u06cc<br><br>\u0622\u06cc\u0686\u064e\u062a \u067e\u0627\u062a\u0648\u0642 \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0628\u0627\u0647\u0645 \u0628\u0648\u062f\u0646\u0647<br><br>\u0686\u062a \u0622\u06cc\u0686\u062a | \u067e\u0627\u062a\u0648\u0642 \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0686\u062a \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc<br><br>\u0686\u062a \u0622\u06cc\u0686\u062a | \u0647\u0645 \u0635\u062d\u0628\u062a \u0648 \u062f\u0648\u0633\u062a\u0627\u0646 \u062c\u062f\u06cc\u062f<br><br>\u0628\u0627 \u06a9\u0645\u06a9 \u0631\u0627\u062f\u0627\u0631 \u062f\u0648\u0633\u062a\u0627\u0646 \u0627\u0637\u0631\u0627\u0641\u062a\u0648 \u067e\u06cc\u062f\u0627 \u06a9\u0646 \u0648 \u0628\u0627\u0647\u0627\u0634\u0648\u0646 \u06af\u067e \u0628\u0632\u0646<br><br>\u0634\u0631\u062d \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0622\u06cc\u0686\u064e\u062a:<br><br>\u062b\u0628\u062a \u0646\u0627\u0645 \u0633\u0627\u062f\u0647 \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0634\u0645\u0627\u0631\u0647 \u0648 \u0627\u06cc\u0645\u06cc\u0644<br>\u0633\u06cc\u0633\u062a\u0645 \u0686\u062a \u0644\u0627\u06cc\u0648 \u0628\u062f\u0648\u0646 \u062a\u0627\u062e\u06cc\u0631<br>\u0627\u0645\u06a9\u0627\u0646 \u062c\u0633\u062a\u062c\u0648\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647<br>\u0627\u0645\u06a9\u0627\u0646 \u0686\u062a \u062e\u0635\u0648\u0635\u06cc \u0628\u0627 \u0647\u0645\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646<br>\u0627\u0645\u06a9\u0627\u0646 \u0686\u062a \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc \u0648 \u06af\u067e \u0628\u0627 \u0647\u0645\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646<br>\u0627\u0645\u06a9\u0627\u0646 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0627\u0641\u0631\u0627\u062f \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0647 \u062e\u0648\u062f\u062a \u06cc\u0627 \u0647\u0645\u0634\u0647\u0631\u06cc \u0647\u0627<br>\u0686\u062a \u0631\u0648\u0645 \u06a9\u0627\u0645\u0644\u0627 \u062d\u0631\u0641\u0647 \u0627\u06cc<br>\u0686\u062a \u0646\u0627\u0634\u0646\u0627\u0633 \u0645\u062c\u0647\u0632 \u0628\u0647 \u0646\u0632\u062f\u06cc\u06a9 \u06cc\u0627\u0628<br>\u0627\u0645\u06a9\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u062a\u0646\u060c \u0639\u06a9\u0633 \u060c \u0635\u062f\u0627 \u0648 \u0641\u06cc\u0644\u0645<br>\u0628\u062f\u0648\u0646 \u0647\u06cc\u0686\u06af\u0648\u0646\u0647 \u067e\u06cc\u0627\u0645 \u06cc\u0627 \u0646\u0648\u062a\u06cc\u0641\u06cc\u06a9\u06cc\u0634\u0646 \u0627\u0636\u0627\u0641\u0647<br>\u0627\u0645\u0646\u06cc\u062a \u0628\u0633\u06cc\u0627\u0631 \u0628\u0627\u0644\u0627 \u0648 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u067e\u06cc\u0627\u0645 \u0647\u0627<br>\u0627\u0645\u06a9\u0627\u0646 \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc\u060c \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc\u060c \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648<br><br>\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u064e\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627<br>\u067e\u06cc\u0634\u0627\u067e\u06cc\u0634 \u0648\u0631\u0648\u062f\u062a\u0648 \u0628\u0647 \u062c\u0645\u0639 \u0635\u0645\u06cc\u0645\u06cc \u062e\u0648\u062f\u0645\u0648\u0646 \u062a\u0628\u0631\u06cc\u06a9 \u0645\u06cc\u06af\u06cc\u0645\ud83d\ude0d\u2665\ufe0f<br>\u0622\u06cc\u0686\u062a (\u0622\u06cc\u200c\u0686\u062a)\u061b \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646\u060c\u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627<br>\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627<br>\u0686\u062a \u0622\u06cc\u0686\u062a | \u0628\u0627\u0632\u06cc\u060c \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0686\u062a \u0631\u0648\u0645\u060c \u062f\u0648\u0633\u062a \u06cc\u0627\u0628\u06cc<br>\u0622\u06cc\u0686\u062a (\u0622\u06cc\u200c\u0686\u062a)\u061b \u067e\u06cc\u0627\u0645 \u0631\u0633\u0627\u0646\u060c\u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627<br>\u0686\u062a (\u0622\u06cc\u0686\u064e\u062a) | \u067e\u0627\u062a\u0648\u0642\u0650 \u0686\u062a \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0627<br><br>\u0622\u06cc\u0686\u064e\u062a \u060c \u0645\u062d\u06cc\u0637\u06cc \u0633\u0627\u0644\u0645 \u0628\u0631\u0627\u06cc \u0686\u062a \u061b \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc \u0628\u0627 \u062f\u0648\u0633\u062a\u0627\u0646",
