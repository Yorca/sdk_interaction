{
    "title": "\u0622\u0686\u0627\u0631\u0647 \u062e\u062f\u0645\u0627\u062a \u0648 \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u062f\u0631 \u0645\u0646\u0632\u0644",
    "description": "\u0686\u0631\u0627 \u0645\u0627 \u0686\u0627\u0631\u0647 \u06a9\u0627\u0631\u06cc\u0645\u061f\r\n\r\n\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u06cc\u0627\u0632\u062a\u0627\u0646 \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0627 \u062e\u06cc\u0627\u0644 \u0631\u0627\u062d\u062a \u0645\u0637\u0645\u0626\u0646 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0628\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0634\u06a9\u0644 \u0627\u0646\u062c\u0627\u0645 \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0645\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0647\u0633\u062a\u06cc\u0645 \u062a\u0627 \u0628\u0631\u0627\u06cc \u062e\u062f\u0645\u0627\u062a \u0645\u0646\u0632\u0644 \u060c \u062e\u0648\u062f\u0631\u0648\u060c \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u0648 \u0647\u0631 \u0622\u0646\u0686\u0647 \u06a9\u0647 \u0641\u06a9\u0631\u0634 \u0631\u0627 \u0628\u06a9\u0646\u06cc\u062f \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627 \u0628\u0627\u0634\u06cc\u0645 \u062a\u0627 \u062f\u063a\u062f\u063a\u0647 \u0627\u06cc \u0628\u0631\u0627\u06cc\u062a\u0627\u0646 \u0628\u0627\u0642\u06cc \u0646\u0645\u0627\u0646\u062f.\u00a0\r\n\r\n\u0647\u0645\u0686\u0646\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647 \u0627\u06cc\u0646 \u0627\u0641\u062a\u062e\u0627\u0631 \u0631\u0627 \u062f\u0627\u0631\u062f \u06a9\u0647 \u0627\u0632 \u0633\u0627\u0644 97 \u062a\u0627 \u0628\u0647 \u0627\u0645\u0631\u0648\u0632 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0631\u06af\u0632\u06cc\u062f\u0647 \u062e\u062f\u0645\u062a \u0631\u0633\u0627\u0646\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0627\u0633\u062a.\r\n\r\n\u0628\u0627 \u0646\u0635\u0628 \u0628\u0631\u0646\u0627\u0645\u0647 \u0622\u0686\u0627\u0631\u0647 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u0631\u0627\u062d\u062a\u200c\u062a\u0631\u06cc \u0628\u0647 \u062b\u0628\u062a \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u062a\u0627\u0646 \u0645\u0627\u0646\u0646\u062f: \u0646\u0638\u0627\u0641\u062a \u0648 \u0634\u0633\u062a\u0634\u0648\u060c \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0644\u0648\u0627\u0632\u0645 \u062e\u0627\u0646\u06af\u06cc\u060c \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0648 \u062f\u06a9\u0648\u0631\u0627\u0633\u06cc\u0648\u0646 \u0648 \u0632\u06cc\u0628\u0627\u06cc\u06cc \u0628\u0627\u0646\u0648\u0627\u0646 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u062a\u0627 \u062f\u0631 \u06a9\u0645\u062a\u0631\u06cc\u0646 \u0632\u0645\u0627\u0646 \u062f\u0631 \u0645\u062d\u0644 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f.\u00a0\r\n\r\n\u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647:\r\n\r\n\u0627\u0631\u0627\u0626\u0647 \u0633\u0631\u0648\u06cc\u0633 \u0647\u0627\u06cc \u0628\u0627 \u06a9\u06cc\u0641\u06cc\u062a \u0648 \u0645\u0642\u0631\u0648\u0646 \u0628\u0647 \u0635\u0631\u0641\u0647 \u062f\u0631 \u0645\u062d\u0644\r\n\u0627\u0645\u06a9\u0627\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0627\u0645\u062a\u06cc\u0627\u0632\u0627\u062a \u0648 \u0631\u0632\u0648\u0645\u0647 \u0622\u0646\u200c\u0647\u0627\u00a0\r\n\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc 12 \u0633\u0627\u0639\u062a\u0647 \u062e\u062f\u0645\u0627\u062a \u0627\u0632\u00a0 \u0633\u0627\u0639\u062a 8 \u0635\u0628\u062d \u0627\u0644\u06cc 9 \u0634\u0628\r\n\u0627\u0631\u0627\u0626\u0647 \u0628\u06cc\u0634 \u0627\u0632 300 \u062e\u062f\u0645\u0627\u062a \u062f\u0631 18 \u0634\u0647\u0631\r\n\u0628\u06cc\u0645\u0647 \u0628\u0648\u062f\u0646 \u062a\u0645\u0627\u0645 \u062e\u062f\u0645\u0627\u062a \u0648 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647\r\n\u062b\u0628\u062a \u0648 \u0644\u063a\u0648 \u0633\u0641\u0627\u0631\u0634 \u06a9\u0627\u0645\u0644\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646\r\n\u0627\u0645\u06a9\u0627\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u0646\u0642\u062f\u06cc \u0648 \u0627\u0639\u062a\u0628\u0627\u0631\u06cc\u00a0\r\n\u0686\u062a \u0628\u0627 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u062c\u0647\u062a \u0647\u0645\u0627\u0647\u0646\u06af\u06cc\r\n\r\n\u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647:\r\n\r\n\u0627\u0632 \u0637\u0631\u06cc\u0642 \u0622\u0686\u0627\u0631\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u0645\u062c\u0631\u0628 \u062a\u0631\u06cc\u0646 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u062f\u0631 \u0633\u0637\u062d \u0634\u0647\u0631 \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0647\u0631\u06af\u0648\u0646\u0647 \u0646\u06cc\u0631\u0648\u06cc \u062a\u0639\u0645\u06cc\u0631\u0627\u062a\u06cc \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0645\u0646\u0632\u0644 \u06cc\u0627 \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u062e\u0648\u062f \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\u060c \u0627\u0632 \u062c\u0645\u0644\u0647: \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u06cc\u062e\u0686\u0627\u0644\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u067e\u06a9\u06cc\u062c \u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u06a9\u0648\u0644\u0631 \u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u0645\u0627\u0634\u06cc\u0646 \u0644\u0628\u0627\u0633\u0634\u0648\u06cc\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0628\u0627\u0631\u0628\u0631\u06cc \u0648 \u0627\u0633\u0628\u0627\u0628 \u06a9\u0634\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0645\u0628\u0644 \u0634\u0648\u06cc\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0642\u0627\u0644\u06cc\u0634\u0648\u06cc\u06cc\u060c \u0646\u062c\u0627\u0631\u060c \u0628\u0631\u0642\u06a9\u0627\u0631 \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u0644\u0648\u0644\u0647 \u06a9\u0634 \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u0622\u0647\u0646\u06af\u0631 \u0648 \u062c\u0648\u0634\u06a9\u0627\u0631\u060c \u0646\u0642\u0627\u0634 \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u060c \u062e\u06cc\u0627\u0637 \u0648 \u0646\u0635\u0627\u0628 \u067e\u0631\u062f\u0647.\r\n\r\n\r\n\u062e\u062f\u0645\u0627\u062a \u0641\u0639\u0627\u0644 \u062f\u0631 \u0622\u0686\u0627\u0631\u0647:\r\n\u062e\u062f\u0645\u0627\u062a \u0646\u0638\u0627\u0641\u062a\u06cc : \u0646\u0638\u0627\u0641\u062a \u0645\u0646\u0632\u0644 \u060c \u0646\u0638\u0627\u0641\u062a \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u067e\u0630\u06cc\u0631\u0627\u06cc\u06cc\u060c \u0645\u0628\u0644 \u0634\u0648\u06cc\u06cc\u060c \u0642\u0627\u0644\u06cc\u0634\u0648\u06cc\u06cc \u060c \u062e\u0634\u06a9\u0634\u0648\u06cc\u06cc \u0648 \u067e\u0631\u062f\u0647 \u0634\u0648\u06cc\u06cc\r\n\u062e\u062f\u0645\u0627\u062a \u0633\u0631\u0645\u0627\u06cc\u0634 \u0648 \u06af\u0631\u0645\u0627\u06cc\u0634: \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0648\u0644\u0631 \u0622\u0628\u06cc \u060c \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0648\u0644\u0631 \u06af\u0627\u0632\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u067e\u06a9\u06cc\u062c \u060c \u062a\u0639\u0645\u06cc\u0631 \u0622\u0628\u06af\u0631\u0645\u06a9\u0646\r\n\u062e\u062f\u0645\u0627\u062a \u0644\u0648\u0644\u0647 \u06a9\u0634\u06cc \u0648 \u062a\u0627\u0633\u06cc\u0633\u0627\u062a: \u0644\u0648\u0644\u0647 \u06a9\u0634\u06cc \u0622\u0628 \u0648 \u0641\u0627\u0636\u0644\u0627\u0628\u060c \u062a\u062e\u0644\u06cc\u0647 \u0686\u0627\u0647 \u0648 \u0644\u0648\u0644\u0647 \u0628\u0627\u0632\u06a9\u0646\u06cc\r\n\u062e\u062f\u0645\u0627\u062a \u0632\u06cc\u0628\u0627\u06cc\u06cc : \u06a9\u0627\u0634\u062a \u0646\u0627\u062e\u0646\u060c \u0631\u0646\u06af \u0645\u0648\u060c \u0622\u0631\u0627\u06cc\u0634 \u0635\u0648\u0631\u062a\u060c \u06a9\u0648\u062a\u0627\u0647\u06cc \u0645\u0648\r\n\u062e\u062f\u0645\u0627\u062a \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646 : \u0646\u0642\u0627\u0634\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u060c \u062f\u06a9\u0648\u0631\u0627\u0633\u06cc\u0648\u0646 \u060c \u06a9\u0627\u0634\u06cc \u0648 \u0633\u0631\u0627\u0645\u06cc\u06a9 \u06a9\u0627\u0631\u06cc\u060c \u0628\u0646\u0627\u06cc\u06cc\u060c \u06af\u0686 \u06a9\u0627\u0631\u06cc\u060c \u0646\u0635\u0628 \u06a9\u0627\u063a\u0630 \u062f\u06cc\u0648\u0627\u0631\u06cc\r\n\u062e\u062f\u0645\u0627\u062a \u0628\u0627\u0631\u0628\u0631\u06cc \u0648 \u062c\u0627\u0628\u062c\u0627\u06cc\u06cc: \u0627\u0633\u0628\u0627\u0628 \u06a9\u0634\u06cc \u0648 \u062d\u0645\u0644 \u0628\u0627\u0631\u060c \u06a9\u0627\u0631\u06af\u0631 \u062c\u0627\u0628\u0647 \u062c\u0627\u06cc\u06cc \u0648 \u0628\u0633\u062a\u0647 \u0628\u0646\u062f\u06cc\r\n\u062e\u062f\u0645\u0627\u062a \u062e\u0648\u062f\u0631\u0648: \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u062e\u0648\u062f\u0631\u0648 \u060c \u062a\u0639\u0648\u06cc\u0636 \u0631\u0648\u063a\u0646 \u060c \u062a\u0639\u0648\u06cc\u0636 \u0628\u0627\u062a\u0631\u06cc\u060c \u0645\u06a9\u0627\u0646\u06cc\u06a9\u06cc \u062e\u0648\u062f\u0631\u0648\u060c \u06a9\u0627\u0631\u0648\u0627\u0634 \u062f\u0631 \u0645\u062d\u0644\r\n\u062e\u062f\u0645\u0627\u062a \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0644\u0648\u0627\u0632\u0645 \u062e\u0627\u0646\u06af\u06cc: \u062a\u0639\u0645\u06cc\u0631 \u0644\u0628\u0627\u0633\u0634\u0648\u06cc\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u06cc\u062e\u0686\u0627\u0644 \u060c \u062a\u0639\u0645\u06cc\u0631 \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646 \u060c \u062a\u0639\u0645\u06cc\u0631 \u062c\u0627\u0631\u0648\u0628\u0631\u0642\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u0645\u0627\u0634\u06cc\u0646 \u0638\u0631\u0641\u0634\u0648\u06cc\u06cc\r\n\u062e\u062f\u0645\u0627\u062a \u062a\u0639\u0645\u06cc\u0631 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0628\u0644\u062a \u0648 \u06a9\u0627\u0645\u067e\u06cc\u0648\u062a\u0631: \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0627\u0645\u067e\u06cc\u0648\u062a\u0631\u060c \u062a\u0639\u0645\u06cc\u0631 \u0628\u0627\u062a\u0631\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u0627\u0633\u067e\u06cc\u06a9\u0631\r\n\u062e\u062f\u0645\u0627\u062a \u0628\u0631\u0642\u06a9\u0627\u0631\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646: \u0633\u06cc\u0645 \u06a9\u0634\u06cc \u0648 \u0628\u0631\u0642\u06a9\u0627\u0631\u06cc\u060c \u0646\u0635\u0628 \u0644\u0648\u0633\u062a\u0631\u060c \u0633\u0631\u0648\u06cc\u0633 \u0622\u0633\u0627\u0646\u0633\u0648\u0631\u060c \u062a\u0639\u0645\u06cc\u0631 \u062f\u0648\u0631\u0628\u06cc\u0646 \u0645\u062f\u0627\u0631\u0628\u0633\u062a\u0647\r\n\r\n\r\n\u0622\u0686\u0627\u0631\u0647 \u062f\u0631 \u0686\u0647 \u0634\u0647\u0631\u0647\u0627\u06cc\u06cc \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u06cc \u062f\u0627\u0631\u062f:\r\n\u0647\u0645 \u0627\u06a9\u0646\u0648\u0646 \u0622\u0686\u0627\u0631\u0647 \u062f\u0631 18 \u0634\u0647\u0631 \u0627\u06cc\u0631\u0627\u0646 \u062e\u062f\u0645\u0627\u062a \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u062f\u0647\u062f \u06a9\u0647 \u0628\u0647 \u0632\u0648\u062f\u06cc \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0641\u0639\u0627\u0644 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.\r\n\u062a\u0647\u0631\u0627\u0646\u060c \u06a9\u0631\u062c\u060c \u0627\u0635\u0641\u0647\u0627\u0646\u060c \u0634\u06cc\u0631\u0627\u0632\u060c \u062a\u0628\u0631\u06cc\u0632\u060c \u0645\u0634\u0647\u062f\u060c \u0631\u0634\u062a\u060c \u06af\u0631\u06af\u0627\u0646\u060c \u0642\u0645\u060c \u06a9\u0631\u0645\u0627\u0646\u060c \u062c\u06cc\u0631\u0641\u062a\u060c \u0631\u0641\u0633\u0646\u062c\u0627\u0646\u060c \u06cc\u0632\u062f\u060c \u0627\u0647\u0648\u0627\u0632\u060c \u0622\u0645\u0644\u060c \u0627\u0631\u0627\u06a9\u060c \u0628\u0646\u062f\u0631\u0639\u0628\u0627\u0633\r\n\r\n\r\n\u062f\u0631 \u0622\u0686\u0627\u0631\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0645\u0634\u06a9\u0644\u06cc \u06cc\u06a9 \u0686\u0627\u0631\u0647 \u0647\u0633\u062a\u060c \u0634\u0645\u0627 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0646\u0635\u0628 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647\u060c \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0648 \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647 \u0628\u0633\u067e\u0627\u0631\u06cc\u062f.\r\n\r\n\u0647\u0645\u0631\u0627\u0647 \u0645\u0627 \u062f\u0631 \u0622\u0686\u0627\u0631\u0647 \u0628\u0627\u0634\u06cc\u062f.\r\n\r\n\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0632 \u0633\u0631\u0627\u0633\u0631 \u06a9\u0634\u0648\u0631: 1471\r\n\u0622\u062f\u0631\u0633 \u0648\u0628\u0633\u0627\u06cc\u062a: https://achareh.co/",
    "descriptionHTML": "\u0686\u0631\u0627 \u0645\u0627 \u0686\u0627\u0631\u0647 \u06a9\u0627\u0631\u06cc\u0645\u061f<br><br>\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u06cc\u0627\u0632\u062a\u0627\u0646 \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0627 \u062e\u06cc\u0627\u0644 \u0631\u0627\u062d\u062a \u0645\u0637\u0645\u0626\u0646 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0628\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0634\u06a9\u0644 \u0627\u0646\u062c\u0627\u0645 \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0645\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0647\u0633\u062a\u06cc\u0645 \u062a\u0627 \u0628\u0631\u0627\u06cc \u062e\u062f\u0645\u0627\u062a \u0645\u0646\u0632\u0644 \u060c \u062e\u0648\u062f\u0631\u0648\u060c \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u0648 \u0647\u0631 \u0622\u0646\u0686\u0647 \u06a9\u0647 \u0641\u06a9\u0631\u0634 \u0631\u0627 \u0628\u06a9\u0646\u06cc\u062f \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627 \u0628\u0627\u0634\u06cc\u0645 \u062a\u0627 \u062f\u063a\u062f\u063a\u0647 \u0627\u06cc \u0628\u0631\u0627\u06cc\u062a\u0627\u0646 \u0628\u0627\u0642\u06cc \u0646\u0645\u0627\u0646\u062f.\u00a0<br><br>\u0647\u0645\u0686\u0646\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647 \u0627\u06cc\u0646 \u0627\u0641\u062a\u062e\u0627\u0631 \u0631\u0627 \u062f\u0627\u0631\u062f \u06a9\u0647 \u0627\u0632 \u0633\u0627\u0644 97 \u062a\u0627 \u0628\u0647 \u0627\u0645\u0631\u0648\u0632 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0628\u0631\u06af\u0632\u06cc\u062f\u0647 \u062e\u062f\u0645\u062a \u0631\u0633\u0627\u0646\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0627\u0633\u062a.<br><br>\u0628\u0627 \u0646\u0635\u0628 \u0628\u0631\u0646\u0627\u0645\u0647 \u0622\u0686\u0627\u0631\u0647 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u0631\u0627\u062d\u062a\u200c\u062a\u0631\u06cc \u0628\u0647 \u062b\u0628\u062a \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u062a\u0627\u0646 \u0645\u0627\u0646\u0646\u062f: \u0646\u0638\u0627\u0641\u062a \u0648 \u0634\u0633\u062a\u0634\u0648\u060c \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0644\u0648\u0627\u0632\u0645 \u062e\u0627\u0646\u06af\u06cc\u060c \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0648 \u062f\u06a9\u0648\u0631\u0627\u0633\u06cc\u0648\u0646 \u0648 \u0632\u06cc\u0628\u0627\u06cc\u06cc \u0628\u0627\u0646\u0648\u0627\u0646 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u062a\u0627 \u062f\u0631 \u06a9\u0645\u062a\u0631\u06cc\u0646 \u0632\u0645\u0627\u0646 \u062f\u0631 \u0645\u062d\u0644 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f.\u00a0<br><br>\u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647:<br><br>\u0627\u0631\u0627\u0626\u0647 \u0633\u0631\u0648\u06cc\u0633 \u0647\u0627\u06cc \u0628\u0627 \u06a9\u06cc\u0641\u06cc\u062a \u0648 \u0645\u0642\u0631\u0648\u0646 \u0628\u0647 \u0635\u0631\u0641\u0647 \u062f\u0631 \u0645\u062d\u0644<br>\u0627\u0645\u06a9\u0627\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0627\u0645\u062a\u06cc\u0627\u0632\u0627\u062a \u0648 \u0631\u0632\u0648\u0645\u0647 \u0622\u0646\u200c\u0647\u0627\u00a0<br>\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc 12 \u0633\u0627\u0639\u062a\u0647 \u062e\u062f\u0645\u0627\u062a \u0627\u0632\u00a0 \u0633\u0627\u0639\u062a 8 \u0635\u0628\u062d \u0627\u0644\u06cc 9 \u0634\u0628<br>\u0627\u0631\u0627\u0626\u0647 \u0628\u06cc\u0634 \u0627\u0632 300 \u062e\u062f\u0645\u0627\u062a \u062f\u0631 18 \u0634\u0647\u0631<br>\u0628\u06cc\u0645\u0647 \u0628\u0648\u062f\u0646 \u062a\u0645\u0627\u0645 \u062e\u062f\u0645\u0627\u062a \u0648 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647<br>\u062b\u0628\u062a \u0648 \u0644\u063a\u0648 \u0633\u0641\u0627\u0631\u0634 \u06a9\u0627\u0645\u0644\u0627 \u0631\u0627\u06cc\u06af\u0627\u0646<br>\u0627\u0645\u06a9\u0627\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u0646\u0642\u062f\u06cc \u0648 \u0627\u0639\u062a\u0628\u0627\u0631\u06cc\u00a0<br>\u0686\u062a \u0628\u0627 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u062c\u0647\u062a \u0647\u0645\u0627\u0647\u0646\u06af\u06cc<br><br>\u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647:<br><br>\u0627\u0632 \u0637\u0631\u06cc\u0642 \u0622\u0686\u0627\u0631\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u0645\u062c\u0631\u0628 \u062a\u0631\u06cc\u0646 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u062f\u0631 \u0633\u0637\u062d \u0634\u0647\u0631 \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0647 \u0631\u0627\u062d\u062a\u06cc \u0647\u0631\u06af\u0648\u0646\u0647 \u0646\u06cc\u0631\u0648\u06cc \u062a\u0639\u0645\u06cc\u0631\u0627\u062a\u06cc \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0645\u0646\u0632\u0644 \u06cc\u0627 \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u062e\u0648\u062f \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\u060c \u0627\u0632 \u062c\u0645\u0644\u0647: \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u06cc\u062e\u0686\u0627\u0644\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u067e\u06a9\u06cc\u062c \u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u06a9\u0648\u0644\u0631 \u060c \u062a\u0639\u0645\u06cc\u0631\u06a9\u0627\u0631 \u0645\u0627\u0634\u06cc\u0646 \u0644\u0628\u0627\u0633\u0634\u0648\u06cc\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0628\u0627\u0631\u0628\u0631\u06cc \u0648 \u0627\u0633\u0628\u0627\u0628 \u06a9\u0634\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0645\u0628\u0644 \u0634\u0648\u06cc\u06cc\u060c \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0642\u0627\u0644\u06cc\u0634\u0648\u06cc\u06cc\u060c \u0646\u062c\u0627\u0631\u060c \u0628\u0631\u0642\u06a9\u0627\u0631 \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u0644\u0648\u0644\u0647 \u06a9\u0634 \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u0622\u0647\u0646\u06af\u0631 \u0648 \u062c\u0648\u0634\u06a9\u0627\u0631\u060c \u0646\u0642\u0627\u0634 \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u060c \u062e\u06cc\u0627\u0637 \u0648 \u0646\u0635\u0627\u0628 \u067e\u0631\u062f\u0647.<br><br><br>\u062e\u062f\u0645\u0627\u062a \u0641\u0639\u0627\u0644 \u062f\u0631 \u0622\u0686\u0627\u0631\u0647:<br>\u062e\u062f\u0645\u0627\u062a \u0646\u0638\u0627\u0641\u062a\u06cc : \u0646\u0638\u0627\u0641\u062a \u0645\u0646\u0632\u0644 \u060c \u0646\u0638\u0627\u0641\u062a \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u060c \u067e\u0630\u06cc\u0631\u0627\u06cc\u06cc\u060c \u0645\u0628\u0644 \u0634\u0648\u06cc\u06cc\u060c \u0642\u0627\u0644\u06cc\u0634\u0648\u06cc\u06cc \u060c \u062e\u0634\u06a9\u0634\u0648\u06cc\u06cc \u0648 \u067e\u0631\u062f\u0647 \u0634\u0648\u06cc\u06cc<br>\u062e\u062f\u0645\u0627\u062a \u0633\u0631\u0645\u0627\u06cc\u0634 \u0648 \u06af\u0631\u0645\u0627\u06cc\u0634: \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0648\u0644\u0631 \u0622\u0628\u06cc \u060c \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0648\u0644\u0631 \u06af\u0627\u0632\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u067e\u06a9\u06cc\u062c \u060c \u062a\u0639\u0645\u06cc\u0631 \u0622\u0628\u06af\u0631\u0645\u06a9\u0646<br>\u062e\u062f\u0645\u0627\u062a \u0644\u0648\u0644\u0647 \u06a9\u0634\u06cc \u0648 \u062a\u0627\u0633\u06cc\u0633\u0627\u062a: \u0644\u0648\u0644\u0647 \u06a9\u0634\u06cc \u0622\u0628 \u0648 \u0641\u0627\u0636\u0644\u0627\u0628\u060c \u062a\u062e\u0644\u06cc\u0647 \u0686\u0627\u0647 \u0648 \u0644\u0648\u0644\u0647 \u0628\u0627\u0632\u06a9\u0646\u06cc<br>\u062e\u062f\u0645\u0627\u062a \u0632\u06cc\u0628\u0627\u06cc\u06cc : \u06a9\u0627\u0634\u062a \u0646\u0627\u062e\u0646\u060c \u0631\u0646\u06af \u0645\u0648\u060c \u0622\u0631\u0627\u06cc\u0634 \u0635\u0648\u0631\u062a\u060c \u06a9\u0648\u062a\u0627\u0647\u06cc \u0645\u0648<br>\u062e\u062f\u0645\u0627\u062a \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646 : \u0646\u0642\u0627\u0634\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u060c \u062f\u06a9\u0648\u0631\u0627\u0633\u06cc\u0648\u0646 \u060c \u06a9\u0627\u0634\u06cc \u0648 \u0633\u0631\u0627\u0645\u06cc\u06a9 \u06a9\u0627\u0631\u06cc\u060c \u0628\u0646\u0627\u06cc\u06cc\u060c \u06af\u0686 \u06a9\u0627\u0631\u06cc\u060c \u0646\u0635\u0628 \u06a9\u0627\u063a\u0630 \u062f\u06cc\u0648\u0627\u0631\u06cc<br>\u062e\u062f\u0645\u0627\u062a \u0628\u0627\u0631\u0628\u0631\u06cc \u0648 \u062c\u0627\u0628\u062c\u0627\u06cc\u06cc: \u0627\u0633\u0628\u0627\u0628 \u06a9\u0634\u06cc \u0648 \u062d\u0645\u0644 \u0628\u0627\u0631\u060c \u06a9\u0627\u0631\u06af\u0631 \u062c\u0627\u0628\u0647 \u062c\u0627\u06cc\u06cc \u0648 \u0628\u0633\u062a\u0647 \u0628\u0646\u062f\u06cc<br>\u062e\u062f\u0645\u0627\u062a \u062e\u0648\u062f\u0631\u0648: \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u062e\u0648\u062f\u0631\u0648 \u060c \u062a\u0639\u0648\u06cc\u0636 \u0631\u0648\u063a\u0646 \u060c \u062a\u0639\u0648\u06cc\u0636 \u0628\u0627\u062a\u0631\u06cc\u060c \u0645\u06a9\u0627\u0646\u06cc\u06a9\u06cc \u062e\u0648\u062f\u0631\u0648\u060c \u06a9\u0627\u0631\u0648\u0627\u0634 \u062f\u0631 \u0645\u062d\u0644<br>\u062e\u062f\u0645\u0627\u062a \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0644\u0648\u0627\u0632\u0645 \u062e\u0627\u0646\u06af\u06cc: \u062a\u0639\u0645\u06cc\u0631 \u0644\u0628\u0627\u0633\u0634\u0648\u06cc\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u06cc\u062e\u0686\u0627\u0644 \u060c \u062a\u0639\u0645\u06cc\u0631 \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646 \u060c \u062a\u0639\u0645\u06cc\u0631 \u062c\u0627\u0631\u0648\u0628\u0631\u0642\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u0645\u0627\u0634\u06cc\u0646 \u0638\u0631\u0641\u0634\u0648\u06cc\u06cc<br>\u062e\u062f\u0645\u0627\u062a \u062a\u0639\u0645\u06cc\u0631 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u062a\u0628\u0644\u062a \u0648 \u06a9\u0627\u0645\u067e\u06cc\u0648\u062a\u0631: \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0627\u0645\u067e\u06cc\u0648\u062a\u0631\u060c \u062a\u0639\u0645\u06cc\u0631 \u0628\u0627\u062a\u0631\u06cc\u060c \u062a\u0639\u0645\u06cc\u0631 \u0627\u0633\u067e\u06cc\u06a9\u0631<br>\u062e\u062f\u0645\u0627\u062a \u0628\u0631\u0642\u06a9\u0627\u0631\u06cc \u0633\u0627\u062e\u062a\u0645\u0627\u0646: \u0633\u06cc\u0645 \u06a9\u0634\u06cc \u0648 \u0628\u0631\u0642\u06a9\u0627\u0631\u06cc\u060c \u0646\u0635\u0628 \u0644\u0648\u0633\u062a\u0631\u060c \u0633\u0631\u0648\u06cc\u0633 \u0622\u0633\u0627\u0646\u0633\u0648\u0631\u060c \u062a\u0639\u0645\u06cc\u0631 \u062f\u0648\u0631\u0628\u06cc\u0646 \u0645\u062f\u0627\u0631\u0628\u0633\u062a\u0647<br><br><br>\u0622\u0686\u0627\u0631\u0647 \u062f\u0631 \u0686\u0647 \u0634\u0647\u0631\u0647\u0627\u06cc\u06cc \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u06cc \u062f\u0627\u0631\u062f:<br>\u0647\u0645 \u0627\u06a9\u0646\u0648\u0646 \u0622\u0686\u0627\u0631\u0647 \u062f\u0631 18 \u0634\u0647\u0631 \u0627\u06cc\u0631\u0627\u0646 \u062e\u062f\u0645\u0627\u062a \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u062f\u0647\u062f \u06a9\u0647 \u0628\u0647 \u0632\u0648\u062f\u06cc \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0641\u0639\u0627\u0644 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.<br>\u062a\u0647\u0631\u0627\u0646\u060c \u06a9\u0631\u062c\u060c \u0627\u0635\u0641\u0647\u0627\u0646\u060c \u0634\u06cc\u0631\u0627\u0632\u060c \u062a\u0628\u0631\u06cc\u0632\u060c \u0645\u0634\u0647\u062f\u060c \u0631\u0634\u062a\u060c \u06af\u0631\u06af\u0627\u0646\u060c \u0642\u0645\u060c \u06a9\u0631\u0645\u0627\u0646\u060c \u062c\u06cc\u0631\u0641\u062a\u060c \u0631\u0641\u0633\u0646\u062c\u0627\u0646\u060c \u06cc\u0632\u062f\u060c \u0627\u0647\u0648\u0627\u0632\u060c \u0622\u0645\u0644\u060c \u0627\u0631\u0627\u06a9\u060c \u0628\u0646\u062f\u0631\u0639\u0628\u0627\u0633<br><br><br>\u062f\u0631 \u0622\u0686\u0627\u0631\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0645\u0634\u06a9\u0644\u06cc \u06cc\u06a9 \u0686\u0627\u0631\u0647 \u0647\u0633\u062a\u060c \u0634\u0645\u0627 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0646\u0635\u0628 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0622\u0686\u0627\u0631\u0647\u060c \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0648 \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0645\u062a\u062e\u0635\u0635\u06cc\u0646 \u0622\u0686\u0627\u0631\u0647 \u0628\u0633\u067e\u0627\u0631\u06cc\u062f.<br><br>\u0647\u0645\u0631\u0627\u0647 \u0645\u0627 \u062f\u0631 \u0622\u0686\u0627\u0631\u0647 \u0628\u0627\u0634\u06cc\u062f.<br><br>\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0632 \u0633\u0631\u0627\u0633\u0631 \u06a9\u0634\u0648\u0631: 1471<br>\u0622\u062f\u0631\u0633 \u0648\u0628\u0633\u0627\u06cc\u062a: https://achareh.co/",
