{
    "title": "\u0644\u0645\u0629 | \u0623\u0644\u0639\u0627\u0628 \u062c\u0645\u0627\u0639\u064a\u0629",
    "description": "\u0647\u0644 \u062a\u0628\u062d\u062b \u0639\u0646 \u0637\u0631\u064a\u0642\u0629 \u0644\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u062d\u064a\u0648\u064a\u0629 \u0639\u0644\u0649 \u062c\u0645\u0639\u0627\u062a\u0643\u061f \u0644\u0627 \u062a\u0646\u0638\u0631 \u0623\u0628\u0639\u062f \u0645\u0646 \"\u0644\u0645\u0629\" - \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u0643\u062b\u0631 \u0625\u062b\u0627\u0631\u0629 \u0644\u0644\u0636\u062d\u0643 \u0648\u0627\u0644\u0627\u0646\u062f\u0645\u0627\u062c! \u0645\u0639 \u0645\u062c\u0645\u0648\u0639\u062a\u0646\u0627 \u0645\u0646 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0645\u0645\u064a\u0632\u0629\u060c \u0633\u062a\u0635\u0628\u062d \u062c\u0645\u0639\u0627\u062a\u0643 \u0645\u0633\u0631\u062d\u064b\u0627 \u0644\u0644\u062a\u0631\u0641\u064a\u0647 \u0639\u0646 \u0627\u0644\u0646\u0641\u0633 \u0648\u0627\u0644\u0645\u0631\u062d \u0627\u0644\u062c\u0646\u0648\u0646\u064a. \u0627\u062a\u0631\u0643 \u0627\u0644\u0645\u0644\u0644 \u062e\u0644\u0641\u0643 \u0648\u0627\u0633\u062a\u0639\u062f \u0644\u0644\u064a\u0644\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0623\u0644\u0639\u0627\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0645\u062b\u0644 \"\u0627\u0644\u0623\u0633\u0631\u0639\" \u0648\"\u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0636\u0648\u0639\" \u0648\u063a\u064a\u0631\u0647\u0627 \u0627\u0644\u0643\u062b\u064a\u0631. \u0644\u0627 \u062a\u0641\u0648\u0651\u062a \u0627\u0644\u0641\u0631\u0635\u0629 \u0644\u0625\u0636\u0627\u0641\u0629 \u0628\u0639\u0636 \u0627\u0644\u0636\u062d\u0643 \u0627\u0644\u0645\u0641\u0631\u0637 \u0625\u0644\u0649 \u062d\u064a\u0627\u062a\u0643 - \u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \"\u0644\u0645\u0629\" \u0627\u0644\u0622\u0646!\r\n\r\n\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u062a\u0646\u0648\u0639\u0629 \u0645\u0646 \u0623\u0644\u0639\u0627\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0648\u0645\u0636\u062d\u0643\u0629 \u062a\u0636\u0645\u0646 \u0644\u064a\u0644\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649. \u0633\u062a\u062c\u062f \u0623\u0644\u0639\u0627\u0628\u064b\u0627 \u0645\u062b\u0644:\r\n\u0627\u0644\u0645\u0627\u0641\u064a\u0627\r\n \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0636\u0648\u0639\r\n\u063a\u0645\u0632\u0629\r\n\u0628\u062f\u0648\u0646 \u0643\u0644\u0627\u0645\r\n\u0627\u0644\u062c\u0627\u0633\u0648\u0633\r\n\u0627\u0644\u0623\u0633\u0631\u0639\r\n\u0627\u0644\u0643\u0646\u0632\r\n\u0645\u064a\u0646 \u0641\u064a\u0646\u0627\u061f\r\n\u0627\u0644\u062a\u0648\u0627\u0632\u0646\r\n\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u0623\u0644\u0639\u0627\u0628 \u0623\u062e\u0631\u0629 \u0645\u0644\u064a\u0626\u0629 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0627\u0644\u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u0636\u062d\u0643. \u0643\u0646 \u0645\u0633\u062a\u0639\u062f\u064b\u0627 \u0644\u0644\u0627\u0646\u063a\u0645\u0627\u0633 \u0641\u064a \u062c\u0648 \u0645\u0646 \u0627\u0644\u0645\u0631\u062d \u0648\u0627\u0644\u0636\u062d\u0643 \u0645\u0639 \u0623\u0635\u062f\u0642\u0627\u0626\u0643 \u0648\u0639\u0627\u0626\u0644\u062a\u0643. \u062a\u0637\u0628\u064a\u0642 \"\u0644\u0645\u0629\" \u0647\u0648 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062b\u0627\u0644\u064a \u0644\u0625\u0636\u0641\u0627\u0621 \u0644\u0645\u0633\u0629 \u0645\u0646 \u0627\u0644\u0628\u0647\u062c\u0629 \u0639\u0644\u0649 \u062c\u0645\u0639\u0627\u062a\u0643!",
    "descriptionHTML": "\u0647\u0644 \u062a\u0628\u062d\u062b \u0639\u0646 \u0637\u0631\u064a\u0642\u0629 \u0644\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u062d\u064a\u0648\u064a\u0629 \u0639\u0644\u0649 \u062c\u0645\u0639\u0627\u062a\u0643\u061f \u0644\u0627 \u062a\u0646\u0638\u0631 \u0623\u0628\u0639\u062f \u0645\u0646 &quot;\u0644\u0645\u0629&quot; - \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u0643\u062b\u0631 \u0625\u062b\u0627\u0631\u0629 \u0644\u0644\u0636\u062d\u0643 \u0648\u0627\u0644\u0627\u0646\u062f\u0645\u0627\u062c! \u0645\u0639 \u0645\u062c\u0645\u0648\u0639\u062a\u0646\u0627 \u0645\u0646 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0645\u0645\u064a\u0632\u0629\u060c \u0633\u062a\u0635\u0628\u062d \u062c\u0645\u0639\u0627\u062a\u0643 \u0645\u0633\u0631\u062d\u064b\u0627 \u0644\u0644\u062a\u0631\u0641\u064a\u0647 \u0639\u0646 \u0627\u0644\u0646\u0641\u0633 \u0648\u0627\u0644\u0645\u0631\u062d \u0627\u0644\u062c\u0646\u0648\u0646\u064a. \u0627\u062a\u0631\u0643 \u0627\u0644\u0645\u0644\u0644 \u062e\u0644\u0641\u0643 \u0648\u0627\u0633\u062a\u0639\u062f \u0644\u0644\u064a\u0644\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0623\u0644\u0639\u0627\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0645\u062b\u0644 &quot;\u0627\u0644\u0623\u0633\u0631\u0639&quot; \u0648&quot;\u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0636\u0648\u0639&quot; \u0648\u063a\u064a\u0631\u0647\u0627 \u0627\u0644\u0643\u062b\u064a\u0631. \u0644\u0627 \u062a\u0641\u0648\u0651\u062a \u0627\u0644\u0641\u0631\u0635\u0629 \u0644\u0625\u0636\u0627\u0641\u0629 \u0628\u0639\u0636 \u0627\u0644\u0636\u062d\u0643 \u0627\u0644\u0645\u0641\u0631\u0637 \u0625\u0644\u0649 \u062d\u064a\u0627\u062a\u0643 - \u0627\u062d\u0635\u0644 \u0639\u0644\u0649 &quot;\u0644\u0645\u0629&quot; \u0627\u0644\u0622\u0646!<br><br>\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u062a\u0646\u0648\u0639\u0629 \u0645\u0646 \u0623\u0644\u0639\u0627\u0628 \u0645\u0628\u062a\u0643\u0631\u0629 \u0648\u0645\u0636\u062d\u0643\u0629 \u062a\u0636\u0645\u0646 \u0644\u064a\u0644\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649. \u0633\u062a\u062c\u062f \u0623\u0644\u0639\u0627\u0628\u064b\u0627 \u0645\u062b\u0644:<br>\u0627\u0644\u0645\u0627\u0641\u064a\u0627<br> \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0636\u0648\u0639<br>\u063a\u0645\u0632\u0629<br>\u0628\u062f\u0648\u0646 \u0643\u0644\u0627\u0645<br>\u0627\u0644\u062c\u0627\u0633\u0648\u0633<br>\u0627\u0644\u0623\u0633\u0631\u0639<br>\u0627\u0644\u0643\u0646\u0632<br>\u0645\u064a\u0646 \u0641\u064a\u0646\u0627\u061f<br>\u0627\u0644\u062a\u0648\u0627\u0632\u0646<br>\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u0623\u0644\u0639\u0627\u0628 \u0623\u062e\u0631\u0629 \u0645\u0644\u064a\u0626\u0629 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0627\u0644\u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u0636\u062d\u0643. \u0643\u0646 \u0645\u0633\u062a\u0639\u062f\u064b\u0627 \u0644\u0644\u0627\u0646\u063a\u0645\u0627\u0633 \u0641\u064a \u062c\u0648 \u0645\u0646 \u0627\u0644\u0645\u0631\u062d \u0648\u0627\u0644\u0636\u062d\u0643 \u0645\u0639 \u0623\u0635\u062f\u0642\u0627\u0626\u0643 \u0648\u0639\u0627\u0626\u0644\u062a\u0643. \u062a\u0637\u0628\u064a\u0642 &quot;\u0644\u0645\u0629&quot; \u0647\u0648 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062b\u0627\u0644\u064a \u0644\u0625\u0636\u0641\u0627\u0621 \u0644\u0645\u0633\u0629 \u0645\u0646 \u0627\u0644\u0628\u0647\u062c\u0629 \u0639\u0644\u0649 \u062c\u0645\u0639\u0627\u062a\u0643!",
    "summary": "\u0627\u0643\u062a\u0634\u0641 \u0623\u0644\u0639\u0627\u0628\u064b\u0627 \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0631\u0627\u0626\u0639\u0629 \u062a\u062c\u0645\u0639\u0643 \u0628\u0623\u0635\u062f\u0642\u0627\u0626\u0643 \u0648\u0639\u0627\u0626\u0644\u062a\u0643!...\u0643\u0646 \u0645\u0633\u062a\u0639\u062f \u0644\u0644\u0645\u0631\u062d \u0648\u0627\u0644\u0636\u062d\u0643",
