{
    "title": "\u0628\u0631\u0646\u0627\u0645\u0647 \u0644\u0627\u0648\u0631\u06cc\u0627",
    "description": "\u0686\u062a \u0631\u0648\u0645 \u0644\u0627\u0648\u0631\u06cc\u0627 \u067e\u0633\u062a\u0648 \u062e\u0648\u0631\u0634\u06cc\u062f \u0647\u0644\u0648 \u0646\u0632\u062f\u06cc\u06a9\u0627 \u06af\u0641\u062a\u06af\u0648\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646 \u0627\u0631\u0633\u0627\u0644 \u0639\u06a9\u0633 \u0648 \u0627\u0633\u062a\u06cc\u06a9\u0631 \u0634\u0628 \u0646\u0645\u0627 \u0645\u0627\u0647 \u0639\u0633\u0644 \u0647\u0645 \u0635\u062d\u0628\u062a\u06cc \u0686\u062a \u0648 \u06af\u0641\u062a\u06af\u0648 \u0628\u0627 \u062f\u0648\u0633\u062a\u0627\u0646 \u0628\u0627 \u0645\u062d\u06cc\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0633\u0627\u062f\u0647 \u0648 \u0631\u0627\u062d\u062a \u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0639\u06a9\u0633 \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u0648 \u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u063a\u0627\u0645 \u0628\u0627 \u0627\u0633\u062a\u06cc\u06a9\u0631 \u0648 \u0639\u06a9\u0633 \u0628\u0627 \u0647\u0645\u062f\u06cc\u06af\u0631 \u06af\u067e \u0628\u0632\u0646\u06cc\u062f \u0686\u062a \u06a9\u0646 \u0648 \u0628\u06cc\u0634\u062a\u0631 \u0622\u0634\u0646\u0627 \u0634\u0648 \u0628\u0627\u0634\u0647\u0631 \u0647\u0627\u06cc \u0646\u0632\u062f\u06cc\u06a9\u0627 \u0646 \u062e\u0648\u062f\u062a \u0686\u062a \u0648 \u06af\u067e \u0628\u0632\u0646",
