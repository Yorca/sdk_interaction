{
    "title": "Samokat: Food Delivery",
    "description": "\u0421\u0430\u043c\u043e\u043a\u0430\u0442 \u2014 \u044d\u0442\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0441 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u043e\u0439 \u043e\u0442 15 \u043c\u0438\u043d\u0443\u0442. \u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u0430\u044f \u0435\u0434\u0430, \u0430 \u0435\u0449\u0451 \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0431\u044b\u0442\u0430 \u0438 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0430. \u0426\u0435\u043d\u044b \u0438 \u0432\u044b\u0431\u043e\u0440 \u2014 \u043a\u0430\u043a \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0443 \u0434\u043e\u043c\u0430.\r\n\r\n\u0410\u041a\u0426\u0418\u0418\r\n\u041c\u044b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c \u0430\u043a\u0446\u0438\u0438 \u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u043c \u0441\u043a\u0438\u0434\u043a\u0438 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043d\u0430\u043f\u0438\u0442\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 <b>SM100</b> \u0434\u0430\u0451\u0442 \u0441\u043a\u0438\u0434\u043a\u0443 100 \u20bd \u043d\u0430 \u0442\u0440\u0438 \u043f\u0435\u0440\u0432\u044b\u0445 \u0437\u0430\u043a\u0430\u0437\u0430. \u0410\u043a\u0446\u0438\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442, \u0435\u0441\u043b\u0438 \u043e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043d\u0430 \u0434\u043e\u043c \u043e\u0442 800 \u20bd.\r\n\u0410 \u0435\u0441\u043b\u0438 \u0432\u044b \u043b\u044e\u0431\u0438\u0442\u0435 \u0431\u043e\u043d\u0443\u0441\u044b \u2014 \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u043f\u043e ID. \u0422\u0430\u043a \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u043e\u043f\u0438\u0442\u044c \u0431\u0430\u043b\u043b\u044b \u0438 \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0438\u0445 \u043d\u0430 \u0437\u0430\u043a\u0430\u0437\u044b \u0432 \u0421\u0430\u043c\u043e\u043a\u0430\u0442\u0435.\r\n\r\n\u0413\u041e\u0420\u041e\u0414\u0410\r\n\u041c\u043e\u0441\u043a\u0432\u0430, \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0410\u043b\u044c\u043c\u0435\u0442\u044c\u0435\u0432\u0441\u043a, \u0410\u0441\u0442\u0440\u0430\u0445\u0430\u043d\u044c, \u0411\u0430\u0440\u043d\u0430\u0443\u043b, \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434, \u0411\u0440\u044f\u043d\u0441\u043a, \u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u041d\u043e\u0432\u0433\u043e\u0440\u043e\u0434, \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440, \u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434, \u0412\u043e\u043b\u043e\u0433\u0434\u0430, \u0412\u043e\u0440\u043e\u043d\u0435\u0436, \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433, \u0418\u0432\u0430\u043d\u043e\u0432\u043e, \u0418\u0436\u0435\u0432\u0441\u043a, \u041a\u0430\u0437\u0430\u043d\u044c, \u041a\u0430\u043b\u0443\u0433\u0430, \u041a\u0435\u043c\u0435\u0440\u043e\u0432\u043e, \u041a\u0438\u0440\u043e\u0432, \u041a\u043e\u043b\u043e\u043c\u043d\u0430, \u041a\u0440\u0430\u0441\u043d\u043e\u0434\u0430\u0440, \u041a\u0440\u0430\u0441\u043d\u043e\u044f\u0440\u0441\u043a, \u041a\u0443\u0440\u0441\u043a, \u041b\u0438\u043f\u0435\u0446\u043a, \u041c\u0430\u0433\u043d\u0438\u0442\u043e\u0433\u043e\u0440\u0441\u043a, \u041d\u0430\u0431\u0435\u0440\u0435\u0436\u043d\u044b\u0435 \u0427\u0435\u043b\u043d\u044b, \u041d\u0438\u0436\u043d\u0435\u043a\u0430\u043c\u0441\u043a, \u041d\u0438\u0436\u043d\u0438\u0439 \u041d\u043e\u0432\u0433\u043e\u0440\u043e\u0434, \u041d\u0438\u0436\u043d\u0438\u0439 \u0422\u0430\u0433\u0438\u043b, \u041d\u043e\u0432\u043e\u043a\u0443\u0437\u043d\u0435\u0446\u043a, \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a, \u041d\u043e\u0432\u043e\u0447\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u0441\u043a, \u041d\u043e\u0433\u0438\u043d\u0441\u043a, \u041e\u043c\u0441\u043a, \u041e\u0440\u0435\u043d\u0431\u0443\u0440\u0433, \u041e\u0440\u0435\u0445\u043e\u0432\u043e-\u0417\u0443\u0435\u0432\u043e, \u041e\u0440\u0451\u043b, \u041f\u0435\u043d\u0437\u0430, \u041f\u0435\u0440\u043c\u044c, \u0420\u043e\u0441\u0442\u043e\u0432-\u043d\u0430-\u0414\u043e\u043d\u0443, \u0420\u044f\u0437\u0430\u043d\u044c, \u0421\u0430\u043c\u0430\u0440\u0430, \u0421\u0430\u0440\u0430\u043d\u0441\u043a, \u0421\u0430\u0440\u0430\u0442\u043e\u0432, \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a, \u0421\u043e\u0447\u0438, \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c, \u0421\u0442\u0435\u0440\u043b\u0438\u0442\u0430\u043c\u0430\u043a, \u0422\u0430\u0433\u0430\u043d\u0440\u043e\u0433, \u0422\u0430\u043c\u0431\u043e\u0432, \u0422\u0432\u0435\u0440\u044c, \u0422\u043e\u043b\u044c\u044f\u0442\u0442\u0438, \u0422\u043e\u043c\u0441\u043a, \u0422\u0443\u043b\u0430, \u0422\u044e\u043c\u0435\u043d\u044c, \u0423\u043b\u044c\u044f\u043d\u043e\u0432\u0441\u043a, \u0423\u0444\u0430, \u0427\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u044b, \u0427\u0435\u043b\u044f\u0431\u0438\u043d\u0441\u043a, \u0427\u0435\u0440\u0435\u043f\u043e\u0432\u0435\u0446, \u042d\u043d\u0433\u0435\u043b\u044c\u0441 \u0438 \u042f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044c.\r\n\r\n\u0411\u042b\u0421\u0422\u0420\u041e\r\n\u0414\u043e\u0441\u0442\u0430\u0432\u0438\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u043d\u0430 \u0434\u043e\u043c \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0437\u0430 15\u201330 \u043c\u0438\u043d\u0443\u0442. \u0422\u0430\u043a \u0431\u044b\u0441\u0442\u0440\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435 \u0441\u0432\u043e\u0439 \u0434\u0430\u0440\u043a\u0441\u0442\u043e\u0440. \u0414\u0430\u0440\u043a\u0441\u0442\u043e\u0440 \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d: \u0432\u043d\u0443\u0442\u0440\u0438 \u043f\u043e\u043b\u043a\u0438 \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u043c\u0438 \u0438 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0438, \u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439 \u2014 \u0441\u0431\u043e\u0440\u0449\u0438\u043a\u0438. \u0417\u0430\u043a\u0430\u0437 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442 \u0437\u0430 2\u20133 \u043c\u0438\u043d\u0443\u0442\u044b, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0442 \u043a\u0443\u0440\u044c\u0435\u0440\u0430\u043c. \u041e\u043d\u0438 \u0440\u0430\u0437\u0432\u043e\u0437\u044f\u0442 \u0438\u0445 \u043f\u043e \u0440\u0430\u0439\u043e\u043d\u0443 \u043d\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0430\u0445.\r\n\r\n\u041a\u0410\u041a \u0412 \u041c\u0410\u0413\u0410\u0417\u0418\u041d\u0415 \u0423 \u0414\u041e\u041c\u0410\r\n\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c:\r\n+ \u0433\u043e\u0442\u043e\u0432\u0430\u044f \u0435\u0434\u0430\r\n+ \u043e\u0432\u043e\u0449\u0438 \u0438 \u0444\u0440\u0443\u043a\u0442\u044b\r\n+ \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u043d\u0430 \u041d\u043e\u0432\u044b\u0439 \u0433\u043e\u0434\r\n+ \u043d\u043e\u0432\u043e\u0433\u043e\u0434\u043d\u0438\u0435 \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u0438\u044f\r\n+ \u043a\u0440\u0443\u043f\u044b, \u043c\u0430\u043a\u0430\u0440\u043e\u043d\u044b \u0438 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u044b\r\n+ \u043c\u044f\u0441\u043e \u0438 \u043f\u0442\u0438\u0446\u0430\r\n+ \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0435\u0434\u0430\r\n+ \u043c\u043e\u043b\u043e\u043a\u043e, \u044f\u0439\u0446\u0430 \u0438 \u043c\u0430\u0441\u043b\u043e\r\n+ \u0445\u043b\u0435\u0431 \u0438 \u0432\u044b\u043f\u0435\u0447\u043a\u0430\r\n+ \u0441\u044b\u0440\u044b\r\n+ \u043a\u043e\u043b\u0431\u0430\u0441\u0430 \u0438 \u0441\u043e\u0441\u0438\u0441\u043a\u0438\r\n+ \u0440\u044b\u0431\u0430 \u0438 \u043c\u043e\u0440\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b\r\n+ \u0447\u0430\u0439 \u0438 \u043a\u043e\u0444\u0435\r\n+ \u0432\u043e\u0434\u0430, \u043b\u0438\u043c\u043e\u043d\u0430\u0434\u044b \u0438 \u0441\u043e\u043a\u0438\r\n+ \u0441\u043b\u0430\u0434\u043a\u043e\u0435\r\n+ \u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e\u0435\r\n+ \u0447\u0438\u043f\u0441\u044b\r\n+ \u0431\u0435\u0437\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0432\u043e \u0438 \u0432\u0438\u043d\u043e\r\n+ \u0432\u0435\u0433\u0430\u043d\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043d\u0430\u043f\u0438\u0442\u043a\u0438\r\n+ \u0442\u043e\u0432\u0430\u0440\u044b \u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\r\n+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\r\n+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445\r\n+ \u0448\u0430\u043c\u043f\u0443\u043d\u0438 \u0438 \u0433\u0435\u043b\u0438 \u0434\u043b\u044f \u0434\u0443\u0448\u0430\r\n+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u043e\u043c\u0430\r\n+ \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0430 \u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0443\u0445\u043e\u0434\u0430\r\n\r\n\u0412\u0421\u0401 \u0421\u0412\u0415\u0416\u0415\u0415\r\n\u0414\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u043d\u0430\u0448\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442 \u0441\u0440\u043e\u043a \u0433\u043e\u0434\u043d\u043e\u0441\u0442\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434 \u0444\u0440\u0443\u043a\u0442\u043e\u0432 \u0438 \u043e\u0432\u043e\u0449\u0435\u0439. \u0412 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0430\u0445 \u0432 \u0434\u0430\u0440\u043a\u0441\u0442\u043e\u0440\u0435 \u043c\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 2\u20134 \u00b0\u0421, \u0432 \u043c\u043e\u0440\u043e\u0437\u0438\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u043c\u0435\u0440\u0430\u0445 \u221218 \u00b0\u0421.\r\n\r\n\u041e\u0422 \u0421\u0410\u041c\u041e\u041a\u0410\u0422\u0410\r\n\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u044f \u043c\u0430\u0440\u043a\u0430, \u043f\u043e\u0434 \u043d\u0435\u0439 \u043c\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u043e\u043c\u0430. \u0421\u0430\u043c\u0438 \u0438\u0449\u0435\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u2014 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445. \u041e\u0431\u0449\u0430\u0435\u043c\u0441\u044f \u0441 \u043d\u0438\u043c\u0438 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u043c \u0442\u0435\u0445, \u043a\u0442\u043e \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043b\u044e\u0431\u0438\u0442 \u0438 \u0437\u043d\u0430\u0435\u0442 \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e. \u0412\u0435\u0441\u044c \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u043d\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044f\u0445 \u0438 \u043f\u0440\u043e\u0431\u0443\u0435\u043c \u0441\u0430\u043c\u0438.\r\n\r\n\u0421\u0423\u041f\u0415\u0420\u041c\u0410\u0420\u041a\u0415\u0422\r\n\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0421\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442. \u042d\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0441\u0435\u0433\u043e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0430\u043c \u0435\u0441\u0442\u044c \u0431\u044b\u0442\u043e\u0432\u0430\u044f \u0442\u0435\u0445\u043d\u0438\u043a\u0430, \u044d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0440\u0443\u043a\u0442\u044b \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0430\u0447\u043a\u0438 \u043a\u043e\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0438\u0442\u043e\u043c\u0446\u0435\u0432. \u0423\u0434\u043e\u0431\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043a\u0443\u043f\u0438\u0442\u044c\u0441\u044f \u0441\u0440\u0430\u0437\u0443 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e. \u0412\u0440\u0435\u043c\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u2014 \u043e\u0442 15 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e 1,5 \u0447\u0430\u0441\u0430.\r\n\r\n\u0411\u042c\u042e\u0422\u0418\r\n\u0412 \u041c\u043e\u0441\u043a\u0432\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0411\u044c\u044e\u0442\u0438. \u0417\u0430\u0433\u043b\u044f\u043d\u0438\u0442\u0435, \u0442\u0430\u043c \u043c\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0433\u043e: \u043e\u0442 \u043a\u043e\u0440\u0435\u0439\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u043e\u043a \u0434\u043e \u0441\u0430\u043b\u043e\u043d\u043d\u043e\u0439 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0441. \u0411\u0440\u0435\u043d\u0434\u044b \u2014 \u043a\u0430\u043a \u043c\u0430\u0441\u0441-\u043c\u0430\u0440\u043a\u0435\u0442, \u0442\u0430\u043a \u0438 \u043d\u0438\u0448\u0435\u0432\u044b\u0435, \u043c\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u043e\u043a. \u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0430\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0432 \u0434\u0435\u043d\u044c \u0437\u0430\u043a\u0430\u0437\u0430.\r\n\r\n\u041c\u0415\u0414\u0418\u0410\r\n\u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u043c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430: \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u044b, \u0441\u043e\u0432\u0435\u0442\u044b \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432, \u043e\u0431\u0437\u043e\u0440\u044b \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0438 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0438, \u0433\u0438\u0434\u044b \u043f\u043e \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442\u0430\u043c. \u041d\u0430\u0448\u0430 \u0446\u0435\u043b\u044c \u2014 \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c\u0438.\r\n\r\n\u0413\u0414\u0415 \u041d\u0410\u0421 \u0418\u0421\u041a\u0410\u0422\u042c\r\n\u0412\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u2014 vk.com/samokat_15min\r\n\u0422\u0435\u043b\u0435\u0433\u0440\u0430\u043c \u2014 t.me/samokatwithlove\r\n\u0422\u0435\u043b\u0435\u0433\u0440\u0430\u043c \u0411\u044c\u044e\u0442\u0438 \u2014 t.me/samokat_beauty",
    "descriptionHTML": "\u0421\u0430\u043c\u043e\u043a\u0430\u0442 \u2014 \u044d\u0442\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0441 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u043e\u0439 \u043e\u0442 15 \u043c\u0438\u043d\u0443\u0442. \u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u0430\u044f \u0435\u0434\u0430, \u0430 \u0435\u0449\u0451 \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0431\u044b\u0442\u0430 \u0438 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0430. \u0426\u0435\u043d\u044b \u0438 \u0432\u044b\u0431\u043e\u0440 \u2014 \u043a\u0430\u043a \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0443 \u0434\u043e\u043c\u0430.<br><br>\u0410\u041a\u0426\u0418\u0418<br>\u041c\u044b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c \u0430\u043a\u0446\u0438\u0438 \u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u043c \u0441\u043a\u0438\u0434\u043a\u0438 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043d\u0430\u043f\u0438\u0442\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 <b>SM100</b> \u0434\u0430\u0451\u0442 \u0441\u043a\u0438\u0434\u043a\u0443 100 \u20bd \u043d\u0430 \u0442\u0440\u0438 \u043f\u0435\u0440\u0432\u044b\u0445 \u0437\u0430\u043a\u0430\u0437\u0430. \u0410\u043a\u0446\u0438\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442, \u0435\u0441\u043b\u0438 \u043e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043d\u0430 \u0434\u043e\u043c \u043e\u0442 800 \u20bd.<br>\u0410 \u0435\u0441\u043b\u0438 \u0432\u044b \u043b\u044e\u0431\u0438\u0442\u0435 \u0431\u043e\u043d\u0443\u0441\u044b \u2014 \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u043f\u043e ID. \u0422\u0430\u043a \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u043e\u043f\u0438\u0442\u044c \u0431\u0430\u043b\u043b\u044b \u0438 \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0438\u0445 \u043d\u0430 \u0437\u0430\u043a\u0430\u0437\u044b \u0432 \u0421\u0430\u043c\u043e\u043a\u0430\u0442\u0435.<br><br>\u0413\u041e\u0420\u041e\u0414\u0410<br>\u041c\u043e\u0441\u043a\u0432\u0430, \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0410\u043b\u044c\u043c\u0435\u0442\u044c\u0435\u0432\u0441\u043a, \u0410\u0441\u0442\u0440\u0430\u0445\u0430\u043d\u044c, \u0411\u0430\u0440\u043d\u0430\u0443\u043b, \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434, \u0411\u0440\u044f\u043d\u0441\u043a, \u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u041d\u043e\u0432\u0433\u043e\u0440\u043e\u0434, \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440, \u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434, \u0412\u043e\u043b\u043e\u0433\u0434\u0430, \u0412\u043e\u0440\u043e\u043d\u0435\u0436, \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433, \u0418\u0432\u0430\u043d\u043e\u0432\u043e, \u0418\u0436\u0435\u0432\u0441\u043a, \u041a\u0430\u0437\u0430\u043d\u044c, \u041a\u0430\u043b\u0443\u0433\u0430, \u041a\u0435\u043c\u0435\u0440\u043e\u0432\u043e, \u041a\u0438\u0440\u043e\u0432, \u041a\u043e\u043b\u043e\u043c\u043d\u0430, \u041a\u0440\u0430\u0441\u043d\u043e\u0434\u0430\u0440, \u041a\u0440\u0430\u0441\u043d\u043e\u044f\u0440\u0441\u043a, \u041a\u0443\u0440\u0441\u043a, \u041b\u0438\u043f\u0435\u0446\u043a, \u041c\u0430\u0433\u043d\u0438\u0442\u043e\u0433\u043e\u0440\u0441\u043a, \u041d\u0430\u0431\u0435\u0440\u0435\u0436\u043d\u044b\u0435 \u0427\u0435\u043b\u043d\u044b, \u041d\u0438\u0436\u043d\u0435\u043a\u0430\u043c\u0441\u043a, \u041d\u0438\u0436\u043d\u0438\u0439 \u041d\u043e\u0432\u0433\u043e\u0440\u043e\u0434, \u041d\u0438\u0436\u043d\u0438\u0439 \u0422\u0430\u0433\u0438\u043b, \u041d\u043e\u0432\u043e\u043a\u0443\u0437\u043d\u0435\u0446\u043a, \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a, \u041d\u043e\u0432\u043e\u0447\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u0441\u043a, \u041d\u043e\u0433\u0438\u043d\u0441\u043a, \u041e\u043c\u0441\u043a, \u041e\u0440\u0435\u043d\u0431\u0443\u0440\u0433, \u041e\u0440\u0435\u0445\u043e\u0432\u043e-\u0417\u0443\u0435\u0432\u043e, \u041e\u0440\u0451\u043b, \u041f\u0435\u043d\u0437\u0430, \u041f\u0435\u0440\u043c\u044c, \u0420\u043e\u0441\u0442\u043e\u0432-\u043d\u0430-\u0414\u043e\u043d\u0443, \u0420\u044f\u0437\u0430\u043d\u044c, \u0421\u0430\u043c\u0430\u0440\u0430, \u0421\u0430\u0440\u0430\u043d\u0441\u043a, \u0421\u0430\u0440\u0430\u0442\u043e\u0432, \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a, \u0421\u043e\u0447\u0438, \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c, \u0421\u0442\u0435\u0440\u043b\u0438\u0442\u0430\u043c\u0430\u043a, \u0422\u0430\u0433\u0430\u043d\u0440\u043e\u0433, \u0422\u0430\u043c\u0431\u043e\u0432, \u0422\u0432\u0435\u0440\u044c, \u0422\u043e\u043b\u044c\u044f\u0442\u0442\u0438, \u0422\u043e\u043c\u0441\u043a, \u0422\u0443\u043b\u0430, \u0422\u044e\u043c\u0435\u043d\u044c, \u0423\u043b\u044c\u044f\u043d\u043e\u0432\u0441\u043a, \u0423\u0444\u0430, \u0427\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u044b, \u0427\u0435\u043b\u044f\u0431\u0438\u043d\u0441\u043a, \u0427\u0435\u0440\u0435\u043f\u043e\u0432\u0435\u0446, \u042d\u043d\u0433\u0435\u043b\u044c\u0441 \u0438 \u042f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044c.<br><br>\u0411\u042b\u0421\u0422\u0420\u041e<br>\u0414\u043e\u0441\u0442\u0430\u0432\u0438\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u043d\u0430 \u0434\u043e\u043c \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0437\u0430 15\u201330 \u043c\u0438\u043d\u0443\u0442. \u0422\u0430\u043a \u0431\u044b\u0441\u0442\u0440\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435 \u0441\u0432\u043e\u0439 \u0434\u0430\u0440\u043a\u0441\u0442\u043e\u0440. \u0414\u0430\u0440\u043a\u0441\u0442\u043e\u0440 \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d: \u0432\u043d\u0443\u0442\u0440\u0438 \u043f\u043e\u043b\u043a\u0438 \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u043c\u0438 \u0438 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0438, \u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439 \u2014 \u0441\u0431\u043e\u0440\u0449\u0438\u043a\u0438. \u0417\u0430\u043a\u0430\u0437 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442 \u0437\u0430 2\u20133 \u043c\u0438\u043d\u0443\u0442\u044b, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0442 \u043a\u0443\u0440\u044c\u0435\u0440\u0430\u043c. \u041e\u043d\u0438 \u0440\u0430\u0437\u0432\u043e\u0437\u044f\u0442 \u0438\u0445 \u043f\u043e \u0440\u0430\u0439\u043e\u043d\u0443 \u043d\u0430 \u0432\u0435\u043b\u043e\u0441\u0438\u043f\u0435\u0434\u0430\u0445.<br><br>\u041a\u0410\u041a \u0412 \u041c\u0410\u0413\u0410\u0417\u0418\u041d\u0415 \u0423 \u0414\u041e\u041c\u0410<br>\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c:<br>+ \u0433\u043e\u0442\u043e\u0432\u0430\u044f \u0435\u0434\u0430<br>+ \u043e\u0432\u043e\u0449\u0438 \u0438 \u0444\u0440\u0443\u043a\u0442\u044b<br>+ \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u043d\u0430 \u041d\u043e\u0432\u044b\u0439 \u0433\u043e\u0434<br>+ \u043d\u043e\u0432\u043e\u0433\u043e\u0434\u043d\u0438\u0435 \u0443\u043a\u0440\u0430\u0448\u0435\u043d\u0438\u044f<br>+ \u043a\u0440\u0443\u043f\u044b, \u043c\u0430\u043a\u0430\u0440\u043e\u043d\u044b \u0438 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u044b<br>+ \u043c\u044f\u0441\u043e \u0438 \u043f\u0442\u0438\u0446\u0430<br>+ \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0435\u0434\u0430<br>+ \u043c\u043e\u043b\u043e\u043a\u043e, \u044f\u0439\u0446\u0430 \u0438 \u043c\u0430\u0441\u043b\u043e<br>+ \u0445\u043b\u0435\u0431 \u0438 \u0432\u044b\u043f\u0435\u0447\u043a\u0430<br>+ \u0441\u044b\u0440\u044b<br>+ \u043a\u043e\u043b\u0431\u0430\u0441\u0430 \u0438 \u0441\u043e\u0441\u0438\u0441\u043a\u0438<br>+ \u0440\u044b\u0431\u0430 \u0438 \u043c\u043e\u0440\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b<br>+ \u0447\u0430\u0439 \u0438 \u043a\u043e\u0444\u0435<br>+ \u0432\u043e\u0434\u0430, \u043b\u0438\u043c\u043e\u043d\u0430\u0434\u044b \u0438 \u0441\u043e\u043a\u0438<br>+ \u0441\u043b\u0430\u0434\u043a\u043e\u0435<br>+ \u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e\u0435<br>+ \u0447\u0438\u043f\u0441\u044b<br>+ \u0431\u0435\u0437\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0432\u043e \u0438 \u0432\u0438\u043d\u043e<br>+ \u0432\u0435\u0433\u0430\u043d\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u043d\u0430\u043f\u0438\u0442\u043a\u0438<br>+ \u0442\u043e\u0432\u0430\u0440\u044b \u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d<br>+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439<br>+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445<br>+ \u0448\u0430\u043c\u043f\u0443\u043d\u0438 \u0438 \u0433\u0435\u043b\u0438 \u0434\u043b\u044f \u0434\u0443\u0448\u0430<br>+ \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u043e\u043c\u0430<br>+ \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0430 \u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0443\u0445\u043e\u0434\u0430<br><br>\u0412\u0421\u0401 \u0421\u0412\u0415\u0416\u0415\u0415<br>\u0414\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u043d\u0430\u0448\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442 \u0441\u0440\u043e\u043a \u0433\u043e\u0434\u043d\u043e\u0441\u0442\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434 \u0444\u0440\u0443\u043a\u0442\u043e\u0432 \u0438 \u043e\u0432\u043e\u0449\u0435\u0439. \u0412 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0430\u0445 \u0432 \u0434\u0430\u0440\u043a\u0441\u0442\u043e\u0440\u0435 \u043c\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 2\u20134 \u00b0\u0421, \u0432 \u043c\u043e\u0440\u043e\u0437\u0438\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u043c\u0435\u0440\u0430\u0445 \u221218 \u00b0\u0421.<br><br>\u041e\u0422 \u0421\u0410\u041c\u041e\u041a\u0410\u0422\u0410<br>\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u044f \u043c\u0430\u0440\u043a\u0430, \u043f\u043e\u0434 \u043d\u0435\u0439 \u043c\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u0442\u043e\u0432\u0430\u0440\u044b \u0434\u043b\u044f \u0434\u043e\u043c\u0430. \u0421\u0430\u043c\u0438 \u0438\u0449\u0435\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u2014 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445. \u041e\u0431\u0449\u0430\u0435\u043c\u0441\u044f \u0441 \u043d\u0438\u043c\u0438 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u043c \u0442\u0435\u0445, \u043a\u0442\u043e \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043b\u044e\u0431\u0438\u0442 \u0438 \u0437\u043d\u0430\u0435\u0442 \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e. \u0412\u0435\u0441\u044c \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u043d\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044f\u0445 \u0438 \u043f\u0440\u043e\u0431\u0443\u0435\u043c \u0441\u0430\u043c\u0438.<br><br>\u0421\u0423\u041f\u0415\u0420\u041c\u0410\u0420\u041a\u0415\u0422<br>\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0421\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442. \u042d\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0441\u0435\u0433\u043e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0430\u043c \u0435\u0441\u0442\u044c \u0431\u044b\u0442\u043e\u0432\u0430\u044f \u0442\u0435\u0445\u043d\u0438\u043a\u0430, \u044d\u043a\u0437\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0440\u0443\u043a\u0442\u044b \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0430\u0447\u043a\u0438 \u043a\u043e\u0440\u043c\u0430 \u0434\u043b\u044f \u043f\u0438\u0442\u043e\u043c\u0446\u0435\u0432. \u0423\u0434\u043e\u0431\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043a\u0443\u043f\u0438\u0442\u044c\u0441\u044f \u0441\u0440\u0430\u0437\u0443 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e. \u0412\u0440\u0435\u043c\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u2014 \u043e\u0442 15 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e 1,5 \u0447\u0430\u0441\u0430.<br><br>\u0411\u042c\u042e\u0422\u0418<br>\u0412 \u041c\u043e\u0441\u043a\u0432\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0411\u044c\u044e\u0442\u0438. \u0417\u0430\u0433\u043b\u044f\u043d\u0438\u0442\u0435, \u0442\u0430\u043c \u043c\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0433\u043e: \u043e\u0442 \u043a\u043e\u0440\u0435\u0439\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u043e\u043a \u0434\u043e \u0441\u0430\u043b\u043e\u043d\u043d\u043e\u0439 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0441. \u0411\u0440\u0435\u043d\u0434\u044b \u2014 \u043a\u0430\u043a \u043c\u0430\u0441\u0441-\u043c\u0430\u0440\u043a\u0435\u0442, \u0442\u0430\u043a \u0438 \u043d\u0438\u0448\u0435\u0432\u044b\u0435, \u043c\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u043e\u043a. \u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0430\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0432 \u0434\u0435\u043d\u044c \u0437\u0430\u043a\u0430\u0437\u0430.<br><br>\u041c\u0415\u0414\u0418\u0410<br>\u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u043c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430: \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u044b, \u0441\u043e\u0432\u0435\u0442\u044b \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432, \u043e\u0431\u0437\u043e\u0440\u044b \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0438 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0438, \u0433\u0438\u0434\u044b \u043f\u043e \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442\u0430\u043c. \u041d\u0430\u0448\u0430 \u0446\u0435\u043b\u044c \u2014 \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c\u0438.<br><br>\u0413\u0414\u0415 \u041d\u0410\u0421 \u0418\u0421\u041a\u0410\u0422\u042c<br>\u0412\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u2014 vk.com/samokat_15min<br>\u0422\u0435\u043b\u0435\u0433\u0440\u0430\u043c \u2014 t.me/samokatwithlove<br>\u0422\u0435\u043b\u0435\u0433\u0440\u0430\u043c \u0411\u044c\u044e\u0442\u0438 \u2014 t.me/samokat_beauty",
