{
    "title": "\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 - \u0628\u062b \u0645\u0628\u0627\u0634\u0631",
    "description": "\u0645\u0639 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641\u060c \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u0622\u062e\u0631 \u062a\u0637\u0648\u0631\u0627\u062a \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0628\u0634\u0643\u0644 \u0641\u0648\u0631\u064a\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0645\u0644\u062e\u0635\u0627\u062a \u0648 \u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0628\u062b \u0645\u0628\u0627\u0634\u0631. \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u0630\u0644\u0643 \u0647\u062f\u0641\u064b\u0627\u060c \u0645\u062d\u0627\u0648\u0644\u0629\u060c \u0623\u0648 \u0642\u0631\u0627\u0631\u064b\u0627 \u0645\u062b\u064a\u0631\u064b\u0627 \u0644\u0644\u062c\u062f\u0644\u060c \u0641\u0625\u0646 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u062a\u0642\u062f\u0645 \u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u0623\u0643\u062b\u0631 \u0625\u062b\u0627\u0631\u0629 \u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u0629.\r\n\r\n\r\n\u0643\u0630\u0644\u0643 \u0639\u0628\u0631 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u0645\u0628\u0627\u0634\u0631\u060c \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u0641\u0631\u0642\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u0648\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u062f\u0642\u064a\u0642\u0629 \u0628\u062f\u0642\u064a\u0642\u0629. \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u0630\u0644\u0643 \u0647\u062f\u0641\u064b\u0627 \u062d\u0627\u0633\u0645\u064b\u0627\u060c \u0623\u0648 \u062a\u063a\u064a\u064a\u0631\u064b\u0627 \u0641\u064a \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u0639\u0628\u0629\u060c \u0623\u0648 \u062d\u062a\u0649 \u0631\u0643\u0644\u0627\u062a \u0627\u0644\u062a\u0631\u062c\u064a\u062d\u060c \u0641\u0625\u0646 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u062a\u0636\u0645\u0646 \u0623\u0646\u0643 \u062f\u0627\u0626\u0645\u064b\u0627 \u0639\u0644\u0649 \u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0643\u0644 \u062a\u0637\u0648\u0631\u0627\u062a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0645\u0628\u0627\u0634\u0631.\r\n\r\n\r\n\u0644\u0643\u064a \u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0645\u062a\u0627\u0628\u0639\u0629 \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u062f\u0648\u0631\u064a\u0627\u062a \u0627\u0644\u0643\u0628\u0631\u0649 \u0645\u062b\u0644 :\r\n\r\n\u062f\u0648\u0631\u064a \u0627\u0628\u0637\u0627\u0644 \u0627\u0648\u0631\u0648\u0628\u0627\r\n\u062f\u0648\u0631\u064a \u0627\u0628\u0637\u0627\u0644 \u0627\u0633\u064a\u0627\r\n\u062f\u0648\u0631\u064a \u0627\u0628\u0637\u0627\u0644 \u0627\u0641\u0631\u064a\u0642\u064a\u0627\r\n\u0627\u0644\u0628\u0637\u0648\u0644\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0644\u0644\u0623\u0646\u062f\u064a\u0629\r\n\r\n\u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\r\n\u0643\u0623\u0633 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\r\n\u0643\u0623\u0633 \u0645\u0644\u0643 \u0625\u0633\u0628\u0627\u0646\u064a\u0627\r\n\u0643\u0623\u0633 \u0627\u0644\u0633\u0648\u0628\u0631 \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\r\n\r\n\u062f\u0648\u0631\u064a \u0627\u0644\u0623\u0645\u0645 \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\u0629\r\n\u062f\u0648\u0631\u064a \u0627\u0644\u0645\u0624\u062a\u0645\u0631 \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\r\n\u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 \u0644\u0644\u0623\u0646\u062f\u064a\u0629\r\n\u0643\u0623\u0633 \u0623\u0645\u0645 \u0623\u0648\u0631\u0648\u0628\u0627 \u064a\u0648\u0631\u0648\r\n\u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645\r\n\r\n\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u0647\u0648 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u0641\u0636\u0644 \u0644\u0643\u0644 \u0639\u0634\u0627\u0642 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645\u060c \u062d\u064a\u062b \u064a\u0648\u0641\u0631 \u0628\u0631\u0646\u0627\u0645\u062c Mobaryat Live \u062a\u062c\u0631\u0628\u0629 \u0633\u0644\u0633\u0629 \u0648\u0645\u0644\u064a\u0626\u0629 \u0628\u0623\u062d\u062f\u062b \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0648\u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0627\u0644\u0639\u0627\u062c\u0644\u0629 \u0641\u064a \u0639\u0627\u0644\u0645 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0646 \u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 \u0627\u0644\u0639\u0627\u0644\u0645. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u0645\u0646 \u0623\u0634\u062f \u0627\u0644\u0645\u0639\u062c\u0628\u064a\u0646 \u0628\u0641\u0631\u064a\u0642\u0643 \u0627\u0644\u0645\u0641\u0636\u0644 \u0623\u0648 \u062a\u0631\u063a\u0628 \u0641\u064a \u0645\u062a\u0627\u0628\u0639\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u062f\u0648\u0631\u064a\u0627\u062a\u060c \u0641\u064a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u062a\u062c\u062f \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0628\u0643\u0644 \u0633\u0647\u0648\u0644\u0629 \u0648\u064a\u0633\u0631.\r\n\r\n\r\n\u0627\u0628\u0642 \u0639\u0644\u0649 \u0627\u0637\u0644\u0627\u0639 \u0628\u062a\u063a\u0637\u064a\u0629 \u0634\u0627\u0645\u0644\u0629 \u062d\u0648\u0644 \u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u0648 \u0644\u0643\u0644 \u0627\u0644\u062f\u0648\u0631\u064a\u0627\u062a \u0648\u0627\u0644\u0628\u0637\u0648\u0644\u0627\u062a \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u060c \u0648\u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u060c \u0648\u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u064a\u0637\u0627\u0644\u064a\u060c \u0648\u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u060c \u0648\u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0623\u0648\u0631\u0648\u0628\u0627\u060c \u0648\u0627\u0644\u0645\u0632\u064a\u062f. \u0645\u0639 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0645\u0628\u0627\u0634\u0631\u060c \u0644\u0646 \u062a\u0641\u0648\u062a\u0643 \u0623\u064a \u0644\u062d\u0638\u0629 \u0645\u0646 \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u062c\u0645\u064a\u0644\u0629.\r\n\r\n\r\n\u0628\u0641\u0636\u0644 \u062a\u0637\u0628\u064a\u0642 \"\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0645\u0628\u0627\u0634\u0631\"\u060c \u0623\u0635\u0628\u062d \u0639\u0627\u0644\u0645 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0641\u064a \u0645\u062a\u0646\u0627\u0648\u0644 \u064a\u062f\u0643. \u0627\u0633\u062a\u0643\u0634\u0641 \u062e\u064a\u0627\u0631 \u062a\u0644\u0641\u0627\u0632 \u0645\u0628\u0627\u0634\u0631 \u0648\u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u062a\u062c\u0631\u0628\u0629 \u0645\u062b\u064a\u0631\u0629 \u0644\u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0644\u0639\u0628\u0629 \u0643\u0645\u0627 \u0644\u0645 \u062a\u0643\u0646 \u0645\u0646 \u0642\u0628\u0644. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u062d\u0636\u0631 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u062f\u0631\u062c\u0627\u062a \u0623\u0648 \u062a\u062a\u0627\u0628\u0639\u0647\u0627 \u0645\u0646 \u0645\u0646\u0632\u0644\u0643\u060c \u062a\u0644\u0641\u0632\u064a\u0648\u0646 \u0645\u0628\u0627\u0634\u0631 \u0642\u0646\u0648\u0627\u062a \u0647\u0648 \u0627\u0644\u0631\u0641\u064a\u0642 \u0627\u0644\u0645\u062b\u0627\u0644\u064a \u0644\u0643 \u0641\u064a \u0643\u0644 \u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0628\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645.\r\n\r\n\r\n\u064a\u062a\u0648\u0641\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0646 \u0646\u0628\u0630\u0629 \u062d\u0648\u0644 \u0627\u062e\u0631\u0627\u0644\u062d\u0635\u0631\u064a\u0627\u062a \u0648 \u062a\u062a\u0628\u0639 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u062d\u0648\u0644 :\r\n\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0623\u0648\u0631\u0648\u0628\u0627\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u062f\u0648\u0631\u064a \u0627\u0644\u0627\u0628\u0637\u0627\u0644 \u0627\u0644\u0642\u0627\u062f\u0645\u0629\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0645\u063a\u0631\u0628\u064a\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u064a\u0637\u0627\u0644\u064a\r\n\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a",
    "descriptionHTML": "\u0645\u0639 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641\u060c \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u0622\u062e\u0631 \u062a\u0637\u0648\u0631\u0627\u062a \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0628\u0634\u0643\u0644 \u0641\u0648\u0631\u064a\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0645\u0644\u062e\u0635\u0627\u062a \u0648 \u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0628\u062b \u0645\u0628\u0627\u0634\u0631. \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u0630\u0644\u0643 \u0647\u062f\u0641\u064b\u0627\u060c \u0645\u062d\u0627\u0648\u0644\u0629\u060c \u0623\u0648 \u0642\u0631\u0627\u0631\u064b\u0627 \u0645\u062b\u064a\u0631\u064b\u0627 \u0644\u0644\u062c\u062f\u0644\u060c \u0641\u0625\u0646 \u062e\u062f\u0645\u0629 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u062a\u0642\u062f\u0645 \u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u0623\u0643\u062b\u0631 \u0625\u062b\u0627\u0631\u0629 \u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u0629.<br><br><br>\u0643\u0630\u0644\u0643 \u0639\u0628\u0631 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0644\u0627\u064a\u0641 \u0645\u0628\u0627\u0634\u0631\u060c \u064a\u0645\u0643\u0646\u0643 \u0645\u062a\u0627\u0628\u0639\u0629 \u0641\u0631\u0642\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0648\u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u0648\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u062f\u0642\u064a\u0642\u0629 \u0628\u062f\u0642\u064a\u0642\u0629. \u0633\u0648\u0627\u0621 \u0643\u0627\u0