{
    "title": "\u062c\u0627\u0628\u0627\u0645\u0627 | \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627 \u0648 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647",
    "description": "\u062c\u0627\u0628\u0627\u0645\u0627 | \u0627\u062c\u0627\u0631\u0647 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0648\u06cc\u0644\u0627\u060c \u0633\u0648\u0626\u06cc\u062a\u060c \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0648 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc   \r\n\r\n\u06a9\u0627\u0645\u0644\u200c\u062a\u0631\u06cc\u0646 \u0648 \u0645\u0639\u062a\u0628\u0631\u062a\u0631\u06cc\u0646 \u0633\u0627\u0645\u0627\u0646\u0647 \u0631\u0632\u0631\u0648 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0648 \u0627\u062c\u0627\u0631\u0647 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646    \r\n\r\n\u0645\u0642\u0635\u062f \u0633\u0641\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062c\u0627\u0628\u0627\u0645\u0627 \u062c\u0633\u062a\u062c\u0648 \u06a9\u0631\u062f\u0647 \u0648 \u0627\u0646\u0648\u0627\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0648\u06cc\u0644\u0627 \u062c\u0646\u06af\u0644\u06cc \u0648 \u0633\u0627\u062d\u0644\u06cc\u060c \u0622\u067e\u0627\u0631\u062a\u0645\u0627\u0646 \u0648 \u062e\u0627\u0646\u0647 \u0645\u0628\u0644\u0647\u060c \u0633\u0648\u0626\u06cc\u062a \u062f\u0631\u0628\u0633\u062a\u06cc\u060c \u0628\u0648\u0645 \u06af\u0631\u062f\u06cc \u0648 \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc\u060c \u0645\u0647\u0645\u0627\u0646\u0633\u0631\u0627 \u0648 \u0645\u0633\u0627\u0641\u0631\u062e\u0627\u0646\u0647\u060c \u0645\u062c\u062a\u0645\u0639 \u0627\u0642\u0627\u0645\u062a\u06cc \u0648 \u0645\u0647\u0645\u0627\u0646\u067e\u0630\u06cc\u0631\u060c \u06a9\u0644\u0628\u0647 \u0645\u062b\u0644\u062b\u06cc \u0648 \u0633\u0648\u0626\u06cc\u0633\u06cc\u060c \u0645\u062a\u0644\u060c \u06a9\u0627\u0631\u0648\u0627\u0646\u0633\u0631\u0627\u060c \u0647\u0627\u0633\u062a\u0644 \u0648 \u062e\u0627\u0646\u0647 \u0631\u0627 \u0632\u06cc\u0631 2 \u062f\u0642\u06cc\u0642\u0647 \u0631\u0632\u0631\u0648 \u06a9\u0646\u06cc\u062f.  \r\n\r\n\r\n\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627:  \r\n\r\n\u2022 \u0628\u06cc\u0634 \u0627\u0632 20000 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0645\u0639\u062a\u0628\u0631  \u062f\u0631 350 \u0634\u0647\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0631\u0627\u06cc \u0627\u062c\u0627\u0631\u0647 \u0631\u0648\u0632\u0627\u0646\u0647 \u0648 \u06a9\u0648\u062a\u0627\u0647 \u0645\u062f\u062a \r\n\r\n\u2022 \u0627\u062c\u0627\u0631\u0647 \u0622\u0633\u0627\u0646 \u0627\u0646\u0648\u0627\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0627\u0632 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u0648 \u0627\u0631\u0632\u0627\u0646 \u062a\u0627 \u0644\u0648\u06a9\u0633 \u0648 \u0627\u062e\u062a\u0635\u0627\u0635\u06cc \u0628\u0627 \u0645\u0646\u0627\u0633\u0628\u200c\u062a\u0631\u06cc\u0646 \u0642\u06cc\u0645\u062a\u200c\u0647\u0627 \r\n\r\n\u2022 \u062f\u0627\u0631\u0627\u06cc \u0641\u06cc\u0644\u062a\u0631\u0647\u0627\u06cc \u062f\u0642\u06cc\u0642 \u0628\u0631\u0627\u06cc \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a\u060c \u0634\u0647\u0631\u060c \u0627\u0633\u062a\u0627\u0646\u060c \u0642\u06cc\u0645\u062a\u060c \u0646\u0648\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0627\u0645\u062a\u06cc\u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \u062a\u062e\u0641\u06cc\u0641\u200c\u0647\u0627\u06cc \u0644\u062d\u0638\u0647 \u0622\u062e\u0631\u06cc \r\n\r\n\u2022 \u0631\u0632\u0631\u0648 \u0648\u06cc\u0644\u0627 \u0628\u0627 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0645\u0627\u0646\u0646\u062f: \u0627\u0633\u062a\u062e\u0631\u060c \u0645\u06cc\u0632 \u0628\u06cc\u0644\u06cc\u0627\u0631\u062f\u060c \u0644\u0648\u0627\u0632\u0645 \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0641\u0648\u062a\u0628\u0627\u0644 \u062f\u0633\u062a\u06cc \u0648 ... \r\n\r\n\u2022 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0648\u0627\u0642\u0639\u06cc\u060c \u0645\u062a\u0646\u0648\u0639 \u0648 \u0628\u0627 \u06a9\u06cc\u0641\u06cc\u062a \u0627\u0632 \u062f\u0627\u062e\u0644 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627 \u062c\u0647\u062a \u062a\u0635\u0645\u06cc\u0645\u200c\u06af\u06cc\u0631\u06cc \u0622\u0633\u0627\u0646 \r\n\r\n\u2022 \u0645\u0634\u0627\u0647\u062f\u0647 \u0646\u0638\u0631\u0627\u062a \u0645\u0647\u0645\u0627\u0646\u0627\u0646 \u0642\u0628\u0644\u06cc \u0647\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u0622\u06af\u0627\u0647\u0627\u0646\u0647 \u0648 \u0645\u0637\u0645\u0626\u0646 \r\n\r\n\u2022 \u0631\u0632\u0631\u0648\u060c \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u062a\u0627\u06cc\u06cc\u062f \u0645\u06cc\u0632\u0628\u0627\u0646 \u0628\u0627 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u00ab\u0622\u0646\u06cc \u0648 \u0642\u0637\u0639\u06cc\u00bb \u062c\u0627\u0628\u0627\u0645\u0627 \r\n\r\n\u2022 \u062c\u0634\u0646\u0648\u0627\u0631\u0647\u200c\u0647\u0627\u06cc \u0647\u06cc\u062c\u0627\u0646 \u0627\u0646\u06af\u06cc\u0632 \u0641\u0635\u0644\u06cc \u0648 \u067e\u0631\u062a\u062e\u0641\u06cc\u0641\u200c \r\n\r\n\u2022 \u0627\u0637\u0644\u0627\u0639 \u06a9\u0627\u0645\u0644 \u0627\u0632 \u0648\u0636\u0639\u06cc\u062a \u0645\u0631\u0627\u062d\u0644 \u0631\u0632\u0631\u0648 \u0628\u0627 \u067e\u06cc\u0627\u0645\u06a9  \r\n\r\n\u2022 \u0646\u0645\u0627\u06cc\u0634 \u0645\u062d\u0644 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0631\u0648\u06cc \u0646\u0642\u0634\u0647 \r\n\r\n\u2022 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0639\u0627\u0644\u06cc \u0648 \u0635\u0641\u0631 \u062a\u0627 \u0635\u062f \u0633\u0641\u0631 \r\n\r\n\u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0633\u0644\u06cc\u0642\u0647\u200c\u0627\u06cc \r\n\r\n\u0642\u062f\u0645 \u0628\u0647 \u0647\u0631 \u0646\u0642\u0637\u0647 \u0627\u0632 \u0627\u06cc\u0631\u0627\u0646 \u06a9\u0647 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u0648 \u0647\u0631 \u0633\u0628\u06a9 \u0633\u0641\u0631\u06cc \u06a9\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f\u060c \u0628\u0627 \u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0647\u062a\u0631\u06cc\u0646 \u062a\u062c\u0631\u0628\u0647 \u0631\u0627 \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u0634\u062a.  \r\n\r\n\u2022 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc:  \u0627\u062c\u0627\u0631\u0647 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u062f\u0648 \u062e\u0648\u0627\u0628\u0647 \u0648 \u0633\u0647 \u062e\u0648\u0627\u0628\u0647 \u062f\u0631\u0628\u0633\u062a\u06cc \r\n\r\n\u2022 \u062f\u0647\u06af\u0631\u062f\u06cc \u0648 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc:  \u062a\u062c\u0631\u0628\u0647 \u0647\u0645\u0646\u0634\u06cc\u0646\u06cc \u0628\u0627 \u0645\u062d\u0644\u06cc\u200c\u0647\u0627 \u0648 \u0686\u0634\u06cc\u062f\u0646 \u0637\u0639\u0645 \u0648 \u0639\u0637\u0631 \u063a\u0630\u0627\u0647\u0627\u06cc \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc \r\n\r\n\u2022 \u062f\u0648 \u0646\u0641\u0631\u0647 \u0648 \u0645\u0646\u0627\u0633\u0628 \u0645\u0627\u0647 \u0639\u0633\u0644: \u0627\u062c\u0627\u0631\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u062c\u0630\u0627\u0628\u200c\u062a\u0631\u06cc\u0646 \u06a9\u0644\u0628\u0647\u200c\u0647\u0627 \u0648 \u0648\u06cc\u0644\u0627\u0647\u0627\u06cc \u0627\u0633\u062a\u062e\u0631\u062f\u0627\u0631 \u0628\u0631\u0627\u06cc \u0645\u0627\u0647 \u0639\u0633\u0644 \r\n\r\n\u2022 \u062f\u0633\u062a\u0647 \u062c\u0645\u0639\u06cc \u0648 \u062f\u0648\u0633\u062a\u0627\u0646\u0647:  \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0645\u0647\u0645\u0627\u0646\u06cc \u0648 \u0645\u0631\u0627\u0633\u0645 \r\n\r\n\u2022 \u0645\u0646\u0627\u0633\u0628 \u062f\u0627\u0631\u0646\u062f\u06af\u0627\u0646 \u062d\u06cc\u0648\u0627\u0646\u0627\u062a \u062e\u0627\u0646\u06af\u06cc:  \u0633\u0641\u0631\u06cc \u0622\u0631\u0627\u0645\u0634 \u0628\u062e\u0634 \u0628\u0627 \u0627\u0645\u06a9\u0627\u0646 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062d\u06cc\u0648\u0627\u0646\u0627\u062a \u062e\u0627\u0646\u06af\u06cc \r\n\r\n\u2022 \u06a9\u0627\u0631\u06cc \u0648 \u0627\u062f\u0627\u0631\u06cc:  \u0631\u0632\u0631\u0648 \u0633\u0631\u06cc\u0639 \u0648 \u0627\u0631\u0632\u0627\u0646 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0633\u0648\u0626\u06cc\u062a\u200c\u0647\u0627 \u0648 \u0647\u0627\u0633\u062a\u0644\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u0633\u0641\u0631\u0647\u0627\u06cc \u06a9\u0627\u0631\u06cc \r\n\r\n\u2022 \u062f\u0631\u0645\u0627\u0646\u06cc:  \u0631\u0632\u0631\u0648 \u0622\u067e\u0627\u0631\u062a\u0645\u0627\u0646 \u06cc\u0627 \u0645\u0646\u0632\u0644 \u0645\u0628\u0644\u0647 \u0628\u0627 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u06a9\u0627\u0645\u0644 \u062c\u0647\u062a \u0627\u0642\u0627\u0645\u062a\u06cc \u0622\u0633\u0648\u062f\u0647 \r\n\r\n\u0627\u0645\u06a9\u0627\u0646 \u062f\u0631\u0622\u0645\u062f\u0632\u0627\u06cc\u06cc \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646 \r\n\r\n\u0627\u06af\u0631 \u0635\u0627\u062d\u0628 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u06cc\u0627 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc \u0647\u0633\u062a\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0648 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u062e\u0648\u062f \u0631\u0627 \u062b\u0628\u062a \u06a9\u0631\u062f\u0647 \u0648 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0631\u0632\u0631\u0648 \u062e\u0648\u062f \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u0634\u0631\u0648\u0639 \u0628\u0647 \u062f\u0631\u0622\u0645\u062f\u0632\u0627\u06cc\u06cc\u200c\u06a9\u0646\u06cc\u062f. \u0627\u0632 \u062c\u0645\u0644\u0647 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632: \r\n\r\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0631\u0632\u0631\u0648 \u0622\u0646\u06cc \u0648 \u0642\u0637\u0639\u06cc \u0628\u0631\u0627\u06cc \u06a9\u0633\u0628 \u062f\u0631\u0622\u0645\u062f \u0628\u06cc\u0634\u062a\u0631 \r\n\r\n\u2022 \u062f\u0627\u0634\u0628\u0648\u0631\u062f \u0631\u0635\u062f \u0648\u0636\u0639\u06cc\u062a \u0628\u0627\u0632\u0627\u0631 \u0628\u0631\u0627\u06cc \u0645\u062f\u06cc\u0631\u06cc\u062a \u0628\u0647\u062a\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \r\n\r\n\u2022 \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u062f\u0642\u06cc\u0642 \u0628\u0631\u0627\u06cc \u0647\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0632\u0631\u0648 \r\n\r\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0645\u0627\u0644\u06cc \u0648\u0636\u0639\u06cc\u062a \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \r\n\r\n\u2022 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u0648 \u062a\u062e\u0641\u06cc\u0641\u200c\u06af\u0630\u0627\u0631\u06cc \u0622\u0633\u0627\u0646 \r\n\r\n\u2022 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u062e\u062a\u0635\u0627\u0635\u06cc \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 \r\n\r\n\u0633\u0648\u0627\u0644\u0627\u062a \u0645\u062a\u062f\u0627\u0648\u0644 \u0628\u0631\u0627\u06cc \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627\u060c \u0633\u0648\u0626\u06cc\u062a \u0648 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \r\n\r\n1- \u0642\u06cc\u0645\u062a \u0647\u0631 \u0634\u0628 \u0627\u0642\u0627\u0645\u062a \u062f\u0631 \u06cc\u06a9 \u0648\u06cc\u0644\u0627 \u0686\u06af\u0648\u0646\u0647 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f    \r\n\r\n\u062a\u0639\u06cc\u06cc\u0646 \u0642\u06cc\u0645\u062a \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627 \u06cc\u0627 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0634\u0628 \u0628\u0647 \u0639\u0647\u062f\u0647 \u0645\u06cc\u0632\u0628\u0627\u0646 \u0627\u0633\u062a. \r\n\r\n2- \u0622\u06cc\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a \u0644\u063a\u0648 \u0631\u0632\u0631\u0648 \u0645\u0628\u0644\u063a \u0622\u0646 \u0628\u0647 \u0645\u0633\u0627\u0641\u0631 \u0639\u0648\u062f\u062a \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f    \r\n\r\n\u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0644\u063a\u0648 \u0631\u0632\u0631\u0648 \u0647\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0645\u0628\u0644\u063a \u0645\u0634\u062e\u0635\u06cc \u0628\u0647 \u0645\u0647\u0645\u0627\u0646 \u0639\u0648\u062f\u062a \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \r\n\r\n3- \u0686\u06af\u0648\u0646\u0647 \u0628\u0647 \u062c\u0627\u0628\u0627\u0645\u0627 \u0627\u0639\u062a\u0645\u0627\u062f \u06a9\u0646\u0645\u061f    \r\n\r\n\u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc\u0646 \u0633\u0627\u0645\u0627\u0646\u0647 \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0647\u0631 \u0645\u0627\u0647\u060c \u062f\u0647\u200c\u0647\u0627 \u0647\u0632\u0627\u0631 \u0631\u0632\u0631\u0648 \u0645\u0648\u0641\u0642 \u062f\u0631 \u0622\u0646 \u062b\u0628\u062a \u0645\u06cc\u200c\u06af\u0631\u062f\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u0647\u0645\u0627\u0646\u0627\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u062d\u062f\u0627\u06a9\u062b\u0631 \u0631\u0636\u0627\u06cc\u062a \u0631\u0627 \u0627\u0632 \u0627\u0642\u0627\u0645\u062a \u062e\u0648\u062f \u062f\u0627\u0634\u062a\u0647\u200c\u0627\u0646\u062f.  \r\n\r\n\u0627\u06af\u0631 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u06cc\u0627 \u0627\u0646\u062a\u0642\u0627\u062f\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u062f\u0627\u0631\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0631\u0627\u0647\u200c\u200c\u0647\u0627\u06cc \u0632\u06cc\u0631 \u0628\u0627 \u0645\u0627 \u062f\u0631 \u062a\u0645\u0627\u0633 \u0628\u0627\u0634\u06cc\u062f  :  \r\n\r\n\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc:  02143900900 \r\n\r\n\u0627\u06cc\u0645\u06cc\u0644:  app@jabama.com \r\n\r\n \u0648\u0628\u200c\u0633\u0627\u06cc\u062a:  www.jabama.com \r\n\r\n \u0635\u0641\u062d\u0647 \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u062c\u0627\u0628\u0627\u0645\u0627:  https://www.instagram.com/jabama.ir",
    "descriptionHTML": "\u062c\u0627\u0628\u0627\u0645\u0627 | \u0627\u062c\u0627\u0631\u0647 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0648\u06cc\u0644\u0627\u060c \u0633\u0648\u0626\u06cc\u062a\u060c \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0648 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc   <br><br>\u06a9\u0627\u0645\u0644\u200c\u062a\u0631\u06cc\u0646 \u0648 \u0645\u0639\u062a\u0628\u0631\u062a\u0631\u06cc\u0646 \u0633\u0627\u0645\u0627\u0646\u0647 \u0631\u0632\u0631\u0648 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0648 \u0627\u062c\u0627\u0631\u0647 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646    <br><br>\u0645\u0642\u0635\u062f \u0633\u0641\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062c\u0627\u0628\u0627\u0645\u0627 \u062c\u0633\u062a\u062c\u0648 \u06a9\u0631\u062f\u0647 \u0648 \u0627\u0646\u0648\u0627\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0648\u06cc\u0644\u0627 \u062c\u0646\u06af\u0644\u06cc \u0648 \u0633\u0627\u062d\u0644\u06cc\u060c \u0622\u067e\u0627\u0631\u062a\u0645\u0627\u0646 \u0648 \u062e\u0627\u0646\u0647 \u0645\u0628\u0644\u0647\u060c \u0633\u0648\u0626\u06cc\u062a \u062f\u0631\u0628\u0633\u062a\u06cc\u060c \u0628\u0648\u0645 \u06af\u0631\u062f\u06cc \u0648 \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc\u060c \u0645\u0647\u0645\u0627\u0646\u0633\u0631\u0627 \u0648 \u0645\u0633\u0627\u0641\u0631\u062e\u0627\u0646\u0647\u060c \u0645\u062c\u062a\u0645\u0639 \u0627\u0642\u0627\u0645\u062a\u06cc \u0648 \u0645\u0647\u0645\u0627\u0646\u067e\u0630\u06cc\u0631\u060c \u06a9\u0644\u0628\u0647 \u0645\u062b\u0644\u062b\u06cc \u0648 \u0633\u0648\u0626\u06cc\u0633\u06cc\u060c \u0645\u062a\u0644\u060c \u06a9\u0627\u0631\u0648\u0627\u0646\u0633\u0631\u0627\u060c \u0647\u0627\u0633\u062a\u0644 \u0648 \u062e\u0627\u0646\u0647 \u0631\u0627 \u0632\u06cc\u0631 2 \u062f\u0642\u06cc\u0642\u0647 \u0631\u0632\u0631\u0648 \u06a9\u0646\u06cc\u062f.  <br><br><br>\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627:  <br><br>\u2022 \u0628\u06cc\u0634 \u0627\u0632 20000 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0645\u0639\u062a\u0628\u0631  \u062f\u0631 350 \u0634\u0647\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0631\u0627\u06cc \u0627\u062c\u0627\u0631\u0647 \u0631\u0648\u0632\u0627\u0646\u0647 \u0648 \u06a9\u0648\u062a\u0627\u0647 \u0645\u062f\u062a <br><br>\u2022 \u0627\u062c\u0627\u0631\u0647 \u0622\u0633\u0627\u0646 \u0627\u0646\u0648\u0627\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0627\u0632 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u0648 \u0627\u0631\u0632\u0627\u0646 \u062a\u0627 \u0644\u0648\u06a9\u0633 \u0648 \u0627\u062e\u062a\u0635\u0627\u0635\u06cc \u0628\u0627 \u0645\u0646\u0627\u0633\u0628\u200c\u062a\u0631\u06cc\u0646 \u0642\u06cc\u0645\u062a\u200c\u0647\u0627 <br><br>\u2022 \u062f\u0627\u0631\u0627\u06cc \u0641\u06cc\u0644\u062a\u0631\u0647\u0627\u06cc \u062f\u0642\u06cc\u0642 \u0628\u0631\u0627\u06cc \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a\u060c \u0634\u0647\u0631\u060c \u0627\u0633\u062a\u0627\u0646\u060c \u0642\u06cc\u0645\u062a\u060c \u0646\u0648\u0639 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0627\u0645\u062a\u06cc\u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \u062a\u062e\u0641\u06cc\u0641\u200c\u0647\u0627\u06cc \u0644\u062d\u0638\u0647 \u0622\u062e\u0631\u06cc <br><br>\u2022 \u0631\u0632\u0631\u0648 \u0648\u06cc\u0644\u0627 \u0628\u0627 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0645\u0627\u0646\u0646\u062f: \u0627\u0633\u062a\u062e\u0631\u060c \u0645\u06cc\u0632 \u0628\u06cc\u0644\u06cc\u0627\u0631\u062f\u060c \u0644\u0648\u0627\u0632\u0645 \u0633\u0631\u06af\u0631\u0645\u06cc\u060c \u0641\u0648\u062a\u0628\u0627\u0644 \u062f\u0633\u062a\u06cc \u0648 ... <br><br>\u2022 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0648\u0627\u0642\u0639\u06cc\u060c \u0645\u062a\u0646\u0648\u0639 \u0648 \u0628\u0627 \u06a9\u06cc\u0641\u06cc\u062a \u0627\u0632 \u062f\u0627\u062e\u0644 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627 \u062c\u0647\u062a \u062a\u0635\u0645\u06cc\u0645\u200c\u06af\u06cc\u0631\u06cc \u0622\u0633\u0627\u0646 <br><br>\u2022 \u0645\u0634\u0627\u0647\u062f\u0647 \u0646\u0638\u0631\u0627\u062a \u0645\u0647\u0645\u0627\u0646\u0627\u0646 \u0642\u0628\u0644\u06cc \u0647\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u0622\u06af\u0627\u0647\u0627\u0646\u0647 \u0648 \u0645\u0637\u0645\u0626\u0646 <br><br>\u2022 \u0631\u0632\u0631\u0648\u060c \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u062a\u0627\u06cc\u06cc\u062f \u0645\u06cc\u0632\u0628\u0627\u0646 \u0628\u0627 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u00ab\u0622\u0646\u06cc \u0648 \u0642\u0637\u0639\u06cc\u00bb \u062c\u0627\u0628\u0627\u0645\u0627 <br><br>\u2022 \u062c\u0634\u0646\u0648\u0627\u0631\u0647\u200c\u0647\u0627\u06cc \u0647\u06cc\u062c\u0627\u0646 \u0627\u0646\u06af\u06cc\u0632 \u0641\u0635\u0644\u06cc \u0648 \u067e\u0631\u062a\u062e\u0641\u06cc\u0641\u200c <br><br>\u2022 \u0627\u0637\u0644\u0627\u0639 \u06a9\u0627\u0645\u0644 \u0627\u0632 \u0648\u0636\u0639\u06cc\u062a \u0645\u0631\u0627\u062d\u0644 \u0631\u0632\u0631\u0648 \u0628\u0627 \u067e\u06cc\u0627\u0645\u06a9  <br><br>\u2022 \u0646\u0645\u0627\u06cc\u0634 \u0645\u062d\u0644 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0631\u0648\u06cc \u0646\u0642\u0634\u0647 <br><br>\u2022 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0639\u0627\u0644\u06cc \u0648 \u0635\u0641\u0631 \u062a\u0627 \u0635\u062f \u0633\u0641\u0631 <br><br>\u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0633\u0644\u06cc\u0642\u0647\u200c\u0627\u06cc <br><br>\u0642\u062f\u0645 \u0628\u0647 \u0647\u0631 \u0646\u0642\u0637\u0647 \u0627\u0632 \u0627\u06cc\u0631\u0627\u0646 \u06a9\u0647 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u0648 \u0647\u0631 \u0633\u0628\u06a9 \u0633\u0641\u0631\u06cc \u06a9\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f\u060c \u0628\u0627 \u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0647\u062a\u0631\u06cc\u0646 \u062a\u062c\u0631\u0628\u0647 \u0631\u0627 \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u0634\u062a.  <br><br>\u2022 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc:  \u0627\u062c\u0627\u0631\u0647 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u062f\u0648 \u062e\u0648\u0627\u0628\u0647 \u0648 \u0633\u0647 \u062e\u0648\u0627\u0628\u0647 \u062f\u0631\u0628\u0633\u062a\u06cc <br><br>\u2022 \u062f\u0647\u06af\u0631\u062f\u06cc \u0648 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc:  \u062a\u062c\u0631\u0628\u0647 \u0647\u0645\u0646\u0634\u06cc\u0646\u06cc \u0628\u0627 \u0645\u062d\u0644\u06cc\u200c\u0647\u0627 \u0648 \u0686\u0634\u06cc\u062f\u0646 \u0637\u0639\u0645 \u0648 \u0639\u0637\u0631 \u063a\u0630\u0627\u0647\u0627\u06cc \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc <br><br>\u2022 \u062f\u0648 \u0646\u0641\u0631\u0647 \u0648 \u0645\u0646\u0627\u0633\u0628 \u0645\u0627\u0647 \u0639\u0633\u0644: \u0627\u062c\u0627\u0631\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u062c\u0630\u0627\u0628\u200c\u062a\u0631\u06cc\u0646 \u06a9\u0644\u0628\u0647\u200c\u0647\u0627 \u0648 \u0648\u06cc\u0644\u0627\u0647\u0627\u06cc \u0627\u0633\u062a\u062e\u0631\u062f\u0627\u0631 \u0628\u0631\u0627\u06cc \u0645\u0627\u0647 \u0639\u0633\u0644 <br><br>\u2022 \u062f\u0633\u062a\u0647 \u062c\u0645\u0639\u06cc \u0648 \u062f\u0648\u0633\u062a\u0627\u0646\u0647:  \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0645\u0647\u0645\u0627\u0646\u06cc \u0648 \u0645\u0631\u0627\u0633\u0645 <br><br>\u2022 \u0645\u0646\u0627\u0633\u0628 \u062f\u0627\u0631\u0646\u062f\u06af\u0627\u0646 \u062d\u06cc\u0648\u0627\u0646\u0627\u062a \u062e\u0627\u0646\u06af\u06cc:  \u0633\u0641\u0631\u06cc \u0622\u0631\u0627\u0645\u0634 \u0628\u062e\u0634 \u0628\u0627 \u0627\u0645\u06a9\u0627\u0646 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062d\u06cc\u0648\u0627\u0646\u0627\u062a \u062e\u0627\u0646\u06af\u06cc <br><br>\u2022 \u06a9\u0627\u0631\u06cc \u0648 \u0627\u062f\u0627\u0631\u06cc:  \u0631\u0632\u0631\u0648 \u0633\u0631\u06cc\u0639 \u0648 \u0627\u0631\u0632\u0627\u0646 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0633\u0648\u0626\u06cc\u062a\u200c\u0647\u0627 \u0648 \u0647\u0627\u0633\u062a\u0644\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u0633\u0641\u0631\u0647\u0627\u06cc \u06a9\u0627\u0631\u06cc <br><br>\u2022 \u062f\u0631\u0645\u0627\u0646\u06cc:  \u0631\u0632\u0631\u0648 \u0622\u067e\u0627\u0631\u062a\u0645\u0627\u0646 \u06cc\u0627 \u0645\u0646\u0632\u0644 \u0645\u0628\u0644\u0647 \u0628\u0627 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u06a9\u0627\u0645\u0644 \u062c\u0647\u062a \u0627\u0642\u0627\u0645\u062a\u06cc \u0622\u0633\u0648\u062f\u0647 <br><br>\u0627\u0645\u06a9\u0627\u0646 \u062f\u0631\u0622\u0645\u062f\u0632\u0627\u06cc\u06cc \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646 <br><br>\u0627\u06af\u0631 \u0635\u0627\u062d\u0628 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u06cc\u0627 \u0628\u0648\u0645\u06af\u0631\u062f\u06cc \u0647\u0633\u062a\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0648 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u062e\u0648\u062f \u0631\u0627 \u062b\u0628\u062a \u06a9\u0631\u062f\u0647 \u0648 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0631\u0632\u0631\u0648 \u062e\u0648\u062f \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u0634\u0631\u0648\u0639 \u0628\u0647 \u062f\u0631\u0622\u0645\u062f\u0632\u0627\u06cc\u06cc\u200c\u06a9\u0646\u06cc\u062f. \u0627\u0632 \u062c\u0645\u0644\u0647 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632: <br><br>\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0631\u0632\u0631\u0648 \u0622\u0646\u06cc \u0648 \u0642\u0637\u0639\u06cc \u0628\u0631\u0627\u06cc \u06a9\u0633\u0628 \u062f\u0631\u0622\u0645\u062f \u0628\u06cc\u0634\u062a\u0631 <br><br>\u2022 \u062f\u0627\u0634\u0628\u0648\u0631\u062f \u0631\u0635\u062f \u0648\u0636\u0639\u06cc\u062a \u0628\u0627\u0632\u0627\u0631 \u0628\u0631\u0627\u06cc \u0645\u062f\u06cc\u0631\u06cc\u062a \u0628\u0647\u062a\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 <br><br>\u2022 \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u062f\u0642\u06cc\u0642 \u0628\u0631\u0627\u06cc \u0647\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0632\u0631\u0648 <br><br>\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0645\u0627\u0644\u06cc \u0648\u0636\u0639\u06cc\u062a \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 <br><br>\u2022 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u0648 \u062a\u062e\u0641\u06cc\u0641\u200c\u06af\u0630\u0627\u0631\u06cc \u0622\u0633\u0627\u0646 <br><br>\u2022 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u062e\u062a\u0635\u0627\u0635\u06cc \u0628\u0631\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u0627\u0646 <br><br>\u0633\u0648\u0627\u0644\u0627\u062a \u0645\u062a\u062f\u0627\u0648\u0644 \u0628\u0631\u0627\u06cc \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627\u060c \u0633\u0648\u0626\u06cc\u062a \u0648 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 <br><br>1- \u0642\u06cc\u0645\u062a \u0647\u0631 \u0634\u0628 \u0627\u0642\u0627\u0645\u062a \u062f\u0631 \u06cc\u06a9 \u0648\u06cc\u0644\u0627 \u0686\u06af\u0648\u0646\u0647 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f    <br><br>\u062a\u0639\u06cc\u06cc\u0646 \u0642\u06cc\u0645\u062a \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627 \u06cc\u0627 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0634\u0628 \u0628\u0647 \u0639\u0647\u062f\u0647 \u0645\u06cc\u0632\u0628\u0627\u0646 \u0627\u0633\u062a. <br><br>2- \u0622\u06cc\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a \u0644\u063a\u0648 \u0631\u0632\u0631\u0648 \u0645\u0628\u0644\u063a \u0622\u0646 \u0628\u0647 \u0645\u0633\u0627\u0641\u0631 \u0639\u0648\u062f\u062a \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f    <br><br>\u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0644\u063a\u0648 \u0631\u0632\u0631\u0648 \u0647\u0631 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0645\u0628\u0644\u063a \u0645\u0634\u062e\u0635\u06cc \u0628\u0647 \u0645\u0647\u0645\u0627\u0646 \u0639\u0648\u062f\u062a \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. <br><br>3- \u0686\u06af\u0648\u0646\u0647 \u0628\u0647 \u062c\u0627\u0628\u0627\u0645\u0627 \u0627\u0639\u062a\u0645\u0627\u062f \u06a9\u0646\u0645\u061f    <br><br>\u062c\u0627\u0628\u0627\u0645\u0627 \u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc\u0646 \u0633\u0627\u0645\u0627\u0646\u0647 \u0627\u062c\u0627\u0631\u0647 \u0648\u06cc\u0644\u0627 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0647\u0631 \u0645\u0627\u0647\u060c \u062f\u0647\u200c\u0647\u0627 \u0647\u0632\u0627\u0631 \u0631\u0632\u0631\u0648 \u0645\u0648\u0641\u0642 \u062f\u0631 \u0622\u0646 \u062b\u0628\u062a \u0645\u06cc\u200c\u06af\u0631\u062f\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u0647\u0645\u0627\u0646\u0627\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u062d\u062f\u0627\u06a9\u062b\u0631 \u0631\u0636\u0627\u06cc\u062a \u0631\u0627 \u0627\u0632 \u0627\u0642\u0627\u0645\u062a \u062e\u0648\u062f \u062f\u0627\u0634\u062a\u0647\u200c\u0627\u0646\u062f.  <br><br>\u0627\u06af\u0631 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u06cc\u0627 \u0627\u0646\u062a\u0642\u0627\u062f\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062c\u0627\u0628\u0627\u0645\u0627 \u062f\u0627\u0631\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0631\u0627\u0647\u200c\u200c\u0647\u0627\u06cc \u0632\u06cc\u0631 \u0628\u0627 \u0645\u0627 \u062f\u0631 \u062a\u0645\u0627\u0633 \u0628\u0627\u0634\u06cc\u062f  :  <br><br>\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc:  02143900900 <br><br>\u0627\u06cc\u0645\u06cc\u0644:  app@jabama.com <br><br> \u0648\u0628\u200c\u0633\u0627\u06cc\u062a:  www.jabama.com <br><br> \u0635\u0641\u062d\u0647 \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u062c\u0627\u0628\u0627\u0645\u0627:  https://www.instagram.com/jabama.ir",
    "summary": "\u06a9\u0627\u0645\u0644\u200c\u062a\u0631\u06cc\u0646 \u0648 \u0645\u0639\u062a\u0628\u0631\u062a\u0631\u06cc\u0646 \u0633\u0627\u0645\u0627\u0646\u0647 \u0627\u062c\u0627\u0631\u0647 \u0627\u0642\u0627\u0645\u062a\u06af\u0627\u0647\u060c \u0633\u0648\u0626\u06cc\u062a \u0648 \u0648\u06cc\u0644\u0627 \u062f\u0631 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646",
