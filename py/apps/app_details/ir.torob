{
    "title": "\u062a\u0631\u0628 | \u0628\u0647\u062a\u0631\u06cc\u0646 \u0642\u06cc\u0645\u062a \u0628\u0627\u0632\u0627\u0631",
    "description": "\u0628\u0647\u062a\u0631\u06cc\u0646 \u0642\u06cc\u0645\u062a \u0628\u0627\u0632\u0627\u0631 \u0631\u0648 \u0628\u0627 \u062a\u0631\u0628 \u067e\u06cc\u062f\u0627 \u06a9\u0646 ! \r\n\u0647\u0631 \u0647\u0641\u062a\u0647 \u0628\u06cc\u0634 \u0627\u0632 5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0648 \u0631\u0648\u0632\u0627\u0646\u0647 \u062f\u0631 \u062d\u062f\u0648\u062f 2 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u06a9\u0627\u0631\u0628\u0631\u060c \u0627\u0632 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646\u060c \u0627\u0632 \u0637\u0631\u06cc\u0642 \u062a\u0631\u0628 \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u0634\u0648\u0646 \u0631\u0648 \u0628\u06cc\u0646 \u0647\u0632\u0627\u0631\u0627\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u0633\u0631\u0686 \u0645\u06cc\u06a9\u0646\u0646 \u0648 \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u0634\u0648\u0646\u060c \u062e\u0631\u06cc\u062f \u0622\u0646\u0644\u0627\u06cc\u0646 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u062f\u0646.\r\n\r\n\u06a9\u0627\u0641\u06cc\u0647 \u0627\u0633\u0645 \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u062a \u0631\u0648 \u062a\u0648 \u062a\u0631\u0628 \u0633\u0631\u0686 \u06a9\u0646\u06cc\u060c  \u062a\u0631\u0628 \u0627\u0648\u0646 \u0645\u062d\u0635\u0648\u0644 \u0631\u0648 \u0628\u06cc\u0646 \u06a9\u0644\u06cc \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062c\u0633\u062a\u200c\u0648\u062c\u0648 \u0645\u06cc\u06a9\u0646\u0647 \u0648 \u0642\u06cc\u0645\u062a \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0631\u0648 \u06cc\u0647 \u062c\u0627 \u0628\u0627 \u0647\u0645 \u0645\u0642\u0627\u06cc\u0633\u0647 \u0645\u06cc\u06a9\u0646\u0647 \u0648 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0645\u0633\u062a\u0642\u06cc\u0645 \u0627\u0632 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u060c \u0622\u0646\u0644\u0627\u06cc\u0646 \u062e\u0631\u06cc\u062f\u062a \u0631\u0648 \u0627\u0646\u062c\u0627\u0645 \u0628\u062f\u06cc. \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0642\u06cc\u0645\u062a \u060c \u0627\u0645\u062a\u06cc\u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0647\u0627 \u0631\u0648 \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631 \u0627\u0633\u0627\u0633 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634 \u06a9\u0627\u0631\u0628\u0631\u0647\u0627\u06cc \u062a\u0631\u0628 \u0628\u0628\u06cc\u0646\u06cc \u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0647\u062a\u0631\u06cc \u0628\u06cc\u0646 \u0641\u0631\u0648\u0634\u0646\u062f\u0647\u200c\u0647\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc. \r\n\r\n\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062a\u0631\u0628:\r\n\u25cf \u0627\u0645\u06a9\u0627\u0646 \u062e\u0631\u06cc\u062f \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u06cc\u0634 \u0627\u0632 15 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0645\u062d\u0635\u0648\u0644 \u0627\u0632 \u0645\u06cc\u0627\u0646 \u0628\u06cc\u0634 \u0627\u0632 50 \u0647\u0632\u0627\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0639\u062a\u0628\u0631 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc\r\n\u25cf \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0642\u06cc\u0645\u062a \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u0644\u067e\u200c\u062a\u0627\u067e \u0648 \u0644\u0648\u0627\u0632\u0645 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u06cc \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u0627\u0632 \u0642\u06cc\u0645\u062a \u06af\u0648\u0634\u06cc \u0622\u06cc\u0641\u0648\u0646 \u0648 \u0633\u0627\u0645\u0633\u0648\u0646\u06af \u062a\u0627 \u0647\u0648\u0627\u0648\u06cc \u0648 \u0634\u06cc\u0627\u0626\u0648\u0645\u06cc\r\n\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0648 \u0628\u0631\u0631\u0633\u06cc \u0639\u0645\u0644\u06a9\u0631\u062f \u0641\u0631\u0648\u0634\u0646\u062f\u06af\u0627\u0646 \u0648 \u062e\u0631\u06cc\u062f \u0645\u0637\u0645\u06cc\u0646\u200c\u062a\u0631 \r\n\u25cf \u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0647\u062f\u0647 \u0642\u06cc\u0645\u062a \u0648 \u062e\u0631\u06cc\u062f \u0622\u0646\u0644\u0627\u06cc\u0646 \u0627\u0632 \u0633\u0648\u067e\u0631 \u0645\u0627\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc\r\n\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0642\u06cc\u0645\u062a \u062f\u0644\u0627\u0631\u060c \u0642\u06cc\u0645\u062a \u0633\u06a9\u0647\u060c \u0642\u06cc\u0645\u062a \u0637\u0644\u0627 \u0648 \u0627\u0631\u0632\u0647\u0627\u06cc \u062e\u0627\u0631\u062c\u06cc \u0627\u0632 \u0645\u0646\u0627\u0628\u0639 \u0645\u0639\u062a\u0628\u0631\r\n\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0648 \u0628\u0631\u0631\u0633\u06cc \u0642\u06cc\u0645\u062a \u0641\u0631\u0648\u0634\u0646\u062f\u06af\u0627\u0646 \u062d\u0636\u0648\u0631\u06cc \u062f\u0631 \u0627\u0637\u0631\u0627\u0641 \u0634\u0645\u0627\r\n\u25cf \u0627\u0645\u06a9\u0627\u0646 \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u062a\u063a\u06cc\u06cc\u0631 \u0642\u06cc\u0645\u062a \u06a9\u0627\u0644\u0627\u06cc \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0646\u0648\u062a\u06cc\u0641\u06cc\u06a9\u06cc\u0634\u0646\r\n\u25cf \u0646\u0645\u0648\u062f\u0627\u0631 \u0632\u0645\u0627\u0646\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u062f\u0631 \u0631\u0648\u0632\u0647\u0627 \u0648 \u0647\u0641\u062a\u0647\u200c\u0647\u0627\u06cc \u06af\u0630\u0634\u062a\u0647\r\n\u25cf\u0642\u06cc\u0645\u062a \u0628\u06cc\u062a\u200c\u06a9\u0648\u06cc\u0646 \u0648 \u0633\u0627\u06cc\u0631 \u0631\u0645\u0632\u0627\u0631\u0632\u0647\u0627 \u0627\u0632 \u0645\u0631\u0627\u062c\u0639 \u0645\u0639\u062a\u0628\u0631\r\n\r\n\u0627\u0632 \u0637\u0631\u06cc\u0642 \u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0646\u06cc\u0632 \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062a\u0631\u0628 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f \u0648 \u062e\u0631\u06cc\u062f \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062e\u0648\u062f\u062a\u0648\u0646 \u0631\u0648 \u0627\u0646\u062c\u0627\u0645 \u0628\u062f\u06cc\u062f. \u0686\u0646\u062f \u0646\u0645\u0648\u0646\u0647 \u0627\u0632 \u062f\u0633\u062a\u0647 \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u067e\u0631\u0637\u0631\u0641\u062f\u0627\u0631 \u062f\u0631 \u062a\u0631\u0628 \r\n\u25cf  \u06af\u0648\u0634\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 \u0648 \u0644\u067e\u200c\u062a\u0627\u067e \u0648 \u062a\u0628\u0644\u062a \u0648 \u0644\u0648\u0627\u0632\u0645 \u062c\u0627\u0646\u0628\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 \r\n\u25cf  \u0627\u0628\u0632\u0627\u0631\u0622\u0644\u0627\u062a \u0648 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u06cc \u0648 \u0639\u0645\u0631\u0627\u0646\u06cc\r\n\u25cf \u06a9\u0646\u0633\u0648\u0644 \u0628\u0627\u0632\u06cc \u067e\u0644\u06cc \u0627\u0633\u062a\u06cc\u0634\u0646 \u0648 \u0627\u06cc\u06a9\u0633 \u0628\u0627\u06a9\u0633 \u0648 \u0646\u06cc\u0646\u062a\u0646\u062f\u0648 \u0648 \u0644\u0648\u0627\u0632\u0645 \u0635\u0648\u062a\u06cc \u0648 \u062a\u0635\u0648\u06cc\u0631\u06cc\r\n\u25cf \u0644\u0628\u0627\u0633 \u0648 \u06a9\u06cc\u0641 \u0648 \u06a9\u0641\u0634 \u0648 \u067e\u0648\u0634\u0627\u06a9\r\n\u25cf \u0644\u0648\u0627\u0632\u0645 \u0622\u0631\u0627\u06cc\u0634\u06cc \u0648 \u0628\u0647\u062f\u0627\u0634\u062a\u06cc\r\n\u25cf \u0645\u0627\u0633\u06a9 \u0648 \u0644\u0648\u0627\u0632\u0645 \u0636\u062f\u0639\u0641\u0648\u0646\u06cc \u0648 \u0644\u0648\u0627\u0632\u0645 \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u06a9\u0631\u0648\u0646\u0627 \r\n\r\n\u25cf \u0686\u0647 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc\u06cc \u062f\u0631 \u062a\u0631\u0628 \u0641\u0639\u0627\u0644\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f\r\n\u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u0628\u06cc\u0634 \u0627\u0632 50 \u0647\u0632\u0627\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062f\u0627\u0631\u0627\u06cc \u0646\u0645\u0627\u062f \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u062f\u0631 \u062a\u0631\u0628 \u062d\u0627\u0636\u0631 \u0647\u0633\u062a\u0646\u062f \u0648 \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0639\u062f\u0627\u062f \u0647\u0631 \u0631\u0648\u0632 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u0634\u0646. \u0647\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0642\u0628\u0644 \u0627\u0632 \u0627\u0636\u0627\u0641\u0647 \u0634\u062f\u0646 \u0628\u0647 \u062a\u0631\u0628 \u062a\u0648\u0633\u0637 \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0637\u0648\u0644 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u062a\u0631\u0628 \u0646\u06cc\u0632 \u0628\u0627\u0632\u062e\u0648\u0631\u062f\u0647\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062a\u0631\u0628 \u062f\u0631 \u0645\u0648\u0631\u062f \u062e\u0631\u06cc\u062f \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0628\u0627 \u062f\u0642\u062a \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u0632 \u062c\u0645\u0644\u0647 \u0627\u06cc\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0628\u0627\u0633\u0644\u0627\u0645\u060c \u062a\u06a9\u0646\u0648\u0644\u0627\u06cc\u0641\u060c \u06a9\u0627\u0644\u0627\u062a\u06cc\u06a9\u060c \u0634\u0647\u0631\u0641\u0627\u0641\u0627\u060c \u0645\u062f\u06cc\u0633\u0647\u060c \u0627\u06cc\u0633\u0627\u0645\u060c \u0632\u0646\u0628\u06cc\u0644 \u0648 \u0645\u0642\u062f\u0627\u062f \u0622\u06cc\u200c\u062a\u06cc \u0647\u0633\u062a\u0646. \u062a\u0631\u0628 \u0647\u0645\u0627\u0646\u0646\u062f \u062f\u06cc\u062c\u06cc\u200c\u06a9\u0627\u0644\u0627 \u0648 \u062f\u06cc\u0648\u0627\u0631\u060c \u0645\u0627\u0631\u06a9\u062a \u067e\u0644\u06cc\u0633 \u0647\u0633\u062a \u0648 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0648 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0631\u0627 \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u0645\u06cc\u06a9\u0646\u06cc\u062f \u0648 \u0641\u0631\u0622\u06cc\u0646\u062f \u062e\u0631\u06cc\u062f \u0631\u0627 \u062a\u0633\u0647\u06cc\u0644 \u0645\u06cc\u06a9\u0646\u062f.",
    "descriptionHTML": "\u0628\u0647\u062a\u0631\u06cc\u0646 \u0642\u06cc\u0645\u062a \u0628\u0627\u0632\u0627\u0631 \u0631\u0648 \u0628\u0627 \u062a\u0631\u0628 \u067e\u06cc\u062f\u0627 \u06a9\u0646 ! <br>\u0647\u0631 \u0647\u0641\u062a\u0647 \u0628\u06cc\u0634 \u0627\u0632 5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0648 \u0631\u0648\u0632\u0627\u0646\u0647 \u062f\u0631 \u062d\u062f\u0648\u062f 2 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u06a9\u0627\u0631\u0628\u0631\u060c \u0627\u0632 \u0633\u0631\u0627\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646\u060c \u0627\u0632 \u0637\u0631\u06cc\u0642 \u062a\u0631\u0628 \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u0634\u0648\u0646 \u0631\u0648 \u0628\u06cc\u0646 \u0647\u0632\u0627\u0631\u0627\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u0633\u0631\u0686 \u0645\u06cc\u06a9\u0646\u0646 \u0648 \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u0634\u0648\u0646\u060c \u062e\u0631\u06cc\u062f \u0622\u0646\u0644\u0627\u06cc\u0646 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u062f\u0646.<br><br>\u06a9\u0627\u0641\u06cc\u0647 \u0627\u0633\u0645 \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u062a \u0631\u0648 \u062a\u0648 \u062a\u0631\u0628 \u0633\u0631\u0686 \u06a9\u0646\u06cc\u060c  \u062a\u0631\u0628 \u0627\u0648\u0646 \u0645\u062d\u0635\u0648\u0644 \u0631\u0648 \u0628\u06cc\u0646 \u06a9\u0644\u06cc \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062c\u0633\u062a\u200c\u0648\u062c\u0648 \u0645\u06cc\u06a9\u0646\u0647 \u0648 \u0642\u06cc\u0645\u062a \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0631\u0648 \u06cc\u0647 \u062c\u0627 \u0628\u0627 \u0647\u0645 \u0645\u0642\u0627\u06cc\u0633\u0647 \u0645\u06cc\u06a9\u0646\u0647 \u0648 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0645\u0633\u062a\u0642\u06cc\u0645 \u0627\u0632 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u060c \u0622\u0646\u0644\u0627\u06cc\u0646 \u062e\u0631\u06cc\u062f\u062a \u0631\u0648 \u0627\u0646\u062c\u0627\u0645 \u0628\u062f\u06cc. \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0642\u06cc\u0645\u062a \u060c \u0627\u0645\u062a\u06cc\u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0647\u0627 \u0631\u0648 \u0647\u0645 \u0645\u06cc\u062a\u0648\u0646\u06cc \u0628\u0631 \u0627\u0633\u0627\u0633 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634 \u06a9\u0627\u0631\u0628\u0631\u0647\u0627\u06cc \u062a\u0631\u0628 \u0628\u0628\u06cc\u0646\u06cc \u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0647\u062a\u0631\u06cc \u0628\u06cc\u0646 \u0641\u0631\u0648\u0634\u0646\u062f\u0647\u200c\u0647\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc. <br><br>\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u062a\u0631\u0628:<br>\u25cf \u0627\u0645\u06a9\u0627\u0646 \u062e\u0631\u06cc\u062f \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u06cc\u0634 \u0627\u0632 15 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u0645\u062d\u0635\u0648\u0644 \u0627\u0632 \u0645\u06cc\u0627\u0646 \u0628\u06cc\u0634 \u0627\u0632 50 \u0647\u0632\u0627\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u0639\u062a\u0628\u0631 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc<br>\u25cf \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u0642\u06cc\u0645\u062a \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u0644\u067e\u200c\u062a\u0627\u067e \u0648 \u0644\u0648\u0627\u0632\u0645 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u06cc \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u0627\u0632 \u0642\u06cc\u0645\u062a \u06af\u0648\u0634\u06cc \u0622\u06cc\u0641\u0648\u0646 \u0648 \u0633\u0627\u0645\u0633\u0648\u0646\u06af \u062a\u0627 \u0647\u0648\u0627\u0648\u06cc \u0648 \u0634\u06cc\u0627\u0626\u0648\u0645\u06cc<br>\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0648 \u0628\u0631\u0631\u0633\u06cc \u0639\u0645\u0644\u06a9\u0631\u062f \u0641\u0631\u0648\u0634\u0646\u062f\u06af\u0627\u0646 \u0648 \u062e\u0631\u06cc\u062f \u0645\u0637\u0645\u06cc\u0646\u200c\u062a\u0631 <br>\u25cf \u0627\u0645\u06a9\u0627\u0646 \u0645\u0634\u0627\u0647\u062f\u0647 \u0642\u06cc\u0645\u062a \u0648 \u062e\u0631\u06cc\u062f \u0622\u0646\u0644\u0627\u06cc\u0646 \u0627\u0632 \u0633\u0648\u067e\u0631 \u0645\u0627\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc<br>\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0642\u06cc\u0645\u062a \u062f\u0644\u0627\u0631\u060c \u0642\u06cc\u0645\u062a \u0633\u06a9\u0647\u060c \u0642\u06cc\u0645\u062a \u0637\u0644\u0627 \u0648 \u0627\u0631\u0632\u0647\u0627\u06cc \u062e\u0627\u0631\u062c\u06cc \u0627\u0632 \u0645\u0646\u0627\u0628\u0639 \u0645\u0639\u062a\u0628\u0631<br>\u25cf \u0645\u0634\u0627\u0647\u062f\u0647 \u0648 \u0628\u0631\u0631\u0633\u06cc \u0642\u06cc\u0645\u062a \u0641\u0631\u0648\u0634\u0646\u062f\u06af\u0627\u0646 \u062d\u0636\u0648\u0631\u06cc \u062f\u0631 \u0627\u0637\u0631\u0627\u0641 \u0634\u0645\u0627<br>\u25cf \u0627\u0645\u06a9\u0627\u0646 \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 \u062a\u063a\u06cc\u06cc\u0631 \u0642\u06cc\u0645\u062a \u06a9\u0627\u0644\u0627\u06cc \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0646\u0648\u062a\u06cc\u0641\u06cc\u06a9\u06cc\u0634\u0646<br>\u25cf \u0646\u0645\u0648\u062f\u0627\u0631 \u0632\u0645\u0627\u0646\u06cc \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u062f\u0631 \u0631\u0648\u0632\u0647\u0627 \u0648 \u0647\u0641\u062a\u0647\u200c\u0647\u0627\u06cc \u06af\u0630\u0634\u062a\u0647<br>\u25cf\u0642\u06cc\u0645\u062a \u0628\u06cc\u062a\u200c\u06a9\u0648\u06cc\u0646 \u0648 \u0633\u0627\u06cc\u0631 \u0631\u0645\u0632\u0627\u0631\u0632\u0647\u0627 \u0627\u0632 \u0645\u0631\u0627\u062c\u0639 \u0645\u0639\u062a\u0628\u0631<br><br>\u0627\u0632 \u0637\u0631\u06cc\u0642 \u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0646\u06cc\u0632 \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u062d\u0635\u0648\u0644 \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062a\u0631\u0628 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f \u0648 \u062e\u0631\u06cc\u062f \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062e\u0648\u062f\u062a\u0648\u0646 \u0631\u0648 \u0627\u0646\u062c\u0627\u0645 \u0628\u062f\u06cc\u062f. \u0686\u0646\u062f \u0646\u0645\u0648\u0646\u0647 \u0627\u0632 \u062f\u0633\u062a\u0647 \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u067e\u0631\u0637\u0631\u0641\u062f\u0627\u0631 \u062f\u0631 \u062a\u0631\u0628 <br>\u25cf  \u06af\u0648\u0634\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 \u0648 \u0644\u067e\u200c\u062a\u0627\u067e \u0648 \u062a\u0628\u0644\u062a \u0648 \u0644\u0648\u0627\u0632\u0645 \u062c\u0627\u0646\u0628\u06cc \u0645\u0648\u0628\u0627\u06cc\u0644 <br>\u25cf  \u0627\u0628\u0632\u0627\u0631\u0622\u0644\u0627\u062a \u0648 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0633\u0627\u062e\u062a\u0645\u0627\u0646\u06cc \u0648 \u0639\u0645\u0631\u0627\u0646\u06cc<br>\u25cf \u06a9\u0646\u0633\u0648\u0644 \u0628\u0627\u0632\u06cc \u067e\u0644\u06cc \u0627\u0633\u062a\u06cc\u0634\u0646 \u0648 \u0627\u06cc\u06a9\u0633 \u0628\u0627\u06a9\u0633 \u0648 \u0646\u06cc\u0646\u062a\u0646\u062f\u0648 \u0648 \u0644\u0648\u0627\u0632\u0645 \u0635\u0648\u062a\u06cc \u0648 \u062a\u0635\u0648\u06cc\u0631\u06cc<br>\u25cf \u0644\u0628\u0627\u0633 \u0648 \u06a9\u06cc\u0641 \u0648 \u06a9\u0641\u0634 \u0648 \u067e\u0648\u0634\u0627\u06a9<br>\u25cf \u0644\u0648\u0627\u0632\u0645 \u0622\u0631\u0627\u06cc\u0634\u06cc \u0648 \u0628\u0647\u062f\u0627\u0634\u062a\u06cc<br>\u25cf \u0645\u0627\u0633\u06a9 \u0648 \u0644\u0648\u0627\u0632\u0645 \u0636\u062f\u0639\u0641\u0648\u0646\u06cc \u0648 \u0644\u0648\u0627\u0632\u0645 \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u06a9\u0631\u0648\u0646\u0627 <br><br>\u25cf \u0686\u0647 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc\u06cc \u062f\u0631 \u062a\u0631\u0628 \u0641\u0639\u0627\u0644\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f<br>\u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u0628\u06cc\u0634 \u0627\u0632 50 \u0647\u0632\u0627\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u062f\u0627\u0631\u0627\u06cc \u0646\u0645\u0627\u062f \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u062f\u0631 \u062a\u0631\u0628 \u062d\u0627\u0636\u0631 \u0647\u0633\u062a\u0646\u062f \u0648 \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0639\u062f\u0627\u062f \u0647\u0631 \u0631\u0648\u0632 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u0634\u0646. \u0647\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0642\u0628\u0644 \u0627\u0632 \u0627\u0636\u0627\u0641\u0647 \u0634\u062f\u0646 \u0628\u0647 \u062a\u0631\u0628 \u062a\u0648\u0633\u0637 \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0637\u0648\u0644 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u062a\u0631\u0628 \u0646\u06cc\u0632 \u0628\u0627\u0632\u062e\u0648\u0631\u062f\u0647\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062a\u0631\u0628 \u062f\u0631 \u0645\u0648\u0631\u062f \u062e\u0631\u06cc\u062f \u0627\u0632 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0628\u0627 \u062f\u0642\u062a \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u0632 \u062c\u0645\u0644\u0647 \u0627\u06cc\u0646 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0628\u0627\u0633\u0644\u0627\u0645\u060c \u062a\u06a9\u0646\u0648\u0644\u0627\u06cc\u0641\u060c \u06a9\u0627\u0644\u0627\u062a\u06cc\u06a9\u060c \u0634\u0647\u0631\u0641\u0627\u0641\u0627\u060c \u0645\u062f\u06cc\u0633\u0647\u060c \u0627\u06cc\u0633\u0627\u0645\u060c \u0632\u0646\u0628\u06cc\u0644 \u0648 \u0645\u0642\u062f\u0627\u062f \u0622\u06cc\u200c\u062a\u06cc \u0647\u0633\u062a\u0646. \u062a\u0631\u0628 \u0647\u0645\u0627\u0646\u0646\u062f \u062f\u06cc\u062c\u06cc\u200c\u06a9\u0627\u0644\u0627 \u0648 \u062f\u06cc\u0648\u0627\u0631\u060c \u0645\u0627\u0631\u06a9\u062a \u067e\u0644\u06cc\u0633 \u0647\u0633\u062a \u0648 \u062e\u0631\u06cc\u062f\u0627\u0631 \u0648 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0631\u0627 \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u0645\u06cc\u06a9\u0646\u06cc\u062f \u0648 \u0641\u0631\u0622\u06cc\u0646\u062f \u062e\u0631\u06cc\u062f \u0631\u0627 \u062a\u0633\u0647\u06cc\u0644 \u0645\u06cc\u06a9\u0646\u062f.",
