public interface  com.adobe.air.FlashEGL extends java.lang.Object
{

    public abstract int CreateDummySurfaceAndContext();

    public abstract int CreateGLContext(boolean);

    public abstract int CreateWindowSurface(android.view.SurfaceView, int);

    public abstract boolean DestroyGLContext();

    public abstract boolean DestroyWindowSurface();

    public abstract int[] GetConfigs(boolean, boolean);

    public abstract int[] GetNumConfigs();

    public abstract int GetSurfaceHeight();

    public abstract int GetSurfaceWidth();

    public abstract boolean HasGLContext();

    public abstract int InitEGL();

    public abstract boolean IsARGBSurface();

    public abstract boolean IsBufferPreserve();

    public abstract boolean IsEmulator();

    public abstract int MakeGLCurrent();

    public abstract void ReleaseGPUResources();

    public abstract void SetConfig(int);

    public abstract void SwapEGLBuffers();

    public abstract void TerminateEGL();
}
