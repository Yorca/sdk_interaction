public interface  com.vungle.warren.PlayAdCallback extends java.lang.Object
{

    public abstract void creativeId(java.lang.String);

    public abstract void onAdClick(java.lang.String);

    public abstract void onAdEnd(java.lang.String);

    public abstract void onAdEnd(java.lang.String, boolean, boolean);

    public abstract void onAdLeftApplication(java.lang.String);

    public abstract void onAdRewarded(java.lang.String);

    public abstract void onAdStart(java.lang.String);

    public abstract void onAdViewed(java.lang.String);

    public abstract void onError(java.lang.String, com.vungle.warren.error.VungleException);
}
