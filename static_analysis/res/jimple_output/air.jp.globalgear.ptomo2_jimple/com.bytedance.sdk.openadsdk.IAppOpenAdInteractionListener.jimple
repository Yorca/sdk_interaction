public interface  com.bytedance.sdk.openadsdk.IAppOpenAdInteractionListener extends java.lang.Object implements android.os.IInterface
{

    public abstract void onAdClicked() throws android.os.RemoteException;

    public abstract void onAdShow() throws android.os.RemoteException;

    public abstract void onAdSkip() throws android.os.RemoteException;

    public abstract void onAdTimeOver() throws android.os.RemoteException;

    public abstract void onDestroy() throws android.os.RemoteException;
}
