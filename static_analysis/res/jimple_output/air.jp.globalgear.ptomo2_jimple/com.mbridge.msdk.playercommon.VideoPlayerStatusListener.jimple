public interface  com.mbridge.msdk.playercommon.VideoPlayerStatusListener extends java.lang.Object
{

    public abstract void onBufferingEnd();

    public abstract void onBufferingStart(java.lang.String);

    public abstract void onPlayCompleted();

    public abstract void onPlayError(java.lang.String);

    public abstract void onPlayProgress(int, int);

    public abstract void onPlayProgressMS(int, int);

    public abstract void onPlaySetDataSourceError(java.lang.String);

    public abstract void onPlayStarted(int);
}
