public interface  com.mbridge.msdk.playercommon.exoplayer2.offline.Downloader extends java.lang.Object
{

    public abstract void cancel();

    public abstract void download() throws java.lang.InterruptedException, java.io.IOException;

    public abstract float getDownloadPercentage();

    public abstract long getDownloadedBytes();

    public abstract void remove() throws java.lang.InterruptedException;
}
