public interface  com.vungle.warren.persistence.Designer extends java.lang.Object
{

    public abstract void clearCache();

    public abstract void deleteAssets(java.lang.String) throws java.io.IOException;

    public abstract java.io.File getAssetDirectory(java.lang.String) throws java.lang.IllegalStateException;

    public abstract java.io.File getCacheDirectory() throws java.lang.IllegalStateException;
}
