public interface  com.vungle.warren.NativeAdListener extends java.lang.Object
{

    public abstract void creativeId(java.lang.String);

    public abstract void onAdClick(java.lang.String);

    public abstract void onAdImpression(java.lang.String);

    public abstract void onAdLeftApplication(java.lang.String);

    public abstract void onAdLoadError(java.lang.String, com.vungle.warren.error.VungleException);

    public abstract void onAdPlayError(java.lang.String, com.vungle.warren.error.VungleException);

    public abstract void onNativeAdLoaded(com.vungle.warren.NativeAd);
}
