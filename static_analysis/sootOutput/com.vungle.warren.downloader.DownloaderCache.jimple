public interface  com.vungle.warren.downloader.DownloaderCache extends java.lang.Object
{

    public abstract void clear();

    public abstract boolean deleteAndRemove(java.io.File);

    public abstract boolean deleteContents(java.io.File);

    public abstract long getCacheUpdateTimestamp(java.io.File);

    public abstract java.io.File getFile(java.lang.String) throws java.io.IOException;

    public abstract java.io.File getMetaFile(java.io.File);

    public abstract void init();

    public abstract void onCacheHit(java.io.File, long);

    public abstract java.util.List purge();

    public abstract void setCacheLastUpdateTimestamp(java.io.File, long);

    public abstract void startTracking(java.io.File);

    public abstract void stopTracking(java.io.File);
}
