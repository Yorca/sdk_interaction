public interface  com.ironsource.mediationsdk.sdk.BannerSmashListener extends java.lang.Object
{

    public abstract void onBannerAdClicked();

    public abstract void onBannerAdLeftApplication();

    public abstract void onBannerAdLoadFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onBannerAdLoaded(android.view.View, android.widget.FrameLayout$LayoutParams);

    public abstract void onBannerAdScreenDismissed();

    public abstract void onBannerAdScreenPresented();

    public abstract void onBannerAdShown();

    public abstract void onBannerInitFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onBannerInitSuccess();
}
