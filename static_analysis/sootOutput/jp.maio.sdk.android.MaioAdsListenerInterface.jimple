public interface  jp.maio.sdk.android.MaioAdsListenerInterface extends java.lang.Object
{

    public abstract void onChangedCanShow(java.lang.String, boolean);

    public abstract void onClickedAd(java.lang.String);

    public abstract void onClosedAd(java.lang.String);

    public abstract void onFailed(jp.maio.sdk.android.FailNotificationReason, java.lang.String);

    public abstract void onFinishedAd(int, boolean, int, java.lang.String);

    public abstract void onInitialized();

    public abstract void onOpenAd(java.lang.String);

    public abstract void onStartedAd(java.lang.String);
}
