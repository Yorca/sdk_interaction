public interface  com.ironsource.mediationsdk.sdk.LevelPlayBannerListener extends java.lang.Object
{

    public abstract void onAdClicked(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdLeftApplication(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdLoadFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onAdLoaded(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdScreenDismissed(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdScreenPresented(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);
}
