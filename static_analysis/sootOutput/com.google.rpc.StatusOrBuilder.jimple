public interface  com.google.rpc.StatusOrBuilder extends java.lang.Object implements com.google.protobuf.MessageLiteOrBuilder
{

    public abstract int getCode();

    public abstract com.google.protobuf.Any getDetails(int);

    public abstract int getDetailsCount();

    public abstract java.util.List getDetailsList();

    public abstract java.lang.String getMessage();

    public abstract com.google.protobuf.ByteString getMessageBytes();
}
