public interface  com.inmobi.sdk.SdkInitializationListener extends java.lang.Object
{
    public static final java.lang.String INVALID_ACCOUNT_ID;
    public static final java.lang.String INVALID_SITE_ID;
    public static final java.lang.String MISSING_REQUIRED_DEPENDENCIES;
    public static final java.lang.String UNKNOWN_ERROR;

    public abstract void onInitializationComplete(java.lang.Error);

    public static void <clinit>()
    {
        <com.inmobi.sdk.SdkInitializationListener: java.lang.String UNKNOWN_ERROR> = "SDK could not be initialized; an unexpected error was encountered.";

        <com.inmobi.sdk.SdkInitializationListener: java.lang.String MISSING_REQUIRED_DEPENDENCIES> = "SDK could not be initialized; Required dependency could not be found. Please check out documentation and include the required dependency.";

        <com.inmobi.sdk.SdkInitializationListener: java.lang.String INVALID_SITE_ID> = "SiteId cannot be empty. Please provide a valid SiteId.";

        <com.inmobi.sdk.SdkInitializationListener: java.lang.String INVALID_ACCOUNT_ID> = "Account id cannot be empty. Please provide a valid account id.";

        return;
    }
}
