public interface  com.ironsource.mediationsdk.demandOnly.ISDemandOnlyInterstitialListener extends java.lang.Object
{

    public abstract void onInterstitialAdClicked(java.lang.String);

    public abstract void onInterstitialAdClosed(java.lang.String);

    public abstract void onInterstitialAdLoadFailed(java.lang.String, com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onInterstitialAdOpened(java.lang.String);

    public abstract void onInterstitialAdReady(java.lang.String);

    public abstract void onInterstitialAdShowFailed(java.lang.String, com.ironsource.mediationsdk.logger.IronSourceError);
}
