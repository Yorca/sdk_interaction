public interface  com.vungle.warren.downloader.Downloader extends java.lang.Object
{

    public abstract void cancel(com.vungle.warren.downloader.DownloadRequest);

    public abstract void cancelAll();

    public abstract boolean cancelAndAwait(com.vungle.warren.downloader.DownloadRequest, long);

    public abstract void clearCache();

    public abstract void download(com.vungle.warren.downloader.DownloadRequest, com.vungle.warren.downloader.AssetDownloadListener);

    public abstract boolean dropCache(java.lang.String);

    public abstract java.util.List getAllRequests();

    public abstract void init();

    public abstract boolean isCacheEnabled();

    public abstract void setCacheEnabled(boolean);

    public abstract void setProgressStep(int);

    public abstract void updatePriority(com.vungle.warren.downloader.DownloadRequest);
}
