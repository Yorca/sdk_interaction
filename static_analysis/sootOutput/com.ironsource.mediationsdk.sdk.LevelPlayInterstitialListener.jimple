public interface  com.ironsource.mediationsdk.sdk.LevelPlayInterstitialListener extends java.lang.Object
{

    public abstract void onAdClicked(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdClosed(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdLoadFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onAdOpened(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdReady(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdShowFailed(com.ironsource.mediationsdk.logger.IronSourceError, com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);

    public abstract void onAdShowSucceeded(com.ironsource.mediationsdk.adunit.adapter.utility.AdInfo);
}
