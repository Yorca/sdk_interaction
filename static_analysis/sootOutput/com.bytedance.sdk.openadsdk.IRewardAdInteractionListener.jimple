public interface  com.bytedance.sdk.openadsdk.IRewardAdInteractionListener extends java.lang.Object implements android.os.IInterface
{

    public abstract void onAdClose() throws android.os.RemoteException;

    public abstract void onAdShow() throws android.os.RemoteException;

    public abstract void onAdVideoBarClick() throws android.os.RemoteException;

    public abstract void onDestroy() throws android.os.RemoteException;

    public abstract void onRewardVerify(boolean, int, java.lang.String, int, java.lang.String) throws android.os.RemoteException;
}
