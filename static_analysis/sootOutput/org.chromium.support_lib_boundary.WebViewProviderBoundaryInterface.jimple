public interface  org.chromium.support_lib_boundary.WebViewProviderBoundaryInterface extends java.lang.Object
{

    public abstract java.lang.reflect.InvocationHandler addDocumentStartJavaScript(java.lang.String, java.lang.String[]);

    public abstract void addWebMessageListener(java.lang.String, java.lang.String[], java.lang.reflect.InvocationHandler);

    public abstract java.lang.reflect.InvocationHandler[] createWebMessageChannel();

    public abstract android.webkit.WebChromeClient getWebChromeClient();

    public abstract android.webkit.WebViewClient getWebViewClient();

    public abstract java.lang.reflect.InvocationHandler getWebViewRenderer();

    public abstract java.lang.reflect.InvocationHandler getWebViewRendererClient();

