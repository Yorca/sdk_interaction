public interface  com.ironsource.mediationsdk.sdk.RewardedVideoListener extends java.lang.Object
{

    public abstract void onRewardedVideoAdClicked(com.ironsource.mediationsdk.model.Placement);

    public abstract void onRewardedVideoAdClosed();

    public abstract void onRewardedVideoAdEnded();

    public abstract void onRewardedVideoAdOpened();

    public abstract void onRewardedVideoAdRewarded(com.ironsource.mediationsdk.model.Placement);

    public abstract void onRewardedVideoAdShowFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onRewardedVideoAdStarted();

    public abstract void onRewardedVideoAvailabilityChanged(boolean);
}
