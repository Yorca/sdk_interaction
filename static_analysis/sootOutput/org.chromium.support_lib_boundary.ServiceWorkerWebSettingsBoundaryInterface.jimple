public interface  org.chromium.support_lib_boundary.ServiceWorkerWebSettingsBoundaryInterface extends java.lang.Object
{

    public abstract boolean getAllowContentAccess();

    public abstract boolean getAllowFileAccess();

    public abstract boolean getBlockNetworkLoads();

    public abstract int getCacheMode();

    public abstract java.util.Set getRequestedWithHeaderOriginAllowList();

    public abstract void setAllowContentAccess(boolean);

    public abstract void setAllowFileAccess(boolean);

    public abstract void setBlockNetworkLoads(boolean);

    public abstract void setCacheMode(int);

    public abstract void setRequestedWithHeaderOriginAllowList(java.util.Set);
}
