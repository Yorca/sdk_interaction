public interface  io.grpc.internal.InternalServer extends java.lang.Object
{

    public abstract java.net.SocketAddress getListenSocketAddress();

    public abstract java.util.List getListenSocketAddresses();

    public abstract io.grpc.InternalInstrumented getListenSocketStats();

    public abstract java.util.List getListenSocketStatsList();

    public abstract void shutdown();

    public abstract void start(io.grpc.internal.ServerListener) throws java.io.IOException;
}
