public interface  org.chromium.support_lib_boundary.TracingControllerBoundaryInterface extends java.lang.Object
{

    public abstract boolean isTracing();

    public abstract void start(int, java.util.Collection, int) throws java.lang.IllegalStateException, java.lang.IllegalArgumentException;

    public abstract boolean stop(java.io.OutputStream, java.util.concurrent.Executor);
}
