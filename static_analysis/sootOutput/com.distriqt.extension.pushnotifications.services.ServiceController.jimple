public interface  com.distriqt.extension.pushnotifications.services.ServiceController extends java.lang.Object
{

    public abstract boolean canSendTags();

    public abstract boolean canSubscribeToTopics();

    public abstract void cancelAll();

    public abstract void checkStartupData();

    public abstract boolean deleteTags(java.util.ArrayList);

    public abstract void dispose();

    public abstract java.lang.String getDeviceToken();

    public abstract java.lang.String getServiceToken();

    public abstract boolean getTags();

    public abstract com.distriqt.extension.pushnotifications.services.InAppMessagingController inAppMessaging();

    public abstract boolean isSupported();

    public abstract boolean provideUserConsent(boolean);

    public abstract void register();

    public abstract void removeUserId();

    public abstract boolean sendTags(java.util.HashMap);

    public abstract void setUserId(java.lang.String, java.lang.String);

    public abstract boolean subscribeToTopic(java.lang.String);

    public abstract void unregister();

    public abstract boolean unsubscribeFromTopic(java.lang.String);
