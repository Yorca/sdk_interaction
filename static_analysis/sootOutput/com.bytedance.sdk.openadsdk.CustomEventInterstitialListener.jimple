public interface  com.bytedance.sdk.openadsdk.CustomEventInterstitialListener extends java.lang.Object
{

    public abstract void onInterstitialClicked();

    public abstract void onInterstitialDismissed();

    public abstract void onInterstitialImpression();

    public abstract void onInterstitialShowFail();

    public abstract void onInterstitialShown();

    public abstract void onLeaveApplication();
}
