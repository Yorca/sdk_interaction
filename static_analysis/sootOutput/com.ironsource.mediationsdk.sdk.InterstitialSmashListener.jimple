public interface  com.ironsource.mediationsdk.sdk.InterstitialSmashListener extends java.lang.Object
{

    public abstract void onInterstitialAdClicked();

    public abstract void onInterstitialAdClosed();

    public abstract void onInterstitialAdLoadFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onInterstitialAdOpened();

    public abstract void onInterstitialAdReady();

    public abstract void onInterstitialAdShowFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onInterstitialAdShowSucceeded();

    public abstract void onInterstitialAdVisible();

    public abstract void onInterstitialInitFailed(com.ironsource.mediationsdk.logger.IronSourceError);

    public abstract void onInterstitialInitSuccess();
}
