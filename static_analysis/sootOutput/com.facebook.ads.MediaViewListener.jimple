public interface  com.facebook.ads.MediaViewListener extends java.lang.Object
{

    public abstract void onComplete(com.facebook.ads.MediaView);

    public abstract void onEnterFullscreen(com.facebook.ads.MediaView);

    public abstract void onExitFullscreen(com.facebook.ads.MediaView);

    public abstract void onFullscreenBackground(com.facebook.ads.MediaView);

    public abstract void onFullscreenForeground(com.facebook.ads.MediaView);

    public abstract void onPause(com.facebook.ads.MediaView);

    public abstract void onPlay(com.facebook.ads.MediaView);

    public abstract void onVolumeChange(com.facebook.ads.MediaView, float);
}
