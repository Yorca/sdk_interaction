public interface  com.mbridge.msdk.foundation.download.resource.stream.DownloadFileOutputStream extends java.lang.Object
{

    public abstract void close() throws java.io.IOException;

    public abstract void flushAndSync() throws java.io.IOException;

    public abstract void seek(long) throws java.io.IOException, java.lang.IllegalAccessException;

    public abstract void setLength(long) throws java.io.IOException, java.lang.IllegalAccessException;

    public abstract void write(byte[], int, int) throws java.io.IOException;
}
